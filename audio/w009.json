 "bodyCues": 22,
 "v": "42cef636",
 "cues": [
  {
   "t": 0.1,
   "d": 1.478,
   "s": "岳阳楼记"
  },
  {
   "t": 1.528,
   "d": 2.472,
   "s": "宋代，范仲淹"
  },
  {
   "t": 4.0,
   "d": 4.056,
   "s": "庆历四年春，滕子京谪守巴陵郡。"
  },
  {
   "t": 8.056,
   "d": 4.0,
   "s": "越明年，政通人和，百废具兴。"
  },
  {
   "t": 12.056,
   "d": 5.875,
   "s": "乃重修岳阳楼，增其旧制，刻唐贤今人诗赋于其上。"
  },
  {
   "t": 17.931,
   "d": 2.167,
   "s": "属予作文以记之。"
  },
  {
   "t": 20.097,
   "d": 3.861,
   "s": "予观夫巴陵胜状，在洞庭一湖。"
  },
  {
   "t": 23.958,
   "d": 7.431,
   "s": "衔远山，吞长江，浩浩汤汤，横无际涯；朝晖夕阴，气象万千。"
  },
  {
   "t": 31.389,
   "d": 4.486,
   "s": "此则岳阳楼之大观也，前人之述备矣。"
  },
  {
   "t": 35.875,
   "d": 8.167,
   "s": "然则北通巫峡，南极潇湘，迁客骚人，多会于此，览物之情，得无异乎？"
  },
  {
   "t": 44.042,
   "d": 13.125,
   "s": "若夫淫雨霏霏，连月不开，阴风怒号，浊浪排空；日星隐曜，山岳潜形；商旅不行，樯倾楫摧；薄暮冥冥，虎啸猿啼。"
  },
  {
   "t": 57.167,
   "d": 7.264,
   "s": "登斯楼也，则有去国怀乡，忧谗畏讥，满目萧然，感极而悲者矣。"
  },
  {
   "t": 64.431,
   "d": 10.653,
   "s": "至若春和景明，波澜不惊，上下天光，一碧万顷；沙鸥翔集，锦鳞游泳；岸芷汀兰，郁郁青青。"
  },
  {
   "t": 75.083,
   "d": 8.403,
   "s": "而或长烟一空，皓月千里，浮光跃金，静影沉璧，渔歌互答，此乐何极！"
  },
  {
   "t": 83.486,
   "d": 7.597,
   "s": "登斯楼也，则有心旷神怡，宠辱偕忘，把酒临风，其喜洋洋者矣。"
  },
  {
   "t": 91.083,
   "d": 1.444,
   "s": "嗟夫！"
  },
  {
   "t": 92.528,
   "d": 4.792,
   "s": "予尝求古仁人之心，或异二者之为，何哉？"
  },
  {
   "t": 97.319,
   "d": 7.444,
   "s": "不以物喜，不以己悲；居庙堂之高则忧其民；处江湖之远则忧其君。"
  },
  {
   "t": 104.764,
   "d": 2.5,
   "s": "是进亦忧，退亦忧。"
  },
  {
   "t": 107.264,
   "d": 2.25,
   "s": "然则何时而乐耶？"
  },
  {
   "t": 109.514,
   "d": 5.681,
   "s": "其必曰先天下之忧，而忧，后天下之乐而乐乎！"
  },
  {
   "t": 115.194,
   "d": 1.0,
   "s": "噫！"
  },
  {
   "t": 116.194,
   "d": 2.625,
   "s": "微斯人，吾谁与归？"
  },
  {
   "t": 118.819,
   "d": 2.903,
   "s": "时六年九月十五日。"
  }
 ]
}