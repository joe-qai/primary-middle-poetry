   "s": "白雪歌送武判官归京"
  },
  {
   "t": 2.986,
   "d": 2.514,
   "s": "唐代，岑参"
  },
  {
   "t": 5.668,
   "d": 4.644,
   "s": "北风卷地白草折，胡天八月即飞雪。"
  },
  {
   "t": 10.42,
   "d": 4.575,
   "s": "忽如一夜春风来，千树万树梨花开。"
  },
  {
   "t": 15.1,
   "d": 4.519,
   "s": "散入珠帘湿罗幕，狐裘不暖锦衾薄。"
  },
  {
   "t": 19.732,
   "d": 4.714,
   "s": "将军角弓不得控，都护铁衣冷难着。"
  },
  {
   "t": 24.556,
   "d": 4.964,
   "s": "瀚海阑干百丈冰，愁云惨淡万里凝。"
  },
  {
   "t": 29.62,
   "d": 4.603,
   "s": "中军置酒饮归客，胡琴琵琶与羌笛。"
  },
  {
   "t": 34.324,
   "d": 4.631,
   "s": "纷纷暮雪下辕门，风掣红旗冻不翻。"
  },
  {
   "t": 39.076,
   "d": 4.631,
   "s": "轮台东门送君去，去时雪满天山路。"
  },
  {
   "t": 43.828,
   "d": 4.769,
   "s": "山回路转不见君，雪上空留马行处。"
  }
 ]
