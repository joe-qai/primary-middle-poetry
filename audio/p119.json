   "s": "白雪歌送武判官归京"
  },
  {
   "t": 2.986,
   "d": 2.181,
   "s": "唐代，岑参"
  },
  {
   "t": 5.167,
   "d": 4.306,
   "s": "北风卷地白草折，胡天八月即飞雪。"
  },
  {
   "t": 9.472,
   "d": 4.236,
   "s": "忽如一夜春风来，千树万树梨花开。"
  },
  {
   "t": 13.708,
   "d": 4.181,
   "s": "散入珠帘湿罗幕，狐裘不暖锦衾薄。"
  },
  {
   "t": 17.889,
   "d": 4.375,
   "s": "将军角弓不得控，都护铁衣冷难着。"
  },
  {
   "t": 22.264,
   "d": 4.625,
   "s": "瀚海阑干百丈冰，愁云惨淡万里凝。"
  },
  {
   "t": 26.889,
   "d": 4.264,
   "s": "中军置酒饮归客，胡琴琵琶与羌笛。"
  },
  {
   "t": 31.153,
   "d": 4.292,
   "s": "纷纷暮雪下辕门，风掣红旗冻不翻。"
  },
  {
   "t": 35.444,
   "d": 4.292,
   "s": "轮台东门送君去，去时雪满天山路。"
  },
  {
   "t": 39.736,
   "d": 4.764,
   "s": "山回路转不见君，雪上空留马行处。"
  }
 ]
