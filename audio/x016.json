{
 "id": "x016",
 "title": "师说",
 "voice": "zh-CN-YunjianNeural",
 "rate": "-10%",
 "pitch": "+0Hz",
 "dur": 147.542,
 "hdr": 2,
 "bodyCues": 29,
 "v": "302d4eaa",
 "cues": [
  {
   "t": 0.1,
   "d": 1.283,
   "s": "师说"
  },
  {
   "t": 1.333,
   "d": 2.167,
   "s": "唐代，韩愈"
  },
  {
   "t": 3.5,
   "d": 2.306,
   "s": "古之学者必有师。"
  },
  {
   "t": 5.806,
   "d": 3.542,
   "s": "师者，所以传道受业解惑也。"
  },
  {
   "t": 9.347,
   "d": 3.764,
   "s": "人非生而知之者，孰能无惑？"
  },
  {
   "t": 13.111,
   "d": 4.375,
   "s": "惑而不从师，其为惑也，终不解矣。"
  },
  {
   "t": 17.486,
   "d": 9.847,
   "s": "生乎吾前，其闻道也固先乎吾，吾从而师之；生乎吾后，其闻道也亦先乎吾，吾从而师之。"
  },
  {
   "t": 27.333,
   "d": 4.694,
   "s": "吾师道也，夫庸知其年之先后生于吾乎？"
  },
  {
   "t": 32.028,
   "d": 6.25,
   "s": "是故无贵无贱，无长无少，道之所存，师之所存也。"
  },
  {
   "t": 38.278,
   "d": 1.417,
   "s": "嗟乎！"
  },
  {
   "t": 39.694,
   "d": 2.639,
   "s": "师道之不传也久矣！"
  },
  {
   "t": 42.333,
   "d": 2.5,
   "s": "欲人之无惑也难矣！"
  },
  {
   "t": 44.833,
   "d": 9.639,
   "s": "古之圣人，其出人也远矣，犹且从师而问焉；今之众人，其下圣人也亦远矣，而耻学于师。"
  },
  {
   "t": 54.472,
   "d": 3.028,
   "s": "是故圣益圣，愚益愚。"
  },
  {
   "t": 57.5,
   "d": 5.639,
   "s": "圣人之所以为圣，愚人之所以为愚，其皆出于此乎？"
  },
  {
   "t": 63.139,
   "d": 6.236,
   "s": "爱其子，择师而教之；于其身也，则耻师焉，惑矣。"
  },
  {
   "t": 69.375,
   "d": 7.125,
   "s": "彼童子之师，授之书而习其句读者，非吾所谓传其道解其惑者也。"
  },
  {
   "t": 76.5,
   "d": 7.944,
   "s": "句读之不知，惑之不解，或师焉，或不焉，小学而大遗，吾未见其明也。"
  },
  {
   "t": 84.444,
   "d": 3.625,
   "s": "巫医乐师百工之人，不耻相师。"
  },
  {
   "t": 88.069,
   "d": 5.403,
   "s": "士大夫之族，曰师曰弟子云者，则群聚而笑之。"
  },
  {
   "t": 93.472,
   "d": 7.958,
   "s": "问之，则曰：彼与彼年相若也，道相似也，位卑则足羞，官盛则近谀。"
  },
  {
   "t": 101.431,
   "d": 1.583,
   "s": "呜呼！"
  },
  {
   "t": 103.014,
   "d": 2.847,
   "s": "师道之不复，可知矣。"
  },
  {
   "t": 105.861,
   "d": 7.153,
   "s": "巫医乐师百工之人，君子不齿，今其智乃反不能及，其可怪也欤！"
  },
  {
   "t": 113.014,
   "d": 2.069,
   "s": "圣人无常师。"
  },
  {
   "t": 115.083,
   "d": 4.889,
   "s": "孔子师郯子、苌弘、师襄、老聃。"
  },
  {
   "t": 119.972,
   "d": 3.431,
   "s": "郯子之徒，其贤不及孔子。"
  },
  {
   "t": 123.403,
   "d": 4.014,
   "s": "孔子曰：三人行，则必有我师。"
  },
  {
   "t": 127.417,
   "d": 8.417,
   "s": "是故弟子不必不如师，师不必贤于弟子，闻道有先后，术业有专攻，如是而已。"
  },
  {
   "t": 135.833,
   "d": 7.792,
   "s": "李氏子蟠，年十七，好古文，六艺经传皆通习之，不拘于时，学于余。"
  },
  {
   "t": 143.625,
   "d": 3.917,
   "s": "余嘉其能行古道，作师说以贻之。"
  }
 ]
}