 "bodyCues": 15,
 "v": "92b24a12",
 "cues": [
  {
   "t": 0.1,
   "d": 1.214,
   "s": "劝学"
  },
  {
   "t": 1.264,
   "d": 2.264,
   "s": "战国，荀子"
  },
  {
   "t": 3.528,
   "d": 3.0,
   "s": "君子曰：学不可以已。"
  },
  {
   "t": 6.528,
   "d": 6.333,
   "s": "青，取之于蓝，而青于蓝；冰，水为之，而寒于水。"
  },
  {
   "t": 12.861,
   "d": 4.097,
   "s": "木直中绳，輮以为轮，其曲中规。"
  },
  {
   "t": 16.958,
   "d": 4.292,
   "s": "虽有槁暴，不复挺者，輮使之然也。"
  },
  {
   "t": 21.25,
   "d": 8.097,
   "s": "故木受绳则直，金就砺则利，君子博学而日参省乎己，则知明而行无过矣。"
  },
  {
   "t": 29.347,
   "d": 8.347,
   "s": "吾尝终日而思矣，不如须臾之所学也；吾尝跂而望矣，不如登高之博见也。"
  },
  {
   "t": 37.694,
   "d": 8.167,
   "s": "登高而招，臂非加长也，而见者远；顺风而呼，声非加疾也，而闻者彰。"
  },
  {
   "t": 45.861,
   "d": 7.875,
   "s": "假舆马者，非利足也，而致千里；假舟楫者，非能水也，而绝江河。"
  },
  {
   "t": 53.736,
   "d": 3.792,
   "s": "君子生非异也，善假于物也。"
  },
  {
   "t": 57.528,
   "d": 9.458,
   "s": "积土成山，风雨兴焉；积水成渊，蛟龙生焉；积善成德，而神明自得，圣心备焉。"
  },
  {
   "t": 66.986,
   "d": 5.833,
   "s": "故不积跬步，无以至千里；不积小流，无以成江海。"
  },
  {
   "t": 72.819,
   "d": 5.264,
   "s": "骐骥一跃，不能十步；驽马十驾，功在不舍。"
  },
  {
   "t": 78.083,
   "d": 5.194,
   "s": "锲而舍之，朽木不折；锲而不舍，金石可镂。"
  },
  {
   "t": 83.278,
   "d": 7.0,
   "s": "蚓无爪牙之利，筋骨之强，上食埃土，下饮黄泉，用心一也。"
  },
  {
   "t": 90.278,
   "d": 6.347,
   "s": "蟹六跪而二螯，非蛇鳝之穴无可寄托者，用心躁也。"
  }
 ]
}