   "s": "东汉，曹操"
  },
  {
   "t": 3.611,
   "d": 2.847,
   "s": "东临碣石，以观沧海。"
  },
  {
   "t": 6.458,
   "d": 3.056,
   "s": "水何澹澹，山岛竦峙。"
  },
  {
   "t": 9.514,
   "d": 3.056,
   "s": "树木丛生，百草丰茂。"
  },
  {
   "t": 12.569,
   "d": 3.222,
   "s": "秋风萧瑟，洪波涌起。"
  },
  {
   "t": 15.792,
   "d": 2.903,
   "s": "日月之行，若出其中；"
  },
  {
   "t": 18.694,
   "d": 3.125,
   "s": "星汉灿烂，若出其里。"
  },
  {
   "t": 21.819,
   "d": 3.264,
   "s": "幸甚至哉，歌以咏志。"
  }
 ]
