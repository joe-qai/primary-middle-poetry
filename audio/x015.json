 "cues": [
  {
   "t": 0.1,
   "d": 1.992,
   "s": "春江花月夜"
  },
  {
   "t": 2.042,
   "d": 2.417,
   "s": "唐代，张若虚"
  },
  {
   "t": 4.458,
   "d": 4.347,
   "s": "春江潮水连海平，海上明月共潮生。"
  },
  {
   "t": 8.806,
   "d": 4.444,
   "s": "滟滟随波千万里，何处春江无月明！"
  },
  {
   "t": 13.25,
   "d": 4.222,
   "s": "江流宛转绕芳甸，月照花林皆似霰。"
  },
  {
   "t": 17.472,
   "d": 3.792,
   "s": "空里流霜不觉飞，汀上白沙看不见。"
  },
  {
   "t": 21.264,
   "d": 4.431,
   "s": "江天一色无纤尘，皎皎空中孤月轮。"
  },
  {
   "t": 25.694,
   "d": 2.611,
   "s": "江畔何人初见月？"
  },
  {
   "t": 28.306,
   "d": 2.361,
   "s": "江月何年初照人？"
  },
  {
   "t": 30.667,
   "d": 4.667,
   "s": "人生代代无穷已，江月年年望相似。"
  },
  {
   "t": 35.333,
   "d": 4.333,
   "s": "不知江月待何人，但见长江送流水。"
  },
  {
   "t": 39.667,
   "d": 4.014,
   "s": "白云一片去悠悠，青枫浦上不胜愁。"
  },
  {
   "t": 43.681,
   "d": 2.625,
   "s": "谁家今夜扁舟子？"
  },
  {
   "t": 46.306,
   "d": 2.556,
   "s": "何处相思明月楼？"
  },
  {
   "t": 48.861,
   "d": 4.264,
   "s": "可怜楼上月徘徊，应照离人妆镜台。"
  },
  {
   "t": 53.125,
   "d": 3.944,
   "s": "玉户帘中卷不去，捣衣砧上拂还来。"
  },
  {
   "t": 57.069,
   "d": 4.444,
   "s": "此时相望不相闻，愿逐月华流照君。"
  },
  {
   "t": 61.514,
   "d": 4.333,
   "s": "鸿雁长飞光不度，鱼龙潜跃水成文。"
  },
  {
   "t": 65.847,
   "d": 4.319,
   "s": "昨夜闲潭梦落花，可怜春半不还家。"
  },
  {
   "t": 70.167,
   "d": 4.306,
   "s": "江水流春去欲尽，江潭落月复西斜。"
  },
  {
   "t": 74.472,
   "d": 4.583,
   "s": "斜月沉沉藏海雾，碣石潇湘无限路。"
  },
  {
   "t": 79.056,
   "d": 4.319,
   "s": "不知乘月几人归，落月摇情满江树。"
  }
 ]
}