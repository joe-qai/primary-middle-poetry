 "v": "275528b3",
 "cues": [
  {
   "t": 0.1,
   "d": 1.992,
   "s": "春江花月夜"
  },
  {
   "t": 2.042,
   "d": 2.75,
   "s": "唐代，张若虚"
  },
  {
   "t": 4.948,
   "d": 4.686,
   "s": "春江潮水连海平，海上明月共潮生。"
  },
  {
   "t": 9.748,
   "d": 4.783,
   "s": "滟滟随波千万里，何处春江无月明！"
  },
  {
   "t": 14.644,
   "d": 4.561,
   "s": "江流宛转绕芳甸，月照花林皆似霰。"
  },
  {
   "t": 19.324,
   "d": 4.131,
   "s": "空里流霜不觉飞，汀上白沙看不见。"
  },
  {
   "t": 23.572,
   "d": 4.769,
   "s": "江天一色无纤尘，皎皎空中孤月轮。"
  },
  {
   "t": 28.444,
   "d": 2.95,
   "s": "江畔何人初见月？"
  },
  {
   "t": 31.516,
   "d": 2.7,
   "s": "江月何年初照人？"
  },
  {
   "t": 34.324,
   "d": 5.006,
   "s": "人生代代无穷已，江月年年望相似。"
  },
  {
   "t": 39.436,
   "d": 4.672,
   "s": "不知江月待何人，但见长江送流水。"
  },
  {
   "t": 44.212,
   "d": 4.353,
   "s": "白云一片去悠悠，青枫浦上不胜愁。"
  },
  {
   "t": 48.676,
   "d": 2.964,
   "s": "谁家今夜扁舟子？"
  },
  {
   "t": 51.748,
   "d": 2.894,
   "s": "何处相思明月楼？"
  },
  {
   "t": 54.748,
   "d": 4.603,
   "s": "可怜楼上月徘徊，应照离人妆镜台。"
  },
  {
   "t": 59.452,
   "d": 4.283,
   "s": "玉户帘中卷不去，捣衣砧上拂还来。"
  },
  {
   "t": 63.844,
   "d": 4.783,
   "s": "此时相望不相闻，愿逐月华流照君。"
  },
  {
   "t": 68.74,
   "d": 4.672,
   "s": "鸿雁长飞光不度，鱼龙潜跃水成文。"
  },
  {
   "t": 73.516,
   "d": 4.658,
   "s": "昨夜闲潭梦落花，可怜春半不还家。"
  },
  {
   "t": 78.292,
   "d": 4.644,
   "s": "江水流春去欲尽，江潭落月复西斜。"
  },
  {
   "t": 83.044,
   "d": 4.922,
   "s": "斜月沉沉藏海雾，碣石潇湘无限路。"
  },
  {
   "t": 88.084,
   "d": 4.325,
   "s": "不知乘月几人归，落月摇情满江树。"
  }
 ]
}