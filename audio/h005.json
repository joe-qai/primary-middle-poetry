   "s": "琵琶行并序"
  },
  {
   "t": 1.903,
   "d": 2.597,
   "s": "唐代，白居易"
  },
  {
   "t": 4.66,
   "d": 4.95,
   "s": "浔阳江头夜送客，枫叶荻花秋瑟瑟。"
  },
  {
   "t": 9.724,
   "d": 4.756,
   "s": "主人下马客在船，举酒欲饮无管弦。"
  },
  {
   "t": 14.596,
   "d": 4.519,
   "s": "千呼万唤始出来，犹抱琵琶半遮面。"
  },
  {
   "t": 19.228,
   "d": 4.867,
   "s": "大弦嘈嘈如急雨，小弦切切如私语。"
  },
  {
   "t": 24.196,
   "d": 5.131,
   "s": "嘈嘈切切错杂弹，大珠小珠落玉盘。"
  },
  {
   "t": 29.428,
   "d": 4.686,
   "s": "间关莺语花底滑，幽咽泉流冰下难。"
  },
  {
   "t": 34.228,
   "d": 4.422,
   "s": "别有幽愁暗恨生，此时无声胜有声。"
  },
  {
   "t": 38.764,
   "d": 4.561,
   "s": "银瓶乍破水浆迸，铁骑突出刀枪鸣。"
  },
  {
   "t": 43.444,
   "d": 4.408,
   "s": "曲终收拨当心画，四弦一声如裂帛。"
  },
  {
   "t": 47.956,
   "d": 4.783,
   "s": "东船西舫悄无言，唯见江心秋月白。"
  },
  {
   "t": 52.852,
   "d": 4.311,
   "s": "自言本是京城女，家在虾蟆陵下住。"
  },
  {
   "t": 57.268,
   "d": 4.7,
   "s": "同是天涯沦落人，相逢何必曾相识！"
  },
  {
   "t": 62.068,
   "d": 2.95,
   "s": "座中泣下谁最多？"
  },
  {
   "t": 65.14,
   "d": 2.811,
   "s": "江州司马青衫湿。"
  }
 ]
