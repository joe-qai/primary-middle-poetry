  },
  {
   "t": 1.278,
   "d": 2.0,
   "s": "诗经，佚名"
  },
  {
   "t": 3.278,
   "d": 3.042,
   "s": "采薇采薇，薇亦作止。"
  },
  {
   "t": 6.319,
   "d": 2.639,
   "s": "曰归曰归，岁亦莫止。"
  },
  {
   "t": 8.958,
   "d": 2.792,
   "s": "靡室靡家，猃狁之故。"
  },
  {
   "t": 11.75,
   "d": 2.889,
   "s": "不遑启居，猃狁之故。"
  },
  {
   "t": 14.639,
   "d": 3.014,
   "s": "采薇采薇，薇亦柔止。"
  },
  {
   "t": 17.653,
   "d": 2.542,
   "s": "曰归曰归，心亦忧止。"
  },
  {
   "t": 20.194,
   "d": 2.819,
   "s": "忧心烈烈，载饥载渴。"
  },
  {
   "t": 23.014,
   "d": 2.806,
   "s": "我戍未定，靡使归聘。"
  },
  {
   "t": 25.819,
   "d": 3.056,
   "s": "采薇采薇，薇亦刚止。"
  },
  {
   "t": 28.875,
   "d": 2.597,
   "s": "曰归曰归，岁亦阳止。"
  },
  {
   "t": 31.472,
   "d": 2.736,
   "s": "王事靡盬，不遑启处。"
  },
  {
   "t": 34.208,
   "d": 2.694,
   "s": "忧心孔疚，我行不来。"
  },
  {
   "t": 36.903,
   "d": 1.611,
   "s": "彼尔维何？"
  },
  {
   "t": 38.514,
   "d": 1.639,
   "s": "维常之华。"
  },
  {
   "t": 40.153,
   "d": 1.583,
   "s": "彼路斯何？"
  },
  {
   "t": 41.736,
   "d": 1.667,
   "s": "君子之车。"
  },
  {
   "t": 43.403,
   "d": 3.083,
   "s": "戎车既驾，四牡业业。"
  },
  {
   "t": 46.486,
   "d": 1.708,
   "s": "岂敢定居？"
  },
  {
   "t": 48.194,
   "d": 1.514,
   "s": "一月三捷。"
  },
  {
   "t": 49.708,
   "d": 3.25,
   "s": "驾彼四牡，四牡骙骙。"
  },
  {
   "t": 52.958,
   "d": 2.944,
   "s": "君子所依，小人所腓。"
  },
  {
   "t": 55.903,
   "d": 3.028,
   "s": "四牡翼翼，象弭鱼服。"
  },
  {
   "t": 58.931,
   "d": 1.694,
   "s": "岂不日戒？"
  },
  {
   "t": 60.625,
   "d": 1.764,
   "s": "猃狁孔棘。"
  },
  {
   "t": 62.389,
   "d": 2.986,
   "s": "昔我往矣，杨柳依依。"
  },
  {
   "t": 65.375,
   "d": 2.958,
   "s": "今我来思，雨雪霏霏。"
  },
  {
   "t": 68.333,
   "d": 2.931,
   "s": "行道迟迟，载渴载饥。"
  },
  {
   "t": 71.264,
   "d": 3.097,
   "s": "我心伤悲，莫知我哀！"
  }
 ]
