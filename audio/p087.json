   "s": "采薇"
  },
  {
   "t": 1.278,
   "d": 2.333,
   "s": "诗经，佚名"
  },
  {
   "t": 3.772,
   "d": 3.38,
   "s": "采薇采薇，薇亦作止。"
  },
  {
   "t": 7.252,
   "d": 2.978,
   "s": "曰归曰归，岁亦莫止。"
  },
  {
   "t": 10.348,
   "d": 3.131,
   "s": "靡室靡家，猃狁之故。"
  },
  {
   "t": 13.588,
   "d": 3.228,
   "s": "不遑启居，猃狁之故。"
  },
  {
   "t": 16.924,
   "d": 3.353,
   "s": "采薇采薇，薇亦柔止。"
  },
  {
   "t": 20.38,
   "d": 2.881,
   "s": "曰归曰归，心亦忧止。"
  },
  {
   "t": 23.38,
   "d": 3.158,
   "s": "忧心烈烈，载饥载渴。"
  },
  {
   "t": 26.644,
   "d": 3.144,
   "s": "我戍未定，靡使归聘。"
  },
  {
   "t": 29.908,
   "d": 3.394,
   "s": "采薇采薇，薇亦刚止。"
  },
  {
   "t": 33.412,
   "d": 2.936,
   "s": "曰归曰归，岁亦阳止。"
  },
  {
   "t": 36.46,
   "d": 3.075,
   "s": "王事靡盬，不遑启处。"
  },
  {
   "t": 39.652,
   "d": 3.033,
   "s": "忧心孔疚，我行不来。"
  },
  {
   "t": 42.796,
   "d": 1.95,
   "s": "彼尔维何？"
  },
  {
   "t": 44.86,
   "d": 1.978,
   "s": "维常之华。"
  },
  {
   "t": 46.948,
   "d": 1.922,
   "s": "彼路斯何？"
  },
  {
   "t": 48.988,
   "d": 2.006,
   "s": "君子之车。"
  },
  {
   "t": 51.1,
   "d": 3.422,
   "s": "戎车既驾，四牡业业。"
  },
  {
   "t": 54.628,
   "d": 2.047,
   "s": "岂敢定居？"
  },
  {
   "t": 56.788,
   "d": 1.853,
   "s": "一月三捷。"
  },
  {
   "t": 58.756,
   "d": 3.589,
   "s": "驾彼四牡，四牡骙骙。"
  },
  {
   "t": 62.452,
   "d": 3.283,
   "s": "君子所依，小人所腓。"
  },
  {
   "t": 65.836,
   "d": 3.367,
   "s": "四牡翼翼，象弭鱼服。"
  },
  {
   "t": 69.316,
   "d": 2.033,
   "s": "岂不日戒？"
  },
  {
   "t": 71.452,
   "d": 2.103,
   "s": "猃狁孔棘。"
  },
  {
   "t": 73.66,
   "d": 3.325,
   "s": "昔我往矣，杨柳依依。"
  },
  {
   "t": 77.092,
   "d": 3.297,
   "s": "今我来思，雨雪霏霏。"
  },
  {
   "t": 80.5,
   "d": 3.269,
   "s": "行道迟迟，载渴载饥。"
  },
  {
   "t": 83.884,
   "d": 3.103,
   "s": "我心伤悲，莫知我哀！"
  }
 ]
}