   "s": "采薇"
  },
  {
   "t": 1.278,
   "d": 2.333,
   "s": "诗经，佚名"
  },
  {
   "t": 3.711,
   "d": 3.381,
   "s": "采薇采薇，薇亦作止。"
  },
  {
   "t": 7.312,
   "d": 2.978,
   "s": "曰归曰归，岁亦莫止。"
  },
  {
   "t": 10.51,
   "d": 3.131,
   "s": "靡室靡家，猃狁之故。"
  },
  {
   "t": 13.861,
   "d": 3.228,
   "s": "不遑启居，猃狁之故。"
  },
  {
   "t": 17.309,
   "d": 3.353,
   "s": "采薇采薇，薇亦柔止。"
  },
  {
   "t": 20.882,
   "d": 2.881,
   "s": "曰归曰归，心亦忧止。"
  },
  {
   "t": 23.983,
   "d": 3.158,
   "s": "忧心烈烈，载饥载渴。"
  },
  {
   "t": 27.361,
   "d": 3.144,
   "s": "我戍未定，靡使归聘。"
  },
  {
   "t": 30.725,
   "d": 3.394,
   "s": "采薇采薇，薇亦刚止。"
  },
  {
   "t": 34.339,
   "d": 2.936,
   "s": "曰归曰归，岁亦阳止。"
  },
  {
   "t": 37.495,
   "d": 3.075,
   "s": "王事靡盬，不遑启处。"
  },
  {
   "t": 40.79,
   "d": 3.033,
   "s": "忧心孔疚，我行不来。"
  },
  {
   "t": 44.043,
   "d": 1.95,
   "s": "彼尔维何？"
  },
  {
   "t": 46.213,
   "d": 1.978,
   "s": "维常之华。"
  },
  {
   "t": 48.411,
   "d": 1.922,
   "s": "彼路斯何？"
  },
  {
   "t": 50.553,
   "d": 2.006,
   "s": "君子之车。"
  },
  {
   "t": 52.779,
   "d": 3.422,
   "s": "戎车既驾，四牡业业。"
  },
  {
   "t": 56.421,
   "d": 2.047,
   "s": "岂敢定居？"
  },
  {
   "t": 58.688,
   "d": 1.853,
   "s": "一月三捷。"
  },
  {
   "t": 60.761,
   "d": 3.589,
   "s": "驾彼四牡，四牡骙骙。"
  },
  {
   "t": 64.57,
   "d": 3.283,
   "s": "君子所依，小人所腓。"
  },
  {
   "t": 68.073,
   "d": 3.367,
   "s": "四牡翼翼，象弭鱼服。"
  },
  {
   "t": 71.66,
   "d": 2.033,
   "s": "岂不日戒？"
  },
  {
   "t": 73.913,
   "d": 2.103,
   "s": "猃狁孔棘。"
  },
  {
   "t": 76.236,
   "d": 3.325,
   "s": "昔我往矣，杨柳依依。"
  },
  {
   "t": 79.781,
   "d": 3.297,
   "s": "今我来思，雨雪霏霏。"
  },
  {
   "t": 83.298,
   "d": 3.269,
   "s": "行道迟迟，载渴载饥。"
  },
  {
   "t": 86.787,
   "d": 0.213,
   "s": "我心伤悲，莫知我哀！"
  }
 ]
