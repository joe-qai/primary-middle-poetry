   "s": "采薇"
  },
  {
   "t": 1.278,
   "d": 2.333,
   "s": "诗经，佚名"
  },
  {
   "t": 5.039,
   "d": 3.381,
   "s": "采薇采薇，薇亦作止。"
  },
  {
   "t": 8.64,
   "d": 2.978,
   "s": "曰归曰归，岁亦莫止。"
  },
  {
   "t": 11.838,
   "d": 3.131,
   "s": "靡室靡家，猃狁之故。"
  },
  {
   "t": 15.189,
   "d": 3.228,
   "s": "不遑启居，猃狁之故。"
  },
  {
   "t": 18.637,
   "d": 3.353,
   "s": "采薇采薇，薇亦柔止。"
  },
  {
   "t": 22.21,
   "d": 2.881,
   "s": "曰归曰归，心亦忧止。"
  },
  {
   "t": 25.311,
   "d": 3.158,
   "s": "忧心烈烈，载饥载渴。"
  },
  {
   "t": 28.689,
   "d": 3.144,
   "s": "我戍未定，靡使归聘。"
  },
  {
   "t": 32.053,
   "d": 3.394,
   "s": "采薇采薇，薇亦刚止。"
  },
  {
   "t": 35.667,
   "d": 2.936,
   "s": "曰归曰归，岁亦阳止。"
  },
  {
   "t": 38.823,
   "d": 3.075,
   "s": "王事靡盬，不遑启处。"
  },
  {
   "t": 42.118,
   "d": 3.033,
   "s": "忧心孔疚，我行不来。"
  },
  {
   "t": 45.371,
   "d": 1.95,
   "s": "彼尔维何？"
  },
  {
   "t": 47.541,
   "d": 1.978,
   "s": "维常之华。"
  },
  {
   "t": 49.739,
   "d": 1.922,
   "s": "彼路斯何？"
  },
  {
   "t": 51.881,
   "d": 2.006,
   "s": "君子之车。"
  },
  {
   "t": 54.107,
   "d": 3.422,
   "s": "戎车既驾，四牡业业。"
  },
  {
   "t": 57.749,
   "d": 2.047,
   "s": "岂敢定居？"
  },
  {
   "t": 60.016,
   "d": 1.853,
   "s": "一月三捷。"
  },
  {
   "t": 62.089,
   "d": 3.589,
   "s": "驾彼四牡，四牡骙骙。"
  },
  {
   "t": 65.898,
   "d": 3.283,
   "s": "君子所依，小人所腓。"
  },
  {
   "t": 69.401,
   "d": 3.367,
   "s": "四牡翼翼，象弭鱼服。"
  },
  {
   "t": 72.988,
   "d": 2.033,
   "s": "岂不日戒？"
  },
  {
   "t": 75.241,
   "d": 2.103,
   "s": "猃狁孔棘。"
  },
  {
   "t": 77.564,
   "d": 3.325,
   "s": "昔我往矣，杨柳依依。"
  },
  {
   "t": 81.109,
   "d": 3.297,
   "s": "今我来思，雨雪霏霏。"
  },
  {
   "t": 84.626,
   "d": 3.269,
   "s": "行道迟迟，载渴载饥。"
  },
  {
   "t": 88.115,
   "d": 3.103,
   "s": "我心伤悲，莫知我哀！"
  }
 ]
}