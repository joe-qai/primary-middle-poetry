  {
   "t": 0.1,
   "d": 3.839,
   "s": "临江仙，夜登小阁忆洛中旧游"
  },
  {
   "t": 3.889,
   "d": 2.403,
   "s": "宋代，陈与义"
  },
  {
   "t": 6.292,
   "d": 3.903,
   "s": "忆昔午桥桥上饮，坐中多是豪英。"
  },
  {
   "t": 10.194,
   "d": 2.389,
   "s": "长沟流月去无声。"
  },
  {
   "t": 12.583,
   "d": 3.361,
   "s": "杏花疏影里，吹笛到天明。"
  },
  {
   "t": 15.944,
   "d": 3.819,
   "s": "二十余年如一梦，此身虽在堪惊。"
  },
  {
   "t": 19.764,
   "d": 2.708,
   "s": "闲登小阁看新晴。"
  },
  {
   "t": 22.472,
   "d": 3.611,
   "s": "古今多少事，渔唱起三更。"
  }
 ]
}