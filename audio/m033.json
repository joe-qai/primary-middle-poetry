  },
  {
   "t": 3.889,
   "d": 2.736,
   "s": "宋代，陈与义"
  },
  {
   "t": 10.664,
   "d": 2.644,
   "s": "忆昔午桥桥上饮"
  },
  {
   "t": 13.558,
   "d": 2.2,
   "s": "坐中多是豪英。"
  },
  {
   "t": 15.708,
   "d": 2.389,
   "s": "长沟流月去无声。"
  },
  {
