  {
   "t": 0.1,
   "d": 3.839,
   "s": "临江仙，夜登小阁忆洛中旧游"
  },
  {
   "t": 3.889,
   "d": 2.736,
   "s": "宋代，陈与义"
  },
  {
   "t": 10.664,
   "d": 4.242,
   "s": "忆昔午桥桥上饮，坐中多是豪英。"
  },
  {
   "t": 15.126,
   "d": 2.728,
   "s": "长沟流月去无声。"
  },
  {
   "t": 18.074,
   "d": 3.7,
   "s": "杏花疏影里，吹笛到天明。"
  },
  {
   "t": 21.994,
   "d": 4.158,
   "s": "二十余年如一梦，此身虽在堪惊。"
  },
  {
   "t": 26.372,
   "d": 3.047,
   "s": "闲登小阁看新晴。"
  },
  {
   "t": 29.639,
   "d": 3.617,
   "s": "古今多少事，渔唱起三更。"
  }
 ]
}