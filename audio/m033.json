   "s": "杏花疏影里"
  },
  {
   "t": 27.564,
   "d": 1.992,
   "s": "吹笛到天明。"
  },
  {
   "t": 29.506,
   "d": 2.444,
   "s": "二十余年如一梦"
  },
  {
   "t": 34.292,
