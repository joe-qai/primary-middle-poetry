   "s": "临江仙，夜登小阁忆洛中旧游"
  },
  {
   "t": 3.889,
   "d": 2.736,
   "s": "宋代，陈与义"
  },
  {
   "t": 10.664,
   "d": 2.061,
   "s": "忆昔午桥"
  },
  {
   "t": 13.125,
   "d": 3.061,
   "s": "桥上饮，坐中多是"
  },
  {
   "t": 16.586,
   "d": 1.228,
   "s": "豪英。"
  },
  {
   "t": 17.764,
   "d": 2.389,
   "s": "长沟流月去无声。"
  },
  {
   "t": 20.153,
   "d": 3.361,
   "s": "杏花疏影里，吹笛到天明。"
  },
  {
   "t": 23.514,
   "d": 1.861,
   "s": "二十余年"
  },
  {
   "t": 37.798,
   "d": 2.908,
   "s": "如一梦，此身虽在"
  },
  {
   "t": 41.106,
   "d": 1.214,
   "s": "堪惊。"
  },
  {
   "t": 42.27,
   "d": 2.708,
   "s": "闲登小阁看新晴。"
  },
  {
   "t": 44.978,
   "d": 3.611,
   "s": "古今多少事，渔唱起三更。"
  }
 ]
