{
 "id": "x020",
 "title": "项脊轩志",
 "voice": "zh-CN-YunjianNeural",
 "rate": "-10%",
 "pitch": "+0Hz",
 "dur": 180.639,
 "hdr": 2,
 "bodyCues": 35,
 "v": "dfd74ec2",
 "cues": [
  {
   "t": 0.1,
   "d": 1.714,
   "s": "项脊轩志"
  },
  {
   "t": 1.764,
   "d": 2.083,
   "s": "明代，归有光"
  },
  {
   "t": 3.847,
   "d": 3.153,
   "s": "项脊轩，旧南阁子也。"
  },
  {
   "t": 7.0,
   "d": 2.917,
   "s": "室仅方丈，可容一人居。"
  },
  {
   "t": 9.917,
   "d": 6.583,
   "s": "百年老屋，尘泥渗漉，雨泽下注；每移案，顾视无可置者。"
  },
  {
   "t": 16.5,
   "d": 4.167,
   "s": "又北向，不能得日，日过午已昏。"
  },
  {
   "t": 20.667,
   "d": 2.903,
   "s": "余稍为修葺，使不上漏。"
  },
  {
   "t": 23.569,
   "d": 6.583,
   "s": "前辟四窗，垣墙周庭，以当南日，日影反照，室始洞然。"
  },
  {
   "t": 30.153,
   "d": 5.097,
   "s": "又杂植兰桂竹木于庭，旧时栏楯，亦遂增胜。"
  },
  {
   "t": 35.25,
   "d": 9.556,
   "s": "借书满架，偃仰啸歌，冥然兀坐，万籁有声；而庭阶寂寂，小鸟时来啄食，人至不去。"
  },
  {
   "t": 44.806,
   "d": 6.458,
   "s": "三五之夜，明月半墙，桂影斑驳，风移影动，珊珊可爱。"
  },
  {
   "t": 51.264,
   "d": 3.847,
   "s": "然余居于此，多可喜，亦多可悲。"
  },
  {
   "t": 55.111,
   "d": 2.986,
   "s": "先是庭中通南北为一。"
  },
  {
   "t": 58.097,
   "d": 4.986,
   "s": "迨诸父异爨，内外多置小门墙，往往而是。"
  },
  {
   "t": 63.083,
   "d": 4.125,
   "s": "东犬西吠，客逾庖而宴，鸡栖于厅。"
  },
  {
   "t": 67.208,
   "d": 4.0,
   "s": "庭中始为篱，已为墙，凡再变矣。"
  },
  {
   "t": 71.208,
   "d": 2.847,
   "s": "家有老妪，尝居于此。"
  },
  {
   "t": 74.056,
   "d": 5.139,
   "s": "妪，先大母婢也，乳二世，先妣抚之甚厚。"
  },
  {
   "t": 79.194,
   "d": 3.361,
   "s": "室西连于中闺，先妣尝一至。"
  },
  {
   "t": 82.556,
   "d": 4.25,
   "s": "妪每谓余曰：某所，而母立于兹。"
  },
  {
   "t": 86.806,
   "d": 6.903,
   "s": "妪又曰：汝姊在吾怀，呱呱而泣；娘以指叩门扉曰：儿寒乎？"
  },
  {
   "t": 93.708,
   "d": 1.486,
   "s": "欲食乎？"
  },
  {
   "t": 95.194,
   "d": 2.722,
   "s": "吾从板外相为应答。"
  },
  {
   "t": 97.917,
   "d": 2.847,
   "s": "语未毕，余泣，妪亦泣。"
  },
  {
   "t": 100.764,
   "d": 10.625,
   "s": "余自束发读书轩中，一日，大母过余曰：吾儿，久不见若影，何竟日默默在此，大类女郎也？"
  },
  {
   "t": 111.389,
   "d": 7.708,
   "s": "比去，以手阖门，自语曰：吾家读书久不效，儿之成，则可待乎！"
  },
  {
   "t": 119.097,
   "d": 8.278,
   "s": "顷之，持一象笏至，曰：此吾祖太常公宣德间执此以朝，他日汝当用之！"
  },
  {
   "t": 127.375,
   "d": 4.792,
   "s": "瞻顾遗迹，如在昨日，令人长号不自禁。"
  },
  {
   "t": 132.167,
   "d": 4.375,
   "s": "轩东故尝为厨，人往，从轩前过。"
  },
  {
   "t": 136.542,
   "d": 4.278,
   "s": "余扃牖而居，久之，能以足音辨人。"
  },
  {
   "t": 140.819,
   "d": 4.792,
   "s": "轩凡四遭火，得不焚，殆有神护者。"
  },
  {
   "t": 145.611,
   "d": 7.889,
   "s": "余既为此志，后五年，吾妻来归，时至轩中，从余问古事，或凭几学书。"
  },
  {
   "t": 153.5,
   "d": 7.014,
   "s": "吾妻归宁，述诸小妹语曰：闻姊家有阁子，且何谓阁子也？"
  },
  {
   "t": 160.514,
   "d": 4.014,
   "s": "其后六年，吾妻死，室坏不修。"
  },
  {
   "t": 164.528,
   "d": 6.903,
   "s": "其后二年，余久卧病无聊，乃使人复葺南阁子，其制稍异于前。"
  },
  {
   "t": 171.431,
   "d": 3.056,
   "s": "然自后余多在外，不常居。"
  },
  {
   "t": 174.486,
   "d": 6.153,
   "s": "庭有枇杷树，吾妻死之年所手植也，今已亭亭如盖矣。"
  }
 ]
}