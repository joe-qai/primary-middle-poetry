{
 "id": "x020",
 "title": "项脊轩志",
 "voice": "zh-CN-YunjianNeural",
 "rate": "-10%",
 "pitch": "+0Hz",
 "dur": 196.368,
 "hdr": 2,
 "bodyCues": 35,
 "v": "26386afd",
 "cues": [
  {
   "t": 0.1,
   "d": 1.714,
   "s": "项脊轩志"
  },
  {
   "t": 1.764,
   "d": 2.417,
   "s": "明代，归有光"
  },
  {
   "t": 4.348,
   "d": 3.492,
   "s": "项脊轩，旧南阁子也。"
  },
  {
   "t": 7.948,
   "d": 3.256,
   "s": "室仅方丈，可容一人居。"
  },
  {
   "t": 11.308,
   "d": 6.922,
   "s": "百年老屋，尘泥渗漉，雨泽下注；每移案，顾视无可置者。"
  },
  {
   "t": 18.34,
   "d": 4.506,
   "s": "又北向，不能得日，日过午已昏。"
  },
  {
   "t": 22.948,
   "d": 3.242,
   "s": "余稍为修葺，使不上漏。"
  },
  {
   "t": 26.308,
   "d": 6.922,
   "s": "前辟四窗，垣墙周庭，以当南日，日影反照，室始洞然。"
  },
  {
   "t": 33.34,
   "d": 5.436,
   "s": "又杂植兰桂竹木于庭，旧时栏楯，亦遂增胜。"
  },
  {
   "t": 38.884,
   "d": 9.894,
   "s": "借书满架，偃仰啸歌，冥然兀坐，万籁有声；而庭阶寂寂，小鸟时来啄食，人至不去。"
  },
  {
   "t": 48.892,
   "d": 6.797,
   "s": "三五之夜，明月半墙，桂影斑驳，风移影动，珊珊可爱。"
  },
  {
   "t": 55.804,
   "d": 4.186,
   "s": "然余居于此，多可喜，亦多可悲。"
  },
  {
   "t": 60.1,
   "d": 3.325,
   "s": "先是庭中通南北为一。"
  },
  {
   "t": 63.532,
   "d": 5.324,
   "s": "迨诸父异爨，内外多置小门墙，往往而是。"
  },
  {
   "t": 68.956,
   "d": 4.464,
   "s": "东犬西吠，客逾庖而宴，鸡栖于厅。"
  },
  {
   "t": 73.54,
   "d": 4.339,
   "s": "庭中始为篱，已为墙，凡再变矣。"
  },
  {
   "t": 77.98,
   "d": 3.186,
   "s": "家有老妪，尝居于此。"
  },
  {
   "t": 81.268,
   "d": 5.478,
   "s": "妪，先大母婢也，乳二世，先妣抚之甚厚。"
  },
  {
   "t": 86.86,
   "d": 3.7,
   "s": "室西连于中闺，先妣尝一至。"
  },
  {
   "t": 90.676,
   "d": 4.589,
   "s": "妪每谓余曰：某所，而母立于兹。"
  },
  {
   "t": 95.38,
   "d": 7.242,
   "s": "妪又曰：汝姊在吾怀，呱呱而泣；娘以指叩门扉曰：儿寒乎？"
  },
  {
   "t": 102.724,
   "d": 1.825,
   "s": "欲食乎？"
  },
  {
   "t": 104.668,
   "d": 3.061,
   "s": "吾从板外相为应答。"
  },
  {
   "t": 107.836,
   "d": 3.186,
   "s": "语未毕，余泣，妪亦泣。"
  },
  {
   "t": 111.124,
   "d": 10.964,
   "s": "余自束发读书轩中，一日，大母过余曰：吾儿，久不见若影，何竟日默默在此，大类女郎也？"
  },
  {
   "t": 122.188,
   "d": 8.047,
   "s": "比去，以手阖门，自语曰：吾家读书久不效，儿之成，则可待乎！"
  },
  {
   "t": 130.348,
   "d": 8.617,
   "s": "顷之，持一象笏至，曰：此吾祖太常公宣德间执此以朝，他日汝当用之！"
  },
  {
   "t": 139.084,
   "d": 5.131,
   "s": "瞻顾遗迹，如在昨日，令人长号不自禁。"
  },
  {
   "t": 144.316,
   "d": 4.714,
   "s": "轩东故尝为厨，人往，从轩前过。"
  },
  {
   "t": 149.14,
   "d": 4.617,
   "s": "余扃牖而居，久之，能以足音辨人。"
  },
  {
   "t": 153.868,
   "d": 5.131,
   "s": "轩凡四遭火，得不焚，殆有神护者。"
  },
  {
   "t": 159.1,
   "d": 8.228,
   "s": "余既为此志，后五年，吾妻来归，时至轩中，从余问古事，或凭几学书。"
  },
  {
   "t": 167.428,
   "d": 7.353,
   "s": "吾妻归宁，述诸小妹语曰：闻姊家有阁子，且何谓阁子也？"
  },
  {
   "t": 174.892,
   "d": 4.353,
   "s": "其后六年，吾妻死，室坏不修。"
  },
  {
   "t": 179.356,
   "d": 7.242,
   "s": "其后二年，余久卧病无聊，乃使人复葺南阁子，其制稍异于前。"
  },
  {
   "t": 186.7,
   "d": 3.394,
   "s": "然自后余多在外，不常居。"
  },
  {
   "t": 190.204,
   "d": 6.158,
   "s": "庭有枇杷树，吾妻死之年所手植也，今已亭亭如盖矣。"
  }
 ]
}