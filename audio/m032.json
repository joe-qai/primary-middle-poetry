   "d": 1.631,
   "s": "十五"
  },
  {
   "t": 8.904,
   "d": 2.908,
   "s": "从军征，八十始得归。"
  },
  {
   "t": 11.762,
   "d": 3.417,
   "s": "道逢乡里人：家中有阿谁？"
  },
  {
   "t": 15.179,
   "d": 1.514,
   "s": "遥看"
  },
  {
   "t": 26.476,
   "d": 3.061,
   "s": "是君家，松柏冢累"
  },
  {
   "t": 29.937,
   "d": 0.922,
   "s": "累。"
  },
  {
   "t": 30.809,
   "d": 3.306,
   "s": "兔从狗窦入，雉从梁上飞。"
  },
  {
   "t": 34.115,
   "d": 1.667,
   "s": "中庭"
  },
  {
   "t": 41.482,
   "d": 3.103,
   "s": "生旅谷，井上生旅"
  },
  {
   "t": 44.985,
   "d": 1.006,
   "s": "葵。"
  },
  {
   "t": 45.941,
   "d": 3.569,
   "s": "舂谷持作饭，采葵持作羹。"
  },
  {
   "t": 49.51,
   "d": 1.583,
   "s": "羹饭"
  },
  {
   "t": 57.224,
   "d": 2.7,
   "s": "一时熟，不知贻阿"
  },
  {
