   "s": "十五从军征"
  },
  {
   "t": 2.153,
   "d": 2.083,
   "s": "汉代，佚名"
  },
  {
   "t": 4.236,
   "d": 3.486,
   "s": "十五从军征，八十始得归。"
  },
  {
   "t": 7.722,
   "d": 3.417,
   "s": "道逢乡里人：家中有阿谁？"
  },
  {
   "t": 11.139,
   "d": 3.403,
   "s": "遥看是君家，松柏冢累累。"
  },
  {
   "t": 14.542,
   "d": 3.306,
   "s": "兔从狗窦入，雉从梁上飞。"
  },
  {
   "t": 17.847,
   "d": 3.597,
   "s": "中庭生旅谷，井上生旅葵。"
  },
  {
   "t": 21.444,
   "d": 3.569,
   "s": "舂谷持作饭，采葵持作羹。"
  },
  {
   "t": 25.014,
   "d": 3.125,
   "s": "羹饭一时熟，不知贻阿谁。"
  },
  {
   "t": 28.139,
   "d": 3.597,
   "s": "出门东向看，泪落沾我衣。"
  }
 ]
