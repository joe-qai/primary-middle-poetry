  {
   "t": 0.1,
   "d": 2.103,
   "s": "十五从军征"
  },
  {
   "t": 2.153,
   "d": 2.417,
   "s": "汉代，佚名"
  },
  {
   "t": 4.67,
   "d": 3.825,
   "s": "十五从军征，八十始得归。"
  },
  {
   "t": 8.715,
   "d": 3.756,
   "s": "道逢乡里人：家中有阿谁？"
  },
  {
   "t": 12.691,
   "d": 3.742,
   "s": "遥看是君家，松柏冢累累。"
  },
  {
   "t": 16.653,
   "d": 3.644,
   "s": "兔从狗窦入，雉从梁上飞。"
  },
  {
   "t": 20.517,
   "d": 3.936,
   "s": "中庭生旅谷，井上生旅葵。"
  },
  {
   "t": 24.673,
   "d": 3.908,
   "s": "舂谷持作饭，采葵持作羹。"
  },
  {
   "t": 28.801,
   "d": 3.464,
   "s": "羹饭一时熟，不知贻阿谁。"
  },
  {
   "t": 32.485,
   "d": 2.891,
   "s": "出门东向看，泪落沾我衣。"
  }
 ]
}