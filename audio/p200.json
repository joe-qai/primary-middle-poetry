   "s": "望海潮，东南形胜"
  },
  {
   "t": 2.667,
   "d": 2.389,
   "s": "宋代，柳永"
  },
  {
   "t": 5.212,
   "d": 5.158,
   "s": "东南形胜，三吴都会，钱塘自古繁华。"
  },
  {
   "t": 10.492,
   "d": 5.075,
   "s": "烟柳画桥，风帘翠幕，参差十万人家。"
  },
  {
   "t": 15.676,
   "d": 5.367,
   "s": "云树绕堤沙，怒涛卷霜雪，天堑无涯。"
  },
  {
   "t": 21.148,
   "d": 4.158,
   "s": "市列珠玑，户盈罗绮，竞豪奢。"
  },
  {
   "t": 25.42,
   "d": 5.172,
   "s": "重湖叠巘清嘉，有三秋桂子，十里荷花。"
  },
  {
   "t": 30.7,
   "d": 5.214,
   "s": "羌管弄晴，菱歌泛夜，嬉嬉钓叟莲娃。"
  },
  {
   "t": 36.028,
   "d": 5.311,
   "s": "千骑拥高牙，乘醉听箫鼓，吟赏烟霞。"
  },
  {
   "t": 41.452,
   "d": 4.004,
   "s": "异日图将好景，归去凤池夸。"
  }
 ]
