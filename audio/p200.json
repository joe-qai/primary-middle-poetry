   "s": "望海潮，东南形胜"
  },
  {
   "t": 2.667,
   "d": 2.056,
   "s": "宋代，柳永"
  },
  {
   "t": 4.722,
   "d": 4.819,
   "s": "东南形胜，三吴都会，钱塘自古繁华。"
  },
  {
   "t": 9.542,
   "d": 4.736,
   "s": "烟柳画桥，风帘翠幕，参差十万人家。"
  },
  {
   "t": 14.278,
   "d": 5.028,
   "s": "云树绕堤沙，怒涛卷霜雪，天堑无涯。"
  },
  {
   "t": 19.306,
   "d": 3.819,
   "s": "市列珠玑，户盈罗绮，竞豪奢。"
  },
  {
   "t": 23.125,
   "d": 4.833,
   "s": "重湖叠巘清嘉，有三秋桂子，十里荷花。"
  },
  {
   "t": 27.958,
   "d": 4.875,
   "s": "羌管弄晴，菱歌泛夜，嬉嬉钓叟莲娃。"
  },
  {
   "t": 32.833,
   "d": 4.972,
   "s": "千骑拥高牙，乘醉听箫鼓，吟赏烟霞。"
  },
  {
   "t": 37.806,
   "d": 4.0,
   "s": "异日图将好景，归去凤池夸。"
  }
 ]
}