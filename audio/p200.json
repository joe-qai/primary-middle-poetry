   "s": "望海潮，东南形胜"
  },
  {
   "t": 2.667,
   "d": 2.389,
   "s": "宋代，柳永"
  },
  {
   "t": 7.873,
   "d": 5.158,
   "s": "东南形胜，三吴都会，钱塘自古繁华。"
  },
  {
   "t": 13.251,
   "d": 5.075,
   "s": "烟柳画桥，风帘翠幕，参差十万人家。"
  },
  {
   "t": 18.546,
   "d": 5.367,
   "s": "云树绕堤沙，怒涛卷霜雪，天堑无涯。"
  },
  {
   "t": 24.133,
   "d": 4.158,
   "s": "市列珠玑，户盈罗绮，竞豪奢。"
  },
  {
   "t": 28.511,
   "d": 5.172,
   "s": "重湖叠巘清嘉，有三秋桂子，十里荷花。"
  },
  {
   "t": 33.903,
   "d": 5.214,
   "s": "羌管弄晴，菱歌泛夜，嬉嬉钓叟莲娃。"
  },
  {
   "t": 39.337,
   "d": 5.311,
   "s": "千骑拥高牙，乘醉听箫鼓，吟赏烟霞。"
  },
  {
   "t": 44.868,
   "d": 4.006,
   "s": "异日图将好景，归去凤池夸。"
  }
 ]
