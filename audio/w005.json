   "s": "记承天寺夜游"
  },
  {
   "t": 2.222,
   "d": 2.139,
   "s": "宋代，苏轼"
  },
  {
   "t": 4.361,
   "d": 6.278,
   "s": "元丰六年十月十二日夜，解衣欲睡，月色入户，欣然起行。"
  },
  {
   "t": 10.639,
   "d": 4.444,
   "s": "念无与为乐者，遂至承天寺寻张怀民。"
  },
  {
   "t": 15.083,
   "d": 3.722,
   "s": "怀民亦未寝，相与步于中庭。"
  },
  {
   "t": 18.806,
   "d": 5.681,
   "s": "庭下如积水空明，水中藻荇交横，盖竹柏影也。"
  },
  {
   "t": 24.486,
   "d": 1.722,
   "s": "何夜无月？"
  },
  {
   "t": 26.208,
   "d": 1.972,
   "s": "何处无竹柏？"
  },
  {
   "t": 28.181,
   "d": 3.236,
   "s": "但少闲人如吾两人者耳。"
  }
 ]
