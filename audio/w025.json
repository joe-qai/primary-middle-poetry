   "s": "南朝，刘义庆世说新语"
  },
  {
   "t": 4.097,
   "d": 4.472,
   "s": "谢太傅寒雪日内集，与儿女讲论文义。"
  },
  {
   "t": 8.569,
   "d": 4.986,
   "s": "俄而雪骤，公欣然曰：白雪纷纷何所似？"
  },
  {
   "t": 13.556,
   "d": 4.431,
   "s": "兄子胡儿曰：撒盐空中差可拟。"
  },
  {
   "t": 17.986,
   "d": 3.375,
   "s": "兄女曰：未若柳絮因风起。"
  },
  {
   "t": 21.361,
   "d": 1.542,
   "s": "公大笑乐。"
  },
  {
   "t": 22.903,
   "d": 5.056,
   "s": "即公大兄无奕女，左将军王凝之妻也。"
