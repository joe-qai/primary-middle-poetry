 "bodyCues": 19,
 "v": "1fc41c62",
 "cues": [
  {
   "t": 0.1,
   "d": 1.658,
   "s": "愚公移山"
  },
  {
   "t": 1.708,
   "d": 2.264,
   "s": "战国，列子"
  },
  {
   "t": 3.972,
   "d": 4.5,
   "s": "太行、王屋二山，方七百里，高万仞。"
  },
  {
   "t": 8.472,
   "d": 3.292,
   "s": "本在冀州之南，河阳之北。"
  },
  {
   "t": 11.764,
   "d": 4.458,
   "s": "北山愚公者，年且九十，面山而居。"
  },
  {
   "t": 16.222,
   "d": 9.986,
   "s": "惩山北之塞，出入之迂也，聚室而谋曰：吾与汝毕力平险，指通豫南，达于汉阴，可乎？"
  },
  {
   "t": 26.208,
   "d": 1.653,
   "s": "杂然相许。"
  },
  {
   "t": 27.861,
   "d": 7.125,
   "s": "其妻献疑曰：以君之力，曾不能损魁父之丘，如太行、王屋何？"
  },
  {
   "t": 34.986,
   "d": 2.0,
   "s": "且焉置土石？"
  },
  {
   "t": 36.986,
   "d": 4.181,
   "s": "杂曰：投诸渤海之尾，隐土之北。"
  },
  {
   "t": 41.167,
   "d": 6.194,
   "s": "遂率子孙荷担者三夫，叩石垦壤，箕畚运于渤海之尾。"
  },
  {
   "t": 47.361,
   "d": 5.375,
   "s": "邻人京城氏之孀妻有遗男，始龀，跳往助之。"
  },
  {
   "t": 52.736,
   "d": 2.861,
   "s": "寒暑易节，始一反焉。"
  },
  {
   "t": 55.597,
   "d": 5.389,
   "s": "河曲智叟笑而止之曰：甚矣，汝之不惠！"
  },
  {
   "t": 60.986,
   "d": 5.319,
   "s": "以残年余力，曾不能毁山之一毛，其如土石何？"
  },
  {
   "t": 66.306,
   "d": 6.5,
   "s": "北山愚公长息曰：汝心之固，固不可彻，曾不若孀妻弱子。"
  },
  {
   "t": 72.806,
   "d": 12.861,
   "s": "虽我之死，有子存焉；子又生孙，孙又生子；子又有子，子又有孙；子子孙孙无穷匮也，而山不加增，何苦而不平？"
  },
  {
   "t": 85.667,
   "d": 2.458,
   "s": "河曲智叟亡以应。"
  },
  {
   "t": 88.125,
   "d": 4.708,
   "s": "操蛇之神闻之，惧其不已也，告之于帝。"
  },
  {
   "t": 92.833,
   "d": 6.653,
   "s": "帝感其诚，命夸娥氏二子负二山，一厝朔东，一厝雍南。"
  },
  {
   "t": 99.486,
   "d": 4.847,
   "s": "自此，冀之南，汉之阴，无陇断焉。"
  }
 ]
}