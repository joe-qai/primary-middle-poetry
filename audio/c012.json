 "bodyCues": 25,
 "v": "9f757c46",
 "cues": [
  {
   "t": 0.1,
   "d": 2.144,
   "s": "烛之武退秦师"
  },
  {
   "t": 2.194,
   "d": 2.472,
   "s": "春秋，左丘明"
  },
  {
   "t": 4.667,
   "d": 5.347,
   "s": "晋侯、秦伯围郑，以其无礼于晋，且贰于楚也。"
  },
  {
   "t": 10.014,
   "d": 3.042,
   "s": "晋军函陵，秦军氾南。"
  },
  {
   "t": 13.056,
   "d": 6.792,
   "s": "佚之狐言于郑伯曰：国危矣，若使烛之武见秦君，师必退。"
  },
  {
   "t": 19.847,
   "d": 1.458,
   "s": "公从之。"
  },
  {
   "t": 21.306,
   "d": 6.25,
   "s": "辞曰：臣之壮也，犹不如人；今老矣，无能为也已。"
  },
  {
   "t": 27.556,
   "d": 6.264,
   "s": "公曰：吾不能早用子，今急而求子，是寡人之过也。"
  },
  {
   "t": 33.819,
   "d": 3.125,
   "s": "然郑亡，子亦有不利焉。"
  },
  {
   "t": 36.944,
   "d": 1.181,
   "s": "许之。"
  },
  {
   "t": 38.125,
   "d": 6.361,
   "s": "夜缒而出，见秦伯，曰：秦、晋围郑，郑既知亡矣。"
  },
  {
   "t": 44.486,
   "d": 3.681,
   "s": "若亡郑而有益于君，敢以烦执事。"
  },
  {
   "t": 48.167,
   "d": 5.361,
   "s": "越国以鄙远，君知其难也，焉用亡郑以陪邻？"
  },
  {
   "t": 53.528,
   "d": 2.694,
   "s": "邻之厚，君之薄也。"
  },
  {
   "t": 56.222,
   "d": 6.375,
   "s": "若舍郑以为东道主，行李之往来，共其乏困，君亦无所害。"
  },
  {
   "t": 62.597,
   "d": 7.833,
   "s": "且君尝为晋君赐矣，许君焦、瑕，朝济而夕设版焉，君之所知也。"
  },
  {
   "t": 70.431,
   "d": 2.542,
   "s": "夫晋，何厌之有？"
  },
  {
   "t": 72.972,
   "d": 5.875,
   "s": "既东封郑，又欲肆其西封，若不阙秦，将焉取之？"
  },
  {
   "t": 78.847,
   "d": 3.431,
   "s": "阙秦以利晋，唯君图之。"
  },
  {
   "t": 82.278,
   "d": 2.583,
   "s": "秦伯说，与郑人盟。"
  },
  {
   "t": 84.861,
   "d": 4.5,
   "s": "使杞子、逢孙、杨孙戍之，乃还。"
  },
  {
   "t": 89.361,
   "d": 2.111,
   "s": "子犯请击之。"
  },
  {
   "t": 91.472,
   "d": 1.875,
   "s": "公曰：不可。"
  },
  {
   "t": 93.347,
   "d": 2.472,
   "s": "微夫人之力不及此。"
  },
  {
   "t": 95.819,
   "d": 7.042,
   "s": "因人之力而敝之，不仁；失其所与，不知；以乱易整，不武。"
  },
  {
   "t": 102.861,
   "d": 1.653,
   "s": "吾其还也。"
  },
  {
   "t": 104.514,
   "d": 1.736,
   "s": "亦去之。"
  }
 ]
}