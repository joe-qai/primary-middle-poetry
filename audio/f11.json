 "cues": [
  {
   "t": 0.1,
   "d": 1.186,
   "s": "自由"
  },
  {
   "t": 1.236,
   "d": 2.458,
   "s": "法国，艾吕雅"
  },
  {
   "t": 3.844,
   "d": 3.547,
   "s": "我在我的屋里写下你的名字。"
  },
  {
   "t": 7.492,
   "d": 9.242,
   "s": "在纸上，在墨水瓶里，在烟灰缸里，在空白的封面，在结冰的窗户上，在融化的雪上。"
  },
  {
   "t": 16.852,
   "d": 4.658,
   "s": "写在水面上，写在月亮上升的云层里。"
  },
  {
   "t": 21.628,
   "d": 5.158,
   "s": "在沙漠、岩石和丛林里，在鸟巢的羽毛上。"
  },
  {
   "t": 26.908,
   "d": 5.45,
   "s": "写在我沾满灰尘的脸上，写在我颤抖的手指上。"
  },
  {
   "t": 32.476,
   "d": 7.881,
   "s": "叫喊的名字，倾听的名字，被遗忘的名字，再次出现、再生的名字。"
  },
  {
   "t": 40.468,
   "d": 5.172,
   "s": "我在森林里散步，每个脚印都印着一个你的名字。"
  },
  {
   "t": 45.748,
   "d": 4.394,
   "s": "我在回家，每一扇门都开着你的名字。"
  },
  {
   "t": 50.26,
   "d": 5.644,
   "s": "在灰烬、纸片和泡沫里，我在空中读着你的名字。"
  },
  {
   "t": 56.02,
   "d": 10.728,
   "s": "雪地上，沙石上，树皮上，在发光的夜晚，我被烧焦的大地上所有的裂缝里，我在黑暗中书写你的名字。"
  },
  {
   "t": 66.868,
   "d": 5.436,
   "s": "触碰的一切，我触碰到你的灵魂的颤栗——自由！"
  },
  {
   "t": 72.412,
   "d": 4.519,
   "s": "因为我爱着你，我不会忘记任何东西。"
  },
  {
   "t": 77.044,
   "d": 11.852,
   "s": "我不记得白天，我不记得黑夜，我在你身上，你在我身上，我的书打开在我面前，我的歌沉默，我的眼睛闭上——在你的眼睛睁开！"
  }
 ]
}