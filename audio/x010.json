{
 "id": "x010",
 "title": "长恨歌",
 "voice": "zh-CN-YunjianNeural",
 "rate": "-10%",
 "dur": 261.264,
 "hdr": 2,
 "bodyCues": 60,
 "v": "84d813bc",
 "cues": [
  {
   "t": 0.1,
   "d": 1.547,
   "s": "长恨歌"
  },
  {
   "t": 1.597,
   "d": 2.264,
   "s": "唐代，白居易"
  },
  {
   "t": 3.861,
   "d": 4.25,
   "s": "汉皇重色思倾国，御宇多年求不得。"
  },
  {
   "t": 8.111,
   "d": 4.0,
   "s": "杨家有女初长成，养在深闺人未识。"
  },
  {
   "t": 12.111,
   "d": 4.694,
   "s": "天生丽质难自弃，一朝选在君王侧。"
  },
  {
   "t": 16.806,
   "d": 4.375,
   "s": "回眸一笑百媚生，六宫粉黛无颜色。"
  },
  {
   "t": 21.181,
   "d": 4.472,
   "s": "春寒赐浴华清池，温泉水滑洗凝脂。"
  },
  {
   "t": 25.653,
   "d": 4.028,
   "s": "侍儿扶起娇无力，始是新承恩泽时。"
  },
  {
   "t": 29.681,
   "d": 4.139,
   "s": "云鬓花颜金步摇，芙蓉帐暖度春宵。"
  },
  {
   "t": 33.819,
   "d": 4.333,
   "s": "春宵苦短日高起，从此君王不早朝。"
  },
  {
   "t": 38.153,
   "d": 4.444,
   "s": "承欢侍宴无闲暇，春从春游夜专夜。"
  },
  {
   "t": 42.597,
   "d": 4.278,
   "s": "后宫佳丽三千人，三千宠爱在一身。"
  },
  {
   "t": 46.875,
   "d": 4.139,
   "s": "金屋妆成娇侍夜，玉楼宴罢醉和春。"
  },
  {
   "t": 51.014,
   "d": 4.306,
   "s": "姊妹弟兄皆列土，可怜光彩生门户。"
  },
  {
   "t": 55.319,
   "d": 4.347,
   "s": "遂令天下父母心，不重生男重生女。"
  },
  {
   "t": 59.667,
   "d": 4.444,
   "s": "骊宫高处入青云，仙乐风飘处处闻。"
  },
  {
   "t": 64.111,
   "d": 4.583,
   "s": "缓歌慢舞凝丝竹，尽日君王看不足。"
  },
  {
   "t": 68.694,
   "d": 3.889,
   "s": "渔阳鼙鼓动地来，惊破霓裳羽衣曲。"
  },
  {
   "t": 72.583,
   "d": 4.625,
   "s": "九重城阙烟尘生，千乘万骑西南行。"
  },
  {
   "t": 77.208,
   "d": 4.167,
   "s": "翠华摇摇行复止，西出都门百余里。"
  },
  {
   "t": 81.375,
   "d": 4.361,
   "s": "六军不发无奈何，宛转蛾眉马前死。"
  },
  {
   "t": 85.736,
   "d": 4.514,
   "s": "花钿委地无人收，翠翘金雀玉搔头。"
  },
  {
   "t": 90.25,
   "d": 4.375,
   "s": "君王掩面救不得，回看血泪相和流。"
  },
  {
   "t": 94.625,
   "d": 4.708,
   "s": "黄埃散漫风萧索，云栈萦纡登剑阁。"
  },
  {
   "t": 99.333,
   "d": 4.583,
   "s": "峨嵋山下少人行，旌旗无光日色薄。"
  },
  {
   "t": 103.917,
   "d": 4.611,
   "s": "蜀江水碧蜀山青，圣主朝朝暮暮情。"
  },
  {
   "t": 108.528,
   "d": 4.444,
   "s": "行宫见月伤心色，夜雨闻铃肠断声。"
  },
  {
   "t": 112.972,
   "d": 4.278,
   "s": "天旋日转回龙驭，到此踌躇不能去。"
  },
  {
   "t": 117.25,
   "d": 4.319,
   "s": "马嵬坡下泥土中，不见玉颜空死处。"
  },
  {
   "t": 121.569,
   "d": 4.431,
   "s": "君臣相顾尽沾衣，东望都门信马归。"
  },
  {
   "t": 126.0,
   "d": 4.194,
   "s": "归来池苑皆依旧，太液芙蓉未央柳。"
  },
  {
   "t": 130.194,
   "d": 3.972,
   "s": "芙蓉如面柳如眉，对此如何不泪垂。"
  },
  {
   "t": 134.167,
   "d": 4.347,
   "s": "春风桃李花开日，秋雨梧桐叶落时。"
  },
  {
   "t": 138.514,
   "d": 4.153,
   "s": "西宫南内多秋草，落叶满阶红不扫。"
  },
  {
   "t": 142.667,
   "d": 4.083,
   "s": "梨园弟子白发新，椒房阿监青娥老。"
  },
  {
   "t": 146.75,
   "d": 4.25,
   "s": "夕殿萤飞思悄然，孤灯挑尽未成眠。"
  },
  {
   "t": 151.0,
   "d": 4.542,
   "s": "迟迟钟鼓初长夜，耿耿星河欲曙天。"
  },
  {
   "t": 155.542,
   "d": 4.333,
   "s": "鸳鸯瓦冷霜华重，翡翠衾寒谁与共。"
  },
  {
   "t": 159.875,
   "d": 4.139,
   "s": "悠悠生死别经年，魂魄不曾来入梦。"
  },
  {
   "t": 164.014,
   "d": 4.292,
   "s": "临邛道士鸿都客，能以精诚致魂魄。"
  },
  {
   "t": 168.306,
   "d": 4.181,
   "s": "为感君王辗转思，遂教方士殷勤觅。"
  },
  {
   "t": 172.486,
   "d": 4.181,
   "s": "排空驭气奔如电，升天入地求之遍。"
  },
  {
   "t": 176.667,
   "d": 4.125,
   "s": "上穷碧落下黄泉，两处茫茫皆不见。"
  },
  {
   "t": 180.792,
   "d": 4.444,
   "s": "忽闻海上有仙山，山在虚无缥缈间。"
  },
  {
   "t": 185.236,
   "d": 4.069,
   "s": "楼阁玲珑五云起，其中绰约多仙子。"
  },
  {
   "t": 189.306,
   "d": 4.278,
   "s": "中有一人字太真，雪肤花貌参差是。"
  },
  {
   "t": 193.583,
   "d": 4.375,
   "s": "金阙西厢叩玉扃，转教小玉报双成。"
  },
  {
   "t": 197.958,
   "d": 4.458,
   "s": "闻道汉家天子使，九华帐里梦魂惊。"
  },
  {
   "t": 202.417,
   "d": 3.903,
   "s": "揽衣推枕起徘徊，珠箔银屏迤逦开。"
  },
  {
   "t": 206.319,
   "d": 4.069,
   "s": "云鬓半偏新睡觉，花冠不整下堂来。"
  },
  {
   "t": 210.389,
   "d": 4.458,
   "s": "风吹仙袂飘飖举，犹似霓裳羽衣舞。"
  },
  {
   "t": 214.847,
   "d": 4.153,
   "s": "玉容寂寞泪阑干，梨花一枝春带雨。"
  },
  {
   "t": 219.0,
   "d": 4.361,
   "s": "含情凝睇谢君王，一别音容两渺茫。"
  },
  {
   "t": 223.361,
   "d": 4.056,
   "s": "昭阳殿里恩爱绝，蓬莱宫中日月长。"
  },
  {
   "t": 227.417,
   "d": 4.139,
   "s": "回头下望人寰处，不见长安见尘雾。"
  },
  {
   "t": 231.556,
   "d": 4.264,
   "s": "惟将旧物表深情，钿合金钗寄将去。"
  },
  {
   "t": 235.819,
   "d": 4.042,
   "s": "钗留一股合一扇，钗擘黄金合分钿。"
  },
  {
   "t": 239.861,
   "d": 4.264,
   "s": "但教心似金钿坚，天上人间会相见。"
  },
  {
   "t": 244.125,
   "d": 4.111,
   "s": "临别殷勤重寄词，词中有誓两心知。"
  },
  {
   "t": 248.236,
   "d": 4.139,
   "s": "七月七日长生殿，夜半无人私语时。"
  },
  {
   "t": 252.375,
   "d": 4.153,
   "s": "在天愿作比翼鸟，在地愿为连理枝。"
  },
  {
   "t": 256.528,
   "d": 4.736,
   "s": "天长地久有时尽，此恨绵绵无绝期。"
  }
 ]
}