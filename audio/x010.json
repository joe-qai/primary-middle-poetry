 "bodyCues": 60,
 "v": "b5636502",
 "cues": [
  {
   "t": 0.1,
   "d": 1.547,
   "s": "长恨歌"
  },
  {
   "t": 1.597,
   "d": 2.597,
   "s": "唐代，白居易"
  },
  {
   "t": 4.348,
   "d": 4.589,
   "s": "汉皇重色思倾国，御宇多年求不得。"
  },
  {
   "t": 9.052,
   "d": 4.339,
   "s": "杨家有女初长成，养在深闺人未识。"
  },
  {
   "t": 13.492,
   "d": 5.033,
   "s": "天生丽质难自弃，一朝选在君王侧。"
  },
  {
   "t": 18.628,
   "d": 4.714,
   "s": "回眸一笑百媚生，六宫粉黛无颜色。"
  },
  {
   "t": 23.452,
   "d": 4.811,
   "s": "春寒赐浴华清池，温泉水滑洗凝脂。"
  },
  {
   "t": 28.372,
   "d": 4.367,
   "s": "侍儿扶起娇无力，始是新承恩泽时。"
  },
  {
   "t": 32.86,
   "d": 4.478,
   "s": "云鬓花颜金步摇，芙蓉帐暖度春宵。"
  },
  {
   "t": 37.444,
   "d": 4.672,
   "s": "春宵苦短日高起，从此君王不早朝。"
  },
  {
   "t": 42.22,
   "d": 4.783,
   "s": "承欢侍宴无闲暇，春从春游夜专夜。"
  },
  {
   "t": 47.116,
   "d": 4.617,
   "s": "后宫佳丽三千人，三千宠爱在一身。"
  },
  {
   "t": 51.844,
   "d": 4.478,
   "s": "金屋妆成娇侍夜，玉楼宴罢醉和春。"
  },
  {
   "t": 56.428,
   "d": 4.644,
   "s": "姊妹弟兄皆列土，可怜光彩生门户。"
  },
  {
   "t": 61.18,
   "d": 4.686,
   "s": "遂令天下父母心，不重生男重生女。"
  },
  {
   "t": 65.98,
   "d": 4.783,
   "s": "骊宫高处入青云，仙乐风飘处处闻。"
  },
  {
   "t": 70.876,
   "d": 4.922,
   "s": "缓歌慢舞凝丝竹，尽日君王看不足。"
  },
  {
   "t": 75.916,
   "d": 4.228,
   "s": "渔阳鼙鼓动地来，惊破霓裳羽衣曲。"
  },
  {
   "t": 80.26,
   "d": 4.936,
   "s": "九重城阙烟尘生，千乘万骑西南行。"
  },
  {
   "t": 85.3,
   "d": 4.506,
   "s": "翠华摇摇行复止，西出都门百余里。"
  },
  {
   "t": 89.908,
   "d": 4.7,
   "s": "六军不发无奈何，宛转蛾眉马前死。"
  },
  {
   "t": 94.708,
   "d": 4.853,
   "s": "花钿委地无人收，翠翘金雀玉搔头。"
  },
  {
   "t": 99.676,
   "d": 4.714,
   "s": "君王掩面救不得，回看血泪相和流。"
  },
  {
   "t": 104.5,
   "d": 5.047,
   "s": "黄埃散漫风萧索，云栈萦纡登剑阁。"
  },
  {
   "t": 109.66,
   "d": 4.922,
   "s": "峨嵋山下少人行，旌旗无光日色薄。"
  },
  {
   "t": 114.7,
   "d": 4.95,
   "s": "蜀江水碧蜀山青，圣主朝朝暮暮情。"
  },
  {
   "t": 119.764,
   "d": 4.783,
   "s": "行宫见月伤心色，夜雨闻铃肠断声。"
  },
  {
   "t": 124.66,
   "d": 4.617,
   "s": "天旋日转回龙驭，到此踌躇不能去。"
  },
  {
   "t": 129.388,
   "d": 4.658,
   "s": "马嵬坡下泥土中，不见玉颜空死处。"
  },
  {
   "t": 134.164,
   "d": 4.769,
   "s": "君臣相顾尽沾衣，东望都门信马归。"
  },
  {
   "t": 139.036,
   "d": 4.532,
   "s": "归来池苑皆依旧，太液芙蓉未央柳。"
  },
  {
   "t": 143.668,
   "d": 4.311,
   "s": "芙蓉如面柳如眉，对此如何不泪垂。"
  },
  {
   "t": 148.084,
   "d": 4.686,
   "s": "春风桃李花开日，秋雨梧桐叶落时。"
  },
  {
   "t": 152.884,
   "d": 4.492,
   "s": "西宫南内多秋草，落叶满阶红不扫。"
  },
  {
   "t": 157.492,
   "d": 4.422,
   "s": "梨园弟子白发新，椒房阿监青娥老。"
  },
  {
   "t": 162.028,
   "d": 4.589,
   "s": "夕殿萤飞思悄然，孤灯挑尽未成眠。"
  },
  {
   "t": 166.732,
   "d": 4.881,
   "s": "迟迟钟鼓初长夜，耿耿星河欲曙天。"
  },
  {
   "t": 171.724,
   "d": 4.672,
   "s": "鸳鸯瓦冷霜华重，翡翠衾寒谁与共。"
  },
  {
   "t": 176.5,
   "d": 4.478,
   "s": "悠悠生死别经年，魂魄不曾来入梦。"
  },
  {
   "t": 181.084,
   "d": 4.631,
   "s": "临邛道士鸿都客，能以精诚致魂魄。"
  },
  {
   "t": 185.836,
   "d": 4.519,
   "s": "为感君王辗转思，遂教方士殷勤觅。"
  },
  {
   "t": 190.468,
   "d": 4.519,
   "s": "排空驭气奔如电，升天入地求之遍。"
  },
  {
   "t": 195.1,
   "d": 4.464,
   "s": "上穷碧落下黄泉，两处茫茫皆不见。"
  },
  {
   "t": 199.684,
   "d": 4.783,
   "s": "忽闻海上有仙山，山在虚无缥缈间。"
  },
  {
   "t": 204.58,
   "d": 4.408,
   "s": "楼阁玲珑五云起，其中绰约多仙子。"
  },
  {
   "t": 209.092,
   "d": 4.617,
   "s": "中有一人字太真，雪肤花貌参差是。"
  },
  {
   "t": 213.82,
   "d": 4.714,
   "s": "金阙西厢叩玉扃，转教小玉报双成。"
  },
  {
   "t": 218.644,
   "d": 4.796,
   "s": "闻道汉家天子使，九华帐里梦魂惊。"
  },
  {
   "t": 223.54,
   "d": 4.242,
   "s": "揽衣推枕起徘徊，珠箔银屏迤逦开。"
  },
  {
   "t": 227.884,
   "d": 4.408,
   "s": "云鬓半偏新睡觉，花冠不整下堂来。"
  },
  {
   "t": 232.396,
   "d": 4.796,
   "s": "风吹仙袂飘飖举，犹似霓裳羽衣舞。"
  },
  {
   "t": 237.292,
   "d": 4.492,
   "s": "玉容寂寞泪阑干，梨花一枝春带雨。"
  },
  {
   "t": 241.9,
   "d": 4.7,
   "s": "含情凝睇谢君王，一别音容两渺茫。"
  },
  {
   "t": 246.7,
   "d": 4.394,
   "s": "昭阳殿里恩爱绝，蓬莱宫中日月长。"
  },
  {
   "t": 251.212,
   "d": 4.478,
   "s": "回头下望人寰处，不见长安见尘雾。"
  },
  {
   "t": 255.796,
   "d": 4.603,
   "s": "惟将旧物表深情，钿合金钗寄将去。"
  },
  {
   "t": 260.5,
   "d": 4.381,
   "s": "钗留一股合一扇，钗擘黄金合分钿。"
  },
  {
   "t": 264.988,
   "d": 4.603,
   "s": "但教心似金钿坚，天上人间会相见。"
  },
  {
   "t": 269.692,
   "d": 4.45,
   "s": "临别殷勤重寄词，词中有誓两心知。"
  },
  {
   "t": 274.252,
   "d": 4.478,
   "s": "七月七日长生殿，夜半无人私语时。"
  },
  {
   "t": 278.836,
   "d": 4.492,
   "s": "在天愿作比翼鸟，在地愿为连理枝。"
  },
  {
   "t": 283.444,
   "d": 4.742,
   "s": "天长地久有时尽，此恨绵绵无绝期。"
  }
 ]
}