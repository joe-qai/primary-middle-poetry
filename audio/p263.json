  {
   "t": 0.1,
   "d": 2.519,
   "s": "千秋岁引，秋景"
  },
  {
   "t": 2.569,
   "d": 2.181,
   "s": "宋代，王安石"
  },
  {
   "t": 4.75,
   "d": 4.903,
   "s": "别馆寒砧，孤城画角，一派秋声入寥廓。"
  },
  {
   "t": 9.653,
   "d": 4.306,
   "s": "东归燕从海上去，南来雁向沙头落。"
  },
  {
   "t": 13.958,
   "d": 3.403,
   "s": "楚台风，庾楼月，宛如昨。"
  },
  {
   "t": 17.361,
   "d": 5.792,
   "s": "无奈被些名利缚，无奈被他情担阁，可惜风流总闲却。"
  },
  {
   "t": 23.153,
   "d": 4.153,
   "s": "当初漫留华表语，而今误我秦楼约。"
  },
  {
   "t": 27.306,
   "d": 4.167,
   "s": "梦内一时收拾，来岁与春还有麽。"
  }
 ]
}