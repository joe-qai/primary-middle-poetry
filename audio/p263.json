  {
   "t": 0.1,
   "d": 2.519,
   "s": "千秋岁引，秋景"
  },
  {
   "t": 2.569,
   "d": 2.514,
   "s": "宋代，王安石"
  },
  {
   "t": 7.802,
   "d": 5.242,
   "s": "别馆寒砧，孤城画角，一派秋声入寥廓。"
  },
  {
   "t": 13.264,
   "d": 4.644,
   "s": "东归燕从海上去，南来雁向沙头落。"
  },
  {
   "t": 18.128,
   "d": 3.742,
   "s": "楚台风，庾楼月，宛如昨。"
  },
  {
   "t": 22.09,
   "d": 6.131,
   "s": "无奈被些名利缚，无奈被他情担阁，可惜风流总闲却。"
  },
  {
   "t": 28.441,
   "d": 4.492,
   "s": "当初漫留华表语，而今误我秦楼约。"
  },
  {
   "t": 33.153,
   "d": 4.172,
   "s": "梦内一时收拾，来岁与春还有麽。"
  }
 ]
}