{
 "id": "c009",
 "title": "鸿门宴",
 "voice": "zh-CN-YunjianNeural",
 "rate": "-10%",
 "pitch": "+0Hz",
 "dur": 476.943,
 "hdr": 2,
 "bodyCues": 107,
 "v": "3e10821d",
 "cues": [
  {
   "t": 0.1,
   "d": 1.492,
   "s": "鸿门宴"
  },
  {
   "t": 1.542,
   "d": 2.319,
   "s": "西汉，司马迁"
  },
  {
   "t": 3.861,
   "d": 3.667,
   "s": "沛公军霸上，未得与项羽相见。"
  },
  {
   "t": 7.528,
   "d": 8.639,
   "s": "沛公左司马曹无伤使人言于项羽曰：沛公欲王关中，使子婴为相，珍宝尽有之。"
  },
  {
   "t": 16.167,
   "d": 5.153,
   "s": "项羽大怒曰：旦日飨士卒，为击破沛公军！"
  },
  {
   "t": 21.319,
   "d": 6.819,
   "s": "当是时，项羽兵四十万，在新丰鸿门；沛公兵十万，在霸上。"
  },
  {
   "t": 28.139,
   "d": 6.208,
   "s": "范增说项羽曰：沛公居山东时，贪于财货，好美姬。"
  },
  {
   "t": 34.347,
   "d": 5.931,
   "s": "今入关，财物无所取，妇女无所幸，此其志不在小。"
  },
  {
   "t": 40.278,
   "d": 5.819,
   "s": "吾令人望其气，皆为龙虎，成五采，此天子气也。"
  },
  {
   "t": 46.097,
   "d": 1.653,
   "s": "急击勿失！"
  },
  {
   "t": 47.75,
   "d": 5.472,
   "s": "楚左尹项伯者，项羽季父也，素善留侯张良。"
  },
  {
   "t": 53.222,
   "d": 11.375,
   "s": "张良是时从沛公，项伯乃夜驰之沛公军，私见张良，具告以事，欲呼张良与俱去，曰：毋从俱死也。"
  },
  {
   "t": 64.597,
   "d": 7.278,
   "s": "张良曰：臣为韩王送沛公，沛公今事有急，亡去不义，不可不语。"
  },
  {
   "t": 71.875,
   "d": 2.556,
   "s": "良乃入，具告沛公。"
  },
  {
   "t": 74.431,
   "d": 3.861,
   "s": "沛公大惊，曰：为之奈何？"
  },
  {
   "t": 78.292,
   "d": 3.611,
   "s": "张良曰：谁为大王为此计者？"
  },
  {
   "t": 81.903,
   "d": 6.542,
   "s": "曰：鲰生说我曰：距关，毋内诸侯，秦地可尽王也。"
  },
  {
   "t": 88.444,
   "d": 1.417,
   "s": "故听之。"
  },
  {
   "t": 89.861,
   "d": 4.264,
   "s": "良曰：料大王士卒足以当项王乎？"
  },
  {
   "t": 94.125,
   "d": 3.708,
   "s": "沛公默然，曰：固不如也。"
  },
  {
   "t": 97.833,
   "d": 2.083,
   "s": "且为之奈何？"
  },
  {
   "t": 99.917,
   "d": 5.25,
   "s": "张良曰：请往谓项伯，言沛公不敢背项王也。"
  },
  {
   "t": 105.167,
   "d": 3.5,
   "s": "沛公曰：君安与项伯有故？"
  },
  {
   "t": 108.667,
   "d": 5.431,
   "s": "张良曰：秦时与臣游，项伯杀人，臣活之。"
  },
  {
   "t": 114.097,
   "d": 2.861,
   "s": "今事有急，故幸来告良。"
  },
  {
   "t": 116.958,
   "d": 2.972,
   "s": "沛公曰：孰与君少长？"
  },
  {
   "t": 119.931,
   "d": 2.153,
   "s": "良曰：长于臣。"
  },
  {
   "t": 122.083,
   "d": 4.431,
   "s": "沛公曰：君为我呼入，吾得兄事之。"
  },
  {
   "t": 126.514,
   "d": 2.472,
   "s": "张良出，要项伯。"
  },
  {
   "t": 128.986,
   "d": 2.375,
   "s": "项伯即入见沛公。"
  },
  {
   "t": 131.361,
   "d": 10.278,
   "s": "沛公奉卮酒为寿，约为婚姻，曰：吾入关，秋毫不敢有所近，籍吏民，封府库，而待将军。"
  },
  {
   "t": 141.639,
   "d": 5.014,
   "s": "所以遣将守关者，备他盗之出入与非常也。"
  },
  {
   "t": 146.653,
   "d": 3.611,
   "s": "日夜望将军至，岂敢反乎！"
  },
  {
   "t": 150.264,
   "d": 3.139,
   "s": "愿伯具言臣之不敢倍德也。"
  },
  {
   "t": 153.403,
   "d": 5.528,
   "s": "项伯许诺，谓沛公曰：旦日不可不蚤自来谢项王。"
  },
  {
   "t": 158.931,
   "d": 1.944,
   "s": "沛公曰：诺。"
  },
  {
   "t": 160.875,
   "d": 9.5,
   "s": "于是项伯复夜去，至军中，具以沛公言报项王，因言曰：沛公不先破关中，公岂敢入乎？"
  },
  {
   "t": 170.375,
   "d": 3.597,
   "s": "今人有大功而击之，不义也。"
  },
  {
   "t": 173.972,
   "d": 2.111,
   "s": "不如因善遇之。"
  },
  {
   "t": 176.083,
   "d": 1.736,
   "s": "项王许诺。"
  },
  {
   "t": 177.819,
   "d": 14.972,
   "s": "沛公旦日从百余骑来见项王，至鸿门，谢曰：臣与将军戮力，而攻秦，将军战河北，臣战河南，然不自意能先入关破秦，得复见将军于此。"
  },
  {
   "t": 192.792,
   "d": 4.181,
   "s": "今者有小人之言，令将军与臣有郤。"
  },
  {
   "t": 196.972,
   "d": 4.181,
   "s": "项王曰：此沛公左司马曹无伤言之。"
  },
  {
   "t": 201.153,
   "d": 2.722,
   "s": "不然，籍何以至此？"
  },
  {
   "t": 203.875,
   "d": 2.861,
   "s": "项王即日因留沛公与饮。"
  },
  {
   "t": 206.736,
   "d": 9.417,
   "s": "项王、项伯东向坐；亚父南向坐，——亚父者，范增也；沛公北向坐；张良西向侍。"
  },
  {
   "t": 216.153,
   "d": 6.792,
   "s": "范增数目项王，举所佩玉玦以示之者三，项王默然不应。"
  },
  {
   "t": 222.944,
   "d": 5.708,
   "s": "范增起，出，召项庄，谓曰：君王为人不忍。"
  },
  {
   "t": 228.653,
   "d": 6.042,
   "s": "若入前为寿，寿毕，请以剑舞，因击沛公于坐，杀之。"
  },
  {
   "t": 234.694,
   "d": 3.194,
   "s": "不者，若属皆且为所虏！"
  },
  {
   "t": 237.889,
   "d": 1.875,
   "s": "庄则入为寿。"
  },
  {
   "t": 239.764,
   "d": 6.375,
   "s": "寿毕，曰：君王与沛公饮，军中无以为乐，请以剑舞。"
  },
  {
   "t": 246.139,
   "d": 2.028,
   "s": "项王曰：诺。"
  },
  {
   "t": 248.167,
   "d": 6.792,
   "s": "项庄拔剑起舞，项伯亦拔剑起舞，常以身翼蔽沛公，庄不得击。"
  },
  {
   "t": 254.958,
   "d": 3.139,
   "s": "于是张良至军门见樊哙。"
  },
  {
   "t": 258.097,
   "d": 3.306,
   "s": "樊哙曰：今日之事何如？"
  },
  {
   "t": 261.403,
   "d": 2.25,
   "s": "良曰：甚急！"
  },
  {
   "t": 263.653,
   "d": 4.181,
   "s": "今者项庄拔剑舞，其意常在沛公也。"
  },
  {
   "t": 267.833,
   "d": 2.472,
   "s": "哙曰：此迫矣！"
  },
  {
   "t": 270.306,
   "d": 2.667,
   "s": "臣请入，与之同命。"
  },
  {
   "t": 272.972,
   "d": 2.819,
   "s": "哙即带剑拥盾入军门。"
  },
  {
   "t": 275.792,
   "d": 11.5,
   "s": "交戟之卫士欲止不内，樊哙侧其盾以撞，卫士仆地，哙遂入，披帷西向立，瞋目视项王，头发上指，目眦尽裂。"
  },
  {
   "t": 287.292,
   "d": 3.833,
   "s": "项王按剑而跽曰：客何为者？"
  },
  {
   "t": 291.125,
   "d": 4.347,
   "s": "张良曰：沛公之参乘樊哙者也。"
  },
  {
   "t": 295.472,
   "d": 2.375,
   "s": "项王曰：壮士！"
  },
  {
   "t": 297.847,
   "d": 1.722,
   "s": "赐之卮酒。"
  },
  {
   "t": 299.569,
   "d": 1.764,
   "s": "则与斗卮酒。"
  },
  {
   "t": 301.333,
   "d": 3.153,
   "s": "哙拜谢，起，立而饮之。"
  },
  {
   "t": 304.486,
   "d": 2.722,
   "s": "项王曰：赐之彘肩。"
  },
  {
   "t": 307.208,
   "d": 2.042,
   "s": "则与一生彘肩。"
  },
  {
   "t": 309.25,
   "d": 5.278,
   "s": "樊哙覆其盾于地，加彘肩上，拔剑切而啖之。"
  },
  {
   "t": 314.528,
   "d": 2.375,
   "s": "项王曰：壮士！"
  },
  {
   "t": 316.903,
   "d": 1.694,
   "s": "能复饮乎？"
  },
  {
   "t": 318.597,
   "d": 4.736,
   "s": "樊哙曰：臣死且不避，卮酒安足辞！"
  },
  {
   "t": 323.333,
   "d": 7.375,
   "s": "夫秦王有虎狼之心，杀人如不能举，刑人如恐不胜，天下皆叛之。"
  },
  {
   "t": 330.708,
   "d": 4.778,
   "s": "怀王与诸将约曰：先破秦入咸阳者王之。"
  },
  {
   "t": 335.486,
   "d": 8.181,
   "s": "今沛公先破秦入咸阳，毫毛不敢有所近，封闭宫室，还军霸上，以待大王来。"
  },
  {
   "t": 343.667,
   "d": 4.264,
   "s": "故遣将守关者，备他盗出入与非常也。"
  },
  {
   "t": 347.931,
   "d": 8.639,
   "s": "劳苦而功高如此，未有封侯之赏，而听细说，欲诛有功之人，此亡秦之续耳。"
  },
  {
   "t": 356.569,
   "d": 2.417,
   "s": "窃为大王不取也！"
  },
  {
   "t": 358.986,
   "d": 3.125,
   "s": "项王未有以应，曰：坐。"
  },
  {
   "t": 362.111,
   "d": 2.0,
   "s": "樊哙从良坐。"
  },
  {
   "t": 364.111,
   "d": 4.625,
   "s": "坐须臾，沛公起如厕，因招樊哙出。"
  },
  {
   "t": 368.932,
   "d": 4.075,
   "s": "沛公已出，项王使都尉陈平召沛公。"
  },
  {
   "t": 372.957,
   "d": 4.875,
   "s": "沛公曰：今者出，未辞也，为之奈何？"
  },
  {
   "t": 377.832,
   "d": 4.792,
   "s": "樊哙曰：大行不顾细谨，大礼不辞小让。"
  },
  {
   "t": 382.624,
   "d": 4.583,
   "s": "如今人方为刀俎，我为鱼肉，何辞为？"
  },
  {
   "t": 387.207,
   "d": 1.556,
   "s": "于是遂去。"
  },
  {
   "t": 388.763,
   "d": 2.097,
   "s": "乃令张良留谢。"
  },
  {
   "t": 390.86,
   "d": 2.889,
   "s": "良问曰：大王来何操？"
  },
  {
   "t": 393.749,
   "d": 6.333,
   "s": "曰：我持白璧一双，欲献项王，玉斗一双，欲与亚父。"
  },
  {
   "t": 400.082,
   "d": 2.167,
   "s": "会其怒，不敢献。"
  },
  {
   "t": 402.249,
   "d": 1.875,
   "s": "公为我献之。"
  },
  {
   "t": 404.124,
   "d": 2.222,
   "s": "张良曰：谨诺。"
  },
  {
   "t": 406.346,
   "d": 6.25,
   "s": "当是时，项王军在鸿门下，沛公军在霸上，相去四十里。"
  },
  {
   "t": 412.596,
   "d": 11.403,
   "s": "沛公则置车骑，脱身独骑，与樊哙、夏侯婴、靳强、纪信等四人持剑盾步走，从郦山下，道芷阳间行。"
  },
  {
   "t": 423.999,
   "d": 5.361,
   "s": "沛公谓张良曰：从此道至吾军，不过二十里耳。"
  },
  {
   "t": 429.36,
   "d": 2.764,
   "s": "度我至军中，公乃入。"
  },
  {
   "t": 432.124,
   "d": 3.125,
   "s": "沛公已去，间至军中。"
  },
  {
   "t": 435.249,
   "d": 5.056,
   "s": "张良入谢，曰：沛公不胜杯杓，不能辞。"
  },
  {
   "t": 440.304,
   "d": 7.653,
   "s": "谨使臣良奉白璧一双，再拜献大王足下，玉斗一双，再拜奉大将军足下。"
  },
  {
   "t": 447.957,
   "d": 2.875,
   "s": "项王曰：沛公安在？"
  },
  {
   "t": 450.832,
   "d": 5.764,
   "s": "良曰：闻大王有意督过之，脱身独去，已至军矣。"
  },
  {
   "t": 456.596,
   "d": 3.111,
   "s": "项王则受璧，置之坐上。"
  },
  {
   "t": 459.707,
   "d": 5.847,
   "s": "亚父受玉斗，置之地，拔剑撞而破之，曰：唉！"
  },
  {
   "t": 465.554,
   "d": 2.125,
   "s": "竖子不足与谋！"
  },
  {
   "t": 467.679,
   "d": 3.181,
   "s": "夺项王天下者必沛公也。"
  },
  {
   "t": 470.86,
   "d": 2.458,
   "s": "吾属今为之虏矣！"
  },
  {
   "t": 473.318,
   "d": 3.625,
   "s": "沛公至军，立诛杀曹无伤。"
  }
 ]
}