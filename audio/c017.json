 "bodyCues": 17,
 "v": "09de711a",
 "cues": [
  {
   "t": 0.1,
   "d": 1.686,
   "s": "庖丁解牛"
  },
  {
   "t": 1.736,
   "d": 2.111,
   "s": "战国，庄子"
  },
  {
   "t": 3.847,
   "d": 11.042,
   "s": "庖丁为文惠君解牛，手之所触，肩之所倚，足之所履，膝之所踦，砉然向然，奏刀騞然，莫不中音。"
  },
  {
   "t": 14.889,
   "d": 3.944,
   "s": "合于桑林之舞，乃中经首之会。"
  },
  {
   "t": 18.833,
   "d": 3.431,
   "s": "文惠君曰：嘻，善哉！"
  },
  {
   "t": 22.264,
   "d": 2.208,
   "s": "技盖至此乎？"
  },
  {
   "t": 24.472,
   "d": 5.583,
   "s": "庖丁释刀对曰：臣之所好者道也，进乎技矣。"
  },
  {
   "t": 30.056,
   "d": 4.264,
   "s": "始臣之解牛之时，所见无非牛者。"
  },
  {
   "t": 34.319,
   "d": 3.556,
   "s": "三年之后，未尝见全牛也。"
  },
  {
   "t": 37.875,
   "d": 6.111,
   "s": "方今之时，臣以神遇而不以目视，官知止而神欲行。"
  },
  {
   "t": 43.986,
   "d": 8.097,
   "s": "依乎天理，批大郤，导大窾，因其固然，技经肯綮之未尝，而况大軱乎！"
  },
  {
   "t": 52.083,
   "d": 5.028,
   "s": "良庖岁更刀，割也；族庖月更刀，折也。"
  },
  {
   "t": 57.111,
   "d": 6.583,
   "s": "今臣之刀十九年矣，所解数千牛矣，而刀刃若新发于硎。"
  },
  {
   "t": 63.694,
   "d": 11.306,
   "s": "彼节者有间，而刀刃者无厚；以无厚入有间，恢恢乎其于游刃必有余地矣，是以十九年而刀刃若新发于硎。"
  },
  {
   "t": 75.0,
   "d": 6.792,
   "s": "虽然，每至于族，吾见其难为，怵然为戒，视为止，行为迟。"
  },
  {
   "t": 81.792,
   "d": 4.0,
   "s": "动刀甚微，謋然已解，如土委地。"
  },
  {
   "t": 85.792,
   "d": 6.167,
   "s": "提刀而立，为之四顾，为之踌躇满志，善刀而藏之。"
  },
  {
   "t": 91.958,
   "d": 2.847,
   "s": "文惠君曰：善哉！"
  },
  {
   "t": 94.806,
   "d": 3.597,
   "s": "吾闻庖丁之言，得养生焉。"
  }
 ]
}