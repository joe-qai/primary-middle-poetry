   "s": "东汉，曹操"
  },
  {
   "t": 5.51,
   "d": 3.367,
   "s": "神龟虽寿，犹有竟时。"
  },
  {
   "t": 9.097,
   "d": 3.408,
   "s": "腾蛇乘雾，终为土灰。"
  },
  {
   "t": 12.725,
   "d": 3.061,
   "s": "老骥伏枥，志在千里。"
  },
  {
   "t": 16.006,
   "d": 3.158,
   "s": "烈士暮年，壮心不已。"
  },
  {
   "t": 19.384,
   "d": 2.867,
   "s": "盈缩之期，不但在天；"
  },
  {
   "t": 22.201,
   "d": 3.167,
   "s": "养怡之福，可得永年。"
  },
  {
   "t": 28.555,
   "d": 3.269,
   "s": "幸甚至哉，歌以咏志。"
  }
 ]
