  },
  {
   "t": 14.512,
   "d": 3.158,
   "s": "烈士暮年，壮心不已。"
  },
  {
   "t": 17.89,
   "d": 2.867,
   "s": "盈缩之期，不但在天；"
  },
  {
   "t": 20.707,
   "d": 3.167,
   "s": "养怡之福，可得永年。"
  },
  {
   "t": 27.061,
   "d": 0.05,
   "s": "幸甚至哉，歌以咏志。"
  }
