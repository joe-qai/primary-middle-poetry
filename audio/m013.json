  },
  {
   "t": 9.681,
   "d": 2.722,
   "s": "老骥伏枥，志在千里。"
  },
  {
   "t": 12.403,
   "d": 2.819,
   "s": "烈士暮年，壮心不已。"
  },
  {
   "t": 15.222,
   "d": 2.861,
   "s": "盈缩之期，不但在天；"
  },
  {
   "t": 18.083,
   "d": 2.833,
   "s": "养怡之福，可得永年。"
  },
  {
   "t": 20.917,
