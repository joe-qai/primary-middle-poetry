{
 "id": "c021",
 "title": "石钟山记",
 "voice": "zh-CN-YunjianNeural",
 "rate": "-10%",
 "dur": 155.402,
 "hdr": 2,
 "bodyCues": 25,
 "v": "f39438e5",
 "cues": [
  {
   "t": 0.1,
   "d": 1.769,
   "s": "石钟山记"
  },
  {
   "t": 1.819,
   "d": 2.042,
   "s": "北宋，苏轼"
  },
  {
   "t": 3.861,
   "d": 3.847,
   "s": "水经云：彭蠡之口有石钟山焉。"
  },
  {
   "t": 7.708,
   "d": 6.125,
   "s": "郦元以为下临深潭，微风鼓浪，水石相搏，声如洪钟。"
  },
  {
   "t": 13.833,
   "d": 2.708,
   "s": "是说也，人常疑之。"
  },
  {
   "t": 16.542,
   "d": 5.569,
   "s": "今以钟磬置水中，虽大风浪不能鸣也，而况石乎！"
  },
  {
   "t": 22.111,
   "d": 10.208,
   "s": "至唐李渤始访其遗踪，得双石于潭上，扣而聆之，南声函胡，北音清越，桴止响腾，余韵徐歇。"
  },
  {
   "t": 32.319,
   "d": 2.097,
   "s": "自以为得之矣。"
  },
  {
   "t": 34.417,
   "d": 2.806,
   "s": "然是说也，余尤疑之。"
  },
  {
   "t": 37.222,
   "d": 6.25,
   "s": "石之铿然有声者，所在皆是也，而此独以钟名，何哉？"
  },
  {
   "t": 43.472,
   "d": 10.722,
   "s": "元丰七年六月丁丑，余自齐安舟行适临汝，而长子迈将赴饶之德兴尉，送之至湖口，因得观所谓石钟者。"
  },
  {
   "t": 54.194,
   "d": 6.083,
   "s": "寺僧使小童持斧，于乱石间择其一二扣之，硿硿焉。"
  },
  {
   "t": 60.278,
   "d": 2.278,
   "s": "余固笑而不信也。"
  },
  {
   "t": 62.556,
   "d": 4.819,
   "s": "至莫夜月明，独与迈乘小舟，至绝壁下。"
  },
  {
   "t": 67.375,
   "d": 14.486,
   "s": "大石侧立千尺，如猛兽奇鬼，森然欲搏人；而山上栖鹘，闻人声亦惊起，磔磔云霄间；又有若老人咳且笑于山谷中者，或曰此鹳鹤也。"
  },
  {
   "t": 81.861,
   "d": 5.833,
   "s": "余方心动欲还，而大声发于水上，噌吰如钟鼓不绝。"
  },
  {
   "t": 87.694,
   "d": 1.708,
   "s": "舟人大恐。"
  },
  {
   "t": 89.403,
   "d": 8.014,
   "s": "徐而察之，则山下皆石穴罅，不知其浅深，微波入焉，涵淡澎湃而为此也。"
  },
  {
   "t": 97.417,
   "d": 14.653,
   "s": "舟回至两山间，将入港口，有大石当中流，可坐百人，空中而多窍，与风水相吞吐，有窾坎镗鞳之声，与向之噌吰者相应，如乐作焉。"
  },
  {
   "t": 112.069,
   "d": 3.292,
   "s": "因笑谓迈曰：汝识之乎？"
  },
  {
   "t": 115.361,
   "d": 7.236,
   "s": "噌吰者，周景王之无射也；窾坎镗鞳者，魏庄子之歌钟也。"
  },
  {
   "t": 122.597,
   "d": 2.319,
   "s": "古之人不余欺也！"
  },
  {
   "t": 124.917,
   "d": 4.542,
   "s": "事不目见耳闻，而臆断其有无，可乎？"
  },
  {
   "t": 129.458,
   "d": 12.847,
   "s": "郦元之所见闻，殆与余同，而言之不详；士大夫终不肯以小舟夜泊绝壁之下，故莫能知；而渔工水师虽知，而不能言。"
  },
  {
   "t": 142.306,
   "d": 2.208,
   "s": "此世所以不传也。"
  },
  {
   "t": 144.514,
   "d": 5.069,
   "s": "而陋者乃以斧斤考击，而求之，自以为得其实。"
  },
  {
   "t": 149.583,
   "d": 5.819,
   "s": "余是以记之，盖叹郦元之简，而笑李渤之陋也。"
  }
 ]
}