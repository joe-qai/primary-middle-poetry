 "cues": [
  {
   "t": 0.1,
   "d": 1.658,
   "s": "精卫填海"
  },
  {
   "t": 1.708,
   "d": 3.528,
   "s": "上古，山海经，北山经"
  },
  {
   "t": 5.236,
   "d": 3.792,
   "s": "传说炎帝有一个小女儿，名叫女娃。"
  },
  {
   "t": 9.028,
   "d": 3.431,
   "s": "女娃聪明可爱，很喜欢大海。"
  },
  {
   "t": 12.458,
   "d": 4.75,
   "s": "有一天，她独自驾着小船到东海去游玩。"
  },
  {
   "t": 17.208,
   "d": 7.167,
   "s": "海上突然起了大风浪，把小船打翻了，女娃不幸淹死在海里，再也没有回来。"
  },
  {
   "t": 24.375,
   "d": 12.361,
   "s": "女娃死后，化成了一只小鸟，形状像乌鸦，头上有花纹，白色的嘴，红色的脚，叫声像精卫、精卫，人们就叫它精卫鸟。"
  },
  {
   "t": 36.736,
   "d": 10.875,
   "s": "精卫痛恨大海夺去了她的生命，就日复一日地从西山衔来小树枝和小石子，投进东海，发誓要把大海填平。"
  },
  {
   "t": 47.611,
   "d": 8.014,
   "s": "大海奔腾咆哮着说：小鸟儿，算了吧，你就算干上一百万年，也休想把我填平！"
  },
  {
   "t": 55.625,
   "d": 6.75,
   "s": "精卫回答说：哪怕是干上一千万年、一万万年，我也要把你填平！"
  },
  {
   "t": 62.375,
   "d": 5.056,
   "s": "就这样，精卫一直不停地填海，从不停歇。"
  }
 ]
}