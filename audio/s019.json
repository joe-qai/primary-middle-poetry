 "cues": [
  {
   "t": 0.1,
   "d": 1.769,
   "s": "画龙点睛"
  },
  {
   "t": 1.819,
   "d": 3.458,
   "s": "唐代，张彦远历代名画记"
  },
  {
   "t": 5.278,
   "d": 5.208,
   "s": "南北朝时，梁朝有一位著名的画家叫张僧繇。"
  },
  {
   "t": 10.486,
   "d": 8.792,
   "s": "有一次，他在金陵安乐寺的墙壁上画了四条龙，画得栩栩如生，可是都没有画上眼睛。"
  },
  {
   "t": 19.278,
   "d": 4.653,
   "s": "人们看了都觉得很奇怪，问他为什么不画眼睛。"
  },
  {
   "t": 23.931,
   "d": 4.75,
   "s": "张僧繇说：如果画上眼睛，龙就会飞走的。"
  },
  {
   "t": 28.681,
   "d": 5.625,
   "s": "大家都不相信，认为他在说大话，坚持请他画上眼睛。"
  },
  {
   "t": 34.306,
   "d": 5.972,
   "s": "张僧繇没办法，只好提起笔来，给其中两条龙点上了眼睛。"
  },
  {
   "t": 40.278,
   "d": 8.778,
   "s": "刚点完，天空忽然电闪雷鸣，墙壁被震破了，那两条点了眼睛的龙乘着云气飞上了天。"
  },
  {
   "t": 49.056,
   "d": 5.069,
   "s": "而另外两条没有点眼睛的龙，还留在墙壁上。"
  }
 ]
}