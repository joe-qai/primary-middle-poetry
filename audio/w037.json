  },
  {
   "t": 47.545,
   "d": 1.519,
   "s": "其筑欲密。"
  },
  {
   "t": 49.014,
   "d": 1.792,
   "s": "既然已"
  },
  {
   "t": 52.675,
   "d": 1.936,
   "s": "勿动勿虑"
  },
  {
   "t": 54.861,
   "d": 1.603,
   "s": "去不复顾。"
  },
  {
   "t": 56.414,
   "d": 2.292,
   "s": "其莳也若子"
  },
  {
   "t": 60.659,
   "d": 2.297,
   "s": "其置也若弃"
  },
  {
   "t": 63.206,
   "d": 2.978,
   "s": "则其天者全而其性得矣。"
  },
  {
   "t": 66.134,
