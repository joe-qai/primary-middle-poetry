 "cues": [
  {
   "t": 0.1,
   "d": 2.144,
   "s": "种树郭橐驼传"
  },
  {
   "t": 2.194,
   "d": 2.278,
   "s": "唐代，柳宗元"
  },
  {
   "t": 4.472,
   "d": 2.778,
   "s": "郭橐驼，不知始何名。"
  },
  {
   "t": 7.25,
   "d": 5.694,
   "s": "病偻，隆然伏行，有类橐驼者，故乡人号之驼。"
  },
  {
   "t": 12.944,
   "d": 4.333,
   "s": "驼闻之，曰：甚善，名我固当。"
  },
  {
   "t": 17.278,
   "d": 3.611,
   "s": "因舍其名，亦自谓橐驼云。"
  },
  {
   "t": 20.889,
   "d": 6.583,
   "s": "凡植木之性，其本欲舒，其培欲平，其土欲故，其筑欲密。"
  },
  {
   "t": 27.472,
   "d": 3.556,
   "s": "既然已，勿动勿虑，去不复顾。"
  },
  {
   "t": 31.028,
   "d": 5.833,
   "s": "其莳也若子，其置也若弃，则其天者全而其性得矣。"
  },
  {
   "t": 36.861,
   "d": 7.083,
   "s": "吾小人辍飧饔以劳吏者，且不得暇，又何以蕃吾生，而安吾性耶？"
  },
  {
   "t": 43.944,
   "d": 1.736,
   "s": "故病且怠。"
  },
  {
   "t": 45.681,
   "d": 3.806,
   "s": "若是，则与吾业者亦有类乎？"
  }
 ]
}