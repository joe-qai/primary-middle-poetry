 "cues": [
  {
   "t": 0.1,
   "d": 2.144,
   "s": "种树郭橐驼传"
  },
  {
   "t": 2.194,
   "d": 2.611,
   "s": "唐代，柳宗元"
  },
  {
   "t": 4.972,
   "d": 3.116,
   "s": "郭橐驼，不知始何名。"
  },
  {
   "t": 8.188,
   "d": 6.033,
   "s": "病偻，隆然伏行，有类橐驼者，故乡人号之驼。"
  },
  {
   "t": 14.332,
   "d": 4.672,
   "s": "驼闻之，曰：甚善，名我固当。"
  },
  {
   "t": 19.108,
   "d": 3.95,
   "s": "因舍其名，亦自谓橐驼云。"
  },
  {
   "t": 23.164,
   "d": 6.922,
   "s": "凡植木之性，其本欲舒，其培欲平，其土欲故，其筑欲密。"
  },
  {
   "t": 30.196,
   "d": 3.894,
   "s": "既然已，勿动勿虑，去不复顾。"
  },
  {
   "t": 34.204,
   "d": 6.172,
   "s": "其莳也若子，其置也若弃，则其天者全而其性得矣。"
  },
  {
   "t": 40.492,
   "d": 7.422,
   "s": "吾小人辍飧饔以劳吏者，且不得暇，又何以蕃吾生，而安吾性耶？"
  },
  {
   "t": 48.028,
   "d": 2.075,
   "s": "故病且怠。"
  },
  {
   "t": 50.212,
   "d": 3.811,
   "s": "若是，则与吾业者亦有类乎？"
  }
 ]
}