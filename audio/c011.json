{
 "id": "c011",
 "title": "唐雎不辱使命",
 "voice": "zh-CN-YunjianNeural",
 "rate": "-10%",
 "pitch": "+0Hz",
 "dur": 127.008,
 "hdr": 2,
 "bodyCues": 22,
 "v": "2abb0500",
 "cues": [
  {
   "t": 0.1,
   "d": 2.006,
   "s": "唐雎不辱使命"
  },
  {
   "t": 2.056,
   "d": 1.875,
   "s": "西汉，刘向"
  },
  {
   "t": 3.931,
   "d": 7.792,
   "s": "秦王使人谓安陵君曰：寡人欲以五百里之地易安陵，安陵君其许寡人！"
  },
  {
   "t": 11.722,
   "d": 9.111,
   "s": "安陵君曰：大王加惠，以大易小，甚善；虽然，受地于先王，愿终守之，弗敢易！"
  },
  {
   "t": 20.833,
   "d": 1.556,
   "s": "秦王不说。"
  },
  {
   "t": 22.389,
   "d": 2.889,
   "s": "安陵君因使唐雎使于秦。"
  },
  {
   "t": 25.278,
   "d": 7.667,
   "s": "秦王谓唐雎曰：寡人以五百里之地易安陵，安陵君不听寡人，何也？"
  },
  {
   "t": 32.944,
   "d": 7.528,
   "s": "且秦灭韩亡魏，而君以五十里之地存者，以君为长者，故不错意也。"
  },
  {
   "t": 40.472,
   "d": 6.583,
   "s": "今吾以十倍之地，请广于君，而君逆寡人者，轻寡人与？"
  },
  {
   "t": 47.056,
   "d": 3.833,
   "s": "唐雎对曰：否，非若是也。"
  },
  {
   "t": 50.889,
   "d": 7.0,
   "s": "安陵君受地于先王，而守之，虽千里不敢易也，岂直五百里哉？"
  },
  {
   "t": 57.889,
   "d": 5.667,
   "s": "秦王怫然怒，谓唐雎曰：公亦尝闻天子之怒乎？"
  },
  {
   "t": 63.556,
   "d": 3.417,
   "s": "唐雎对曰：臣未尝闻也。"
  },
  {
   "t": 66.972,
   "d": 5.208,
   "s": "秦王曰：天子之怒，伏尸百万，流血千里。"
  },
  {
   "t": 72.181,
   "d": 3.986,
   "s": "唐雎曰：大王尝闻布衣之怒乎？"
  },
  {
   "t": 76.167,
   "d": 5.486,
   "s": "秦王曰：布衣之怒，亦免冠徒跣，以头抢地耳。"
  },
  {
   "t": 81.653,
   "d": 4.847,
   "s": "唐雎曰：此庸夫之怒也，非士之怒也。"
  },
  {
   "t": 86.5,
   "d": 10.361,
   "s": "夫专诸之刺王僚也，彗星袭月；聂政之刺韩傀也，白虹贯日；要离之刺庆忌也，仓鹰击于殿上。"
  },
  {
   "t": 96.861,
   "d": 7.583,
   "s": "此三子者，皆布衣之士也，怀怒未发，休祲降于天，与臣而将四矣。"
  },
  {
   "t": 104.444,
   "d": 6.431,
   "s": "若士必怒，伏尸二人，流血五步，天下缟素，今日是也。"
  },
  {
   "t": 110.875,
   "d": 1.597,
   "s": "挺剑而起。"
  },
  {
   "t": 112.472,
   "d": 4.486,
   "s": "秦王色挠，长跪而谢之曰：先生坐！"
  },
  {
   "t": 116.958,
   "d": 1.764,
   "s": "何至于此！"
  },
  {
   "t": 118.722,
   "d": 8.208,
   "s": "寡人谕矣：夫韩、魏灭亡，而安陵以五十里之地存者，徒以有先生也。"
  }
 ]
}