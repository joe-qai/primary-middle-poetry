{
 "id": "c013",
 "title": "邹忌讽齐王纳谏",
 "voice": "zh-CN-YunjianNeural",
 "rate": "-10%",
 "dur": 113.93,
 "hdr": 2,
 "bodyCues": 18,
 "v": "5945a0fc",
 "cues": [
  {
   "t": 0.1,
   "d": 2.269,
   "s": "邹忌讽齐王纳谏"
  },
  {
   "t": 2.319,
   "d": 1.875,
   "s": "西汉，刘向"
  },
  {
   "t": 4.194,
   "d": 3.639,
   "s": "邹忌修八尺有余，而形貌昳丽。"
  },
  {
   "t": 7.833,
   "d": 5.903,
   "s": "朝服衣冠，窥镜，谓其妻曰：我孰与城北徐公美？"
  },
  {
   "t": 13.736,
   "d": 4.653,
   "s": "其妻曰：君美甚，徐公何能及君也？"
  },
  {
   "t": 18.389,
   "d": 3.583,
   "s": "城北徐公，齐国之美丽者也。"
  },
  {
   "t": 21.972,
   "d": 5.153,
   "s": "忌不自信，而复问其妾曰：吾孰与徐公美？"
  },
  {
   "t": 27.125,
   "d": 3.444,
   "s": "妾曰：徐公何能及君也？"
  },
  {
   "t": 30.569,
   "d": 6.375,
   "s": "旦日，客从外来，与坐谈，问之客曰：吾与徐公孰美？"
  },
  {
   "t": 36.944,
   "d": 3.583,
   "s": "客曰：徐公不若君之美也。"
  },
  {
   "t": 40.528,
   "d": 7.0,
   "s": "明日徐公来，孰视之，自以为不如；窥镜而自视，又弗如远甚。"
  },
  {
   "t": 47.528,
   "d": 10.667,
   "s": "暮寝而思之，曰：吾妻之美我者，私我也；妾之美我者，畏我也；客之美我者，欲有求于我也。"
  },
  {
   "t": 58.194,
   "d": 5.236,
   "s": "于是入朝见威王，曰：臣诚知不如徐公美。"
  },
  {
   "t": 63.431,
   "d": 7.236,
   "s": "臣之妻私臣，臣之妾畏臣，臣之客欲有求于臣，皆以美于徐公。"
  },
  {
   "t": 70.667,
   "d": 12.403,
   "s": "今齐地方千里，百二十城，宫妇左右莫不私王，朝廷之臣莫不畏王，四境之内莫不有求于王：由此观之，王之蔽甚矣。"
  },
  {
   "t": 83.069,
   "d": 1.681,
   "s": "王曰：善。"
  },
  {
   "t": 84.75,
   "d": 12.028,
   "s": "乃下令：群臣吏民能面刺寡人之过者，受上赏；上书谏寡人者，受中赏；能谤讥于市朝，闻寡人之耳者，受下赏。"
  },
  {
   "t": 96.778,
   "d": 9.597,
   "s": "令初下，群臣进谏，门庭若市；数月之后，时时而间进；期年之后，虽欲言，无可进者。"
  },
  {
   "t": 106.375,
   "d": 4.458,
   "s": "燕、赵、韩、魏闻之，皆朝于齐。"
  },
  {
   "t": 110.833,
   "d": 3.097,
   "s": "此所谓战胜于朝廷。"
  }
 ]
}