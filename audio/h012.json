 "cues": [
  {
   "t": 0.1,
   "d": 2.367,
   "s": "梦游天姥吟留别"
  },
  {
   "t": 2.417,
   "d": 2.458,
   "s": "唐代，李白"
  },
  {
   "t": 5.044,
   "d": 7.631,
   "s": "海客谈瀛洲，烟涛微茫信难求；越人语天姥，云霞明灭或可睹。"
  },
  {
   "t": 12.796,
   "d": 4.589,
   "s": "天姥连天向天横，势拔五岳掩赤城。"
  },
  {
   "t": 17.5,
   "d": 4.603,
   "s": "天台一万八千丈，对此欲倒东南倾。"
  },
  {
   "t": 22.204,
   "d": 4.547,
   "s": "我欲因之梦吴越，一夜飞度镜湖月。"
  },
  {
   "t": 26.86,
   "d": 3.867,
   "s": "湖月照我影，送我至剡溪。"
  },
  {
   "t": 30.844,
   "d": 4.408,
   "s": "谢公宿处今尚在，渌水荡漾清猿啼。"
  },
  {
   "t": 35.356,
   "d": 3.644,
   "s": "脚著谢公屐，身登青云梯。"
  },
  {
   "t": 39.1,
   "d": 3.922,
   "s": "半壁见海日，空中闻天鸡。"
  },
  {
   "t": 43.132,
   "d": 4.422,
   "s": "千岩万转路不定，迷花倚石忽已暝。"
  },
  {
   "t": 47.668,
   "d": 4.756,
   "s": "熊咆龙吟殷岩泉，栗深林兮惊层巅。"
  },
  {
   "t": 52.54,
   "d": 4.186,
   "s": "云青青兮欲雨，水澹澹兮生烟。"
  },
  {
   "t": 56.836,
   "d": 3.075,
   "s": "列缺霹雳，丘峦崩摧。"
  },
  {
   "t": 60.028,
   "d": 3.061,
   "s": "洞天石扉，訇然中开。"
  },
  {
   "t": 63.196,
   "d": 4.714,
   "s": "青冥浩荡不见底，日月照耀金银台。"
  },
  {
   "t": 68.02,
   "d": 4.867,
   "s": "霓为衣兮风为马，云之君兮纷纷下来下。"
  },
  {
   "t": 72.988,
   "d": 4.714,
   "s": "虎鼓瑟兮鸾回车，仙之人兮列如麻。"
  },
  {
   "t": 77.812,
   "d": 4.228,
   "s": "忽魂悸以魄动，恍惊起而长嗟。"
  },
  {
   "t": 82.156,
   "d": 4.381,
   "s": "惟觉时之枕席，失向来之烟霞。"
  },
  {
   "t": 86.644,
   "d": 4.408,
   "s": "世间行乐亦如此，古来万事东流水。"
  },
  {
   "t": 91.156,
   "d": 4.756,
   "s": "安能摧眉折腰事权贵，使我不得开心颜！"
  }
 ]
}