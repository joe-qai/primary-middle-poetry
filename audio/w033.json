 "cues": [
  {
   "t": 0.1,
   "d": 2.853,
   "s": "黄州快哉亭记节选"
  },
  {
   "t": 2.903,
   "d": 2.125,
   "s": "宋代，苏辙"
  },
  {
   "t": 5.028,
   "d": 4.431,
   "s": "江出西陵，始得平地，其流奔放肆大。"
  },
  {
   "t": 9.458,
   "d": 4.028,
   "s": "南合沅湘，北合汉沔，其势益张。"
  },
  {
   "t": 13.486,
   "d": 4.611,
   "s": "至于赤壁之下，波流浸灌，与海相若。"
  },
  {
   "t": 18.097,
   "d": 10.125,
   "s": "清河张君梦得，谪居齐安，即其庐之西南为亭，以览观江流之胜，而余兄子瞻名之曰\"快哉\"。"
  },
  {
   "t": 28.222,
   "d": 4.528,
   "s": "盖亭之所见，南北百里，东西一舍。"
  },
  {
   "t": 32.75,
   "d": 3.111,
   "s": "涛澜汹涌，风云开阖。"
  },
  {
   "t": 35.861,
   "d": 5.222,
   "s": "昼则舟楫出没于其前，夜则鱼龙悲啸于其下。"
  },
  {
   "t": 41.083,
   "d": 3.75,
   "s": "变化倏忽，动心骇目，不可久视。"
  },
  {
   "t": 44.833,
   "d": 9.458,
   "s": "今乃得玩之几席之上，举手可供俯仰，而皆足以畅幽情，快意于耳目之间，岂不快哉！"
  }
 ]
}