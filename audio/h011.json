  {
   "t": 0.1,
   "d": 1.95,
   "s": "归园田居其一"
  },
  {
   "t": 2.0,
   "d": 2.736,
   "s": "东晋，陶渊明"
  },
  {
   "t": 4.9,
   "d": 3.825,
   "s": "少无适俗韵，性本爱丘山。"
  },
  {
   "t": 8.836,
   "d": 3.644,
   "s": "误落尘网中，一去三十年。"
  },
  {
   "t": 12.58,
   "d": 3.783,
   "s": "羁鸟恋旧林，池鱼思故渊。"
  },
  {
   "t": 16.468,
   "d": 3.769,
   "s": "开荒南野际，守拙归园田。"
  },
  {
   "t": 20.356,
   "d": 3.881,
   "s": "方宅十余亩，草屋八九间。"
  },
  {
   "t": 24.34,
   "d": 3.783,
   "s": "榆柳荫后檐，桃李罗堂前。"
  },
  {
   "t": 28.228,
   "d": 3.7,
   "s": "暧暧远人村，依依墟里烟。"
  },
  {
   "t": 32.044,
   "d": 3.783,
   "s": "狗吠深巷中，鸡鸣桑树颠。"
  },
  {
   "t": 35.932,
   "d": 3.839,
   "s": "户庭无尘杂，虚室有余闲。"
  },
  {
   "t": 39.892,
   "d": 3.575,
   "s": "久在樊笼里，复得返自然。"
  }
 ]
}