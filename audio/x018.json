{
 "id": "x018",
 "title": "阿房宫赋",
 "voice": "zh-CN-YunjianNeural",
 "rate": "-10%",
 "pitch": "+0Hz",
 "dur": 185.664,
 "hdr": 2,
 "bodyCues": 33,
 "v": "afe71864",
 "cues": [
  {
   "t": 0.1,
   "d": 1.728,
   "s": "阿房宫赋"
  },
  {
   "t": 1.778,
   "d": 2.361,
   "s": "唐代，杜牧"
  },
  {
   "t": 4.3,
   "d": 4.422,
   "s": "六王毕，四海一，蜀山兀，阿房出。"
  },
  {
   "t": 8.836,
   "d": 3.672,
   "s": "覆压三百余里，隔离天日。"
  },
  {
   "t": 12.628,
   "d": 3.992,
   "s": "骊山北构而西折，直走咸阳。"
  },
  {
   "t": 16.732,
   "d": 3.158,
   "s": "二川溶溶，流入宫墙。"
  },
  {
   "t": 19.996,
   "d": 7.769,
   "s": "五步一楼，十步一阁；廊腰缦回，檐牙高啄；各抱地势，钩心斗角。"
  },
  {
   "t": 27.868,
   "d": 6.436,
   "s": "盘盘焉，囷囷焉，蜂房水涡，矗不知其几千万落。"
  },
  {
   "t": 34.42,
   "d": 3.506,
   "s": "长桥卧波，未云何龙？"
  },
  {
   "t": 38.044,
   "d": 3.325,
   "s": "复道行空，不霁何虹？"
  },
  {
   "t": 41.476,
   "d": 3.061,
   "s": "高低冥迷，不知西东。"
  },
  {
   "t": 44.644,
   "d": 5.756,
   "s": "歌台暖响，春光融融；舞殿冷袖，风雨凄凄。"
  },
  {
   "t": 50.5,
   "d": 4.436,
   "s": "一日之内，一宫之间，而气候不齐。"
  },
  {
   "t": 55.036,
   "d": 5.783,
   "s": "妃嫔媵嫱，王子皇孙，辞楼下殿，辇来于秦。"
  },
  {
   "t": 60.94,
   "d": 3.311,
   "s": "朝歌夜弦，为秦宫人。"
  },
  {
   "t": 64.372,
   "d": 10.992,
   "s": "明星荧荧，开妆镜也；绿云扰扰，梳晓鬟也；渭流涨腻，弃脂水也；烟斜雾横，焚椒兰也。"
  },
  {
   "t": 75.484,
   "d": 6.2,
   "s": "雷霆乍惊，宫车过也；辘辘远听，杳不知其所之也。"
  },
  {
   "t": 81.796,
   "d": 5.672,
   "s": "一肌一容，尽态极妍，缦立远视，而望幸焉。"
  },
  {
   "t": 87.58,
   "d": 3.311,
   "s": "有不见者，三十六年。"
  },
  {
   "t": 91.012,
   "d": 8.742,
   "s": "燕赵之收藏，韩魏之经营，齐楚之精英，几世几年，剽掠其人，倚叠如山。"
  },
  {
   "t": 99.868,
   "d": 3.186,
   "s": "一旦不能有，输来其间。"
  },
  {
   "t": 103.156,
   "d": 6.867,
   "s": "鼎铛玉石，金块珠砾，弃掷逦迤，秦人视之，亦不甚惜。"
  },
  {
   "t": 110.14,
   "d": 1.756,
   "s": "嗟乎！"
  },
  {
   "t": 112.012,
   "d": 3.672,
   "s": "一人之心，千万人之心也。"
  },
  {
   "t": 115.804,
   "d": 3.464,
   "s": "秦爱纷奢，人亦念其家。"
  },
  {
   "t": 119.38,
   "d": 4.117,
   "s": "奈何取之尽锱铢，用之如泥沙？"
  },
  {
   "t": 123.604,
   "d": 19.103,
   "s": "使负栋之柱，多于南亩之农夫；架梁之椽，多于机上之工女；钉头磷磷，多于在庾之粟粒；瓦缝参差，多于周身之帛缕；直栏横槛，多于九土之城郭；管弦呕哑，多于市人之言语。"
  },
  {
   "t": 142.828,
   "d": 3.74,
   "s": "使天下之人，不敢言而敢怒。"
  },
  {
   "t": 146.668,
   "d": 3.144,
   "s": "独夫之心，日益骄固。"
  },
  {
   "t": 149.932,
   "d": 5.353,
   "s": "戍卒叫，函谷举，楚人一炬，可怜焦土！"
  },
  {
   "t": 155.404,
   "d": 1.922,
   "s": "呜呼！"
  },
  {
   "t": 157.444,
   "d": 6.506,
   "s": "灭六国者六国也，非秦也；族秦者秦也，非天下也。"
  },
  {
   "t": 164.068,
   "d": 1.783,
   "s": "嗟夫！"
  },
  {
   "t": 165.964,
   "d": 11.047,
   "s": "使六国各爱其人，则足以拒秦；使秦复爱六国之人，则递三世可至万世，而为君，谁得而族灭也？"
  },
  {
   "t": 177.124,
   "d": 8.519,
   "s": "秦人不暇自哀，而后人哀之；后人哀之而不鉴之，亦使后人而复哀后人也。"
  }
 ]
}