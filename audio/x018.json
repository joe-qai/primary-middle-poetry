{
 "id": "x018",
 "title": "阿房宫赋",
 "voice": "zh-CN-YunjianNeural",
 "rate": "-10%",
 "dur": 170.681,
 "hdr": 2,
 "bodyCues": 33,
 "v": "4eb208b1",
 "cues": [
  {
   "t": 0.1,
   "d": 1.728,
   "s": "阿房宫赋"
  },
  {
   "t": 1.778,
   "d": 2.028,
   "s": "唐代，杜牧"
  },
  {
   "t": 3.806,
   "d": 4.083,
   "s": "六王毕，四海一，蜀山兀，阿房出。"
  },
  {
   "t": 7.889,
   "d": 3.333,
   "s": "覆压三百余里，隔离天日。"
  },
  {
   "t": 11.222,
   "d": 3.653,
   "s": "骊山北构而西折，直走咸阳。"
  },
  {
   "t": 14.875,
   "d": 2.819,
   "s": "二川溶溶，流入宫墙。"
  },
  {
   "t": 17.694,
   "d": 7.431,
   "s": "五步一楼，十步一阁；廊腰缦回，檐牙高啄；各抱地势，钩心斗角。"
  },
  {
   "t": 25.125,
   "d": 6.097,
   "s": "盘盘焉，囷囷焉，蜂房水涡，矗不知其几千万落。"
  },
  {
   "t": 31.222,
   "d": 3.167,
   "s": "长桥卧波，未云何龙？"
  },
  {
   "t": 34.389,
   "d": 2.986,
   "s": "复道行空，不霁何虹？"
  },
  {
   "t": 37.375,
   "d": 2.722,
   "s": "高低冥迷，不知西东。"
  },
  {
   "t": 40.097,
   "d": 5.417,
   "s": "歌台暖响，春光融融；舞殿冷袖，风雨凄凄。"
  },
  {
   "t": 45.514,
   "d": 4.097,
   "s": "一日之内，一宫之间，而气候不齐。"
  },
  {
   "t": 49.611,
   "d": 5.444,
   "s": "妃嫔媵嫱，王子皇孙，辞楼下殿，辇来于秦。"
  },
  {
   "t": 55.056,
   "d": 2.972,
   "s": "朝歌夜弦，为秦宫人。"
  },
  {
   "t": 58.028,
   "d": 10.653,
   "s": "明星荧荧，开妆镜也；绿云扰扰，梳晓鬟也；渭流涨腻，弃脂水也；烟斜雾横，焚椒兰也。"
  },
  {
   "t": 68.681,
   "d": 5.861,
   "s": "雷霆乍惊，宫车过也；辘辘远听，杳不知其所之也。"
  },
  {
   "t": 74.542,
   "d": 5.333,
   "s": "一肌一容，尽态极妍，缦立远视，而望幸焉。"
  },
  {
   "t": 79.875,
   "d": 2.972,
   "s": "有不见者，三十六年。"
  },
  {
   "t": 82.847,
   "d": 8.403,
   "s": "燕赵之收藏，韩魏之经营，齐楚之精英，几世几年，剽掠其人，倚叠如山。"
  },
  {
   "t": 91.25,
   "d": 2.847,
   "s": "一旦不能有，输来其间。"
  },
  {
   "t": 94.097,
   "d": 6.528,
   "s": "鼎铛玉石，金块珠砾，弃掷逦迤，秦人视之，亦不甚惜。"
  },
  {
   "t": 100.625,
   "d": 1.417,
   "s": "嗟乎！"
  },
  {
   "t": 102.042,
   "d": 3.333,
   "s": "一人之心，千万人之心也。"
  },
  {
   "t": 105.375,
   "d": 3.125,
   "s": "秦爱纷奢，人亦念其家。"
  },
  {
   "t": 108.5,
   "d": 3.778,
   "s": "奈何取之尽锱铢，用之如泥沙？"
  },
  {
   "t": 112.278,
   "d": 18.764,
   "s": "使负栋之柱，多于南亩之农夫；架梁之椽，多于机上之工女；钉头磷磷，多于在庾之粟粒；瓦缝参差，多于周身之帛缕；直栏横槛，多于九土之城郭；管弦呕哑，多于市人之言语。"
  },
  {
   "t": 131.042,
   "d": 3.403,
   "s": "使天下之人，不敢言而敢怒。"
  },
  {
   "t": 134.444,
   "d": 2.806,
   "s": "独夫之心，日益骄固。"
  },
  {
   "t": 137.25,
   "d": 5.014,
   "s": "戍卒叫，函谷举，楚人一炬，可怜焦土！"
  },
  {
   "t": 142.264,
   "d": 1.583,
   "s": "呜呼！"
  },
  {
   "t": 143.847,
   "d": 6.167,
   "s": "灭六国者六国也，非秦也；族秦者秦也，非天下也。"
  },
  {
   "t": 150.014,
   "d": 1.444,
   "s": "嗟夫！"
  },
  {
   "t": 151.458,
   "d": 10.708,
   "s": "使六国各爱其人，则足以拒秦；使秦复爱六国之人，则递三世可至万世，而为君，谁得而族灭也？"
  },
  {
   "t": 162.167,
   "d": 8.514,
   "s": "秦人不暇自哀，而后人哀之；后人哀之而不鉴之，亦使后人而复哀后人也。"
  }
 ]
}