  },
  {
   "t": 1.972,
   "d": 2.167,
   "s": "唐代，韩愈"
  },
  {
   "t": 4.139,
   "d": 9.903,
   "s": "国子先生晨入太学，招诸生立馆下，诲之曰：业精于勤，荒于嬉；行成于思，毁于随。"
  },
  {
   "t": 14.042,
   "d": 3.403,
   "s": "方今圣贤相逢，治具毕张。"
  },
  {
   "t": 17.444,
   "d": 3.014,
   "s": "拔去凶邪，登崇畯良。"
  },
  {
   "t": 20.458,
   "d": 4.319,
   "s": "占小善者率以录，名一艺者无不庸。"
  },
  {
   "t": 24.778,
   "d": 2.972,
   "s": "爬罗剔抉，刮垢磨光。"
  },
  {
   "t": 27.75,
   "d": 3.972,
   "s": "盖有幸而获选，孰云多而不扬？"
  },
  {
   "t": 31.722,
   "d": 7.903,
   "s": "诸生业患不能精，无患有司之不明；行患不能成，无患有司之不公。"
  }
 ]
