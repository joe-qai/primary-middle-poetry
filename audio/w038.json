   "s": "进学解节选"
  },
  {
   "t": 1.972,
   "d": 2.5,
   "s": "唐代，韩愈"
  },
  {
   "t": 4.572,
   "d": 10.242,
   "s": "国子先生晨入太学，招诸生立馆下，诲之曰：业精于勤，荒于嬉；行成于思，毁于随。"
  },
  {
   "t": 15.034,
   "d": 3.742,
   "s": "方今圣贤相逢，治具毕张。"
  },
  {
   "t": 18.996,
   "d": 3.353,
   "s": "拔去凶邪，登崇畯良。"
  },
  {
   "t": 22.569,
   "d": 4.658,
   "s": "占小善者率以录，名一艺者无不庸。"
  },
  {
   "t": 27.447,
   "d": 3.311,
   "s": "爬罗剔抉，刮垢磨光。"
  },
  {
   "t": 30.978,
   "d": 4.311,
   "s": "盖有幸而获选，孰云多而不扬？"
  },
  {
   "t": 35.509,
   "d": 7.307,
   "s": "诸生业患不能精，无患有司之不明；行患不能成，无患有司之不公。"
  }
 ]
}