 "cues": [
  {
   "t": 0.1,
   "d": 1.922,
   "s": "进学解节选"
  },
  {
   "t": 1.972,
   "d": 2.5,
   "s": "唐代，韩愈"
  },
  {
   "t": 6.594,
   "d": 1.978,
   "s": "国子先生"
  },
  {
   "t": 8.972,
   "d": 4.881,
   "s": "晨入太学，招诸生立馆下，诲之曰："
  },
  {
   "t": 14.253,
   "d": 4.006,
   "s": "业精于勤，荒于嬉；行成"
  },
  {
   "t": 18.659,
   "d": 2.117,
   "s": "于思，毁于随。"
  },
  {
   "t": 20.726,
   "d": 3.736,
   "s": "方今圣贤相逢，治具毕张"
  },
  {
   "t": 27.079,
   "d": 3.019,
   "s": "拔去凶邪，登崇畯良。"
  },
  {
   "t": 30.048,
   "d": 2.069,
   "s": "占小善者"
  },
  {
   "t": 35.636,
   "d": 3.381,
   "s": "率以录，名一艺者无不庸。"
  },
  {
   "t": 38.967,
   "d": 1.528,
   "s": "爬罗"
  },
  {
   "t": 44.376,
   "d": 2.617,
   "s": "剔抉，刮垢磨光。"
  },
  {
   "t": 46.943,
   "d": 3.972,
   "s": "盖有幸而获选，孰云多而不扬？"
  },
  {
   "t": 50.915,
   "d": 2.042,
   "s": "诸生业患"
  },
  {
   "t": 62.713,
   "d": 3.061,
   "s": "不能精，无患有司"
  },
  {
   "t": 66.174,
   "d": 2.672,
   "s": "之不明；行患"
  },
  {
   "t": 69.246,
   "d": 3.658,
   "s": "不能成，无患有司之不公。"
  }
 ]
}