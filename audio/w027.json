 "cues": [
  {
   "t": 0.1,
   "d": 1.881,
   "s": "穿井得一人"
  },
  {
   "t": 1.931,
   "d": 3.028,
   "s": "战国，吕不韦吕氏春秋"
  },
  {
   "t": 4.958,
   "d": 5.167,
   "s": "宋之丁氏，家无井而出溉汲，常一人居外。"
  },
  {
   "t": 10.125,
   "d": 4.833,
   "s": "及其家穿井，告人曰：吾穿井得一人。"
  },
  {
   "t": 14.958,
   "d": 4.042,
   "s": "有闻而传之者：丁氏穿井得一人。"
  },
  {
   "t": 19.0,
   "d": 3.264,
   "s": "国人道之，闻之于宋君。"
  },
  {
   "t": 22.264,
   "d": 7.542,
   "s": "宋君令人问之于丁氏，丁氏对曰：得一人之使，非得一人于井中也。"
  },
  {
   "t": 29.806,
   "d": 3.778,
   "s": "求闻之若此，不若无闻也。"
  }
 ]
}