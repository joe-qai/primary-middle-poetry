  {
   "t": 0.1,
   "d": 3.658,
   "s": "八声甘州，对潇潇暮雨洒江天"
  },
  {
   "t": 3.708,
   "d": 2.056,
   "s": "宋代，柳永"
  },
  {
   "t": 5.764,
   "d": 3.917,
   "s": "对潇潇暮雨洒江天，一番洗清秋。"
  },
  {
   "t": 9.681,
   "d": 4.528,
   "s": "渐霜风凄紧，关河冷落，残照当楼。"
  },
  {
   "t": 14.208,
   "d": 3.861,
   "s": "是处红衰翠减，苒苒物华休。"
  },
  {
   "t": 18.069,
   "d": 3.111,
   "s": "惟有长江水，无语东流。"
  },
  {
   "t": 21.181,
   "d": 4.875,
   "s": "不忍登高临远，望故乡渺邈，归思难收。"
  },
  {
   "t": 26.056,
   "d": 3.375,
   "s": "叹年来踪迹，何事苦淹留？"
  },
  {
   "t": 29.431,
   "d": 4.264,
   "s": "想佳人妆楼颙望，误几回天际识归舟。"
  },
  {
   "t": 33.694,
   "d": 4.306,
   "s": "争知我，倚阑干处，正恁凝眸！"
  }
 ]
}