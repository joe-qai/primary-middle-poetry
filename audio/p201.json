  {
   "t": 0.1,
   "d": 3.658,
   "s": "八声甘州，对潇潇暮雨洒江天"
  },
  {
   "t": 3.708,
   "d": 2.389,
   "s": "宋代，柳永"
  },
  {
   "t": 9.955,
   "d": 4.256,
   "s": "对潇潇暮雨洒江天，一番洗清秋。"
  },
  {
   "t": 14.431,
   "d": 4.867,
   "s": "渐霜风凄紧，关河冷落，残照当楼。"
  },
  {
   "t": 19.518,
   "d": 4.2,
   "s": "是处红衰翠减，苒苒物华休。"
  },
  {
   "t": 23.938,
   "d": 3.45,
   "s": "惟有长江水，无语东流。"
  },
  {
   "t": 27.608,
   "d": 5.214,
   "s": "不忍登高临远，望故乡渺邈，归思难收。"
  },
  {
   "t": 33.042,
   "d": 3.714,
   "s": "叹年来踪迹，何事苦淹留？"
  },
  {
   "t": 36.976,
   "d": 4.603,
   "s": "想佳人妆楼颙望，误几回天际识归舟。"
  },
  {
   "t": 41.799,
   "d": 4.311,
   "s": "争知我，倚阑干处，正恁凝眸！"
  }
 ]
}