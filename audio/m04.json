   "s": "现代，余光中"
  },
  {
   "t": 4.156,
   "d": 9.533,
   "s": "小时候，\\n乡愁是一枚小小的邮票，\\n我在这头，\\n母亲在那头。"
  },
  {
   "t": 13.804,
   "d": 10.644,
   "s": "\\n长大后，\\n乡愁是一张窄窄的船票，\\n我在这头，\\n新娘在那头。"
  },
  {
   "t": 24.556,
   "d": 9.978,
   "s": "\\n后来啊，\\n乡愁是一方矮矮的坟墓，\\n我在外头，\\n母亲在里头。"
  },
  {
   "t": 34.636,
   "d": 10.575,
   "s": "\\n而现在，\\n乡愁是一湾浅浅的海峡，\\n我在这头，\\n大陆在那头。"
  }
 ]
