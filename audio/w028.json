 "bodyCues": 9,
 "v": "789130c7",
 "cues": [
  {
   "t": 0.1,
   "d": 1.603,
   "s": "杞人忧天"
  },
  {
   "t": 1.653,
   "d": 2.264,
   "s": "战国，列子"
  },
  {
   "t": 3.917,
   "d": 5.167,
   "s": "杞国有人忧天地崩坠，身亡所寄，废寝食者。"
  },
  {
   "t": 9.083,
   "d": 7.278,
   "s": "又有忧彼之所忧者，因往晓之，曰：天，积气耳，亡处亡气。"
  },
  {
   "t": 16.361,
   "d": 5.583,
   "s": "若屈伸呼吸，终日在天中行止，奈何忧崩坠乎？"
  },
  {
   "t": 21.944,
   "d": 5.042,
   "s": "其人曰：天果积气，日月星宿，不当坠耶？"
  },
  {
   "t": 26.986,
   "d": 7.917,
   "s": "晓之者曰：日月星宿，亦积气中之有光耀者，只使坠，亦不能有所中伤。"
  },
  {
   "t": 34.903,
   "d": 2.847,
   "s": "其人曰：奈地坏何？"
  },
  {
   "t": 37.75,
   "d": 5.583,
   "s": "晓者曰：地，积块耳，充塞四虚，亡处亡块。"
  },
  {
   "t": 43.333,
   "d": 5.264,
   "s": "若躇步跐蹈，终日在地上行止，奈何忧其坏？"
  },
  {
   "t": 48.597,
   "d": 4.458,
   "s": "其人舍然大喜，晓之者亦舍然大喜。"
  }
 ]
}