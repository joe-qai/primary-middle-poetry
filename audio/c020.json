{
 "id": "c020",
 "title": "后赤壁赋",
 "voice": "zh-CN-YunjianNeural",
 "rate": "-10%",
 "pitch": "+0Hz",
 "dur": 122.976,
 "hdr": 2,
 "bodyCues": 28,
 "v": "21804471",
 "cues": [
  {
   "t": 0.1,
   "d": 1.644,
   "s": "后赤壁赋"
  },
  {
   "t": 1.694,
   "d": 2.042,
   "s": "北宋，苏轼"
  },
  {
   "t": 3.736,
   "d": 4.667,
   "s": "是岁十月之望，步自雪堂，将归于临皋。"
  },
  {
   "t": 8.403,
   "d": 2.764,
   "s": "二客从予过黄泥之坂。"
  },
  {
   "t": 11.167,
   "d": 7.889,
   "s": "霜露既降，木叶尽脱，人影在地，仰见明月，顾而乐之，行歌相答。"
  },
  {
   "t": 19.056,
   "d": 7.097,
   "s": "已而叹曰：有客无酒，有酒无肴，月白风清，如此良夜何！"
  },
  {
   "t": 26.153,
   "d": 6.736,
   "s": "客曰：今者薄暮，举网得鱼，巨口细鳞，状如松江之鲈。"
  },
  {
   "t": 32.889,
   "d": 2.222,
   "s": "顾安所得酒乎？"
  },
  {
   "t": 35.111,
   "d": 1.778,
   "s": "归而谋诸妇。"
  },
  {
   "t": 36.889,
   "d": 5.694,
   "s": "妇曰：我有斗酒，藏之久矣，以待子不时之需。"
  },
  {
   "t": 42.583,
   "d": 3.833,
   "s": "于是携酒与鱼，复游于赤壁之下。"
  },
  {
   "t": 46.417,
   "d": 5.694,
   "s": "江流有声，断岸千尺；山高月小，水落石出。"
  },
  {
   "t": 52.111,
   "d": 4.194,
   "s": "曾日月之几何，而江山不可复识矣。"
  },
  {
   "t": 56.306,
   "d": 8.944,
   "s": "予乃摄衣而上，履巉岩，披蒙茸，踞虎豹，登虬龙，攀栖鹘之危巢，俯冯夷之幽宫。"
  },
  {
   "t": 65.25,
   "d": 2.292,
   "s": "盖二客不能从焉。"
  },
  {
   "t": 67.542,
   "d": 5.528,
   "s": "划然长啸，草木震动，山鸣谷应，风起水涌。"
  },
  {
   "t": 73.069,
   "d": 5.208,
   "s": "予亦悄然而悲，肃然而恐，凛乎其不可留也。"
  },
  {
   "t": 78.278,
   "d": 4.75,
   "s": "反而登舟，放乎中流，听其所止而休焉。"
  },
  {
   "t": 83.028,
   "d": 3.125,
   "s": "时夜将半，四顾寂寥。"
  },
  {
   "t": 86.153,
   "d": 2.972,
   "s": "适有孤鹤，横江东来。"
  },
  {
   "t": 89.125,
   "d": 5.986,
   "s": "翅如车轮，玄裳缟衣，戛然长鸣，掠予舟而西也。"
  },
  {
   "t": 95.111,
   "d": 2.569,
   "s": "须臾客去，予亦就睡。"
  },
  {
   "t": 97.681,
   "d": 7.153,
   "s": "梦一道士，羽衣蹁跹，过临皋之下，揖予而言曰：赤壁之游乐乎？"
  },
  {
   "t": 104.833,
   "d": 2.917,
   "s": "问其姓名，俯而不答。"
  },
  {
   "t": 107.75,
   "d": 1.583,
   "s": "呜呼！"
  },
  {
   "t": 109.333,
   "d": 1.25,
   "s": "噫嘻！"
  },
  {
   "t": 110.583,
   "d": 1.764,
   "s": "我知之矣。"
  },
  {
   "t": 112.347,
   "d": 4.653,
   "s": "畴昔之夜，飞鸣而过我者，非子也邪？"
  },
  {
   "t": 117.0,
   "d": 2.722,
   "s": "道士顾笑，予亦惊寤。"
  },
  {
   "t": 119.722,
   "d": 3.181,
   "s": "开户视之，不见其处。"
  }
 ]
}