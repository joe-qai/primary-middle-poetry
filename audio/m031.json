 "cues": [
  {
   "t": 0.1,
   "d": 2.047,
   "s": "沁园春，雪"
  },
  {
   "t": 2.097,
   "d": 2.681,
   "s": "现代，毛泽东"
  },
  {
   "t": 4.948,
   "d": 4.644,
   "s": "北国风光，千里冰封，万里雪飘。"
  },
  {
   "t": 9.7,
   "d": 6.047,
   "s": "望长城内外，惟余莽莽；大河上下，顿失滔滔。"
  },
  {
   "t": 15.868,
   "d": 5.2,
   "s": "山舞银蛇，原驰蜡象，欲与天公试比高。"
  },
  {
   "t": 21.172,
   "d": 4.867,
   "s": "须晴日，看红装素裹，分外妖娆。"
  },
  {
   "t": 26.14,
   "d": 4.617,
   "s": "江山如此多娇，引无数英雄竞折腰。"
  },
  {
   "t": 30.868,
   "d": 6.339,
   "s": "惜秦皇汉武，略输文采；唐宗宋祖，稍逊风骚。"
  },
  {
   "t": 37.324,
   "d": 5.131,
   "s": "一代天骄，成吉思汗，只识弯弓射大雕。"
  },
  {
   "t": 42.556,
   "d": 4.256,
   "s": "俱往矣，数风流人物，还看今朝。"
  }
 ]
}