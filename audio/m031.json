 "cues": [
  {
   "t": 0.1,
   "d": 2.047,
   "s": "沁园春，雪"
  },
  {
   "t": 2.097,
   "d": 2.347,
   "s": "现代，毛泽东"
  },
  {
   "t": 4.444,
   "d": 4.306,
   "s": "北国风光，千里冰封，万里雪飘。"
  },
  {
   "t": 8.75,
   "d": 5.708,
   "s": "望长城内外，惟余莽莽；大河上下，顿失滔滔。"
  },
  {
   "t": 14.458,
   "d": 4.861,
   "s": "山舞银蛇，原驰蜡象，欲与天公试比高。"
  },
  {
   "t": 19.319,
   "d": 4.528,
   "s": "须晴日，看红装素裹，分外妖娆。"
  },
  {
   "t": 23.847,
   "d": 4.278,
   "s": "江山如此多娇，引无数英雄竞折腰。"
  },
  {
   "t": 28.125,
   "d": 6.0,
   "s": "惜秦皇汉武，略输文采；唐宗宋祖，稍逊风骚。"
  },
  {
   "t": 34.125,
   "d": 4.792,
   "s": "一代天骄，成吉思汗，只识弯弓射大雕。"
  },
  {
   "t": 38.917,
   "d": 4.25,
   "s": "俱往矣，数风流人物，还看今朝。"
  }
 ]
}