 "cues": [
  {
   "t": 0.1,
   "d": 1.783,
   "s": "孙权劝学"
  },
  {
   "t": 1.833,
   "d": 3.306,
   "s": "宋代，司马光资治通鉴"
  },
  {
   "t": 5.139,
   "d": 5.722,
   "s": "初，权谓吕蒙曰：卿今当涂掌事，不可不学！"
  },
  {
   "t": 10.861,
   "d": 2.375,
   "s": "蒙辞以军中多务。"
  },
  {
   "t": 13.236,
   "d": 4.0,
   "s": "权曰：孤岂欲卿治经为博士邪！"
  },
  {
   "t": 17.236,
   "d": 3.014,
   "s": "但当涉猎，见往事耳。"
  },
  {
   "t": 20.25,
   "d": 2.819,
   "s": "卿言多务，孰若孤？"
  },
  {
   "t": 23.069,
   "d": 3.208,
   "s": "孤常读书，自以为大有所益。"
  },
  {
   "t": 26.278,
   "d": 1.917,
   "s": "蒙乃始就学。"
  },
  {
   "t": 28.194,
   "d": 7.347,
   "s": "及鲁肃过寻阳，与蒙论议，大惊曰：卿今者才略，非复吴下阿蒙！"
  },
  {
   "t": 35.542,
   "d": 6.431,
   "s": "蒙曰：士别三日，即更刮目相待，大兄何见事之晚乎！"
  },
  {
   "t": 41.972,
   "d": 3.694,
   "s": "肃遂拜蒙母，结友而别。"
  }
 ]
}