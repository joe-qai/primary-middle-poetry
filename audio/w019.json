{
 "id": "w019",
 "title": "曹刿论战",
 "voice": "zh-CN-YunjianNeural",
 "rate": "-10%",
 "dur": 90.083,
 "hdr": 2,
 "bodyCues": 30,
 "v": "6cc59aa6",
 "cues": [
  {
   "t": 0.1,
   "d": 1.644,
   "s": "曹刿论战"
  },
  {
   "t": 1.694,
   "d": 2.861,
   "s": "春秋，左丘明左传"
  },
  {
   "t": 4.556,
   "d": 2.667,
   "s": "十年春，齐师伐我。"
  },
  {
   "t": 7.222,
   "d": 2.819,
   "s": "公将战，曹刿请见。"
  },
  {
   "t": 10.042,
   "d": 4.653,
   "s": "其乡人曰：肉食者谋之，又何间焉？"
  },
  {
   "t": 14.694,
   "d": 3.792,
   "s": "刿曰：肉食者鄙，未能远谋。"
  },
  {
   "t": 18.486,
   "d": 1.472,
   "s": "乃入见。"
  },
  {
   "t": 19.958,
   "d": 2.125,
   "s": "问：何以战？"
  },
  {
   "t": 22.083,
   "d": 4.625,
   "s": "公曰：衣食所安，弗敢专也，必以分人。"
  },
  {
   "t": 26.708,
   "d": 3.792,
   "s": "对曰：小惠未遍，民弗从也。"
  },
  {
   "t": 30.5,
   "d": 4.417,
   "s": "公曰：牺牲玉帛，弗敢加也，必以信。"
  },
  {
   "t": 34.917,
   "d": 3.764,
   "s": "对曰：小信未孚，神弗福也。"
  },
  {
   "t": 38.681,
   "d": 4.5,
   "s": "公曰：小大之狱，虽不能察，必以情。"
  },
  {
   "t": 43.181,
   "d": 2.431,
   "s": "对曰：忠之属也。"
  },
  {
   "t": 45.611,
   "d": 1.556,
   "s": "可以一战。"
  },
  {
   "t": 47.167,
   "d": 1.722,
   "s": "战则请从。"
  },
  {
   "t": 48.889,
   "d": 2.903,
   "s": "公与之乘，战于长勺。"
  },
  {
   "t": 51.792,
   "d": 1.722,
   "s": "公将鼓之。"
  },
  {
   "t": 53.514,
   "d": 1.847,
   "s": "刿曰：未可。"
  },
  {
   "t": 55.361,
   "d": 1.694,
   "s": "齐人三鼓。"
  },
  {
   "t": 57.056,
   "d": 1.736,
   "s": "刿曰：可矣。"
  },
  {
   "t": 58.792,
   "d": 1.681,
   "s": "齐师败绩。"
  },
  {
   "t": 60.472,
   "d": 1.694,
   "s": "公将驰之。"
  },
  {
   "t": 62.167,
   "d": 1.847,
   "s": "刿曰：未可。"
  },
  {
   "t": 64.014,
   "d": 4.736,
   "s": "下视其辙，登轼而望之，曰：可矣。"
  },
  {
   "t": 68.75,
   "d": 1.583,
   "s": "遂逐齐师。"
  },
  {
   "t": 70.333,
   "d": 2.319,
   "s": "既克，公问其故。"
  },
  {
   "t": 72.653,
   "d": 3.083,
   "s": "对曰：夫战，勇气也。"
  },
  {
   "t": 75.736,
   "d": 3.667,
   "s": "一鼓作气，再而衰，三而竭。"
  },
  {
   "t": 79.403,
   "d": 2.389,
   "s": "彼竭我盈，故克之。"
  },
  {
   "t": 81.792,
   "d": 3.819,
   "s": "夫大国，难测也，惧有伏焉。"
  },
  {
   "t": 85.611,
   "d": 4.472,
   "s": "吾视其辙乱，望其旗靡，故逐之。"
  }
 ]
}