  {
   "t": 0.1,
   "d": 1.644,
   "s": "虽有嘉肴"
  },
  {
   "t": 1.694,
   "d": 2.694,
   "s": "西汉，礼记，学记"
  },
  {
   "t": 4.389,
   "d": 6.944,
   "s": "虽有嘉肴，弗食，不知其旨也；虽有至道，弗学，不知其善也。"
  },
  {
   "t": 11.333,
   "d": 4.056,
   "s": "是故学然后知不足，教然后知困。"
  },
  {
   "t": 15.389,
   "d": 5.819,
   "s": "知不足，然后能自反也；知困，然后能自强也。"
  },
  {
   "t": 21.208,
   "d": 2.75,
   "s": "故曰：教学相长也。"
  },
  {
   "t": 23.958,
   "d": 4.125,
   "s": "兑命曰学学半，其此之谓乎！"
  }
 ]
}