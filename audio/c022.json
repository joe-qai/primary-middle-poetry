{
 "id": "c022",
 "title": "游褒禅山记",
 "voice": "zh-CN-YunjianNeural",
 "rate": "-10%",
 "pitch": "+0Hz",
 "dur": 162.597,
 "hdr": 2,
 "bodyCues": 26,
 "v": "1700ca3d",
 "cues": [
  {
   "t": 0.1,
   "d": 1.853,
   "s": "游褒禅山记"
  },
  {
   "t": 1.903,
   "d": 2.111,
   "s": "北宋，王安石"
  },
  {
   "t": 4.014,
   "d": 8.708,
   "s": "褒禅山亦谓之华山，唐浮图慧褒始舍于其址，而卒葬之；以故其后名之曰褒禅。"
  },
  {
   "t": 12.722,
   "d": 4.25,
   "s": "今所谓慧空禅院者，褒之庐冢也。"
  },
  {
   "t": 16.972,
   "d": 6.278,
   "s": "距其院东五里，所谓华山洞者，以其乃华山之阳名之也。"
  },
  {
   "t": 23.25,
   "d": 6.847,
   "s": "距洞百余步，有碑仆道，其文漫灭，独其为文犹可识，曰花山。"
  },
  {
   "t": 30.097,
   "d": 4.083,
   "s": "今言华如华实之华者，盖音谬也。"
  },
  {
   "t": 34.181,
   "d": 6.222,
   "s": "其下平旷，有泉侧出，而记游者甚众，所谓前洞也。"
  },
  {
   "t": 40.403,
   "d": 9.194,
   "s": "由山以上五六里，有穴窈然，入之甚寒，问其深，则其好游者不能穷也，谓之后洞。"
  },
  {
   "t": 49.597,
   "d": 6.208,
   "s": "余与四人拥火以入，入之愈深，其进愈难，而其见愈奇。"
  },
  {
   "t": 55.806,
   "d": 4.389,
   "s": "有怠而欲出者，曰：不出，火且尽。"
  },
  {
   "t": 60.194,
   "d": 1.736,
   "s": "遂与之俱出。"
  },
  {
   "t": 61.931,
   "d": 6.583,
   "s": "盖余所至，比好游者尚不能十一，然视其左右，来而记之者已少。"
  },
  {
   "t": 68.514,
   "d": 3.556,
   "s": "盖其又深，则其至又加少矣。"
  },
  {
   "t": 72.069,
   "d": 4.819,
   "s": "方是时，余之力尚足以入，火尚足以明也。"
  },
  {
   "t": 76.889,
   "d": 7.486,
   "s": "既其出，则或咎其欲出者，而余亦悔其随之，而不得极夫游之乐也。"
  },
  {
   "t": 84.375,
   "d": 1.986,
   "s": "于是余有叹焉。"
  },
  {
   "t": 86.361,
   "d": 9.681,
   "s": "古人之观于天地、山川、草木、虫鱼、鸟兽，往往有得，以其求思之深，而无不在也。"
  },
  {
   "t": 96.042,
   "d": 4.958,
   "s": "夫夷以近，则游者众；险以远，则至者少。"
  },
  {
   "t": 101.0,
   "d": 9.569,
   "s": "而世之奇伟、瑰怪，非常之观，常在于险远，而人之所罕至焉，故非有志者不能至也。"
  },
  {
   "t": 110.569,
   "d": 5.611,
   "s": "有志矣，不随以止也，然力不足者，亦不能至也。"
  },
  {
   "t": 116.181,
   "d": 8.139,
   "s": "有志与力，而又不随以怠，至于幽暗昏惑，而无物以相之，亦不能至也。"
  },
  {
   "t": 124.319,
   "d": 10.278,
   "s": "然力足以至焉，于人为可讥，而在己为有悔；尽吾志也而不能至者，可以无悔矣，其孰能讥之乎？"
  },
  {
   "t": 134.597,
   "d": 2.208,
   "s": "此余之所得也。"
  },
  {
   "t": 136.806,
   "d": 8.5,
   "s": "余于仆碑，又以悲夫古书之不存，后世之谬其传，而莫能名者，何可胜道也哉！"
  },
  {
   "t": 145.306,
   "d": 4.736,
   "s": "此所以学者不可以不深思，而慎取之也。"
  },
  {
   "t": 150.042,
   "d": 8.056,
   "s": "四人者：庐陵萧君圭君玉，长乐王回深父，余弟安国平父、安上纯父。"
  },
  {
   "t": 158.097,
   "d": 4.5,
   "s": "至和元年七月某日，临川王某记。"
  }
 ]
}