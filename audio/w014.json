 "cues": [
  {
   "t": 0.1,
   "d": 1.436,
   "s": "卖油翁"
  },
  {
   "t": 1.486,
   "d": 2.139,
   "s": "宋代，欧阳修"
  },
  {
   "t": 3.625,
   "d": 4.944,
   "s": "陈康肃公善射，当世无双，公亦以此自矜。"
  },
  {
   "t": 8.569,
   "d": 6.306,
   "s": "尝射于家圃，有卖油翁释担，而立，睨之久而不去。"
  },
  {
   "t": 14.875,
   "d": 4.056,
   "s": "见其发矢十中八九，但微颔之。"
  },
  {
   "t": 18.931,
   "d": 3.222,
   "s": "康肃问曰：汝亦知射乎？"
  },
  {
   "t": 22.153,
   "d": 2.194,
   "s": "吾射不亦精乎？"
  },
  {
   "t": 24.347,
   "d": 3.389,
   "s": "翁曰：无他，但手熟尔。"
  },
  {
   "t": 27.736,
   "d": 3.875,
   "s": "康肃忿然曰：尔安敢轻吾射！"
  },
  {
   "t": 31.611,
   "d": 2.986,
   "s": "翁曰：以我酌油知之。"
  },
  {
   "t": 34.597,
   "d": 8.153,
   "s": "乃取一葫芦置于地，以钱覆其口，徐以杓酌油沥之，自钱孔入，而钱不湿。"
  },
  {
   "t": 42.75,
   "d": 3.847,
   "s": "因曰：我亦无他，惟手熟尔。"
  },
  {
   "t": 46.597,
   "d": 2.667,
   "s": "康肃笑而遣之。"
  }
 ]
}