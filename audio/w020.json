 "cues": [
  {
   "t": 0.1,
   "d": 2.019,
   "s": "湖心亭看雪"
  },
  {
   "t": 2.069,
   "d": 2.125,
   "s": "明代，张岱"
  },
  {
   "t": 4.194,
   "d": 3.486,
   "s": "崇祯五年十二月，余住西湖。"
  },
  {
   "t": 7.681,
   "d": 3.958,
   "s": "大雪三日，湖中人鸟声俱绝。"
  },
  {
   "t": 11.639,
   "d": 6.764,
   "s": "是日更定矣，余挐一小舟，拥毳衣炉火，独往湖心亭看雪。"
  },
  {
   "t": 18.403,
   "d": 4.528,
   "s": "雾凇沆砀，天与云与山与水，上下一白。"
  },
  {
   "t": 22.931,
   "d": 8.153,
   "s": "湖上影子，惟长堤一痕、湖心亭一点、与余舟一芥、舟中人两三粒，而已。"
  },
  {
   "t": 31.083,
   "d": 5.056,
   "s": "到亭上，有两人铺毡对坐，一童子烧酒炉正沸。"
  },
  {
   "t": 36.139,
   "d": 4.083,
   "s": "见余大喜曰：湖中焉得更有此人！"
  },
  {
   "t": 40.222,
   "d": 1.639,
   "s": "拉余同饮。"
  },
  {
   "t": 41.861,
   "d": 2.903,
   "s": "余强饮三大白，而别。"
  },
  {
   "t": 44.764,
   "d": 3.653,
   "s": "问其姓氏，是金陵人，客此。"
  },
  {
   "t": 48.417,
   "d": 6.833,
   "s": "及下船，舟子喃喃曰：莫说相公痴，更有痴似相公者。"
  }
 ]
}