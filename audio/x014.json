 "hdr": 2,
 "bodyCues": 49,
 "v": "472e1932",
 "cues": [
  {
   "t": 0.1,
   "d": 1.756,
   "s": "归去来兮辞"
  },
  {
   "t": 1.806,
   "d": 2.736,
   "s": "东晋，陶渊明"
  },
  {
   "t": 4.708,
   "d": 3.519,
   "s": "余家贫，耕植不足以自给。"
  },
  {
   "t": 8.332,
   "d": 5.631,
   "s": "幼稚盈室，瓶无储粟，生生所资，未见其术。"
  },
  {
   "t": 14.068,
   "d": 5.283,
   "s": "亲故多劝余为长吏，脱然有怀，求之靡途。"
  },
  {
   "t": 19.468,
   "d": 7.242,
   "s": "会有四方之事，诸侯以惠爱为德，家叔以余贫苦，遂见用于小邑。"
  },
  {
   "t": 26.812,
   "d": 7.158,
   "s": "于时风波未静，心惮远役，彭泽去家百里，公田之利，足以为酒。"
  },
  {
   "t": 34.084,
   "d": 1.95,
   "s": "故便求之。"
  },
  {
   "t": 36.148,
   "d": 3.728,
   "s": "及少日，眷然有归欤之情。"
  },
  {
   "t": 39.988,
   "d": 1.742,
   "s": "何则？"
  },
  {
   "t": 41.836,
   "d": 3.506,
   "s": "质性自然，非矫厉所得。"
  },
  {
   "t": 45.46,
   "d": 3.131,
   "s": "饥冻虽切，违己交病。"
  },
  {
   "t": 48.7,
   "d": 3.631,
   "s": "尝从人事，皆口腹自役。"
  },
  {
   "t": 52.444,
   "d": 4.242,
   "s": "于是怅然慷慨，深愧平生之志。"
  },
  {
   "t": 56.788,
   "d": 3.575,
   "s": "犹望一稔，当敛裳宵逝。"
  },
  {
   "t": 60.484,
   "d": 5.464,
   "s": "寻程氏妹丧于武昌，情在骏奔，自免去职。"
  },
  {
   "t": 66.052,
   "d": 3.658,
   "s": "仲秋至冬，在官八十余日。"
  },
  {
   "t": 69.82,
   "d": 3.964,
   "s": "因事顺心，命篇曰归去来兮。"
  },
  {
   "t": 73.9,
   "d": 2.533,
   "s": "乙巳岁十一月也。"
  },
  {
   "t": 76.54,
   "d": 3.936,
   "s": "归去来兮，田园将芜胡不归？"
  },
  {
   "t": 80.596,
   "d": 4.268,
   "s": "既自以心为形役，奚惆怅而独悲？"
  },
  {
   "t": 84.964,
   "d": 3.783,
   "s": "悟已往之不谏，知来者之可追。"
  },
  {
   "t": 88.852,
   "d": 4.075,
   "s": "实迷途其未远，觉今是而昨非。"
  },
  {
   "t": 93.028,
   "d": 4.2,
   "s": "舟遥遥以轻飏，风飘飘而吹衣。"
  },
  {
   "t": 97.348,
   "d": 4.268,
   "s": "问征夫以前路，恨晨光之熹微。"
  },
  {
   "t": 101.716,
   "d": 3.283,
   "s": "乃瞻衡宇，载欣载奔。"
  },
  {
   "t": 105.1,
   "d": 3.436,
   "s": "僮仆欢迎，稚子候门。"
  },
  {
   "t": 108.652,
   "d": 3.394,
   "s": "三径就荒，松菊犹存。"
  },
  {
   "t": 112.156,
   "d": 3.492,
   "s": "携幼入室，有酒盈樽。"
  },
  {
   "t": 115.756,
   "d": 3.95,
   "s": "引壶觞以自酌，眄庭柯以怡颜。"
  },
  {
   "t": 119.812,
   "d": 3.964,
   "s": "倚南窗以寄傲，审容膝之易安。"
  },
  {
   "t": 123.892,
   "d": 4.325,
   "s": "园日涉以成趣，门虽设而常关。"
  },
  {
   "t": 128.332,
   "d": 4.004,
   "s": "策扶老以流憩，时矫首而遐观。"
  },
  {
   "t": 132.436,
   "d": 4.214,
   "s": "云无心以出岫，鸟倦飞而知还。"
  },
  {
   "t": 136.756,
   "d": 4.004,
   "s": "景翳翳以将入，抚孤松而盘桓。"
  },
  {
   "t": 140.86,
   "d": 3.45,
   "s": "归去来兮，请息交以绝游。"
  },
  {
   "t": 144.412,
   "d": 4.228,
   "s": "世与我而相违，复驾言兮焉求？"
  },
  {
   "t": 148.756,
   "d": 4.186,
   "s": "悦亲戚之情话，乐琴书以消忧。"
  },
  {
   "t": 153.052,
   "d": 4.381,
   "s": "农人告余以春及，将有事于西畴。"
  },
  {
   "t": 157.54,
   "d": 3.311,
   "s": "或命巾车，或棹孤舟。"
  },
  {
   "t": 160.972,
   "d": 4.033,
   "s": "既窈窕以寻壑，亦崎岖而经丘。"
  },
  {
   "t": 165.124,
   "d": 4.367,
   "s": "木欣欣以向荣，泉涓涓而始流。"
  },
  {
   "t": 169.612,
   "d": 4.242,
   "s": "善万物之得时，感吾生之行休。"
  },
  {
   "t": 173.956,
   "d": 1.922,
   "s": "已矣乎！"
  },
  {
   "t": 175.996,
   "d": 2.686,
   "s": "寓形宇内复几时？"
  },
  {
   "t": 178.804,
   "d": 2.617,
   "s": "曷不委心任去留？"
  },
  {
   "t": 181.54,
   "d": 3.228,
   "s": "胡为乎遑遑欲何之？"
  },
  {
   "t": 184.876,
   "d": 3.783,
   "s": "富贵非吾愿，帝乡不可期。"
  },
  {
   "t": 188.764,
   "d": 4.214,
   "s": "怀良辰以孤往，或植杖而耘耔。"
  },
  {
   "t": 193.084,
   "d": 4.089,
   "s": "登东皋以舒啸，临清流而赋诗。"
  },
  {
   "t": 197.284,
   "d": 4.339,
   "s": "聊乘化以归尽，乐夫天命复奚疑！"
  }
 ]
}