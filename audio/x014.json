 "v": "05c4e640",
 "cues": [
  {
   "t": 0.1,
   "d": 1.756,
   "s": "归去来兮辞"
  },
  {
   "t": 1.806,
   "d": 2.403,
   "s": "东晋，陶渊明"
  },
  {
   "t": 4.208,
   "d": 3.181,
   "s": "余家贫，耕植不足以自给。"
  },
  {
   "t": 7.389,
   "d": 5.292,
   "s": "幼稚盈室，瓶无储粟，生生所资，未见其术。"
  },
  {
   "t": 12.681,
   "d": 4.944,
   "s": "亲故多劝余为长吏，脱然有怀，求之靡途。"
  },
  {
   "t": 17.625,
   "d": 6.903,
   "s": "会有四方之事，诸侯以惠爱为德，家叔以余贫苦，遂见用于小邑。"
  },
  {
   "t": 24.528,
   "d": 6.819,
   "s": "于时风波未静，心惮远役，彭泽去家百里，公田之利，足以为酒。"
  },
  {
   "t": 31.347,
   "d": 1.611,
   "s": "故便求之。"
  },
  {
   "t": 32.958,
   "d": 3.389,
   "s": "及少日，眷然有归欤之情。"
  },
  {
   "t": 36.347,
   "d": 1.403,
   "s": "何则？"
  },
  {
   "t": 37.75,
   "d": 3.167,
   "s": "质性自然，非矫厉所得。"
  },
  {
   "t": 40.917,
   "d": 2.792,
   "s": "饥冻虽切，违己交病。"
  },
  {
   "t": 43.708,
   "d": 3.292,
   "s": "尝从人事，皆口腹自役。"
  },
  {
   "t": 47.0,
   "d": 3.903,
   "s": "于是怅然慷慨，深愧平生之志。"
  },
  {
   "t": 50.903,
   "d": 3.236,
   "s": "犹望一稔，当敛裳宵逝。"
  },
  {
   "t": 54.139,
   "d": 5.125,
   "s": "寻程氏妹丧于武昌，情在骏奔，自免去职。"
  },
  {
   "t": 59.264,
   "d": 3.319,
   "s": "仲秋至冬，在官八十余日。"
  },
  {
   "t": 62.583,
   "d": 3.625,
   "s": "因事顺心，命篇曰归去来兮。"
  },
  {
   "t": 66.208,
   "d": 2.194,
   "s": "乙巳岁十一月也。"
  },
  {
   "t": 68.403,
   "d": 3.597,
   "s": "归去来兮，田园将芜胡不归？"
  },
  {
   "t": 72.0,
   "d": 3.931,
   "s": "既自以心为形役，奚惆怅而独悲？"
  },
  {
   "t": 75.931,
   "d": 3.444,
   "s": "悟已往之不谏，知来者之可追。"
  },
  {
   "t": 79.375,
   "d": 3.736,
   "s": "实迷途其未远，觉今是而昨非。"
  },
  {
   "t": 83.111,
   "d": 3.861,
   "s": "舟遥遥以轻飏，风飘飘而吹衣。"
  },
  {
   "t": 86.972,
   "d": 3.931,
   "s": "问征夫以前路，恨晨光之熹微。"
  },
  {
   "t": 90.903,
   "d": 2.944,
   "s": "乃瞻衡宇，载欣载奔。"
  },
  {
   "t": 93.847,
   "d": 3.097,
   "s": "僮仆欢迎，稚子候门。"
  },
  {
   "t": 96.944,
   "d": 3.056,
   "s": "三径就荒，松菊犹存。"
  },
  {
   "t": 100.0,
   "d": 3.153,
   "s": "携幼入室，有酒盈樽。"
  },
  {
   "t": 103.153,
   "d": 3.611,
   "s": "引壶觞以自酌，眄庭柯以怡颜。"
  },
  {
   "t": 106.764,
   "d": 3.625,
   "s": "倚南窗以寄傲，审容膝之易安。"
  },
  {
   "t": 110.389,
   "d": 3.986,
   "s": "园日涉以成趣，门虽设而常关。"
  },
  {
   "t": 114.375,
   "d": 3.667,
   "s": "策扶老以流憩，时矫首而遐观。"
  },
  {
   "t": 118.042,
   "d": 3.875,
   "s": "云无心以出岫，鸟倦飞而知还。"
  },
  {
   "t": 121.917,
   "d": 3.667,
   "s": "景翳翳以将入，抚孤松而盘桓。"
  },
  {
   "t": 125.583,
   "d": 3.111,
   "s": "归去来兮，请息交以绝游。"
  },
  {
   "t": 128.694,
   "d": 3.889,
   "s": "世与我而相违，复驾言兮焉求？"
  },
  {
   "t": 132.583,
   "d": 3.847,
   "s": "悦亲戚之情话，乐琴书以消忧。"
  },
  {
   "t": 136.431,
   "d": 4.042,
   "s": "农人告余以春及，将有事于西畴。"
  },
  {
   "t": 140.472,
   "d": 2.972,
   "s": "或命巾车，或棹孤舟。"
  },
  {
   "t": 143.444,
   "d": 3.694,
   "s": "既窈窕以寻壑，亦崎岖而经丘。"
  },
  {
   "t": 147.139,
   "d": 4.028,
   "s": "木欣欣以向荣，泉涓涓而始流。"
  },
  {
   "t": 151.167,
   "d": 3.903,
   "s": "善万物之得时，感吾生之行休。"
  },
  {
   "t": 155.069,
   "d": 1.583,
   "s": "已矣乎！"
  },
  {
   "t": 156.653,
   "d": 2.347,
   "s": "寓形宇内复几时？"
  },
  {
   "t": 159.0,
   "d": 2.278,
   "s": "曷不委心任去留？"
  },
  {
   "t": 161.278,
   "d": 2.889,
   "s": "胡为乎遑遑欲何之？"
  },
  {
   "t": 164.167,
   "d": 3.444,
   "s": "富贵非吾愿，帝乡不可期。"
  },
  {
   "t": 167.611,
   "d": 3.875,
   "s": "怀良辰以孤往，或植杖而耘耔。"
  },
  {
   "t": 171.486,
   "d": 3.75,
   "s": "登东皋以舒啸，临清流而赋诗。"
  },
  {
   "t": 175.236,
   "d": 4.333,
   "s": "聊乘化以归尽，乐夫天命复奚疑！"
  }
 ]
}