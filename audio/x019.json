{
 "id": "x019",
 "title": "逍遥游",
 "voice": "zh-CN-YunjianNeural",
 "rate": "-10%",
 "pitch": "+0Hz",
 "dur": 504.72,
 "hdr": 2,
 "bodyCues": 88,
 "v": "76d9f5f0",
 "cues": [
  {
   "t": 0.1,
   "d": 1.339,
   "s": "逍遥游"
  },
  {
   "t": 1.389,
   "d": 2.444,
   "s": "战国，庄子"
  },
  {
   "t": 3.988,
   "d": 3.089,
   "s": "北冥有鱼，其名为鲲。"
  },
  {
   "t": 7.18,
   "d": 6.367,
   "s": "鲲之大，不知其几千里也；化而为鸟，其名为鹏。"
  },
  {
   "t": 13.66,
   "d": 6.936,
   "s": "鹏之背，不知其几千里也；怒而飞，其翼若垂天之云。"
  },
  {
   "t": 20.716,
   "d": 4.004,
   "s": "是鸟也，海运则将徙于南冥。"
  },
  {
   "t": 24.82,
   "d": 2.797,
   "s": "南冥者，天池也。"
  },
  {
   "t": 27.724,
   "d": 3.103,
   "s": "齐谐者，志怪者也。"
  },
  {
   "t": 30.94,
   "d": 9.394,
   "s": "谐之言曰：鹏之徙于南冥也，水击三千里，抟扶摇而上者九万里，去以六月息者也。"
  },
  {
   "t": 40.444,
   "d": 4.853,
   "s": "野马也，尘埃也，生物之以息相吹也。"
  },
  {
   "t": 45.412,
   "d": 3.367,
   "s": "天之苍苍，其正色邪？"
  },
  {
   "t": 48.892,
   "d": 2.881,
   "s": "其远而无所至极邪？"
  },
  {
   "t": 51.892,
   "d": 3.894,
   "s": "其视下也，亦若是则已矣。"
  },
  {
   "t": 55.9,
   "d": 4.575,
   "s": "且夫水之积也不厚，则其负大舟也无力。"
  },
  {
   "t": 60.58,
   "d": 7.658,
   "s": "覆杯水于坳堂之上，则芥为之舟；置杯焉则胶，水浅而舟大也。"
  },
  {
   "t": 68.356,
   "d": 4.256,
   "s": "风之积也不厚，则其负大翼也无力。"
  },
  {
   "t": 72.724,
   "d": 10.186,
   "s": "故九万里，则风斯在下矣，而后乃今培风；背负青天，而莫之夭阏者，而后乃今将图南。"
  },
  {
   "t": 83.02,
   "d": 11.172,
   "s": "蜩与学鸠笑之曰：我决起而飞，抢榆枋而止，时则不至，而控于地而已矣，奚以之九万里，而南为？"
  },
  {
   "t": 94.3,
   "d": 9.408,
   "s": "适莽苍者，三餐而反，腹犹果然；适百里者，宿舂粮；适千里者，三月聚粮。"
  },
  {
   "t": 103.828,
   "d": 2.506,
   "s": "之二虫又何知！"
  },
  {
   "t": 106.444,
   "d": 4.004,
   "s": "小知不及大知，小年不及大年。"
  },
  {
   "t": 110.548,
   "d": 2.547,
   "s": "奚以知其然也？"
  },
  {
   "t": 113.212,
   "d": 5.2,
   "s": "朝菌不知晦朔，蟪蛄不知春秋，此小年也。"
  },
  {
   "t": 118.516,
   "d": 11.297,
   "s": "楚之南有冥灵者，以五百岁为春，五百岁为秋；上古有大椿者，以八千岁为春，八千岁为秋，此大年也。"
  },
  {
   "t": 129.916,
   "d": 5.422,
   "s": "而彭祖乃今以久特闻，众人匹之，不亦悲乎！"
  },
  {
   "t": 135.46,
   "d": 2.617,
   "s": "汤之问棘也是已。"
  },
  {
   "t": 138.196,
   "d": 4.45,
   "s": "穷发之北，有冥海者，天池也。"
  },
  {
   "t": 142.756,
   "d": 6.047,
   "s": "有鱼焉，其广数千里，未有知其修者，其名为鲲。"
  },
  {
   "t": 148.924,
   "d": 13.353,
   "s": "有鸟焉，其名为鹏，背若泰山，翼若垂天之云，抟扶摇羊角而上者九万里，绝云气，负青天，然后图南，且适南冥也。"
  },
  {
   "t": 162.388,
   "d": 4.061,
   "s": "斥鴳笑之曰：彼且奚适也？"
  },
  {
   "t": 166.564,
   "d": 7.047,
   "s": "我腾跃而上，不过数仞而下，翱翔蓬蒿之间，此亦飞之至也。"
  },
  {
   "t": 173.716,
   "d": 2.603,
   "s": "而彼且奚适也？"
  },
  {
   "t": 176.428,
   "d": 2.547,
   "s": "此小大之辩也。"
  },
  {
   "t": 179.092,
   "d": 8.7,
   "s": "故夫知效一官，行比一乡，德合一君，而征一国者，其自视也，亦若此矣。"
  },
  {
   "t": 187.9,
   "d": 2.881,
   "s": "而宋荣子犹然笑之。"
  },
  {
   "t": 190.9,
   "d": 9.478,
   "s": "且举世誉之而不加劝，举世非之而不加沮，定乎内外之分，辩乎荣辱之境，斯已矣。"
  },
  {
   "t": 200.5,
   "d": 3.478,
   "s": "彼其于世，未数数然也。"
  },
  {
   "t": 204.1,
   "d": 2.922,
   "s": "虽然，犹有未树也。"
  },
  {
   "t": 207.124,
   "d": 6.061,
   "s": "夫列子御风而行，泠然善也，旬有五日而后反。"
  },
  {
   "t": 213.292,
   "d": 3.644,
   "s": "彼于致福者，未数数然也。"
  },
  {
   "t": 217.036,
   "d": 3.95,
   "s": "此虽免乎行，犹有所待者也。"
  },
  {
   "t": 221.092,
   "d": 7.297,
   "s": "若夫乘天地之正，而御六气之辩，以游无穷者，彼且恶乎待哉？"
  },
  {
   "t": 228.508,
   "d": 5.324,
   "s": "故曰：至人无己，神人无功，圣人无名。"
  },
  {
   "t": 233.932,
   "d": 8.464,
   "s": "尧让天下于许由，曰：日月出矣，而爝火不息，其于光也，不亦难乎！"
  },
  {
   "t": 242.5,
   "d": 5.631,
   "s": "时雨降矣，而犹浸灌，其于泽也，不亦劳乎！"
  },
  {
   "t": 248.236,
   "d": 6.075,
   "s": "夫子立而天下治，而我犹尸之，吾自视缺然。"
  },
  {
   "t": 254.428,
   "d": 2.033,
   "s": "请致天下。"
  },
  {
   "t": 256.564,
   "d": 7.7,
   "s": "许由曰：子治天下，天下既已治也，而我犹代子，吾将为名乎？"
  },
  {
   "t": 264.364,
   "d": 4.408,
   "s": "名者，实之宾也，吾将为宾乎？"
  },
  {
   "t": 268.876,
   "d": 5.964,
   "s": "鹪鹩巢于深林，不过一枝；偃鼠饮河，不过满腹。"
  },
  {
   "t": 274.948,
   "d": 4.006,
   "s": "归休乎君，予无所用天下为！"
  },
  {
   "t": 279.076,
   "d": 5.408,
   "s": "庖人虽不治庖，尸祝不越樽俎，而代之矣。"
  },
  {
   "t": 284.596,
   "d": 6.575,
   "s": "肩吾问于连叔曰：吾闻言于接舆，大而无当，往而不反。"
  },
  {
   "t": 291.292,
   "d": 6.853,
   "s": "吾惊怖其言，犹河汉而无极也；大有径庭，不近人情焉。"
  },
  {
   "t": 298.252,
   "d": 3.2,
   "s": "连叔曰：其言谓何哉？"
  },
  {
   "t": 301.564,
   "d": 13.256,
   "s": "曰：藐姑射之山，有神人居焉，肌肤若冰雪，淖约若处子；不食五谷，吸风饮露；乘云气，御飞龙，而游乎四海之外。"
  },
  {
   "t": 314.932,
   "d": 4.381,
   "s": "其神凝，使物不疵疠而年谷熟。"
  },
  {
   "t": 319.42,
   "d": 2.894,
   "s": "吾以是狂而不信也。"
  },
  {
   "t": 322.42,
   "d": 7.325,
   "s": "连叔曰：然，瞽者无以与乎文章之观，聋者无以与乎钟鼓之声。"
  },
  {
   "t": 329.86,
   "d": 2.839,
   "s": "岂唯形骸有聋盲哉？"
  },
  {
   "t": 332.812,
   "d": 2.242,
   "s": "夫知亦有之。"
  },
  {
   "t": 335.164,
   "d": 3.228,
   "s": "是其言也，犹时女也。"
  },
  {
   "t": 338.5,
   "d": 8.506,
   "s": "之人也，之德也，将旁礴万物以为一，世蕲乎乱，孰弊弊焉以天下为事！"
  },
  {
   "t": 347.116,
   "d": 7.811,
   "s": "之人也，物莫之伤，大浸稽天而不溺，大旱金石流、土山焦而不热。"
  },
  {
   "t": 355.036,
   "d": 6.339,
   "s": "是其尘垢秕糠，将犹陶铸尧舜者也，孰肯以物为事！"
  },
  {
   "t": 361.492,
   "d": 6.019,
   "s": "宋人资章甫而适诸越，越人断发文身，无所用之。"
  },
  {
   "t": 367.636,
   "d": 9.45,
   "s": "尧治天下之民，平海内之政，往见四子藐姑射之山，汾水之阳，窅然丧其天下焉。"
  },
  {
   "t": 377.188,
   "d": 6.769,
   "s": "惠子谓庄子曰：魏王贻我大瓠之种，我树之成而实五石。"
  },
  {
   "t": 384.076,
   "d": 3.867,
   "s": "以盛水浆，其坚不能自举也。"
  },
  {
   "t": 388.06,
   "d": 3.881,
   "s": "剖之以为瓢，则瓠落无所容。"
  },
  {
   "t": 392.044,
   "d": 4.769,
   "s": "非不呺然大也，吾为其无用而掊之。"
  },
  {
   "t": 396.916,
   "d": 4.033,
   "s": "庄子曰：夫子固拙于用大矣。"
  },
  {
   "t": 401.068,
   "d": 5.533,
   "s": "宋人有善为不龟手之药者，世世以洴澼絖为事。"
  },
  {
   "t": 406.708,
   "d": 3.367,
   "s": "客闻之，请买其方百金。"
  },
  {
   "t": 410.188,
   "d": 8.269,
   "s": "聚族而谋曰：我世世为洴澼絖，不过数金；今一朝而鬻技百金，请与之。"
  },
  {
   "t": 418.564,
   "d": 3.006,
   "s": "客得之，以说吴王。"
  },
  {
   "t": 421.684,
   "d": 7.714,
   "s": "越有难，吴王使之将，冬，与越人水战，大败越人，裂地而封之。"
  },
  {
   "t": 429.508,
   "d": 6.631,
   "s": "能不龟手一也，或以封，或不免于洴澼絖，则所用之异也。"
  },
  {
   "t": 436.252,
   "d": 8.2,
   "s": "今子有五石之瓠，何不虑以为大樽，而浮乎江湖，而忧其瓠落无所容？"
  },
  {
   "t": 444.556,
   "d": 3.339,
   "s": "则夫子犹有蓬之心也夫！"
  },
  {
   "t": 448.012,
   "d": 5.256,
   "s": "惠子谓庄子曰：吾有大树，人谓之樗。"
  },
  {
   "t": 453.388,
   "d": 6.325,
   "s": "其大本拥肿而不中绳墨，其小枝卷曲而不中规矩。"
  },
  {
   "t": 459.82,
   "d": 2.95,
   "s": "立之涂，匠者不顾。"
  },
  {
   "t": 462.892,
   "d": 4.853,
   "s": "今子之言，大而无用，众所同去也。"
  },
  {
   "t": 467.86,
   "d": 3.825,
   "s": "庄子曰：子独不见狸狌乎？"
  },
  {
   "t": 471.796,
   "d": 7.825,
   "s": "卑身而伏，以候敖者；东西跳梁，不辟高下；中于机辟，死于罔罟。"
  },
  {
   "t": 479.74,
   "d": 4.103,
   "s": "今夫斄牛，其大若垂天之云。"
  },
  {
   "t": 483.964,
   "d": 3.769,
   "s": "此能为大矣，而不能执鼠。"
  },
  {
   "t": 487.852,
   "d": 10.894,
   "s": "今子有大树，患其无用，何不树之于无何有之乡，广莫之野，彷徨乎无为其侧，逍遥乎寝卧其下。"
  },
  {
   "t": 498.868,
   "d": 5.839,
   "s": "不夭斤斧，物无害者，无所可用，安所困苦哉！"
  }
 ]
}