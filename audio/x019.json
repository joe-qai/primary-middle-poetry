{
 "id": "x019",
 "title": "逍遥游",
 "voice": "zh-CN-YunjianNeural",
 "rate": "-10%",
 "dur": 465.515,
 "hdr": 2,
 "bodyCues": 88,
 "v": "61913344",
 "cues": [
  {
   "t": 0.1,
   "d": 1.339,
   "s": "逍遥游"
  },
  {
   "t": 1.389,
   "d": 2.111,
   "s": "战国，庄子"
  },
  {
   "t": 3.5,
   "d": 2.75,
   "s": "北冥有鱼，其名为鲲。"
  },
  {
   "t": 6.25,
   "d": 6.028,
   "s": "鲲之大，不知其几千里也；化而为鸟，其名为鹏。"
  },
  {
   "t": 12.278,
   "d": 6.597,
   "s": "鹏之背，不知其几千里也；怒而飞，其翼若垂天之云。"
  },
  {
   "t": 18.875,
   "d": 3.667,
   "s": "是鸟也，海运则将徙于南冥。"
  },
  {
   "t": 22.542,
   "d": 2.458,
   "s": "南冥者，天池也。"
  },
  {
   "t": 25.0,
   "d": 2.764,
   "s": "齐谐者，志怪者也。"
  },
  {
   "t": 27.764,
   "d": 9.056,
   "s": "谐之言曰：鹏之徙于南冥也，水击三千里，抟扶摇而上者九万里，去以六月息者也。"
  },
  {
   "t": 36.819,
   "d": 4.514,
   "s": "野马也，尘埃也，生物之以息相吹也。"
  },
  {
   "t": 41.333,
   "d": 3.028,
   "s": "天之苍苍，其正色邪？"
  },
  {
   "t": 44.361,
   "d": 2.542,
   "s": "其远而无所至极邪？"
  },
  {
   "t": 46.903,
   "d": 3.556,
   "s": "其视下也，亦若是则已矣。"
  },
  {
   "t": 50.458,
   "d": 4.236,
   "s": "且夫水之积也不厚，则其负大舟也无力。"
  },
  {
   "t": 54.694,
   "d": 7.319,
   "s": "覆杯水于坳堂之上，则芥为之舟；置杯焉则胶，水浅而舟大也。"
  },
  {
   "t": 62.014,
   "d": 3.917,
   "s": "风之积也不厚，则其负大翼也无力。"
  },
  {
   "t": 65.931,
   "d": 9.847,
   "s": "故九万里，则风斯在下矣，而后乃今培风；背负青天，而莫之夭阏者，而后乃今将图南。"
  },
  {
   "t": 75.778,
   "d": 10.833,
   "s": "蜩与学鸠笑之曰：我决起而飞，抢榆枋而止，时则不至，而控于地而已矣，奚以之九万里，而南为？"
  },
  {
   "t": 86.611,
   "d": 9.069,
   "s": "适莽苍者，三餐而反，腹犹果然；适百里者，宿舂粮；适千里者，三月聚粮。"
  },
  {
   "t": 95.681,
   "d": 2.167,
   "s": "之二虫又何知！"
  },
  {
   "t": 97.847,
   "d": 3.667,
   "s": "小知不及大知，小年不及大年。"
  },
  {
   "t": 101.514,
   "d": 2.208,
   "s": "奚以知其然也？"
  },
  {
   "t": 103.722,
   "d": 4.861,
   "s": "朝菌不知晦朔，蟪蛄不知春秋，此小年也。"
  },
  {
   "t": 108.583,
   "d": 10.958,
   "s": "楚之南有冥灵者，以五百岁为春，五百岁为秋；上古有大椿者，以八千岁为春，八千岁为秋，此大年也。"
  },
  {
   "t": 119.542,
   "d": 5.083,
   "s": "而彭祖乃今以久特闻，众人匹之，不亦悲乎！"
  },
  {
   "t": 124.625,
   "d": 2.278,
   "s": "汤之问棘也是已。"
  },
  {
   "t": 126.903,
   "d": 4.111,
   "s": "穷发之北，有冥海者，天池也。"
  },
  {
   "t": 131.014,
   "d": 5.708,
   "s": "有鱼焉，其广数千里，未有知其修者，其名为鲲。"
  },
  {
   "t": 136.722,
   "d": 13.014,
   "s": "有鸟焉，其名为鹏，背若泰山，翼若垂天之云，抟扶摇羊角而上者九万里，绝云气，负青天，然后图南，且适南冥也。"
  },
  {
   "t": 149.736,
   "d": 3.722,
   "s": "斥鴳笑之曰：彼且奚适也？"
  },
  {
   "t": 153.458,
   "d": 6.708,
   "s": "我腾跃而上，不过数仞而下，翱翔蓬蒿之间，此亦飞之至也。"
  },
  {
   "t": 160.167,
   "d": 2.264,
   "s": "而彼且奚适也？"
  },
  {
   "t": 162.431,
   "d": 2.208,
   "s": "此小大之辩也。"
  },
  {
   "t": 164.639,
   "d": 8.361,
   "s": "故夫知效一官，行比一乡，德合一君，而征一国者，其自视也，亦若此矣。"
  },
  {
   "t": 173.0,
   "d": 2.542,
   "s": "而宋荣子犹然笑之。"
  },
  {
   "t": 175.542,
   "d": 9.139,
   "s": "且举世誉之而不加劝，举世非之而不加沮，定乎内外之分，辩乎荣辱之境，斯已矣。"
  },
  {
   "t": 184.681,
   "d": 3.139,
   "s": "彼其于世，未数数然也。"
  },
  {
   "t": 187.819,
   "d": 2.583,
   "s": "虽然，犹有未树也。"
  },
  {
   "t": 190.403,
   "d": 5.722,
   "s": "夫列子御风而行，泠然善也，旬有五日而后反。"
  },
  {
   "t": 196.125,
   "d": 3.306,
   "s": "彼于致福者，未数数然也。"
  },
  {
   "t": 199.431,
   "d": 3.611,
   "s": "此虽免乎行，犹有所待者也。"
  },
  {
   "t": 203.042,
   "d": 6.958,
   "s": "若夫乘天地之正，而御六气之辩，以游无穷者，彼且恶乎待哉？"
  },
  {
   "t": 210.0,
   "d": 4.986,
   "s": "故曰：至人无己，神人无功，圣人无名。"
  },
  {
   "t": 214.986,
   "d": 8.125,
   "s": "尧让天下于许由，曰：日月出矣，而爝火不息，其于光也，不亦难乎！"
  },
  {
   "t": 223.111,
   "d": 5.292,
   "s": "时雨降矣，而犹浸灌，其于泽也，不亦劳乎！"
  },
  {
   "t": 228.403,
   "d": 5.736,
   "s": "夫子立而天下治，而我犹尸之，吾自视缺然。"
  },
  {
   "t": 234.139,
   "d": 1.694,
   "s": "请致天下。"
  },
  {
   "t": 235.833,
   "d": 7.361,
   "s": "许由曰：子治天下，天下既已治也，而我犹代子，吾将为名乎？"
  },
  {
   "t": 243.194,
   "d": 4.069,
   "s": "名者，实之宾也，吾将为宾乎？"
  },
  {
   "t": 247.264,
   "d": 5.625,
   "s": "鹪鹩巢于深林，不过一枝；偃鼠饮河，不过满腹。"
  },
  {
   "t": 252.889,
   "d": 3.667,
   "s": "归休乎君，予无所用天下为！"
  },
  {
   "t": 256.556,
   "d": 5.069,
   "s": "庖人虽不治庖，尸祝不越樽俎，而代之矣。"
  },
  {
   "t": 261.625,
   "d": 6.236,
   "s": "肩吾问于连叔曰：吾闻言于接舆，大而无当，往而不反。"
  },
  {
   "t": 267.861,
   "d": 6.514,
   "s": "吾惊怖其言，犹河汉而无极也；大有径庭，不近人情焉。"
  },
  {
   "t": 274.375,
   "d": 2.861,
   "s": "连叔曰：其言谓何哉？"
  },
  {
   "t": 277.236,
   "d": 12.917,
   "s": "曰：藐姑射之山，有神人居焉，肌肤若冰雪，淖约若处子；不食五谷，吸风饮露；乘云气，御飞龙，而游乎四海之外。"
  },
  {
   "t": 290.153,
   "d": 4.042,
   "s": "其神凝，使物不疵疠而年谷熟。"
  },
  {
   "t": 294.194,
   "d": 2.556,
   "s": "吾以是狂而不信也。"
  },
  {
   "t": 296.75,
   "d": 6.986,
   "s": "连叔曰：然，瞽者无以与乎文章之观，聋者无以与乎钟鼓之声。"
  },
  {
   "t": 303.736,
   "d": 2.5,
   "s": "岂唯形骸有聋盲哉？"
  },
  {
   "t": 306.236,
   "d": 1.903,
   "s": "夫知亦有之。"
  },
  {
   "t": 308.139,
   "d": 2.889,
   "s": "是其言也，犹时女也。"
  },
  {
   "t": 311.028,
   "d": 8.167,
   "s": "之人也，之德也，将旁礴万物以为一，世蕲乎乱，孰弊弊焉以天下为事！"
  },
  {
   "t": 319.194,
   "d": 7.472,
   "s": "之人也，物莫之伤，大浸稽天而不溺，大旱金石流、土山焦而不热。"
  },
  {
   "t": 326.667,
   "d": 6.0,
   "s": "是其尘垢秕糠，将犹陶铸尧舜者也，孰肯以物为事！"
  },
  {
   "t": 332.667,
   "d": 5.681,
   "s": "宋人资章甫而适诸越，越人断发文身，无所用之。"
  },
  {
   "t": 338.347,
   "d": 9.444,
   "s": "尧治天下之民，平海内之政，往见四子藐姑射之山，汾水之阳，窅然丧其天下焉。"
  },
  {
   "t": 348.004,
   "d": 6.436,
   "s": "惠子谓庄子曰：魏王贻我大瓠之种，我树之成而实五石。"
  },
  {
   "t": 354.39,
   "d": 3.528,
   "s": "以盛水浆，其坚不能自举也。"
  },
  {
   "t": 357.918,
   "d": 3.542,
   "s": "剖之以为瓢，则瓠落无所容。"
  },
  {
   "t": 361.46,
   "d": 4.431,
   "s": "非不呺然大也，吾为其无用而掊之。"
  },
  {
   "t": 365.89,
   "d": 3.694,
   "s": "庄子曰：夫子固拙于用大矣。"
  },
  {
   "t": 369.585,
   "d": 5.194,
   "s": "宋人有善为不龟手之药者，世世以洴澼絖为事。"
  },
  {
   "t": 374.779,
   "d": 3.028,
   "s": "客闻之，请买其方百金。"
  },
  {
   "t": 377.807,
   "d": 7.931,
   "s": "聚族而谋曰：我世世为洴澼絖，不过数金；今一朝而鬻技百金，请与之。"
  },
  {
   "t": 385.737,
   "d": 2.667,
   "s": "客得之，以说吴王。"
  },
  {
   "t": 388.404,
   "d": 7.375,
   "s": "越有难，吴王使之将，冬，与越人水战，大败越人，裂地而封之。"
  },
  {
   "t": 395.779,
   "d": 6.292,
   "s": "能不龟手一也，或以封，或不免于洴澼絖，则所用之异也。"
  },
  {
   "t": 402.071,
   "d": 7.861,
   "s": "今子有五石之瓠，何不虑以为大樽，而浮乎江湖，而忧其瓠落无所容？"
  },
  {
   "t": 409.932,
   "d": 3.0,
   "s": "则夫子犹有蓬之心也夫！"
  },
  {
   "t": 412.932,
   "d": 4.917,
   "s": "惠子谓庄子曰：吾有大树，人谓之樗。"
  },
  {
   "t": 417.848,
   "d": 5.986,
   "s": "其大本拥肿而不中绳墨，其小枝卷曲而不中规矩。"
  },
  {
   "t": 423.835,
   "d": 2.611,
   "s": "立之涂，匠者不顾。"
  },
  {
   "t": 426.446,
   "d": 4.514,
   "s": "今子之言，大而无用，众所同去也。"
  },
  {
   "t": 430.96,
   "d": 3.486,
   "s": "庄子曰：子独不见狸狌乎？"
  },
  {
   "t": 434.446,
   "d": 7.486,
   "s": "卑身而伏，以候敖者；东西跳梁，不辟高下；中于机辟，死于罔罟。"
  },
  {
   "t": 441.932,
   "d": 3.764,
   "s": "今夫斄牛，其大若垂天之云。"
  },
  {
   "t": 445.696,
   "d": 3.431,
   "s": "此能为大矣，而不能执鼠。"
  },
  {
   "t": 449.126,
   "d": 10.556,
   "s": "今子有大树，患其无用，何不树之于无何有之乡，广莫之野，彷徨乎无为其侧，逍遥乎寝卧其下。"
  },
  {
   "t": 459.682,
   "d": 5.833,
   "s": "不夭斤斧，物无害者，无所可用，安所困苦哉！"
  }
 ]
}