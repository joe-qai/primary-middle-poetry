   "s": "悬梁刺股"
  },
  {
   "t": 1.778,
   "d": 4.208,
   "s": "汉，战国，太平御览战国策"
  },
  {
   "t": 5.986,
   "d": 6.639,
   "s": "汉代的孙敬，非常好学，从早到晚读书，常常废寝忘食。"
  },
  {
   "t": 12.625,
   "d": 3.597,
   "s": "读书时间久了，疲倦得直打瞌睡。"
  },
  {
   "t": 16.222,
   "d": 11.153,
   "s": "他想了一个办法，用绳子把头发系在屋梁上，一打瞌睡，头往下垂，绳子就会扯痛头皮，他就清醒过来，继续读书。"
  },
  {
   "t": 27.375,
   "d": 5.417,
   "s": "战国时的苏秦，早年游说失败，回家后发愤读书。"
  },
  {
   "t": 32.792,
   "d": 7.125,
   "s": "读书困倦时，就用锥子刺自己的大腿，疼痛使他清醒，继续苦读。"
  },
  {
   "t": 39.917,
   "d": 3.222,
   "s": "后来苏秦成为纵横家。"
  }
 ]
