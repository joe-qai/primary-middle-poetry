   "s": "渔家傲，天接云涛连晓雾"
  },
  {
   "t": 3.417,
   "d": 2.347,
   "s": "宋代，李清照"
  },
  {
   "t": 5.764,
   "d": 4.208,
   "s": "天接云涛连晓雾，星河欲转千帆舞。"
  },
  {
   "t": 9.972,
   "d": 2.333,
   "s": "仿佛梦魂归帝所。"
  },
  {
   "t": 12.306,
   "d": 3.222,
   "s": "闻天语，殷勤问我归何处。"
  },
  {
   "t": 15.528,
   "d": 4.111,
   "s": "我报路长嗟日暮，学诗谩有惊人句。"
  },
  {
   "t": 19.639,
   "d": 2.569,
   "s": "九万里风鹏正举。"
  },
  {
   "t": 22.208,
   "d": 3.722,
   "s": "风休住，蓬舟吹取三山去！"
  }
 ]
