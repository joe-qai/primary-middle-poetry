  },
  {
   "t": 3.417,
   "d": 2.681,
   "s": "宋代，李清照"
  },
  {
   "t": 6.268,
   "d": 4.547,
   "s": "天接云涛连晓雾，星河欲转千帆舞。"
  },
  {
   "t": 10.924,
   "d": 2.672,
   "s": "仿佛梦魂归帝所。"
  },
  {
   "t": 13.708,
   "d": 3.561,
   "s": "闻天语，殷勤问我归何处。"
  },
  {
   "t": 17.38,
   "d": 4.45,
   "s": "我报路长嗟日暮，学诗谩有惊人句。"
  },
  {
   "t": 21.94,
   "d": 2.908,
   "s": "九万里风鹏正举。"
  },
  {
   "t": 24.964,
   "d": 3.728,
   "s": "风休住，蓬舟吹取三山去！"
  }
