  {
   "t": 1.875,
   "d": 2.028,
   "s": "唐代，杜甫"
  },
  {
   "t": 3.903,
   "d": 4.528,
   "s": "车辚辚，马萧萧，行人弓箭各在腰。"
  },
  {
   "t": 8.431,
   "d": 4.292,
   "s": "耶娘妻子走相送，尘埃不见咸阳桥。"
  },
  {
   "t": 12.722,
   "d": 4.333,
   "s": "牵衣顿足拦道哭，哭声直上干云霄。"
  },
  {
   "t": 17.056,
   "d": 4.153,
   "s": "边庭流血成海水，武皇开边意未已。"
  },
  {
   "t": 21.208,
   "d": 5.181,
   "s": "君不闻汉家山东二百州，千村万落生荆杞。"
  },
  {
   "t": 26.389,
   "d": 4.167,
   "s": "纵有健妇把锄犁，禾生陇亩无东西。"
  },
  {
   "t": 30.556,
   "d": 4.278,
   "s": "况复秦兵耐苦战，被驱不异犬与鸡。"
  },
  {
   "t": 34.833,
   "d": 3.292,
   "s": "长者虽有问，役夫敢申恨？"
  },
  {
   "t": 38.125,
   "d": 3.389,
   "s": "且如今年冬，未休关西卒。"
  },
  {
   "t": 41.514,
   "d": 3.583,
   "s": "县官急索租，租税从何出？"
  },
  {
   "t": 45.097,
   "d": 3.264,
   "s": "信知生男恶，反是生女好。"
  },
  {
   "t": 48.361,
   "d": 4.097,
   "s": "生女犹得嫁比邻，生男埋没随百草。"
  },
  {
   "t": 52.458,
   "d": 4.056,
   "s": "君不见青海头，古来白骨无人收。"
  },
  {
   "t": 56.514,
   "d": 4.486,
   "s": "新鬼烦冤旧鬼哭，天阴雨湿声啾啾！"
  }
