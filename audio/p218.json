  {
   "t": 1.875,
   "d": 2.361,
   "s": "唐代，杜甫"
  },
  {
   "t": 6.261,
   "d": 4.867,
   "s": "车辚辚，马萧萧，行人弓箭各在腰。"
  },
  {
   "t": 11.348,
   "d": 4.631,
   "s": "耶娘妻子走相送，尘埃不见咸阳桥。"
  },
  {
   "t": 16.199,
   "d": 4.672,
   "s": "牵衣顿足拦道哭，哭声直上干云霄。"
  },
  {
   "t": 21.091,
   "d": 4.492,
   "s": "边庭流血成海水，武皇开边意未已。"
  },
  {
   "t": 25.803,
   "d": 5.519,
   "s": "君不闻汉家山东二百州，千村万落生荆杞。"
  },
  {
   "t": 31.542,
   "d": 4.506,
   "s": "纵有健妇把锄犁，禾生陇亩无东西。"
  },
  {
   "t": 36.268,
   "d": 4.617,
   "s": "况复秦兵耐苦战，被驱不异犬与鸡。"
  },
  {
   "t": 41.105,
   "d": 3.631,
   "s": "长者虽有问，役夫敢申恨？"
  },
  {
   "t": 44.956,
   "d": 3.728,
   "s": "且如今年冬，未休关西卒。"
  },
  {
   "t": 48.904,
   "d": 3.922,
   "s": "县官急索租，租税从何出？"
  },
  {
   "t": 53.046,
   "d": 3.603,
   "s": "信知生男恶，反是生女好。"
  },
  {
   "t": 56.869,
   "d": 4.436,
   "s": "生女犹得嫁比邻，生男埋没随百草。"
  },
  {
   "t": 61.525,
   "d": 4.394,
   "s": "君不见青海头，古来白骨无人收。"
  },
  {
   "t": 66.139,
   "d": 4.492,
   "s": "新鬼烦冤旧鬼哭，天阴雨湿声啾啾！"
  }
