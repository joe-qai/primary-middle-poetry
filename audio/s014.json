  {
   "t": 0.1,
   "d": 1.672,
   "s": "夸父逐日"
  },
  {
   "t": 1.722,
   "d": 3.875,
   "s": "上古，山海经，海外北经"
  },
  {
   "t": 5.597,
   "d": 3.681,
   "s": "远古时候，有一个巨人名叫夸父。"
  },
  {
   "t": 9.278,
   "d": 6.625,
   "s": "他力大无穷，意志坚强，想要追赶太阳，让太阳永远留在人间。"
  },
  {
   "t": 15.903,
   "d": 4.597,
   "s": "夸父迈开大步，朝着太阳升起的方向追去。"
  },
  {
   "t": 20.5,
   "d": 6.75,
   "s": "他跨过一座座高山，越过一条条大河，一直追到太阳落下的地方。"
  },
  {
   "t": 27.25,
   "d": 6.431,
   "s": "眼看着就要追上太阳了，可太阳像个大火球，烤得他口干舌燥。"
  },
  {
   "t": 33.681,
   "d": 10.597,
   "s": "夸父渴极了，就跑到黄河边，一口气把黄河的水喝干了；又跑到渭水边，把渭水也喝干了，还是不解渴。"
  },
  {
   "t": 44.278,
   "d": 6.153,
   "s": "他又想去喝北方大湖的水，可是还没走到，就在半路上渴死了。"
  },
  {
   "t": 50.431,
   "d": 9.306,
   "s": "夸父倒下后，他的手杖化成了大片桃林，结出甘甜的桃子，给后来经过这里的人解渴。"
  }
 ]
}