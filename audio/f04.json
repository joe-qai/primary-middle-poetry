   "s": "未选取的路节选"
  },
  {
   "t": 2.306,
   "d": 3.472,
   "s": "美国，罗伯特，弗罗斯特"
  },
  {
   "t": 5.932,
   "d": 3.075,
   "s": "两片落叶分出两条路啊，"
  },
  {
   "t": 8.957,
   "d": 3.5,
   "s": "遗憾我站在那儿不能两路同行，"
  },
  {
   "t": 12.457,
   "d": 3.972,
   "s": "久立凝望其中的一条路伸向远方，"
  },
  {
   "t": 16.429,
   "d": 2.806,
   "s": "它隐没在丛林深处。"
  },
  {
   "t": 19.396,
   "d": 2.478,
   "s": "然后踏上了另一条路，"
  },
  {
   "t": 21.824,
   "d": 3.667,
   "s": "这条路野草漫漫，杂草丛生，"
  },
  {
   "t": 25.49,
   "d": 4.708,
   "s": "同样需要人迹，同样是未经踩踏的路径。"
  },
  {
   "t": 30.364,
   "d": 3.492,
   "s": "从此之后，一切都改变了。"
  },
  {
   "t": 33.964,
   "d": 3.242,
   "s": "也许多少年后在某个地方，"
  },
  {
   "t": 37.156,
   "d": 3.153,
   "s": "我将轻声叹息往事重提："
  },
  {
   "t": 40.308,
   "d": 5.347,
   "s": "两条路在林中分岔，而我选择了人迹更少的那一条，"
  },
  {
   "t": 45.656,
   "d": 3.306,
   "s": "从此决定了人生迥然不同。"
  }
 ]
