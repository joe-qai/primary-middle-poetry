{
 "id": "w018",
 "title": "鱼我所欲也",
 "voice": "zh-CN-YunjianNeural",
 "rate": "-10%",
 "pitch": "+0Hz",
 "dur": 98.088,
 "hdr": 2,
 "bodyCues": 16,
 "v": "972b8603",
 "cues": [
  {
   "t": 0.1,
   "d": 1.992,
   "s": "鱼我所欲也"
  },
  {
   "t": 2.042,
   "d": 2.181,
   "s": "战国，孟子"
  },
  {
   "t": 4.222,
   "d": 4.75,
   "s": "鱼，我所欲也；熊掌，亦我所欲也。"
  },
  {
   "t": 8.972,
   "d": 4.028,
   "s": "二者不可得兼，舍鱼而取熊掌者也。"
  },
  {
   "t": 13.0,
   "d": 4.958,
   "s": "生，亦我所欲也；义，亦我所欲也。"
  },
  {
   "t": 17.958,
   "d": 3.819,
   "s": "二者不可得兼，舍生而取义者也。"
  },
  {
   "t": 21.778,
   "d": 9.931,
   "s": "生亦我所欲，所欲有甚于生者，故不为苟得也；死亦我所恶，所恶有甚于死者，故患有所不辟也。"
  },
  {
   "t": 31.708,
   "d": 5.625,
   "s": "如使人之所欲莫甚于生，则凡可以得生者何不用也？"
  },
  {
   "t": 37.333,
   "d": 5.653,
   "s": "使人之所恶莫甚于死者，则凡可以辟患者何不为也？"
  },
  {
   "t": 42.986,
   "d": 5.667,
   "s": "由是则生而有不用也，由是则可以辟患，而有不为也。"
  },
  {
   "t": 48.653,
   "d": 4.319,
   "s": "是故所欲有甚于生者，所恶有甚于死者。"
  },
  {
   "t": 52.972,
   "d": 5.333,
   "s": "非独贤者有是心也，人皆有之，贤者能勿丧耳。"
  },
  {
   "t": 58.306,
   "d": 5.014,
   "s": "一箪食，一豆羹，得之则生，弗得则死。"
  },
  {
   "t": 63.319,
   "d": 6.403,
   "s": "呼尔而与之，行道之人弗受；蹴尔而与之，乞人不屑也。"
  },
  {
   "t": 69.722,
   "d": 5.333,
   "s": "万钟则不辩礼义，而受之，万钟于我何加焉！"
  },
  {
   "t": 75.056,
   "d": 5.208,
   "s": "为宫室之美、妻妾之奉、所识穷乏者得我与？"
  },
  {
   "t": 80.264,
   "d": 15.125,
   "s": "乡为身死而不受，今为宫室之美为之；乡为身死而不受，今为妻妾之奉为之；乡为身死而不受，今为所识穷乏者得我，而为之：是亦不可以已乎？"
  },
  {
   "t": 95.389,
   "d": 2.639,
   "s": "此之谓失其本心。"
  }
 ]
}