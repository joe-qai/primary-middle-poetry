{
 "id": "c002",
 "title": "洛神赋",
 "voice": "zh-CN-YunjianNeural",
 "rate": "-10%",
 "pitch": "+0Hz",
 "dur": 305.4,
 "hdr": 2,
 "bodyCues": 76,
 "v": "3b005ba3",
 "cues": [
  {
   "t": 0.1,
   "d": 1.381,
   "s": "洛神赋"
  },
  {
   "t": 1.431,
   "d": 2.194,
   "s": "三国，曹植"
  },
  {
   "t": 3.625,
   "d": 4.153,
   "s": "黄初三年，余朝京师，还济洛川。"
  },
  {
   "t": 7.778,
   "d": 4.111,
   "s": "古人有言，斯水之神，名曰宓妃。"
  },
  {
   "t": 11.889,
   "d": 4.319,
   "s": "感宋玉对楚王神女之事，遂作斯赋。"
  },
  {
   "t": 16.208,
   "d": 1.333,
   "s": "其辞曰："
  },
  {
   "t": 17.542,
   "d": 2.958,
   "s": "余从京域，言归东藩。"
  },
  {
   "t": 20.5,
   "d": 4.847,
   "s": "背伊阙，越轘辕，经通谷，陵景山。"
  },
  {
   "t": 25.347,
   "d": 3.014,
   "s": "日既西倾，车殆马烦。"
  },
  {
   "t": 28.361,
   "d": 6.764,
   "s": "尔乃税驾乎蘅皋，秣驷乎芝田，容与乎阳林，流眄乎洛川。"
  },
  {
   "t": 35.125,
   "d": 3.056,
   "s": "于是精移神骇，忽焉思散。"
  },
  {
   "t": 38.181,
   "d": 5.528,
   "s": "俯则未察，仰以殊观，睹一丽人，于岩之畔。"
  },
  {
   "t": 43.708,
   "d": 4.5,
   "s": "乃援御者而告之曰：尔有觌于彼者乎？"
  },
  {
   "t": 48.208,
   "d": 1.708,
   "s": "彼何人斯？"
  },
  {
   "t": 49.917,
   "d": 2.097,
   "s": "若此之艳也！"
  },
  {
   "t": 52.014,
   "d": 4.639,
   "s": "御者对曰：臣闻河洛之神，名曰宓妃。"
  },
  {
   "t": 56.653,
   "d": 3.875,
   "s": "然则君王之所见也，无乃是乎？"
  },
  {
   "t": 60.528,
   "d": 1.833,
   "s": "其状若何？"
  },
  {
   "t": 62.361,
   "d": 1.722,
   "s": "臣愿闻之。"
  },
  {
   "t": 64.083,
   "d": 5.375,
   "s": "余告之曰：其形也，翩若惊鸿，婉若游龙。"
  },
  {
   "t": 69.458,
   "d": 3.097,
   "s": "荣曜秋菊，华茂春松。"
  },
  {
   "t": 72.556,
   "d": 5.181,
   "s": "髣髴兮若轻云之蔽月，飘飖兮若流风之回雪。"
  },
  {
   "t": 77.736,
   "d": 7.0,
   "s": "远而望之，皎若太阳升朝霞；迫而察之，灼若芙蕖出渌波。"
  },
  {
   "t": 84.736,
   "d": 2.944,
   "s": "秾纤得衷，修短合度。"
  },
  {
   "t": 87.681,
   "d": 3.167,
   "s": "肩若削成，腰如约素。"
  },
  {
   "t": 90.847,
   "d": 2.972,
   "s": "延颈秀项，皓质呈露。"
  },
  {
   "t": 93.819,
   "d": 2.944,
   "s": "芳泽无加，铅华弗御。"
  },
  {
   "t": 96.764,
   "d": 2.847,
   "s": "云髻峨峨，修眉联娟。"
  },
  {
   "t": 99.611,
   "d": 5.611,
   "s": "丹唇外朗，皓齿内鲜，明眸善睐，靥辅承权。"
  },
  {
   "t": 105.222,
   "d": 3.0,
   "s": "瑰姿艳逸，仪静体闲。"
  },
  {
   "t": 108.222,
   "d": 3.056,
   "s": "柔情绰态，媚于语言。"
  },
  {
   "t": 111.278,
   "d": 3.028,
   "s": "奇服旷世，骨像应图。"
  },
  {
   "t": 114.306,
   "d": 4.25,
   "s": "披罗衣之璀粲兮，珥瑶碧之华琚。"
  },
  {
   "t": 118.556,
   "d": 4.014,
   "s": "戴金翠之首饰，缀明珠以耀躯。"
  },
  {
   "t": 122.569,
   "d": 3.944,
   "s": "践远游之文履，曳雾绡之轻裾。"
  },
  {
   "t": 126.514,
   "d": 3.569,
   "s": "微幽兰之芳蔼兮，步踟蹰于山隅。"
  },
  {
   "t": 130.083,
   "d": 3.153,
   "s": "于是忽焉纵体，以遨以嬉。"
  },
  {
   "t": 133.236,
   "d": 2.792,
   "s": "左倚采旄，右荫桂旗。"
  },
  {
   "t": 136.028,
   "d": 4.444,
   "s": "壤皓腕于神浒兮，采湍濑之玄芝。"
  },
  {
   "t": 140.472,
   "d": 4.069,
   "s": "余情悦其淑美兮，心振荡而不怡。"
  },
  {
   "t": 144.542,
   "d": 3.833,
   "s": "无良媒以接欢兮，托微波而通辞。"
  },
  {
   "t": 148.375,
   "d": 4.167,
   "s": "愿诚素之先达兮，解玉佩以要之。"
  },
  {
   "t": 152.542,
   "d": 4.208,
   "s": "嗟佳人之信修兮，羌习礼而明诗。"
  },
  {
   "t": 156.75,
   "d": 3.986,
   "s": "抗琼珶以和予兮，指潜渊而为期。"
  },
  {
   "t": 160.736,
   "d": 4.111,
   "s": "执眷眷之款实兮，惧斯灵之我欺。"
  },
  {
   "t": 164.847,
   "d": 4.222,
   "s": "感交甫之弃言兮，怅犹豫而狐疑。"
  },
  {
   "t": 169.069,
   "d": 4.083,
   "s": "收和颜而静志兮，申礼防以自持。"
  },
  {
   "t": 173.153,
   "d": 5.681,
   "s": "于是洛灵感焉，徙倚彷徨，神光离合，乍阴乍阳。"
  },
  {
   "t": 178.833,
   "d": 3.819,
   "s": "竦轻躯以鹤立，若将飞而未翔。"
  },
  {
   "t": 182.653,
   "d": 3.722,
   "s": "践椒涂之郁烈，步蘅薄而流芳。"
  },
  {
   "t": 186.375,
   "d": 3.792,
   "s": "超长吟以永慕兮，声哀厉而弥长。"
  },
  {
   "t": 190.167,
   "d": 8.181,
   "s": "尔乃众灵杂遝，命俦啸侣，或戏清流，或翔神渚，或采明珠，或拾翠羽。"
  },
  {
   "t": 198.347,
   "d": 3.847,
   "s": "从南湘之二妃，携汉滨之游女。"
  },
  {
   "t": 202.194,
   "d": 4.167,
   "s": "叹匏瓜之无匹兮，咏牵牛之独处。"
  },
  {
   "t": 206.361,
   "d": 4.222,
   "s": "扬轻袿之猗靡兮，翳修袖以延伫。"
  },
  {
   "t": 210.583,
   "d": 5.417,
   "s": "体迅飞凫，飘忽若神，凌波微步，罗袜生尘。"
  },
  {
   "t": 216.0,
   "d": 2.847,
   "s": "动无常则，若危若安。"
  },
  {
   "t": 218.847,
   "d": 2.958,
   "s": "进止难期，若往若还。"
  },
  {
   "t": 221.806,
   "d": 3.0,
   "s": "转眄流精，光润玉颜。"
  },
  {
   "t": 224.806,
   "d": 3.083,
   "s": "含辞未吐，气若幽兰。"
  },
  {
   "t": 227.889,
   "d": 2.986,
   "s": "华容婀娜，令我忘餐。"
  },
  {
   "t": 230.875,
   "d": 3.181,
   "s": "于是屏翳收风，川后静波。"
  },
  {
   "t": 234.056,
   "d": 3.014,
   "s": "冯夷鸣鼓，女娲清歌。"
  },
  {
   "t": 237.069,
   "d": 3.681,
   "s": "腾文鱼以警乘，鸣玉鸾以偕逝。"
  },
  {
   "t": 240.75,
   "d": 7.056,
   "s": "六龙俨其齐首，载云车之容裔，鲸鲵踊而夹毂，水禽翔而为卫。"
  },
  {
   "t": 247.806,
   "d": 7.944,
   "s": "于是越北沚，过南冈，纡素领，回清阳，动朱唇以徐言，陈交接之大纲。"
  },
  {
   "t": 255.75,
   "d": 4.208,
   "s": "恨人神之道殊兮，怨盛年之莫当。"
  },
  {
   "t": 259.958,
   "d": 3.875,
   "s": "抗罗袂以掩涕兮，泪流襟之浪浪。"
  },
  {
   "t": 263.833,
   "d": 4.056,
   "s": "悼良会之永绝兮，哀一逝而异乡。"
  },
  {
   "t": 267.889,
   "d": 4.264,
   "s": "无微情以效爱兮，献江南之明珰。"
  },
  {
   "t": 272.153,
   "d": 4.056,
   "s": "虽潜处于太阴，长寄心于君王。"
  },
  {
   "t": 276.208,
   "d": 3.931,
   "s": "忽不悟其所舍，怅神宵而蔽光。"
  },
  {
   "t": 280.139,
   "d": 5.25,
   "s": "于是背下陵高，足往神留，遗情想像，顾望怀愁。"
  },
  {
   "t": 285.389,
   "d": 4.0,
   "s": "冀灵体之复形，御轻舟而上溯。"
  },
  {
   "t": 289.389,
   "d": 4.042,
   "s": "浮长川而忘返，思绵绵而增慕。"
  },
  {
   "t": 293.431,
   "d": 4.014,
   "s": "夜耿耿而不寐，沾繁霜而至曙。"
  },
  {
   "t": 297.444,
   "d": 3.486,
   "s": "命仆夫而驾，吾将归乎东路。"
  },
  {
   "t": 300.931,
   "d": 4.361,
   "s": "揽騑辔以抗策，怅盘桓而不能去。"
  }
 ]
}