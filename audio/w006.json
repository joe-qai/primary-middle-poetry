 "v": "97298bed",
 "cues": [
  {
   "t": 0.1,
   "d": 1.672,
   "s": "桃花源记"
  },
  {
   "t": 1.722,
   "d": 2.403,
   "s": "东晋，陶渊明"
  },
  {
   "t": 4.125,
   "d": 3.542,
   "s": "晋太元中，武陵人捕鱼为业。"
  },
  {
   "t": 7.667,
   "d": 3.028,
   "s": "缘溪行，忘路之远近。"
  },
  {
   "t": 10.694,
   "d": 7.0,
   "s": "忽逢桃花林，夹岸数百步，中无杂树，芳草鲜美，落英缤纷。"
  },
  {
   "t": 17.694,
   "d": 4.153,
   "s": "渔人甚异之，复前行，欲穷其林。"
  },
  {
   "t": 21.847,
   "d": 5.514,
   "s": "林尽水源，便得一山，山有小口，仿佛若有光。"
  },
  {
   "t": 27.361,
   "d": 2.5,
   "s": "便舍船，从口入。"
  },
  {
   "t": 29.861,
   "d": 2.403,
   "s": "初极狭，才通人。"
  },
  {
   "t": 32.264,
   "d": 3.125,
   "s": "复行数十步，豁然开朗。"
  },
  {
   "t": 35.389,
   "d": 5.972,
   "s": "土地平旷，屋舍俨然，有良田、美池、桑竹之属。"
  },
  {
   "t": 41.361,
   "d": 3.042,
   "s": "阡陌交通，鸡犬相闻。"
  },
  {
   "t": 44.403,
   "d": 4.528,
   "s": "其中往来种作，男女衣着，悉如外人。"
  },
  {
   "t": 48.931,
   "d": 3.292,
   "s": "黄发垂髫，并怡然自乐。"
  },
  {
   "t": 52.222,
   "d": 3.722,
   "s": "见渔人，乃大惊，问所从来。"
  },
  {
   "t": 55.944,
   "d": 1.375,
   "s": "具答之。"
  },
  {
   "t": 57.319,
   "d": 3.25,
   "s": "便要还家，设酒杀鸡作食。"
  },
  {
   "t": 60.569,
   "d": 3.278,
   "s": "村中闻有此人，咸来问讯。"
  },
  {
   "t": 63.847,
   "d": 7.347,
   "s": "自云先世避秦时乱，率妻子邑人来此绝境，不复出焉，遂与外人间隔。"
  },
  {
   "t": 71.194,
   "d": 4.514,
   "s": "问今是何世，乃不知有汉，无论魏晋。"
  },
  {
   "t": 75.708,
   "d": 3.583,
   "s": "此人一一为具言所闻，皆叹惋。"
  },
  {
   "t": 79.292,
   "d": 3.569,
   "s": "余人各复延至其家，皆出酒食。"
  },
  {
   "t": 82.861,
   "d": 2.347,
   "s": "停数日，辞去。"
  },
  {
   "t": 85.208,
   "d": 3.958,
   "s": "此中人语云：不足为外人道也。"
  },
  {
   "t": 89.167,
   "d": 4.375,
   "s": "既出，得其船，便扶向路，处处志之。"
  },
  {
   "t": 93.542,
   "d": 3.389,
   "s": "及郡下，诣太守，说如此。"
  },
  {
   "t": 96.931,
   "d": 5.764,
   "s": "太守即遣人随其往，寻向所志，遂迷，不复得路。"
  },
  {
   "t": 102.694,
   "d": 5.25,
   "s": "南阳刘子骥，高尚士也，闻之，欣然规往。"
  },
  {
   "t": 107.944,
   "d": 2.208,
   "s": "未果，寻病终。"
  },
  {
   "t": 110.153,
   "d": 2.417,
   "s": "后遂无问津者。"
  }
 ]
}