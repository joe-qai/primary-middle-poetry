  {
   "t": 0.1,
   "d": 1.797,
   "s": "三顾茅庐"
  },
  {
   "t": 1.847,
   "d": 4.069,
   "s": "东汉，陈寿三国志后世演义有增饰"
  },
  {
   "t": 5.917,
   "d": 8.167,
   "s": "东汉末年，刘备听说诸葛亮很有才华，就带着关羽、张飞亲自到隆中去请他。"
  },
  {
   "t": 14.083,
   "d": 5.278,
   "s": "第一次去，诸葛亮不在家；第二次去，又没见到。"
  },
  {
   "t": 19.361,
   "d": 3.764,
   "s": "张飞不耐烦了，刘备却坚持再去。"
  },
  {
   "t": 23.125,
   "d": 7.528,
   "s": "第三次去，诸葛亮正在睡觉，刘备就在门外恭恭敬敬地等候，直到他醒来。"
  },
  {
   "t": 30.653,
   "d": 5.847,
   "s": "诸葛亮被刘备的诚心所感动，终于答应出山辅佐刘备。"
  }
 ]
}