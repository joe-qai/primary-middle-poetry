{
 "id": "x013",
 "title": "前赤壁赋",
 "voice": "zh-CN-YunjianNeural",
 "rate": "-10%",
 "pitch": "+0Hz",
 "dur": 169.25,
 "hdr": 2,
 "bodyCues": 31,
 "v": "8d4a5ef9",
 "cues": [
  {
   "t": 0.1,
   "d": 1.672,
   "s": "前赤壁赋"
  },
  {
   "t": 1.722,
   "d": 2.139,
   "s": "宋代，苏轼"
  },
  {
   "t": 3.861,
   "d": 5.431,
   "s": "壬戌之秋，七月既望，苏子与客泛舟游于赤壁之下。"
  },
  {
   "t": 9.292,
   "d": 2.958,
   "s": "清风徐来，水波不兴。"
  },
  {
   "t": 12.25,
   "d": 4.625,
   "s": "举酒属客，诵明月之诗，歌窈窕之章。"
  },
  {
   "t": 16.875,
   "d": 4.903,
   "s": "少焉，月出于东山之上，徘徊于斗牛之间。"
  },
  {
   "t": 21.778,
   "d": 2.903,
   "s": "白露横江，水光接天。"
  },
  {
   "t": 24.681,
   "d": 3.861,
   "s": "纵一苇之所如，凌万顷之茫然。"
  },
  {
   "t": 28.542,
   "d": 7.611,
   "s": "浩浩乎如冯虚御风，而不知其所止；飘飘乎如遗世独立，羽化而登仙。"
  },
  {
   "t": 36.153,
   "d": 3.389,
   "s": "于是饮酒乐甚，扣舷而歌之。"
  },
  {
   "t": 39.542,
   "d": 4.889,
   "s": "歌曰：桂棹兮兰桨，击空明兮溯流光。"
  },
  {
   "t": 44.431,
   "d": 3.708,
   "s": "渺渺兮予怀，望美人兮天一方。"
  },
  {
   "t": 48.139,
   "d": 3.625,
   "s": "客有吹洞箫者，倚歌而和之。"
  },
  {
   "t": 51.764,
   "d": 6.736,
   "s": "其声呜呜然，如怨如慕，如泣如诉；余音袅袅，不绝如缕。"
  },
  {
   "t": 58.5,
   "d": 3.75,
   "s": "舞幽壑之潜蛟，泣孤舟之嫠妇。"
  },
  {
   "t": 62.25,
   "d": 5.431,
   "s": "苏子愀然，正襟危坐而问客曰：何为其然也？"
  },
  {
   "t": 67.681,
   "d": 5.986,
   "s": "客曰：月明星稀，乌鹊南飞，此非曹孟德之诗乎？"
  },
  {
   "t": 73.667,
   "d": 8.083,
   "s": "西望夏口，东望武昌，山川相缪，郁乎苍苍，此非孟德之困于周郎者乎？"
  },
  {
   "t": 81.75,
   "d": 12.431,
   "s": "方其破荆州，下江陵，顺流而东也，舳舻千里，旌旗蔽空，酾酒临江，横槊赋诗，固一世之雄也，而今安在哉？"
  },
  {
   "t": 94.181,
   "d": 8.069,
   "s": "况吾与子渔樵于江渚之上，侣鱼虾而友麋鹿，驾一叶之扁舟，举匏樽以相属。"
  },
  {
   "t": 102.25,
   "d": 3.639,
   "s": "寄蜉蝣于天地，渺沧海之一粟。"
  },
  {
   "t": 105.889,
   "d": 4.014,
   "s": "哀吾生之须臾，羡长江之无穷。"
  },
  {
   "t": 109.903,
   "d": 3.833,
   "s": "挟飞仙以遨游，抱明月而长终。"
  },
  {
   "t": 113.736,
   "d": 3.597,
   "s": "知不可乎骤得，托遗响于悲风。"
  },
  {
   "t": 117.333,
   "d": 3.764,
   "s": "苏子曰：客亦知夫水与月乎？"
  },
  {
   "t": 121.097,
   "d": 6.708,
   "s": "逝者如斯，而未尝往也；盈虚者如彼，而卒莫消长也。"
  },
  {
   "t": 127.806,
   "d": 10.611,
   "s": "盖将自其变者，而观之，则天地曾不能以一瞬；自其不变者而观之，则物与我皆无尽也，而又何羡乎！"
  },
  {
   "t": 138.417,
   "d": 6.417,
   "s": "且夫天地之间，物各有主，苟非吾之所有，虽一毫而莫取。"
  },
  {
   "t": 144.833,
   "d": 9.458,
   "s": "惟江上之清风，与山间之明月，耳得之而为声，目遇之而成色，取之无禁，用之不竭。"
  },
  {
   "t": 154.292,
   "d": 4.875,
   "s": "是造物者之无尽藏也，而吾与子之所共适。"
  },
  {
   "t": 159.167,
   "d": 3.069,
   "s": "客喜而笑，洗盏更著。"
  },
  {
   "t": 162.236,
   "d": 2.847,
   "s": "肴核既尽，杯盘狼籍。"
  },
  {
   "t": 165.083,
   "d": 4.167,
   "s": "相与枕藉乎舟中，不知东方之既白。"
  }
 ]
}