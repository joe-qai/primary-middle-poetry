{
 "id": "x013",
 "title": "前赤壁赋",
 "voice": "zh-CN-YunjianNeural",
 "rate": "-10%",
 "pitch": "+0Hz",
 "dur": 183.264,
 "hdr": 2,
 "bodyCues": 31,
 "v": "56e01cbf",
 "cues": [
  {
   "t": 0.1,
   "d": 1.672,
   "s": "前赤壁赋"
  },
  {
   "t": 1.722,
   "d": 2.472,
   "s": "宋代，苏轼"
  },
  {
   "t": 4.348,
   "d": 5.769,
   "s": "壬戌之秋，七月既望，苏子与客泛舟游于赤壁之下。"
  },
  {
   "t": 10.228,
   "d": 3.297,
   "s": "清风徐来，水波不兴。"
  },
  {
   "t": 13.636,
   "d": 4.964,
   "s": "举酒属客，诵明月之诗，歌窈窕之章。"
  },
  {
   "t": 18.7,
   "d": 5.242,
   "s": "少焉，月出于东山之上，徘徊于斗牛之间。"
  },
  {
   "t": 24.052,
   "d": 3.242,
   "s": "白露横江，水光接天。"
  },
  {
   "t": 27.412,
   "d": 4.2,
   "s": "纵一苇之所如，凌万顷之茫然。"
  },
  {
   "t": 31.732,
   "d": 7.95,
   "s": "浩浩乎如冯虚御风，而不知其所止；飘飘乎如遗世独立，羽化而登仙。"
  },
  {
   "t": 39.796,
   "d": 3.728,
   "s": "于是饮酒乐甚，扣舷而歌之。"
  },
  {
   "t": 43.636,
   "d": 5.228,
   "s": "歌曰：桂棹兮兰桨，击空明兮溯流光。"
  },
  {
   "t": 48.964,
   "d": 4.047,
   "s": "渺渺兮予怀，望美人兮天一方。"
  },
  {
   "t": 53.116,
   "d": 3.964,
   "s": "客有吹洞箫者，倚歌而和之。"
  },
  {
   "t": 57.196,
   "d": 7.075,
   "s": "其声呜呜然，如怨如慕，如泣如诉；余音袅袅，不绝如缕。"
  },
  {
   "t": 64.372,
   "d": 4.089,
   "s": "舞幽壑之潜蛟，泣孤舟之嫠妇。"
  },
  {
   "t": 68.572,
   "d": 5.769,
   "s": "苏子愀然，正襟危坐而问客曰：何为其然也？"
  },
  {
   "t": 74.452,
   "d": 6.325,
   "s": "客曰：月明星稀，乌鹊南飞，此非曹孟德之诗乎？"
  },
  {
   "t": 80.884,
   "d": 8.422,
   "s": "西望夏口，东望武昌，山川相缪，郁乎苍苍，此非孟德之困于周郎者乎？"
  },
  {
   "t": 89.428,
   "d": 12.769,
   "s": "方其破荆州，下江陵，顺流而东也，舳舻千里，旌旗蔽空，酾酒临江，横槊赋诗，固一世之雄也，而今安在哉？"
  },
  {
   "t": 102.316,
   "d": 8.408,
   "s": "况吾与子渔樵于江渚之上，侣鱼虾而友麋鹿，驾一叶之扁舟，举匏樽以相属。"
  },
  {
   "t": 110.836,
   "d": 3.978,
   "s": "寄蜉蝣于天地，渺沧海之一粟。"
  },
  {
   "t": 114.916,
   "d": 4.353,
   "s": "哀吾生之须臾，羡长江之无穷。"
  },
  {
   "t": 119.38,
   "d": 4.172,
   "s": "挟飞仙以遨游，抱明月而长终。"
  },
  {
   "t": 123.676,
   "d": 3.936,
   "s": "知不可乎骤得，托遗响于悲风。"
  },
  {
   "t": 127.732,
   "d": 4.103,
   "s": "苏子曰：客亦知夫水与月乎？"
  },
  {
   "t": 131.956,
   "d": 7.047,
   "s": "逝者如斯，而未尝往也；盈虚者如彼，而卒莫消长也。"
  },
  {
   "t": 139.108,
   "d": 10.95,
   "s": "盖将自其变者，而观之，则天地曾不能以一瞬；自其不变者而观之，则物与我皆无尽也，而又何羡乎！"
  },
  {
   "t": 150.172,
   "d": 6.756,
   "s": "且夫天地之间，物各有主，苟非吾之所有，虽一毫而莫取。"
  },
  {
   "t": 157.036,
   "d": 9.797,
   "s": "惟江上之清风，与山间之明月，耳得之而为声，目遇之而成色，取之无禁，用之不竭。"
  },
  {
   "t": 166.948,
   "d": 5.214,
   "s": "是造物者之无尽藏也，而吾与子之所共适。"
  },
  {
   "t": 172.276,
   "d": 3.408,
   "s": "客喜而笑，洗盏更著。"
  },
  {
   "t": 175.804,
   "d": 3.186,
   "s": "肴核既尽，杯盘狼籍。"
  },
  {
   "t": 179.092,
   "d": 4.172,
   "s": "相与枕藉乎舟中，不知东方之既白。"
  }
 ]
}