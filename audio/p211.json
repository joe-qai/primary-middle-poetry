   "s": "凌余阵兮躐余行，左轮朱兮右轮殷。"
  },
  {
   "t": 20.729,
   "d": 4.853,
   "s": "霾两轮兮絷四马，援玉枹兮击鸣鼓。"
  },
  {
   "t": 25.802,
   "d": 4.686,
   "s": "天时怼兮威灵怒，严杀尽兮弃原野。"
  },
  {
   "t": 30.708,
   "d": 4.714,
   "s": "出不入兮往不反，平原忽兮路超远。"
  },
  {
   "t": 35.642,
   "d": 4.853,
   "s": "带长剑兮挟秦弓，首身离兮心不惩。"
  },
  {
   "t": 40.715,
   "d": 4.769,
