   "s": "战国，屈原"
  },
  {
   "t": 4.183,
   "d": 4.631,
   "s": "操吴戈兮被犀甲，车错毂兮短兵接。"
  },
  {
   "t": 9.034,
   "d": 4.589,
   "s": "旌蔽日兮敌若云，矢交坠兮士争先。"
  },
  {
   "t": 13.843,
   "d": 4.894,
   "s": "凌余阵兮躐余行，左轮朱兮右轮殷。"
  },
  {
   "t": 18.957,
   "d": 4.853,
   "s": "霾两轮兮絷四马，援玉枹兮击鸣鼓。"
  },
  {
   "t": 24.03,
   "d": 4.686,
   "s": "天时怼兮威灵怒，严杀尽兮弃原野。"
  },
  {
   "t": 28.936,
   "d": 4.714,
   "s": "出不入兮往不反，平原忽兮路超远。"
  },
  {
   "t": 33.87,
   "d": 4.853,
   "s": "带长剑兮挟秦弓，首身离兮心不惩。"
  },
  {
   "t": 38.943,
   "d": 4.769,
   "s": "诚既勇兮又以武，终刚强兮不可凌。"
  },
  {
   "t": 43.932,
   "d": 4.356,
   "s": "身既死兮神以灵，魂魄毅兮为鬼雄。"
