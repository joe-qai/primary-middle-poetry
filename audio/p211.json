   "s": "战国，屈原"
  },
  {
   "t": 3.75,
   "d": 4.292,
   "s": "操吴戈兮被犀甲，车错毂兮短兵接。"
  },
  {
   "t": 8.042,
   "d": 4.25,
   "s": "旌蔽日兮敌若云，矢交坠兮士争先。"
  },
  {
   "t": 12.292,
   "d": 4.556,
   "s": "凌余阵兮躐余行，左轮朱兮右轮殷。"
  },
  {
   "t": 16.847,
   "d": 4.514,
   "s": "霾两轮兮絷四马，援玉枹兮击鸣鼓。"
  },
  {
   "t": 21.361,
   "d": 4.347,
   "s": "天时怼兮威灵怒，严杀尽兮弃原野。"
  },
  {
   "t": 25.708,
   "d": 4.375,
   "s": "出不入兮往不反，平原忽兮路超远。"
  },
  {
   "t": 30.083,
   "d": 4.514,
   "s": "带长剑兮挟秦弓，首身离兮心不惩。"
  },
  {
   "t": 34.597,
   "d": 4.431,
   "s": "诚既勇兮又以武，终刚强兮不可凌。"
  },
  {
   "t": 39.028,
   "d": 5.125,
   "s": "身既死兮神以灵，魂魄毅兮为鬼雄。"
