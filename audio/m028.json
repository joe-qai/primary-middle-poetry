   "s": "石壕吏"
  },
  {
   "t": 1.403,
   "d": 2.361,
   "s": "唐代，杜甫"
  },
  {
   "t": 3.916,
   "d": 3.714,
   "s": "暮投石壕村，有吏夜捉人。"
  },
  {
   "t": 7.732,
   "d": 3.478,
   "s": "老翁逾墙走，老妇出门看。"
  },
  {
   "t": 11.332,
   "d": 2.186,
   "s": "吏呼一何怒！"
  },
  {
   "t": 13.636,
   "d": 2.436,
   "s": "妇啼一何苦！"
  },
  {
   "t": 16.18,
   "d": 3.756,
   "s": "听妇前致词：三男邺城戍。"
  },
  {
   "t": 20.044,
   "d": 3.936,
   "s": "一男附书至，二男新战死。"
  },
  {
   "t": 24.1,
   "d": 3.908,
   "s": "存者且偷生，死者长已矣！"
  },
  {
   "t": 28.108,
   "d": 3.7,
   "s": "室中更无人，惟有乳下孙。"
  },
  {
   "t": 31.924,
   "d": 3.644,
   "s": "有孙母未去，出入无完裙。"
  },
  {
   "t": 35.668,
   "d": 3.339,
   "s": "老妪力虽衰，请从吏夜归。"
  },
  {
   "t": 39.124,
   "d": 3.519,
   "s": "急应河阳役，犹得备晨炊。"
  },
  {
   "t": 42.748,
   "d": 3.631,
   "s": "夜久语声绝，如闻泣幽咽。"
  },
  {
   "t": 46.492,
   "d": 3.533,
   "s": "天明登前途，独与老翁别。"
  }
 ]
