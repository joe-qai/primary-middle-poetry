   "s": "石壕吏"
  },
  {
   "t": 1.403,
   "d": 2.361,
   "s": "唐代，杜甫"
  },
  {
   "t": 5.317,
   "d": 3.714,
   "s": "暮投石壕村，有吏夜捉人。"
  },
  {
   "t": 9.251,
   "d": 3.478,
   "s": "老翁逾墙走，老妇出门看。"
  },
  {
   "t": 12.949,
   "d": 2.186,
   "s": "吏呼一何怒！"
  },
  {
   "t": 15.355,
   "d": 2.436,
   "s": "妇啼一何苦！"
  },
  {
   "t": 18.011,
   "d": 3.756,
   "s": "听妇前致词：三男邺城戍。"
  },
  {
   "t": 21.987,
   "d": 3.936,
   "s": "一男附书至，二男新战死。"
  },
  {
   "t": 26.143,
   "d": 3.908,
   "s": "存者且偷生，死者长已矣！"
  },
  {
   "t": 30.271,
   "d": 3.7,
   "s": "室中更无人，惟有乳下孙。"
  },
  {
   "t": 34.191,
   "d": 3.644,
   "s": "有孙母未去，出入无完裙。"
  },
  {
   "t": 38.055,
   "d": 3.339,
   "s": "老妪力虽衰，请从吏夜归。"
  },
  {
   "t": 41.614,
   "d": 3.519,
   "s": "急应河阳役，犹得备晨炊。"
  },
  {
   "t": 45.353,
   "d": 3.631,
   "s": "夜久语声绝，如闻泣幽咽。"
  },
  {
   "t": 49.204,
   "d": 3.533,
   "s": "天明登前途，独与老翁别。"
  }
