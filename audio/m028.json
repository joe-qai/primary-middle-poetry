  },
  {
   "t": 1.403,
   "d": 2.028,
   "s": "唐代，杜甫"
  },
  {
   "t": 3.431,
   "d": 3.375,
   "s": "暮投石壕村，有吏夜捉人。"
  },
  {
   "t": 6.806,
   "d": 3.139,
   "s": "老翁逾墙走，老妇出门看。"
  },
  {
   "t": 9.944,
   "d": 1.847,
   "s": "吏呼一何怒！"
  },
  {
   "t": 11.792,
   "d": 2.097,
   "s": "妇啼一何苦！"
  },
  {
   "t": 13.889,
   "d": 3.417,
   "s": "听妇前致词：三男邺城戍。"
  },
  {
   "t": 17.306,
   "d": 3.597,
   "s": "一男附书至，二男新战死。"
  },
  {
   "t": 20.903,
   "d": 3.569,
   "s": "存者且偷生，死者长已矣！"
  },
  {
   "t": 24.472,
   "d": 3.361,
   "s": "室中更无人，惟有乳下孙。"
  },
  {
   "t": 27.833,
   "d": 3.306,
   "s": "有孙母未去，出入无完裙。"
  },
  {
   "t": 31.139,
   "d": 3.0,
   "s": "老妪力虽衰，请从吏夜归。"
  },
  {
   "t": 34.139,
   "d": 3.181,
   "s": "急应河阳役，犹得备晨炊。"
  },
  {
   "t": 37.319,
   "d": 3.292,
   "s": "夜久语声绝，如闻泣幽咽。"
  },
  {
   "t": 40.611,
   "d": 3.528,
   "s": "天明登前途，独与老翁别。"
  }
