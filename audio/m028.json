   "s": "寻梦者"
  },
  {
   "t": 1.486,
   "d": 2.736,
   "s": "现代，戴望舒"
  },
  {
   "t": 4.396,
   "d": 2.242,
   "s": "梦会开出花来的，"
  },
  {
   "t": 6.588,
   "d": 2.944,
   "s": "梦会开出娇妍的花来的，"
  },
  {
   "t": 9.532,
   "d": 2.736,
   "s": "去求无价的珍宝吧。"
  },
  {
   "t": 12.436,
   "d": 2.353,
   "s": "在青色的大海里，"
  },
  {
   "t": 14.739,
   "d": 2.208,
   "s": "在海底的明珠里，"
  },
  {
   "t": 16.947,
   "d": 2.5,
   "s": "去求，去寻找。"
  },
  {
   "t": 19.612,
   "d": 2.797,
   "s": "她们的生命便带去了。"
  },
  {
   "t": 22.516,
   "d": 2.853,
   "s": "那你还需要寻找什么？"
  },
  {
   "t": 25.492,
   "d": 1.811,
   "s": "你已寻到了——"
  },
  {
   "t": 27.253,
   "d": 3.153,
   "s": "美丽的梦曾给过你的。"
  },
  {
   "t": 30.58,
   "d": 2.228,
   "s": "那里是春的和煦，"
  },
  {
   "t": 32.758,
   "d": 1.847,
   "s": "是夏的热烈，"
  },
  {
   "t": 34.605,
   "d": 1.889,
   "s": "是秋的静美，"
  },
  {
   "t": 36.494,
   "d": 2.0,
   "s": "是冬的深沉——"
  },
  {
   "t": 38.494,
   "d": 2.903,
   "s": "全都包含在这梦里了。"
  },
  {
   "t": 41.548,
   "d": 3.075,
   "s": "所以我要去寻这梦的珍珠，"
  },
  {
   "t": 44.573,
   "d": 2.361,
   "s": "要历尽千辛万苦，"
  },
  {
   "t": 46.934,
   "d": 2.958,
   "s": "要到海的最深处去找。"
  },
  {
   "t": 50.044,
   "d": 2.172,
   "s": "因为那里面藏着"
  },
  {
   "t": 52.166,
   "d": 2.542,
