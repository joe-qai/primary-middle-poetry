  {
   "t": 1.889,
   "d": 2.736,
   "s": "东晋，陶渊明"
  },
  {
   "t": 4.78,
   "d": 7.589,
   "s": "先生不知何许人也，亦不详其姓字，宅边有五柳树，因以为号焉。"
  },
  {
   "t": 12.484,
   "d": 3.408,
   "s": "闲静少言，不慕荣利。"
  },
  {
   "t": 16.012,
   "d": 5.381,
   "s": "好读书，不求甚解；每有会意，便欣然忘食。"
  },
  {
   "t": 21.508,
   "d": 3.519,
   "s": "性嗜酒，家贫不能常得。"
  },
  {
   "t": 25.132,
   "d": 6.464,
   "s": "亲旧知其如此，或置酒而招之；造饮辄尽，期在必醉。"
  },
  {
   "t": 31.708,
   "d": 3.492,
   "s": "既醉而退，曾不吝情去留。"
  },
  {
   "t": 35.308,
   "d": 7.186,
   "s": "环堵萧然，不蔽风日；短褐穿结，箪瓢屡空，晏如也。"
  }
 ]
}