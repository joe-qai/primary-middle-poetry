   "s": "五柳先生传"
  },
  {
   "t": 1.889,
   "d": 2.403,
   "s": "东晋，陶渊明"
  },
  {
   "t": 4.292,
   "d": 7.25,
   "s": "先生不知何许人也，亦不详其姓字，宅边有五柳树，因以为号焉。"
  },
  {
   "t": 11.542,
   "d": 3.069,
   "s": "闲静少言，不慕荣利。"
  },
  {
   "t": 14.611,
   "d": 5.042,
   "s": "好读书，不求甚解；每有会意，便欣然忘食。"
  },
  {
   "t": 19.653,
   "d": 3.181,
   "s": "性嗜酒，家贫不能常得。"
  },
  {
   "t": 22.833,
   "d": 6.125,
   "s": "亲旧知其如此，或置酒而招之；造饮辄尽，期在必醉。"
  },
  {
   "t": 28.958,
   "d": 3.153,
   "s": "既醉而退，曾不吝情去留。"
  },
  {
   "t": 32.111,
   "d": 6.847,
   "s": "环堵萧然，不蔽风日；短褐穿结，箪瓢屡空，晏如也。"
  }
 ]
}