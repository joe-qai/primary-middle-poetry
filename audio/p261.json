 "cues": [
  {
   "t": 0.1,
   "d": 1.839,
   "s": "五柳先生传"
  },
  {
   "t": 1.889,
   "d": 2.736,
   "s": "东晋，陶渊明"
  },
  {
   "t": 4.78,
   "d": 7.589,
   "s": "先生不知何许人也，亦不详其姓字，宅边有五柳树，因以为号焉。"
  },
  {
   "t": 12.484,
   "d": 3.408,
   "s": "闲静少言，不慕荣利。"
  },
  {
   "t": 16.012,
   "d": 5.464,
   "s": "好读书，不求甚解；每有会意，便欣然忘食。"
  },
  {
   "t": 21.58,
   "d": 3.519,
   "s": "性嗜酒，家贫不能常得。"
  },
  {
   "t": 25.204,
   "d": 6.464,
   "s": "亲旧知其如此，或置酒而招之；造饮辄尽，期在必醉。"
  },
  {
   "t": 31.78,
   "d": 3.492,
   "s": "既醉而退，曾不吝情去留。"
  },
  {
   "t": 35.38,
   "d": 7.186,
   "s": "环堵萧然，不蔽风日；短褐穿结，箪瓢屡空，晏如也。"
  },
  {
   "t": 42.676,
   "d": 3.714,
   "s": "常著文章自娱，颇示己志。"
  },
  {
   "t": 46.492,
   "d": 3.394,
   "s": "忘怀得失，以此自终。"
  },
  {
   "t": 49.996,
   "d": 6.228,
   "s": "赞曰：黔娄之妻有言，不戚戚于贫贱，不汲汲于富贵。"
  },
  {
   "t": 56.332,
   "d": 3.103,
   "s": "其言兹若人之俦乎？"
  },
  {
   "t": 59.548,
   "d": 3.283,
   "s": "衔觞赋诗，以乐其志。"
  },
  {
   "t": 62.932,
   "d": 2.547,
   "s": "无怀氏之民欤？"
  },
  {
   "t": 65.596,
   "d": 2.561,
   "s": "葛天氏之民欤？"
  }
 ]
}