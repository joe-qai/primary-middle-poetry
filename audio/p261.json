   "d": 1.611,
   "s": "闲静"
  },
  {
   "t": 23.877,
   "d": 2.436,
   "s": "少言，不慕荣利。"
  },
  {
   "t": 26.263,
   "d": 2.347,
   "s": "好读书，不求"
  },
  {
   "t": 31.546,
   "d": 2.269,
   "s": "甚解；每有"
  },
  {
   "t": 34.215,
   "d": 2.783,
   "s": "会意，便欣然忘食。"
  },
  {
   "t": 36.948,
