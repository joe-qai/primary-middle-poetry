 "cues": [
  {
   "t": 0.1,
   "d": 3.061,
   "s": "生于忧患，死于安乐"
  },
  {
   "t": 3.111,
   "d": 2.181,
   "s": "战国，孟子"
  },
  {
   "t": 5.292,
   "d": 10.208,
   "s": "舜发于畎亩之中，傅说举于版筑之间，胶鬲举于鱼盐之中，管夷吾举于士，孙叔敖举于海，百里奚举于市。"
  },
  {
   "t": 15.5,
   "d": 12.375,
   "s": "故天将降大任于是人也，必先苦其心志，劳其筋骨，饿其体肤，空乏其身，行拂乱其所为，所以动心忍性，曾益其所不能。"
  },
  {
   "t": 27.875,
   "d": 8.792,
   "s": "人恒过，然后能改；困于心，衡于虑，而后作；征于色，发于声，而后喻。"
  },
  {
   "t": 36.667,
   "d": 5.458,
   "s": "入则无法家拂士，出则无敌国外患者，国恒亡。"
  },
  {
   "t": 42.125,
   "d": 4.542,
   "s": "然后知生于忧患，而死于安乐也。"
  }
 ]
}