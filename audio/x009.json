 "hdr": 2,
 "bodyCues": 47,
 "v": "ca7057a4",
 "cues": [
  {
   "t": 0.1,
   "d": 1.436,
   "s": "琵琶行"
  },
  {
   "t": 1.486,
   "d": 2.597,
   "s": "唐代，白居易"
  },
  {
   "t": 4.252,
   "d": 4.95,
   "s": "浔阳江头夜送客，枫叶荻花秋瑟瑟。"
  },
  {
   "t": 9.316,
   "d": 4.756,
   "s": "主人下马客在船，举酒欲饮无管弦。"
  },
  {
   "t": 14.188,
   "d": 4.339,
   "s": "醉不成欢惨将别，别时茫茫江浸月。"
  },
  {
   "t": 18.628,
   "d": 4.575,
   "s": "忽闻水上琵琶声，主人忘归客不发。"
  },
  {
   "t": 23.308,
   "d": 4.644,
   "s": "寻声暗问弹者谁，琵琶声停欲语迟。"
  },
  {
   "t": 28.06,
   "d": 4.769,
   "s": "移船相近邀相见，添酒回灯重开宴。"
  },
  {
   "t": 32.932,
   "d": 4.519,
   "s": "千呼万唤始出来，犹抱琵琶半遮面。"
  },
  {
   "t": 37.564,
   "d": 4.811,
   "s": "转轴拨弦三两声，未成曲调先有情。"
  },
  {
   "t": 42.484,
   "d": 4.492,
   "s": "弦弦掩抑声声思，似诉平生不得志。"
  },
  {
   "t": 47.092,
   "d": 4.603,
   "s": "低眉信手续续弹，说尽心中无限事。"
  },
  {
   "t": 51.796,
   "d": 4.672,
   "s": "轻拢慢捻抹复挑，初为霓裳后六幺。"
  },
  {
   "t": 56.572,
   "d": 4.867,
   "s": "大弦嘈嘈如急雨，小弦切切如私语。"
  },
  {
   "t": 61.54,
   "d": 5.131,
   "s": "嘈嘈切切错杂弹，大珠小珠落玉盘。"
  },
  {
   "t": 66.772,
   "d": 4.686,
   "s": "间关莺语花底滑，幽咽泉流冰下难。"
  },
  {
   "t": 71.572,
   "d": 4.617,
   "s": "冰泉冷涩弦凝绝，凝绝不通声暂歇。"
  },
  {
   "t": 76.3,
   "d": 4.422,
   "s": "别有幽愁暗恨生，此时无声胜有声。"
  },
  {
   "t": 80.836,
   "d": 4.561,
   "s": "银瓶乍破水浆迸，铁骑突出刀枪鸣。"
  },
  {
   "t": 85.516,
   "d": 4.408,
   "s": "曲终收拨当心画，四弦一声如裂帛。"
  },
  {
   "t": 90.028,
   "d": 4.783,
   "s": "东船西舫悄无言，唯见江心秋月白。"
  },
  {
   "t": 94.924,
   "d": 4.714,
   "s": "沉吟放拨插弦中，整顿衣裳起敛容。"
  },
  {
   "t": 99.748,
   "d": 4.311,
   "s": "自言本是京城女，家在虾蟆陵下住。"
  },
  {
   "t": 104.164,
   "d": 4.353,
   "s": "十三学得琵琶成，名属教坊第一部。"
  },
  {
   "t": 108.628,
   "d": 4.7,
   "s": "曲罢曾教善才服，妆成每被秋娘妒。"
  },
  {
   "t": 113.452,
   "d": 4.575,
   "s": "五陵年少争缠头，一曲红绡不知数。"
  },
  {
   "t": 118.132,
   "d": 4.756,
   "s": "钿头银篦击节碎，血色罗裙翻酒污。"
  },
  {
   "t": 123.004,
   "d": 4.769,
   "s": "今年欢笑复明年，秋月春风等闲度。"
  },
  {
   "t": 127.876,
   "d": 4.464,
   "s": "弟走从军阿姨死，暮去朝来颜色故。"
  },
  {
   "t": 132.46,
   "d": 4.519,
   "s": "门前冷落鞍马稀，老大嫁作商人妇。"
  },
  {
   "t": 137.092,
   "d": 4.325,
   "s": "商人重利轻别离，前月浮梁买茶去。"
  },
  {
   "t": 141.532,
   "d": 4.631,
   "s": "去来江口守空船，绕船月明江水寒。"
  },
  {
   "t": 146.284,
   "d": 4.714,
   "s": "夜深忽梦少年事，梦啼妆泪红阑干。"
  },
  {
   "t": 151.108,
   "d": 4.297,
   "s": "我闻琵琶已叹息，又闻此语重唧唧。"
  },
  {
   "t": 155.524,
   "d": 4.7,
   "s": "同是天涯沦落人，相逢何必曾相识！"
  },
  {
   "t": 160.324,
   "d": 4.492,
   "s": "我从去年辞帝京，谪居卧病浔阳城。"
  },
  {
   "t": 164.932,
   "d": 4.756,
   "s": "浔阳地僻无音乐，终岁不闻丝竹声。"
  },
  {
   "t": 169.804,
   "d": 4.728,
   "s": "住近湓江地低湿，黄芦苦竹绕宅生。"
  },
  {
   "t": 174.652,
   "d": 2.728,
   "s": "其间旦暮闻何物？"
  },
  {
   "t": 177.484,
   "d": 2.756,
   "s": "杜鹃啼血猿哀鸣。"
  },
  {
   "t": 180.34,
   "d": 4.95,
   "s": "春江花朝秋月夜，往往取酒还独倾。"
  },
  {
   "t": 185.404,
   "d": 2.617,
   "s": "岂无山歌与村笛？"
  },
  {
   "t": 188.14,
   "d": 2.561,
   "s": "呕哑嘲哳难为听。"
  },
  {
   "t": 190.804,
   "d": 4.811,
   "s": "今夜闻君琵琶语，如听仙乐耳暂明。"
  },
  {
   "t": 195.724,
   "d": 4.811,
   "s": "莫辞更坐弹一曲，为君翻作琵琶行。"
  },
  {
   "t": 200.644,
   "d": 4.631,
   "s": "感我此言良久立，却坐促弦弦转急。"
  },
  {
   "t": 205.396,
   "d": 4.575,
   "s": "凄凄不似向前声，满座重闻皆掩泣。"
  },
  {
   "t": 210.076,
   "d": 2.95,
   "s": "座中泣下谁最多？"
  },
  {
   "t": 213.148,
   "d": 2.811,
   "s": "江州司马青衫湿。"
  }
 ]
}