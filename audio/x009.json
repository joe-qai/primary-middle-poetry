{
 "id": "x009",
 "title": "琵琶行",
 "voice": "zh-CN-YunjianNeural",
 "rate": "-10%",
 "dur": 194.82,
 "hdr": 2,
 "bodyCues": 47,
 "v": "362b8c61",
 "cues": [
  {
   "t": 0.1,
   "d": 1.436,
   "s": "琵琶行"
  },
  {
   "t": 1.486,
   "d": 2.264,
   "s": "唐代，白居易"
  },
  {
   "t": 3.75,
   "d": 4.611,
   "s": "浔阳江头夜送客，枫叶荻花秋瑟瑟。"
  },
  {
   "t": 8.361,
   "d": 4.417,
   "s": "主人下马客在船，举酒欲饮无管弦。"
  },
  {
   "t": 12.778,
   "d": 4.0,
   "s": "醉不成欢惨将别，别时茫茫江浸月。"
  },
  {
   "t": 16.778,
   "d": 4.236,
   "s": "忽闻水上琵琶声，主人忘归客不发。"
  },
  {
   "t": 21.014,
   "d": 4.306,
   "s": "寻声暗问弹者谁，琵琶声停欲语迟。"
  },
  {
   "t": 25.319,
   "d": 4.431,
   "s": "移船相近邀相见，添酒回灯重开宴。"
  },
  {
   "t": 29.75,
   "d": 4.181,
   "s": "千呼万唤始出来，犹抱琵琶半遮面。"
  },
  {
   "t": 33.931,
   "d": 4.472,
   "s": "转轴拨弦三两声，未成曲调先有情。"
  },
  {
   "t": 38.403,
   "d": 4.153,
   "s": "弦弦掩抑声声思，似诉平生不得志。"
  },
  {
   "t": 42.556,
   "d": 4.264,
   "s": "低眉信手续续弹，说尽心中无限事。"
  },
  {
   "t": 46.819,
   "d": 4.333,
   "s": "轻拢慢捻抹复挑，初为霓裳后六幺。"
  },
  {
   "t": 51.153,
   "d": 4.528,
   "s": "大弦嘈嘈如急雨，小弦切切如私语。"
  },
  {
   "t": 55.681,
   "d": 4.792,
   "s": "嘈嘈切切错杂弹，大珠小珠落玉盘。"
  },
  {
   "t": 60.472,
   "d": 4.347,
   "s": "间关莺语花底滑，幽咽泉流冰下难。"
  },
  {
   "t": 64.819,
   "d": 4.278,
   "s": "冰泉冷涩弦凝绝，凝绝不通声暂歇。"
  },
  {
   "t": 69.097,
   "d": 4.083,
   "s": "别有幽愁暗恨生，此时无声胜有声。"
  },
  {
   "t": 73.181,
   "d": 4.278,
   "s": "银瓶乍破水浆迸，铁骑突出刀枪鸣。"
  },
  {
   "t": 77.458,
   "d": 4.069,
   "s": "曲终收拨当心画，四弦一声如裂帛。"
  },
  {
   "t": 81.528,
   "d": 4.444,
   "s": "东船西舫悄无言，唯见江心秋月白。"
  },
  {
   "t": 85.972,
   "d": 4.375,
   "s": "沉吟放拨插弦中，整顿衣裳起敛容。"
  },
  {
   "t": 90.347,
   "d": 3.972,
   "s": "自言本是京城女，家在虾蟆陵下住。"
  },
  {
   "t": 94.319,
   "d": 4.014,
   "s": "十三学得琵琶成，名属教坊第一部。"
  },
  {
   "t": 98.333,
   "d": 4.361,
   "s": "曲罢曾教善才服，妆成每被秋娘妒。"
  },
  {
   "t": 102.694,
   "d": 4.236,
   "s": "五陵年少争缠头，一曲红绡不知数。"
  },
  {
   "t": 106.931,
   "d": 4.417,
   "s": "钿头银篦击节碎，血色罗裙翻酒污。"
  },
  {
   "t": 111.347,
   "d": 4.431,
   "s": "今年欢笑复明年，秋月春风等闲度。"
  },
  {
   "t": 115.778,
   "d": 4.125,
   "s": "弟走从军阿姨死，暮去朝来颜色故。"
  },
  {
   "t": 119.903,
   "d": 4.181,
   "s": "门前冷落鞍马稀，老大嫁作商人妇。"
  },
  {
   "t": 124.083,
   "d": 3.986,
   "s": "商人重利轻别离，前月浮梁买茶去。"
  },
  {
   "t": 128.069,
   "d": 4.292,
   "s": "去来江口守空船，绕船月明江水寒。"
  },
  {
   "t": 132.361,
   "d": 4.375,
   "s": "夜深忽梦少年事，梦啼妆泪红阑干。"
  },
  {
   "t": 136.736,
   "d": 3.958,
   "s": "我闻琵琶已叹息，又闻此语重唧唧。"
  },
  {
   "t": 140.694,
   "d": 4.361,
   "s": "同是天涯沦落人，相逢何必曾相识！"
  },
  {
   "t": 145.056,
   "d": 4.153,
   "s": "我从去年辞帝京，谪居卧病浔阳城。"
  },
  {
   "t": 149.208,
   "d": 4.417,
   "s": "浔阳地僻无音乐，终岁不闻丝竹声。"
  },
  {
   "t": 153.625,
   "d": 4.389,
   "s": "住近湓江地低湿，黄芦苦竹绕宅生。"
  },
  {
   "t": 158.014,
   "d": 2.389,
   "s": "其间旦暮闻何物？"
  },
  {
   "t": 160.403,
   "d": 2.417,
   "s": "杜鹃啼血猿哀鸣。"
  },
  {
   "t": 162.819,
   "d": 4.611,
   "s": "春江花朝秋月夜，往往取酒还独倾。"
  },
  {
   "t": 167.431,
   "d": 2.278,
   "s": "岂无山歌与村笛？"
  },
  {
   "t": 169.708,
   "d": 2.222,
   "s": "呕哑嘲哳难为听。"
  },
  {
   "t": 171.931,
   "d": 4.472,
   "s": "今夜闻君琵琶语，如听仙乐耳暂明。"
  },
  {
   "t": 176.403,
   "d": 4.472,
   "s": "莫辞更坐弹一曲，为君翻作琵琶行。"
  },
  {
   "t": 180.875,
   "d": 4.292,
   "s": "感我此言良久立，却坐促弦弦转急。"
  },
  {
   "t": 185.167,
   "d": 4.236,
   "s": "凄凄不似向前声，满座重闻皆掩泣。"
  },
  {
   "t": 189.403,
   "d": 2.611,
   "s": "座中泣下谁最多？"
  },
  {
   "t": 192.014,
   "d": 2.806,
   "s": "江州司马青衫湿。"
  }
 ]
}