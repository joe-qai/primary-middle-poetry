{
 "id": "x012",
 "title": "兰亭集序",
 "voice": "zh-CN-YunjianNeural",
 "rate": "-10%",
 "dur": 102.236,
 "hdr": 2,
 "bodyCues": 17,
 "v": "d5aef355",
 "cues": [
  {
   "t": 0.1,
   "d": 1.672,
   "s": "兰亭集序"
  },
  {
   "t": 1.722,
   "d": 2.292,
   "s": "东晋，王羲之"
  },
  {
   "t": 4.014,
   "d": 7.222,
   "s": "永和九年，岁在癸丑，暮春之初，会于会稽山阴之兰亭，修禊事也。"
  },
  {
   "t": 11.236,
   "d": 3.111,
   "s": "群贤毕至，少长咸集。"
  },
  {
   "t": 14.347,
   "d": 9.181,
   "s": "此地有崇山峻岭，茂林修竹，又有清流激湍，映带左右，引以为流觞曲水，列坐其次。"
  },
  {
   "t": 23.528,
   "d": 5.333,
   "s": "虽无丝竹管弦之盛，一觞一咏，亦足以畅叙幽情。"
  },
  {
   "t": 28.861,
   "d": 4.236,
   "s": "是日也，天朗气清，惠风和畅。"
  },
  {
   "t": 33.097,
   "d": 8.069,
   "s": "仰观宇宙之大，俯察品类之盛，所以游目骋怀，足以极视听之娱，信可乐也。"
  },
  {
   "t": 41.167,
   "d": 2.889,
   "s": "夫人之相与，俯仰一世。"
  },
  {
   "t": 44.056,
   "d": 6.292,
   "s": "或取诸怀抱，悟言一室之内；或因寄所托，放浪形骸之外。"
  },
  {
   "t": 50.347,
   "d": 12.736,
   "s": "虽趣舍万殊，静躁不同，当其欣于所遇，暂得于己，快然自足，不知老之将至；及其所之既倦，情随事迁，感慨系之矣。"
  },
  {
   "t": 63.083,
   "d": 8.569,
   "s": "向之所欣，俯仰之间，已为陈迹，犹不能不以之兴怀，况修短随化，终期于尽！"
  },
  {
   "t": 71.653,
   "d": 3.167,
   "s": "古人云：死生亦大矣。"
  },
  {
   "t": 74.819,
   "d": 1.556,
   "s": "岂不痛哉！"
  },
  {
   "t": 76.375,
   "d": 7.083,
   "s": "每览昔人兴感之由，若合一契，未尝不临文嗟悼，不能喻之于怀。"
  },
  {
   "t": 83.458,
   "d": 4.389,
   "s": "固知一死生为虚诞，齐彭殇为妄作。"
  },
  {
   "t": 87.847,
   "d": 3.944,
   "s": "后之视今，亦犹今之视昔，悲夫！"
  },
  {
   "t": 91.792,
   "d": 6.569,
   "s": "故列叙时人，录其所述，虽世殊事异，所以兴怀，其致一也。"
  },
  {
   "t": 98.361,
   "d": 3.875,
   "s": "后之览者，亦将有感于斯文。"
  }
 ]
}