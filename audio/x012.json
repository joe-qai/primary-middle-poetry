 "bodyCues": 17,
 "v": "9d45701b",
 "cues": [
  {
   "t": 0.1,
   "d": 1.672,
   "s": "兰亭集序"
  },
  {
   "t": 1.722,
   "d": 2.625,
   "s": "东晋，王羲之"
  },
  {
   "t": 4.516,
   "d": 7.7,
   "s": "永和九年，岁在癸丑，暮春之初，会于会稽山阴之兰亭，修禊事也。"
  },
  {
   "t": 12.316,
   "d": 3.45,
   "s": "群贤毕至，少长咸集。"
  },
  {
   "t": 15.868,
   "d": 9.519,
   "s": "此地有崇山峻岭，茂林修竹，又有清流激湍，映带左右，引以为流觞曲水，列坐其次。"
  },
  {
   "t": 25.492,
   "d": 5.672,
   "s": "虽无丝竹管弦之盛，一觞一咏，亦足以畅叙幽情。"
  },
  {
   "t": 31.276,
   "d": 4.575,
   "s": "是日也，天朗气清，惠风和畅。"
  },
  {
   "t": 35.956,
   "d": 8.408,
   "s": "仰观宇宙之大，俯察品类之盛，所以游目骋怀，足以极视听之娱，信可乐也。"
  },
  {
   "t": 44.476,
   "d": 3.228,
   "s": "夫人之相与，俯仰一世。"
  },
  {
   "t": 47.812,
   "d": 6.631,
   "s": "或取诸怀抱，悟言一室之内；或因寄所托，放浪形骸之外。"
  },
  {
   "t": 54.556,
   "d": 13.075,
   "s": "虽趣舍万殊，静躁不同，当其欣于所遇，暂得于己，快然自足，不知老之将至；及其所之既倦，情随事迁，感慨系之矣。"
  },
  {
   "t": 67.732,
   "d": 8.908,
   "s": "向之所欣，俯仰之间，已为陈迹，犹不能不以之兴怀，况修短随化，终期于尽！"
  },
  {
   "t": 76.756,
   "d": 3.506,
   "s": "古人云：死生亦大矣。"
  },
  {
   "t": 80.38,
   "d": 1.894,
   "s": "岂不痛哉！"
  },
  {
   "t": 82.396,
   "d": 7.422,
   "s": "每览昔人兴感之由，若合一契，未尝不临文嗟悼，不能喻之于怀。"
  },
  {
   "t": 89.932,
   "d": 4.728,
   "s": "固知一死生为虚诞，齐彭殇为妄作。"
  },
  {
   "t": 94.78,
   "d": 4.283,
   "s": "后之视今，亦犹今之视昔，悲夫！"
  },
  {
   "t": 99.172,
   "d": 6.908,
   "s": "故列叙时人，录其所述，虽世殊事异，所以兴怀，其致一也。"
  },
  {
   "t": 106.18,
   "d": 3.881,
   "s": "后之览者，亦将有感于斯文。"
  }
 ]
}