  {
   "t": 0.1,
   "d": 1.297,
   "s": "蒹葭"
  },
  {
   "t": 1.347,
   "d": 2.0,
   "s": "诗经，佚名"
  },
  {
   "t": 3.347,
   "d": 2.736,
   "s": "蒹葭苍苍，白露为霜。"
  },
  {
   "t": 6.083,
   "d": 2.889,
   "s": "所谓伊人，在水一方。"
  },
  {
   "t": 8.972,
   "d": 3.097,
   "s": "溯洄从之，道阻且长。"
  },
  {
   "t": 12.069,
   "d": 3.167,
   "s": "溯游从之，宛在水中央。"
  },
  {
   "t": 15.236,
   "d": 2.819,
   "s": "蒹葭萋萋，白露未晞。"
  },
  {
   "t": 18.056,
   "d": 2.944,
   "s": "所谓伊人，在水之湄。"
  },
  {
   "t": 21.0,
   "d": 3.028,
   "s": "溯洄从之，道阻且跻。"
  },
  {
   "t": 24.028,
   "d": 3.194,
   "s": "溯游从之，宛在水中坻。"
  },
  {
   "t": 27.222,
   "d": 2.944,
   "s": "蒹葭采采，白露未已。"
  },
  {
   "t": 30.167,
   "d": 3.083,
   "s": "所谓伊人，在水之涘。"
  },
  {
   "t": 33.25,
   "d": 3.014,
   "s": "溯洄从之，道阻且右。"
  },
  {
   "t": 36.264,
   "d": 3.514,
   "s": "溯游从之，宛在水中沚。"
  }
 ]
}