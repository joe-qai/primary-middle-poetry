  },
  {
   "t": 5.177,
   "d": 3.075,
   "s": "蒹葭苍苍，白露为霜。"
  },
  {
   "t": 8.472,
   "d": 3.228,
   "s": "所谓伊人，在水一方。"
  },
  {
   "t": 11.92,
   "d": 3.436,
   "s": "溯洄从之，道阻且长。"
  },
  {
   "t": 15.576,
   "d": 3.506,
   "s": "溯游从之，宛在水中央。"
  },
  {
   "t": 19.302,
   "d": 3.158,
   "s": "蒹葭萋萋，白露未晞。"
  },
  {
   "t": 22.68,
   "d": 3.283,
   "s": "所谓伊人，在水之湄。"
  },
  {
   "t": 26.183,
   "d": 3.367,
   "s": "溯洄从之，道阻且跻。"
  },
  {
   "t": 29.77,
   "d": 3.533,
   "s": "溯游从之，宛在水中坻。"
  },
  {
   "t": 33.523,
   "d": 3.283,
   "s": "蒹葭采采，白露未已。"
  },
  {
   "t": 37.026,
   "d": 3.422,
