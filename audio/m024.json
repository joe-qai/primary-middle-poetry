   "s": "诗经，佚名"
  },
  {
   "t": 3.844,
   "d": 3.075,
   "s": "蒹葭苍苍，白露为霜。"
  },
  {
   "t": 7.036,
   "d": 3.228,
   "s": "所谓伊人，在水一方。"
  },
  {
   "t": 10.372,
   "d": 3.436,
   "s": "溯洄从之，道阻且长。"
  },
  {
   "t": 13.924,
   "d": 3.506,
   "s": "溯游从之，宛在水中央。"
  },
  {
   "t": 17.548,
   "d": 3.158,
   "s": "蒹葭萋萋，白露未晞。"
  },
  {
   "t": 20.812,
   "d": 3.283,
   "s": "所谓伊人，在水之湄。"
  },
  {
   "t": 24.196,
   "d": 3.367,
   "s": "溯洄从之，道阻且跻。"
  },
  {
   "t": 27.676,
   "d": 3.533,
   "s": "溯游从之，宛在水中坻。"
  },
  {
   "t": 31.324,
   "d": 3.283,
   "s": "蒹葭采采，白露未已。"
  },
  {
   "t": 34.708,
   "d": 3.422,
   "s": "所谓伊人，在水之涘。"
  },
  {
   "t": 38.236,
