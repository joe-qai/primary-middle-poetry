   "s": "宋代，苏轼"
  },
  {
   "t": 6.028,
   "d": 3.167,
   "s": "缺月挂疏桐，漏断人初静。"
  },
  {
   "t": 9.194,
   "d": 4.111,
   "s": "谁见幽人独往来，缥缈孤鸿影。"
  },
  {
   "t": 13.306,
