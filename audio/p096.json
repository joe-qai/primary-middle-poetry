 "cues": [
  {
   "t": 0.1,
   "d": 1.311,
   "s": "木兰诗"
  },
  {
   "t": 1.361,
   "d": 2.542,
   "s": "北朝民歌，佚名"
  },
  {
   "t": 3.903,
   "d": 2.889,
   "s": "唧唧复唧唧，木兰当户织。"
  },
  {
   "t": 6.792,
   "d": 3.333,
   "s": "不闻机杼声，唯闻女叹息。"
  },
  {
   "t": 10.125,
   "d": 3.167,
   "s": "问女何所思，问女何所忆。"
  },
  {
   "t": 13.292,
   "d": 3.236,
   "s": "女亦无所思，女亦无所忆。"
  },
  {
   "t": 16.528,
   "d": 3.681,
   "s": "昨夜见军帖，可汗大点兵。"
  },
  {
   "t": 20.208,
   "d": 3.528,
   "s": "军书十二卷，卷卷有爷名。"
  },
  {
   "t": 23.736,
   "d": 2.972,
   "s": "阿爷无大儿，木兰无长兄。"
  },
  {
   "t": 26.708,
   "d": 3.458,
   "s": "愿为市鞍马，从此替爷征。"
  },
  {
   "t": 30.167,
   "d": 6.0,
   "s": "东市买骏马，西市买鞍鞯，南市买辔头，北市买长鞭。"
  },
  {
   "t": 36.167,
   "d": 3.417,
   "s": "旦辞爷娘去，暮宿黄河边。"
  },
  {
   "t": 39.583,
   "d": 4.75,
   "s": "不闻爷娘唤女声，但闻黄河流水鸣溅溅。"
  },
  {
   "t": 44.333,
   "d": 3.5,
   "s": "旦辞黄河去，暮至黑山头。"
  },
  {
   "t": 47.833,
   "d": 4.625,
   "s": "不闻爷娘唤女声，但闻燕山胡骑鸣啾啾。"
  },
  {
   "t": 52.458,
   "d": 3.236,
   "s": "万里赴戎机，关山度若飞。"
  },
  {
   "t": 55.694,
   "d": 3.75,
   "s": "朔气传金柝，寒光照铁衣。"
  },
  {
   "t": 59.444,
   "d": 3.569,
   "s": "将军百战死，壮士十年归。"
  },
  {
   "t": 63.014,
   "d": 3.667,
   "s": "归来见天子，天子坐明堂。"
  },
  {
   "t": 66.681,
   "d": 3.597,
   "s": "策勋十二转，赏赐百千强。"
  },
  {
   "t": 70.278,
   "d": 3.556,
   "s": "可汗问所欲，木兰不用尚书郎，"
  },
  {
   "t": 73.833,
   "d": 3.458,
   "s": "愿驰千里足，送儿还故乡。"
  },
  {
   "t": 77.292,
   "d": 3.361,
   "s": "爷娘闻女来，出郭相扶将；"
  },
  {
   "t": 80.653,
   "d": 6.528,
   "s": "阿姊闻妹来，当户理红妆；小弟闻姊来，磨刀霍霍向猪羊。"
  },
  {
   "t": 87.181,
   "d": 3.028,
   "s": "开我东阁门，坐我西阁床。"
  },
  {
   "t": 90.208,
   "d": 3.111,
   "s": "脱我战时袍，著我旧时裳。"
  },
  {
   "t": 93.319,
   "d": 3.347,
   "s": "当窗理云鬓，对镜帖花黄。"
  },
  {
   "t": 96.667,
   "d": 3.389,
   "s": "出门看火伴，火伴皆惊忙："
  },
  {
   "t": 100.056,
   "d": 3.653,
   "s": "同行十二年，不知木兰是女郎。"
  },
  {
   "t": 103.708,
   "d": 3.319,
   "s": "雄兔脚扑朔，雌兔眼迷离；"
  },
  {
   "t": 107.028,
   "d": 4.194,
   "s": "双兔傍地走，安能辨我是雄雌？"
  }
 ]
}