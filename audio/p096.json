   "s": "木兰诗"
  },
  {
   "t": 1.361,
   "d": 2.875,
   "s": "北朝民歌，佚名"
  },
  {
   "t": 5.747,
   "d": 1.506,
   "s": "唧唧"
  },
  {
   "t": 7.653,
   "d": 2.797,
   "s": "复唧唧，木兰当户"
  },
  {
   "t": 10.85,
   "d": 0.964,
   "s": "织。"
  },
  {
   "t": 11.764,
   "d": 3.333,
   "s": "不闻机杼声，唯闻女叹息。"
  },
  {
   "t": 15.097,
   "d": 1.528,
   "s": "问女"
  },
  {
   "t": 22.436,
   "d": 3.033,
   "s": "何所思，问女何所"
  },
  {
   "t": 25.869,
   "d": 0.992,
   "s": "忆。"
  },
  {
   "t": 26.811,
   "d": 3.236,
   "s": "女亦无所思，女亦无所忆。"
  },
  {
   "t": 30.047,
   "d": 1.5,
   "s": "昨夜"
  },
  {
   "t": 37.317,
   "d": 3.256,
   "s": "见军帖，可汗大点"
  },
  {
   "t": 40.973,
   "d": 1.019,
   "s": "兵。"
  },
  {
   "t": 41.942,
   "d": 3.528,
   "s": "军书十二卷，卷卷有爷名。"
  },
  {
   "t": 45.47,
   "d": 1.472,
   "s": "阿爷"
  },
  {
   "t": 53.058,
   "d": 2.686,
   "s": "无大儿，木兰无长"
  },
  {
   "t": 56.144,
   "d": 1.144,
   "s": "兄。"
  },
  {
   "t": 57.238,
   "d": 3.458,
   "s": "愿为市鞍马，从此替爷征。"
  },
  {
   "t": 60.697,
   "d": 1.528,
   "s": "东市"
  },
  {
   "t": 68.521,
   "d": 2.547,
   "s": "买骏马，西市"
  },
  {
   "t": 71.468,
   "d": 2.45,
   "s": "买鞍鞯，南市"
  },
  {
   "t": 74.318,
   "d": 2.853,
   "s": "买辔头，北市买长鞭。"
  },
  {
   "t": 77.121,
   "d": 1.556,
   "s": "旦辞"
  },
  {
   "t": 82.03,
   "d": 3.256,
   "s": "爷娘去，暮宿黄河"
  },
  {
   "t": 85.686,
   "d": 1.006,
   "s": "边。"
  },
  {
   "t": 86.642,
   "d": 4.75,
   "s": "不闻爷娘唤女声，但闻黄河流水鸣溅溅。"
  },
  {
   "t": 91.392,
   "d": 1.556,
   "s": "旦辞"
  },
  {
   "t": 100.26,
   "d": 3.242,
   "s": "黄河去，暮至黑山"
  },
  {
   "t": 103.902,
   "d": 0.992,
   "s": "头。"
  },
  {
   "t": 104.844,
   "d": 4.625,
   "s": "不闻爷娘唤女声，但闻燕山胡骑鸣啾啾。"
  },
  {
   "t": 109.469,
   "d": 1.486,
   "s": "万里"
  },
  {
   "t": 118.114,
   "d": 2.95,
   "s": "赴戎机，关山度若"
  },
  {
   "t": 121.464,
   "d": 1.006,
   "s": "飞。"
  },
  {
   "t": 122.42,
   "d": 3.75,
   "s": "朔气传金柝，寒光照铁衣。"
  },
  {
   "t": 126.17,
   "d": 1.639,
   "s": "将军"
  },
  {
   "t": 134.121,
   "d": 3.033,
   "s": "百战死，壮士十年"
  },
  {
   "t": 137.554,
   "d": 0.936,
   "s": "归。"
  },
  {
   "t": 138.44,
   "d": 3.667,
   "s": "归来见天子，天子坐明堂。"
  },
  {
   "t": 142.107,
   "d": 1.569,
   "s": "策勋"
  },
  {
   "t": 149.765,
   "d": 3.103,
   "s": "十二转，赏赐百千"
  },
  {
   "t": 153.268,
   "d": 1.047,
   "s": "强。"
  },
  {
   "t": 154.265,
   "d": 3.25,
   "s": "可汗问所欲，木兰不用"
  },
  {
   "t": 159.062,
   "d": 1.45,
   "s": "尚书郎，"
  },
  {
   "t": 160.462,
   "d": 1.528,
   "s": "愿驰"
  },
  {
   "t": 163.94,
   "d": 3.103,
   "s": "千里足，送儿还故"
  },
  {
   "t": 167.443,
   "d": 1.075,
   "s": "乡。"
  },
  {
   "t": 168.468,
   "d": 2.931,
   "s": "爷娘闻女来，出郭"
  },
  {
   "t": 172.974,
   "d": 1.575,
   "s": "相扶将；"
  },
  {
   "t": 174.499,
   "d": 1.528,
   "s": "阿姊"
  },
  {
   "t": 178.102,
   "d": 2.436,
   "s": "闻妹来，当户"
  },
  {
   "t": 180.938,
   "d": 2.575,
   "s": "理红妆；小弟"
  },
  {
   "t": 183.913,
   "d": 3.506,
   "s": "闻姊来，磨刀霍霍向猪羊。"
  },
  {
   "t": 187.369,
   "d": 1.597,
   "s": "开我"
  },
  {
   "t": 192.972,
   "d": 2.978,
   "s": "东阁门，坐我西阁"
  },
  {
   "t": 196.35,
   "d": 1.047,
   "s": "床。"
  },
  {
   "t": 197.347,
   "d": 3.111,
   "s": "脱我战时袍，著我旧时裳。"
  },
  {
   "t": 200.458,
   "d": 1.583,
   "s": "当窗"
  },
  {
   "t": 207.796,
   "d": 3.089,
   "s": "理云鬓，对镜帖花"
  },
  {
   "t": 211.285,
   "d": 1.033,
   "s": "黄。"
  },
  {
   "t": 212.268,
   "d": 3.389,
   "s": "出门看火伴，火伴皆惊忙："
  },
  {
   "t": 215.657,
   "d": 1.569,
   "s": "同行"
  },
  {
   "t": 223.231,
   "d": 2.756,
   "s": "十二年，不知木兰"
  },
  {
   "t": 226.387,
   "d": 1.394,
   "s": "是女郎。"
  },
  {
   "t": 227.731,
   "d": 3.028,
   "s": "雄兔脚扑朔，雌兔"
  },
  {
   "t": 232.653,
   "d": 1.367,
   "s": "眼迷离；"
  },
  {
   "t": 233.97,
   "d": 1.625,
   "s": "双兔"
  },
  {
   "t": 237.462,
   "d": 3.617,
   "s": "傍地走，安能辨我是雄雌？"
  }
 ]
