 "cues": [
  {
   "t": 0.1,
   "d": 1.311,
   "s": "木兰诗"
  },
  {
   "t": 1.361,
   "d": 2.875,
   "s": "北朝民歌，佚名"
  },
  {
   "t": 4.336,
   "d": 3.228,
   "s": "唧唧复唧唧，木兰当户织。"
  },
  {
   "t": 7.784,
   "d": 3.672,
   "s": "不闻机杼声，唯闻女叹息。"
  },
  {
   "t": 11.676,
   "d": 3.506,
   "s": "问女何所思，问女何所忆。"
  },
  {
   "t": 15.402,
   "d": 3.575,
   "s": "女亦无所思，女亦无所忆。"
  },
  {
   "t": 19.197,
   "d": 4.019,
   "s": "昨夜见军帖，可汗大点兵。"
  },
  {
   "t": 23.436,
   "d": 3.867,
   "s": "军书十二卷，卷卷有爷名。"
  },
  {
   "t": 27.523,
   "d": 3.311,
   "s": "阿爷无大儿，木兰无长兄。"
  },
  {
   "t": 31.054,
   "d": 3.797,
   "s": "愿为市鞍马，从此替爷征。"
  },
  {
   "t": 35.071,
   "d": 6.339,
   "s": "东市买骏马，西市买鞍鞯，南市买辔头，北市买长鞭。"
  },
  {
   "t": 41.63,
   "d": 3.756,
   "s": "旦辞爷娘去，暮宿黄河边。"
  },
  {
   "t": 45.606,
   "d": 5.089,
   "s": "不闻爷娘唤女声，但闻黄河流水鸣溅溅。"
  },
  {
   "t": 50.915,
   "d": 3.839,
   "s": "旦辞黄河去，暮至黑山头。"
  },
  {
   "t": 54.974,
   "d": 4.964,
   "s": "不闻爷娘唤女声，但闻燕山胡骑鸣啾啾。"
  },
  {
   "t": 60.158,
   "d": 3.575,
   "s": "万里赴戎机，关山度若飞。"
  },
  {
   "t": 63.953,
   "d": 4.089,
   "s": "朔气传金柝，寒光照铁衣。"
  },
  {
   "t": 68.262,
   "d": 3.908,
   "s": "将军百战死，壮士十年归。"
  },
  {
   "t": 72.39,
   "d": 4.006,
   "s": "归来见天子，天子坐明堂。"
  },
  {
   "t": 76.616,
   "d": 3.936,
   "s": "策勋十二转，赏赐百千强。"
  },
  {
   "t": 80.772,
   "d": 3.561,
   "s": "可汗问所欲，木兰不用尚书郎，"
  },
  {
   "t": 84.283,
   "d": 3.792,
   "s": "愿驰千里足，送儿还故乡。"
  },
  {
   "t": 91.956,
   "d": 3.367,
   "s": "爷娘闻女来，出郭相扶将；"
  },
  {
   "t": 95.273,
   "d": 6.861,
   "s": "阿姊闻妹来，当户理红妆；小弟闻姊来，磨刀霍霍向猪羊。"
  },
  {
   "t": 105.821,
   "d": 3.367,
   "s": "开我东阁门，坐我西阁床。"
  },
  {
   "t": 109.408,
   "d": 3.45,
   "s": "脱我战时袍，著我旧时裳。"
  },
  {
   "t": 113.078,
   "d": 3.686,
   "s": "当窗理云鬓，对镜帖花黄。"
  },
  {
   "t": 116.984,
   "d": 3.394,
   "s": "出门看火伴，火伴皆惊忙："
  },
  {
   "t": 120.328,
   "d": 3.986,
   "s": "同行十二年，不知木兰是女郎。"
  },
  {
   "t": 128.028,
   "d": 3.325,
   "s": "雄兔脚扑朔，雌兔眼迷离；"
  },
  {
   "t": 131.303,
   "d": 0.05,
   "s": "双兔傍地走，安能辨我是雄雌？"
  }
 ]
}