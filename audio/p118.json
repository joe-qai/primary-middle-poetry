   "s": "满江红，小住京华"
  },
  {
   "t": 2.917,
   "d": 2.097,
   "s": "清代，秋瑾"
  },
  {
   "t": 5.014,
   "d": 3.597,
   "s": "小住京华，早又是中秋佳节。"
  },
  {
   "t": 8.611,
   "d": 3.639,
   "s": "为篱下黄花开遍，秋容如拭。"
  },
  {
   "t": 12.25,
   "d": 4.375,
   "s": "四面歌残终破楚，八年风味徒思浙。"
  },
  {
   "t": 16.625,
   "d": 3.833,
   "s": "苦将侬强派作蛾眉，殊未屑！"
  },
  {
   "t": 20.458,
   "d": 4.486,
   "s": "身不得，男儿列；心却比，男儿烈。"
  },
  {
   "t": 24.944,
   "d": 3.319,
   "s": "算平生肝胆，因人常热。"
  },
  {
   "t": 28.264,
   "d": 2.403,
   "s": "俗子胸襟谁识我？"
  },
  {
   "t": 30.667,
   "d": 2.528,
   "s": "英雄末路当磨折。"
  },
  {
   "t": 33.194,
   "d": 2.764,
   "s": "莽红尘何处觅知音？"
  },
  {
   "t": 35.958,
   "d": 1.833,
   "s": "青衫湿！"
  }
 ]
