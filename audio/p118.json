  },
  {
   "t": 5.448,
   "d": 3.936,
   "s": "小住京华，早又是中秋佳节。"
  },
  {
   "t": 9.604,
   "d": 3.978,
   "s": "为篱下黄花开遍，秋容如拭。"
  },
  {
   "t": 13.802,
   "d": 4.714,
   "s": "四面歌残终破楚，八年风味徒思浙。"
  },
  {
   "t": 18.736,
   "d": 4.172,
   "s": "苦将侬强派作蛾眉，殊未屑！"
  },
  {
   "t": 23.128,
   "d": 4.825,
   "s": "身不得，男儿列；心却比，男儿烈。"
  },
  {
   "t": 28.173,
   "d": 3.658,
   "s": "算平生肝胆，因人常热。"
  },
  {
   "t": 32.051,
   "d": 2.742,
   "s": "俗子胸襟谁识我？"
  },
  {
