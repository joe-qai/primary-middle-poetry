  {
   "t": 0.1,
   "d": 3.2,
   "s": "水龙吟，登建康赏心亭"
  },
  {
   "t": 3.25,
   "d": 2.306,
   "s": "宋代，辛弃疾"
  },
  {
   "t": 5.556,
   "d": 4.222,
   "s": "楚天千里清秋，水随天去秋无际。"
  },
  {
   "t": 9.778,
   "d": 4.389,
   "s": "遥岑远目，献愁供恨，玉簪螺髻。"
  },
  {
   "t": 14.167,
   "d": 4.306,
   "s": "落日楼头，断鸿声里，江南游子。"
  },
  {
   "t": 18.472,
   "d": 5.056,
   "s": "把吴钩看了，栏杆拍遍，无人会，登临意。"
  },
  {
   "t": 23.528,
   "d": 4.222,
   "s": "休说鲈鱼堪脍，尽西风，季鹰归未？"
  },
  {
   "t": 27.75,
   "d": 4.069,
   "s": "求田问舍，怕应羞见，刘郎才气。"
  },
  {
   "t": 31.819,
   "d": 4.069,
   "s": "可惜流年，忧愁风雨，树犹如此！"
  },
  {
   "t": 35.889,
   "d": 4.931,
   "s": "倩何人唤取，红巾翠袖，揾英雄泪？"
  }
 ]
}