   "s": "水龙吟，登建康赏心亭"
  },
  {
   "t": 3.25,
   "d": 2.639,
   "s": "宋代，辛弃疾"
  },
  {
   "t": 6.052,
   "d": 4.561,
   "s": "楚天千里清秋，水随天去秋无际。"
  },
  {
   "t": 10.732,
   "d": 4.728,
   "s": "遥岑远目，献愁供恨，玉簪螺髻。"
  },
  {
   "t": 15.58,
   "d": 4.644,
   "s": "落日楼头，断鸿声里，江南游子。"
  },
  {
   "t": 20.332,
   "d": 5.394,
   "s": "把吴钩看了，栏杆拍遍，无人会，登临意。"
  },
  {
   "t": 25.828,
   "d": 4.561,
   "s": "休说鲈鱼堪脍，尽西风，季鹰归未？"
  },
  {
   "t": 30.508,
   "d": 4.408,
   "s": "求田问舍，怕应羞见，刘郎才气。"
  },
  {
   "t": 35.02,
   "d": 4.408,
   "s": "可惜流年，忧愁风雨，树犹如此！"
  },
  {
   "t": 39.532,
   "d": 4.936,
   "s": "倩何人唤取，红巾翠袖，揾英雄泪？"
  }
 ]
