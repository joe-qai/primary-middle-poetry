 "cues": [
  {
   "t": 0.1,
   "d": 1.242,
   "s": "海燕"
  },
  {
   "t": 1.292,
   "d": 2.5,
   "s": "俄国，高尔基"
  },
  {
   "t": 3.964,
   "d": 4.575,
   "s": "在苍茫的大海上，狂风卷集着乌云。"
  },
  {
   "t": 8.644,
   "d": 6.256,
   "s": "在乌云和大海之间，海燕像黑色的闪电，在高傲地飞翔。"
  },
  {
   "t": 15.004,
   "d": 5.297,
   "s": "一会儿翅膀碰着波浪，一会儿箭一般地直冲向乌云。"
  },
  {
   "t": 20.404,
   "d": 7.367,
   "s": "它叫喊着——鸟儿们呻吟着，它们在大海上飞窜，想把自己藏到海底去。"
  },
  {
   "t": 27.892,
   "d": 5.547,
   "s": "这是勇敢的海燕，在暴风雨来临之前高声飞翔。"
  },
  {
   "t": 33.556,
   "d": 5.2,
   "s": "它深信乌云遮不住太阳——是的，遮不住的！"
  },
  {
   "t": 38.86,
   "d": 2.06,
   "s": "暴风雨吧！"
  },
  {
   "t": 41.02,
   "d": 2.506,
   "s": "暴风雨就要来啦！"
  },
  {
   "t": 43.636,
   "d": 3.992,
   "s": "这是勇敢的精灵在欢乐中呐喊。"
  },
  {
   "t": 47.74,
   "d": 3.297,
   "s": "让暴风雨来得更猛烈些吧！"
  }
 ]
}