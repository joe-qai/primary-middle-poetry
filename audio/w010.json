{
 "id": "w010",
 "title": "醉翁亭记",
 "voice": "zh-CN-YunjianNeural",
 "rate": "-10%",
 "pitch": "+0Hz",
 "dur": 130.458,
 "hdr": 2,
 "bodyCues": 24,
 "v": "b4ed56dc",
 "cues": [
  {
   "t": 0.1,
   "d": 1.589,
   "s": "醉翁亭记"
  },
  {
   "t": 1.639,
   "d": 2.139,
   "s": "宋代，欧阳修"
  },
  {
   "t": 3.778,
   "d": 2.014,
   "s": "环滁皆山也。"
  },
  {
   "t": 5.792,
   "d": 6.278,
   "s": "其西南诸峰，林壑尤美，望之蔚然而深秀者，琅琊也。"
  },
  {
   "t": 12.069,
   "d": 7.375,
   "s": "山行六七里，渐闻水声潺潺，而泻出于两峰之间者，酿泉也。"
  },
  {
   "t": 19.444,
   "d": 5.361,
   "s": "峰回路转，有亭翼然临于泉上者，醉翁亭也。"
  },
  {
   "t": 24.806,
   "d": 1.694,
   "s": "作亭者谁？"
  },
  {
   "t": 26.5,
   "d": 2.333,
   "s": "山之僧智仙也。"
  },
  {
   "t": 28.833,
   "d": 1.722,
   "s": "名之者谁？"
  },
  {
   "t": 30.556,
   "d": 2.069,
   "s": "太守自谓也。"
  },
  {
   "t": 32.625,
   "d": 6.611,
   "s": "太守与客来饮于此，饮少辄醉，而年又最高，故自号曰醉翁也。"
  },
  {
   "t": 39.236,
   "d": 4.194,
   "s": "醉翁之意不在酒，在乎山水之间也。"
  },
  {
   "t": 43.431,
   "d": 4.097,
   "s": "山水之乐，得之心而寓之酒也。"
  },
  {
   "t": 47.528,
   "d": 7.236,
   "s": "若夫日出而林霏开，云归而岩穴暝，晦明变化者，山间之朝暮也。"
  },
  {
   "t": 54.764,
   "d": 7.847,
   "s": "野芳发而幽香，佳木秀而繁阴，风霜高洁，水落而石出者，山间之四时也。"
  },
  {
   "t": 62.611,
   "d": 6.111,
   "s": "朝而往，暮而归，四时之景不同，而乐亦无穷也。"
  },
  {
   "t": 68.722,
   "d": 9.556,
   "s": "至于负者歌于途，行者休于树，前者呼，后者应，伛偻提携，往来而不绝者，滁人游也。"
  },
  {
   "t": 78.278,
   "d": 10.042,
   "s": "临溪而渔，溪深而鱼肥；酿泉为酒，泉香而酒洌；山肴野蔌，杂然而前陈者，太守宴也。"
  },
  {
   "t": 88.319,
   "d": 8.931,
   "s": "宴酣之乐，非丝非竹，射者中，弈者胜，觥筹交错，起坐而喧哗者，众宾欢也。"
  },
  {
   "t": 97.25,
   "d": 4.778,
   "s": "苍颜白发，颓然乎其间者，太守醉也。"
  },
  {
   "t": 102.028,
   "d": 5.5,
   "s": "已而夕阳在山，人影散乱，太守归而宾客从也。"
  },
  {
   "t": 107.528,
   "d": 4.944,
   "s": "树林阴翳，鸣声上下，游人去而禽鸟乐也。"
  },
  {
   "t": 112.472,
   "d": 9.069,
   "s": "然而禽鸟知山林之乐，而不知人之乐；人知从太守游，而乐，而不知太守之乐其乐也。"
  },
  {
   "t": 121.542,
   "d": 4.694,
   "s": "醉能同其乐，醒能述以文者，太守也。"
  },
  {
   "t": 126.236,
   "d": 1.778,
   "s": "太守谓谁？"
  },
  {
   "t": 128.014,
   "d": 2.444,
   "s": "庐陵欧阳修也。"
  }
 ]
}