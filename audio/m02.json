 "cues": [
  {
   "t": 0.1,
   "d": 1.714,
   "s": "再别康桥"
  },
  {
   "t": 1.764,
   "d": 2.778,
   "s": "现代，徐志摩"
  },
  {
   "t": 4.708,
   "d": 7.214,
   "s": "轻轻的我走了，正如我轻轻的来；我轻轻的招手，作别西天的云彩。"
  },
  {
   "t": 12.028,
   "d": 7.589,
   "s": "那河畔的金柳，是夕阳中的新娘；波光里的艳影，在我的心头荡漾。"
  },
  {
   "t": 19.732,
   "d": 7.908,
   "s": "软泥上的青荇，油油的在水底招摇；在康河的柔波里，我甘心做一条水草！"
  },
  {
   "t": 27.748,
   "d": 8.519,
   "s": "那榆荫下的一潭，不是清泉，是天上虹；揉碎在浮藻间，沉淀着彩虹似的梦。"
  },
  {
   "t": 36.388,
   "d": 1.492,
   "s": "寻梦？"
  },
  {
   "t": 37.996,
   "d": 7.978,
   "s": "撑一支长篙，向青草更青处漫溯；满载一船星辉，在星辉斑斓里放歌。"
  },
  {
   "t": 46.084,
   "d": 8.186,
   "s": "但我不能放歌，悄悄是别离的笙箫；夏虫也为我沉默，沉默是今晚的康桥！"
  },
  {
   "t": 54.388,
   "d": 7.325,
   "s": "悄悄的我走了，正如我悄悄的来；我挥一挥衣袖，不带走一片云彩。"
  }
 ]
}