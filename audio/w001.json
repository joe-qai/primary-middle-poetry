  {
   "t": 0.1,
   "d": 1.408,
   "s": "陋室铭"
  },
  {
   "t": 1.458,
   "d": 2.222,
   "s": "唐代，刘禹锡"
  },
  {
   "t": 3.681,
   "d": 2.819,
   "s": "山不在高，有仙则名。"
  },
  {
   "t": 6.5,
   "d": 2.944,
   "s": "水不在深，有龙则灵。"
  },
  {
   "t": 9.444,
   "d": 2.819,
   "s": "斯是陋室，惟吾德馨。"
  },
  {
   "t": 12.264,
   "d": 3.514,
   "s": "苔痕上阶绿，草色入帘青。"
  },
  {
   "t": 15.778,
   "d": 3.444,
   "s": "谈笑有鸿儒，往来无白丁。"
  },
  {
   "t": 19.222,
   "d": 2.861,
   "s": "可以调素琴，阅金经。"
  },
  {
   "t": 22.083,
   "d": 3.819,
   "s": "无丝竹之乱耳，无案牍之劳形。"
  },
  {
   "t": 25.903,
   "d": 3.306,
   "s": "南阳诸葛庐，西蜀子云亭。"
  },
  {
   "t": 29.208,
   "d": 3.236,
   "s": "孔子云：何陋之有？"
  }
 ]
}