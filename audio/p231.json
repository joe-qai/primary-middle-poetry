 "cues": [
  {
   "t": 0.1,
   "d": 3.95,
   "s": "江城子，乙卯正月二十日夜记梦"
  },
  {
   "t": 4.0,
   "d": 2.472,
   "s": "宋代，苏轼"
  },
  {
   "t": 6.628,
   "d": 4.561,
   "s": "十年生死两茫茫，不思量，自难忘。"
  },
  {
   "t": 11.308,
   "d": 3.478,
   "s": "千里孤坟，无处话凄凉。"
  },
  {
   "t": 14.908,
   "d": 4.867,
   "s": "纵使相逢应不识，尘满面，鬓如霜。"
  },
  {
   "t": 19.876,
   "d": 4.714,
   "s": "夜来幽梦忽还乡，小轩窗，正梳妆。"
  },
  {
   "t": 24.7,
   "d": 3.575,
   "s": "相顾无言，惟有泪千行。"
  },
  {
   "t": 28.396,
   "d": 4.908,
   "s": "料得年年肠断处：明月夜，短松冈。"
  }
 ]
}