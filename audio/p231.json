  {
   "t": 0.1,
   "d": 3.95,
   "s": "江城子，乙卯正月二十日夜记梦"
  },
  {
   "t": 4.0,
   "d": 2.472,
   "s": "宋代，苏轼"
  },
  {
   "t": 10.622,
   "d": 2.158,
   "s": "十年生死"
  },
  {
   "t": 13.18,
   "d": 3.256,
   "s": "两茫茫，不思量，自难忘。"
  },
  {
   "t": 16.386,
   "d": 1.611,
   "s": "千里"
  },
  {
   "t": 21.753,
   "d": 2.714,
   "s": "孤坟，无处话凄凉。"
  },
  {
   "t": 24.417,
   "d": 2.056,
   "s": "纵使相逢"
  },
  {
   "t": 29.687,
   "d": 3.617,
   "s": "应不识，尘满面，鬓如霜。"
  },
  {
   "t": 33.254,
   "d": 1.847,
   "s": "夜来幽梦"
  },
  {
   "t": 39.218,
   "d": 3.533,
   "s": "忽还乡，小轩窗，正梳妆。"
  },
  {
   "t": 42.701,
   "d": 1.597,
   "s": "相顾"
  },
  {
   "t": 48.331,
   "d": 2.7,
   "s": "无言，惟有泪千行。"
  },
  {
   "t": 50.981,
   "d": 1.889,
   "s": "料得年年"
  },
  {
   "t": 56.07,
   "d": 4.103,
   "s": "肠断处：明月夜，短松冈。"
  }
 ]
