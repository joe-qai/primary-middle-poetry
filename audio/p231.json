  {
   "t": 0.1,
   "d": 3.95,
   "s": "江城子，乙卯正月二十日夜记梦"
  },
  {
   "t": 4.0,
   "d": 2.139,
   "s": "宋代，苏轼"
  },
  {
   "t": 6.139,
   "d": 4.222,
   "s": "十年生死两茫茫，不思量，自难忘。"
  },
  {
   "t": 10.361,
   "d": 3.139,
   "s": "千里孤坟，无处话凄凉。"
  },
  {
   "t": 13.5,
   "d": 4.528,
   "s": "纵使相逢应不识，尘满面，鬓如霜。"
  },
  {
   "t": 18.028,
   "d": 4.375,
   "s": "夜来幽梦忽还乡，小轩窗，正梳妆。"
  },
  {
   "t": 22.403,
   "d": 3.236,
   "s": "相顾无言，惟有泪千行。"
  },
  {
   "t": 25.639,
   "d": 4.903,
   "s": "料得年年肠断处：明月夜，短松冈。"
  }
 ]
}