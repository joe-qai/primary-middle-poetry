   "s": "临江仙，夜饮东坡醒复醉"
  },
  {
   "t": 3.611,
   "d": 2.139,
   "s": "宋代，苏轼"
  },
  {
   "t": 5.75,
   "d": 3.889,
   "s": "夜饮东坡醒复醉，归来仿佛三更。"
  },
  {
   "t": 9.639,
   "d": 4.931,
   "s": "家童鼻息已雷鸣，敲门都不应，倚杖听江声。"
  },
  {
   "t": 14.569,
   "d": 4.153,
   "s": "长恨此身非我有，何时忘却营营。"
  },
  {
   "t": 18.722,
   "d": 5.5,
   "s": "夜阑风静縠纹平，小舟从此逝，江海寄余生。"
  }
 ]
