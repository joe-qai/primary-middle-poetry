  },
  {
   "t": 3.611,
   "d": 2.472,
   "s": "宋代，苏轼"
  },
  {
   "t": 9.844,
   "d": 4.228,
   "s": "夜饮东坡醒复醉，归来仿佛三更。"
  },
  {
   "t": 14.292,
   "d": 5.269,
   "s": "家童鼻息已雷鸣，敲门都不应，倚杖听江声。"
  },
  {
   "t": 19.781,
   "d": 4.492,
   "s": "长恨此身非我有，何时忘却营营。"
  },
  {
   "t": 24.493,
   "d": 5.506,
   "s": "夜阑风静縠纹平，小舟从此逝，江海寄余生。"
  }
 ]
