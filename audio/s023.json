 "cues": [
  {
   "t": 0.1,
   "d": 1.672,
   "s": "纸上谈兵"
  },
  {
   "t": 1.722,
   "d": 4.819,
   "s": "西汉，司马迁史记，廉颇蔺相如列传"
  },
  {
   "t": 6.542,
   "d": 9.111,
   "s": "赵括从小学习兵法，谈论起用兵打仗来头头是道，连他的父亲、名将赵奢也难不倒他。"
  },
  {
   "t": 15.653,
   "d": 8.597,
   "s": "但赵奢并不认为他有真本事，对妻子说：用兵是生死存亡的大事，括儿却说得太轻易。"
  },
  {
   "t": 24.25,
   "d": 6.417,
   "s": "将来赵国不用他则罢，若用他为将，使赵军大败的一定是他。"
  },
  {
   "t": 30.667,
   "d": 6.833,
   "s": "后来秦国攻打赵国，赵王听信谣言，用赵括代替老将廉颇。"
  },
  {
   "t": 37.5,
   "d": 7.264,
   "s": "赵括一到前线，就照搬兵书上的条文，改变廉颇的部署，轻率出击。"
  },
  {
   "t": 44.764,
   "d": 6.333,
   "s": "秦将白起佯败后退，截断赵军粮道，把赵军团团围住。"
  },
  {
   "t": 51.097,
   "d": 8.208,
   "s": "赵军断粮四十六天，赵括突围时被乱箭射死，四十多万赵军全部覆没。"
  }
 ]
}