 "cues": [
  {
   "t": 0.1,
   "d": 1.492,
   "s": "扬州慢"
  },
  {
   "t": 1.542,
   "d": 2.486,
   "s": "宋代，姜夔"
  },
  {
   "t": 4.18,
   "d": 4.004,
   "s": "淳熙丙申至日，予过维扬。"
  },
  {
   "t": 8.284,
   "d": 3.075,
   "s": "夜雪初霁，荠麦弥望。"
  },
  {
   "t": 11.476,
   "d": 4.603,
   "s": "入其城，则四顾萧条，寒水自碧。"
  },
  {
   "t": 16.18,
   "d": 3.228,
   "s": "暮色渐起，戍角悲吟。"
  },
  {
   "t": 19.516,
   "d": 4.769,
   "s": "予怀怆然，感慨今昔，因自度此曲。"
  },
  {
   "t": 24.388,
   "d": 3.728,
   "s": "千岩老人以为有黍离之悲也。"
  },
  {
   "t": 28.228,
   "d": 4.7,
   "s": "淮左名都，竹西佳处，解鞍少驻初程。"
  },
  {
   "t": 33.028,
   "d": 3.728,
   "s": "过春风十里，尽荠麦青青。"
  },
  {
   "t": 36.868,
   "d": 4.922,
   "s": "自胡马窥江去后，废池乔木，犹厌言兵。"
  },
  {
   "t": 41.908,
   "d": 4.575,
   "s": "渐黄昏，清角吹寒，都在空城。"
  },
  {
   "t": 46.588,
   "d": 4.158,
   "s": "杜郎俊赏，算而今、重到须惊。"
  },
  {
   "t": 50.86,
   "d": 5.075,
   "s": "纵豆蔻词工，青楼梦好，难赋深情。"
  },
  {
   "t": 56.044,
   "d": 4.492,
   "s": "二十四桥仍在，波心荡、冷月无声。"
  },
  {
   "t": 60.652,
   "d": 3.992,
   "s": "念桥边红药，年年知为谁生？"
  }
 ]
}