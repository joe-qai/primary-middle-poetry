 "cues": [
  {
   "t": 0.1,
   "d": 1.631,
   "s": "捕蛇者说"
  },
  {
   "t": 1.681,
   "d": 2.611,
   "s": "唐代，柳宗元"
  },
  {
   "t": 6.123,
   "d": 2.658,
   "s": "永州之野产异蛇"
  },
  {
   "t": 9.031,
   "d": 2.256,
   "s": "黑质而白章"
  },
  {
   "t": 11.537,
   "d": 2.353,
   "s": "触草木尽死"
  },
  {
   "t": 14.14,
   "d": 1.769,
   "s": "以啮人"
  },
  {
   "t": 16.159,
   "d": 1.631,
   "s": "无御之者。"
  },
  {
   "t": 17.74,
   "d": 2.514,
   "s": "然得而腊之以为饵"
  },
  {
   "t": 22.235,
   "d": 3.519,
   "s": "可以已大风、挛踠、瘘疠"
  },
  {
   "t": 26.004,
   "d": 1.825,
   "s": "去死肌"
  },
  {
   "t": 28.079,
   "d": 1.561,
   "s": "杀三虫。"
  },
  {
   "t": 29.59,
   "d": 3.181,
   "s": "其始太医以王命聚之"
  },
  {
   "t": 34.682,
   "d": 1.894,
   "s": "岁赋其二"
  },
  {
   "t": 36.826,
   "d": 2.464,
   "s": "募有能捕之者"
  },
  {
   "t": 39.54,
   "d": 1.561,
   "s": "当其租入。"
  },
  {
   "t": 41.051,
   "d": 2.5,
   "s": "永之人争奔走焉。"
  },
  {
   "t": 43.551,
   "d": 1.597,
   "s": "余哀之"
  },
  {
   "t": 51.17,
   "d": 2.478,
   "s": "而告曰：若是"
  },
  {
   "t": 53.898,
   "d": 2.464,
   "s": "则虽稼穑之力"
  },
  {
   "t": 56.612,
   "d": 1.575,
   "s": "可已乎？"
  },
  {
   "t": 58.137,
   "d": 3.278,
   "s": "曰：吾斯役之不幸"
  },
  {
   "t": 63.34,
   "d": 3.047,
   "s": "未若复吾赋不幸之甚也。"
  },
  {
   "t": 66.337,
   "d": 1.833,
   "s": "故为之说"
  },
  {
   "t": 71.567,
   "d": 3.075,
   "s": "以俟夫观人风者得焉。"
  }
 ]
}