 "cues": [
  {
   "t": 0.1,
   "d": 1.631,
   "s": "捕蛇者说"
  },
  {
   "t": 1.681,
   "d": 2.611,
   "s": "唐代，柳宗元"
  },
  {
   "t": 6.123,
   "d": 2.103,
   "s": "永州之野"
  },
  {
   "t": 8.626,
   "d": 2.672,
   "s": "产异蛇，黑质"
  },
  {
   "t": 11.698,
   "d": 2.408,
   "s": "而白章，触草"
  },
  {
   "t": 14.506,
   "d": 3.672,
   "s": "木尽死，以啮人，无御之者。"
  },
  {
   "t": 18.128,
   "d": 1.792,
   "s": "然得而腊"
  },
  {
   "t": 24.092,
   "d": 2.964,
   "s": "之以为饵，可以已大"
  },
  {
   "t": 27.456,
   "d": 4.658,
   "s": "风、挛踠、瘘疠，去死肌，杀三虫。"
  },
  {
   "t": 32.064,
   "d": 1.889,
   "s": "其始太医"
  },
  {
   "t": 39.111,
   "d": 2.908,
   "s": "以王命聚之，岁赋"
  },
  {
   "t": 42.419,
   "d": 3.992,
   "s": "其二，募有能捕之者，当其租入。"
  },
  {
   "t": 46.361,
   "d": 2.5,
   "s": "永之人争奔走焉。"
  },
  {
   "t": 48.861,
   "d": 5.542,
   "s": "余哀之，而告曰：若是，则虽稼穑之力，可已乎？"
  },
  {
   "t": 54.402,
   "d": 2.236,
   "s": "曰：吾斯"
  },
  {
   "t": 79.756,
   "d": 4.283,
   "s": "役之不幸，未若复吾赋不幸之甚也。"
  },
  {
   "t": 83.989,
   "d": 1.514,
   "s": "故为"
  },
  {
   "t": 90.286,
   "d": 3.853,
   "s": "之说，以俟夫观人风者得焉。"
  }
 ]
}