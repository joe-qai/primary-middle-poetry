 "cues": [
  {
   "t": 0.1,
   "d": 1.631,
   "s": "捕蛇者说"
  },
  {
   "t": 1.681,
   "d": 2.611,
   "s": "唐代，柳宗元"
  },
  {
   "t": 4.392,
   "d": 7.894,
   "s": "永州之野产异蛇，黑质而白章，触草木尽死，以啮人，无御之者。"
  },
  {
   "t": 12.506,
   "d": 7.186,
   "s": "然得而腊之以为饵，可以已大风、挛踠、瘘疠，去死肌，杀三虫。"
  },
  {
   "t": 19.912,
   "d": 7.131,
   "s": "其始太医以王命聚之，岁赋其二，募有能捕之者，当其租入。"
  },
  {
   "t": 27.263,
   "d": 2.839,
   "s": "永之人争奔走焉。"
  },
  {
   "t": 30.322,
   "d": 5.881,
   "s": "余哀之，而告曰：若是，则虽稼穑之力，可已乎？"
  },
  {
   "t": 36.423,
   "d": 5.783,
   "s": "曰：吾斯役之不幸，未若复吾赋不幸之甚也。"
  },
  {
   "t": 42.426,
   "d": 3.63,
   "s": "故为之说，以俟夫观人风者得焉。"
  }
 ]
}