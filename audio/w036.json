 "cues": [
  {
   "t": 0.1,
   "d": 1.631,
   "s": "捕蛇者说"
  },
  {
   "t": 1.681,
   "d": 2.278,
   "s": "唐代，柳宗元"
  },
  {
   "t": 3.958,
   "d": 7.556,
   "s": "永州之野产异蛇，黑质而白章，触草木尽死，以啮人，无御之者。"
  },
  {
   "t": 11.514,
   "d": 6.847,
   "s": "然得而腊之以为饵，可以已大风、挛踠、瘘疠，去死肌，杀三虫。"
  },
  {
   "t": 18.361,
   "d": 6.792,
   "s": "其始太医以王命聚之，岁赋其二，募有能捕之者，当其租入。"
  },
  {
   "t": 25.153,
   "d": 2.5,
   "s": "永之人争奔走焉。"
  },
  {
   "t": 27.653,
   "d": 5.542,
   "s": "余哀之，而告曰：若是，则虽稼穑之力，可已乎？"
  },
  {
   "t": 33.194,
   "d": 5.444,
   "s": "曰：吾斯役之不幸，未若复吾赋不幸之甚也。"
  },
  {
   "t": 38.639,
   "d": 4.181,
   "s": "故为之说，以俟夫观人风者得焉。"
  }
 ]
}