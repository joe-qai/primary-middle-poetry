 "bodyCues": 29,
 "v": "f902fa47",
 "cues": [
  {
   "t": 0.1,
   "d": 1.492,
   "s": "陈情表"
  },
  {
   "t": 1.542,
   "d": 2.028,
   "s": "西晋，李密"
  },
  {
   "t": 3.569,
   "d": 4.111,
   "s": "臣密言：臣以险衅，夙遭闵凶。"
  },
  {
   "t": 7.681,
   "d": 5.514,
   "s": "生孩六月，慈父见背；行年四岁，舅夺母志。"
  },
  {
   "t": 13.194,
   "d": 3.472,
   "s": "祖母刘愍臣孤弱，躬亲抚养。"
  },
  {
   "t": 16.667,
   "d": 5.639,
   "s": "臣少多疾病，九岁不行，零丁孤苦，至于成立。"
  },
  {
   "t": 22.306,
   "d": 5.25,
   "s": "既无伯叔，终鲜兄弟，门衰祚薄，晚有儿息。"
  },
  {
   "t": 27.556,
   "d": 7.222,
   "s": "外无期功强近之亲，内无应门五尺之僮，茕茕孑立，形影相吊。"
  },
  {
   "t": 34.778,
   "d": 5.972,
   "s": "而刘夙婴疾病，常在床蓐，臣侍汤药，未曾废离。"
  },
  {
   "t": 40.75,
   "d": 2.958,
   "s": "逮奉圣朝，沐浴清化。"
  },
  {
   "t": 43.708,
   "d": 5.597,
   "s": "前太守臣逵察臣孝廉，后刺史臣荣举臣秀才。"
  },
  {
   "t": 49.306,
   "d": 3.333,
   "s": "臣以供养无主，辞不赴命。"
  },
  {
   "t": 52.639,
   "d": 5.319,
   "s": "诏书特下，拜臣郎中，寻蒙国恩，除臣洗马。"
  },
  {
   "t": 57.958,
   "d": 4.944,
   "s": "猥以微贱，当侍东宫，非臣陨首所能上报。"
  },
  {
   "t": 62.903,
   "d": 3.069,
   "s": "臣具以表闻，辞不就职。"
  },
  {
   "t": 65.972,
   "d": 3.042,
   "s": "诏书切峻，责臣逋慢。"
  },
  {
   "t": 69.014,
   "d": 5.25,
   "s": "郡县逼迫，催臣上道；州司临门，急于星火。"
  },
  {
   "t": 74.264,
   "d": 6.653,
   "s": "臣欲奉诏奔驰，则刘病日笃；欲苟顺私情，则告诉不许。"
  },
  {
   "t": 80.917,
   "d": 2.889,
   "s": "臣之进退，实为狼狈。"
  },
  {
   "t": 83.806,
   "d": 7.75,
   "s": "伏惟圣朝以孝治天下，凡在故老，犹蒙矜育，况臣孤苦，特为尤甚。"
  },
  {
   "t": 91.556,
   "d": 5.639,
   "s": "且臣少仕伪朝，历职郎署，本图宦达，不矜名节。"
  },
  {
   "t": 97.194,
   "d": 8.069,
   "s": "今臣亡国贱俘，至微至陋，过蒙拔擢，宠命优渥，岂敢盘桓，有所希冀。"
  },
  {
   "t": 105.264,
   "d": 5.792,
   "s": "但以刘日薄西山，气息奄奄，人命危浅，朝不虑夕。"
  },
  {
   "t": 111.056,
   "d": 5.986,
   "s": "臣无祖母，无以至今日；祖母无臣，无以终余年。"
  },
  {
   "t": 117.042,
   "d": 4.792,
   "s": "母孙二人，更相为命，是以区区不能废远。"
  },
  {
   "t": 121.833,
   "d": 8.306,
   "s": "臣密今年四十有四，祖母今年九十有六，是臣尽节于陛下之日长，报养刘之日短也。"
  },
  {
   "t": 130.139,
   "d": 3.014,
   "s": "乌鸟私情，愿乞终养。"
  },
  {
   "t": 133.153,
   "d": 7.611,
   "s": "臣之辛苦，非独蜀之人士及二州牧伯所见明知，皇天后土实所共鉴。"
  },
  {
   "t": 140.764,
   "d": 6.153,
   "s": "愿陛下矜愍愚诚，听臣微志，庶刘侥幸，保卒余年。"
  },
  {
   "t": 146.917,
   "d": 3.097,
   "s": "臣生当陨首，死当结草。"
  },
  {
   "t": 150.014,
   "d": 4.597,
   "s": "臣不胜犬马怖惧之情，谨拜表以闻。"
  }
 ]
}