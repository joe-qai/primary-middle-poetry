 "bodyCues": 29,
 "v": "b536e386",
 "cues": [
  {
   "t": 0.1,
   "d": 1.492,
   "s": "陈情表"
  },
  {
   "t": 1.542,
   "d": 2.361,
   "s": "西晋，李密"
  },
  {
   "t": 4.06,
   "d": 4.45,
   "s": "臣密言：臣以险衅，夙遭闵凶。"
  },
  {
   "t": 8.62,
   "d": 5.852,
   "s": "生孩六月，慈父见背；行年四岁，舅夺母志。"
  },
  {
   "t": 14.572,
   "d": 3.811,
   "s": "祖母刘愍臣孤弱，躬亲抚养。"
  },
  {
   "t": 18.484,
   "d": 5.978,
   "s": "臣少多疾病，九岁不行，零丁孤苦，至于成立。"
  },
  {
   "t": 24.58,
   "d": 5.588,
   "s": "既无伯叔，终鲜兄弟，门衰祚薄，晚有儿息。"
  },
  {
   "t": 30.268,
   "d": 7.561,
   "s": "外无期功强近之亲，内无应门五尺之僮，茕茕孑立，形影相吊。"
  },
  {
   "t": 37.948,
   "d": 6.311,
   "s": "而刘夙婴疾病，常在床蓐，臣侍汤药，未曾废离。"
  },
  {
   "t": 44.38,
   "d": 3.297,
   "s": "逮奉圣朝，沐浴清化。"
  },
  {
   "t": 47.788,
   "d": 5.936,
   "s": "前太守臣逵察臣孝廉，后刺史臣荣举臣秀才。"
  },
  {
   "t": 53.836,
   "d": 3.672,
   "s": "臣以供养无主，辞不赴命。"
  },
  {
   "t": 57.628,
   "d": 5.658,
   "s": "诏书特下，拜臣郎中，寻蒙国恩，除臣洗马。"
  },
  {
   "t": 63.388,
   "d": 5.283,
   "s": "猥以微贱，当侍东宫，非臣陨首所能上报。"
  },
  {
   "t": 68.788,
   "d": 3.408,
   "s": "臣具以表闻，辞不就职。"
  },
  {
   "t": 72.316,
   "d": 3.38,
   "s": "诏书切峻，责臣逋慢。"
  },
  {
   "t": 75.796,
   "d": 5.588,
   "s": "郡县逼迫，催臣上道；州司临门，急于星火。"
  },
  {
   "t": 81.484,
   "d": 6.992,
   "s": "臣欲奉诏奔驰，则刘病日笃；欲苟顺私情，则告诉不许。"
  },
  {
   "t": 88.588,
   "d": 3.228,
   "s": "臣之进退，实为狼狈。"
  },
  {
   "t": 91.924,
   "d": 8.089,
   "s": "伏惟圣朝以孝治天下，凡在故老，犹蒙矜育，况臣孤苦，特为尤甚。"
  },
  {
   "t": 100.132,
   "d": 5.978,
   "s": "且臣少仕伪朝，历职郎署，本图宦达，不矜名节。"
  },
  {
   "t": 106.228,
   "d": 8.408,
   "s": "今臣亡国贱俘，至微至陋，过蒙拔擢，宠命优渥，岂敢盘桓，有所希冀。"
  },
  {
   "t": 114.748,
   "d": 6.131,
   "s": "但以刘日薄西山，气息奄奄，人命危浅，朝不虑夕。"
  },
  {
   "t": 120.988,
   "d": 6.325,
   "s": "臣无祖母，无以至今日；祖母无臣，无以终余年。"
  },
  {
   "t": 127.42,
   "d": 5.131,
   "s": "母孙二人，更相为命，是以区区不能废远。"
  },
  {
   "t": 132.652,
   "d": 8.644,
   "s": "臣密今年四十有四，祖母今年九十有六，是臣尽节于陛下之日长，报养刘之日短也。"
  },
  {
   "t": 141.412,
   "d": 3.353,
   "s": "乌鸟私情，愿乞终养。"
  },
  {
   "t": 144.868,
   "d": 7.95,
   "s": "臣之辛苦，非独蜀之人士及二州牧伯所见明知，皇天后土实所共鉴。"
  },
  {
   "t": 152.932,
   "d": 6.492,
   "s": "愿陛下矜愍愚诚，听臣微志，庶刘侥幸，保卒余年。"
  },
  {
   "t": 159.532,
   "d": 3.436,
   "s": "臣生当陨首，死当结草。"
  },
  {
   "t": 163.084,
   "d": 4.603,
   "s": "臣不胜犬马怖惧之情，谨拜表以闻。"
  }
 ]
}