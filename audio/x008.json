 "cues": [
  {
   "t": 0.1,
   "d": 1.478,
   "s": "蜀道难"
  },
  {
   "t": 1.528,
   "d": 2.125,
   "s": "唐代，李白"
  },
  {
   "t": 3.653,
   "d": 2.861,
   "s": "噫吁嚱，危乎高哉！"
  },
  {
   "t": 6.514,
   "d": 3.347,
   "s": "蜀道之难，难于上青天！"
  },
  {
   "t": 9.861,
   "d": 3.431,
   "s": "蚕丛及鱼凫，开国何茫然！"
  },
  {
   "t": 13.292,
   "d": 4.028,
   "s": "尔来四万八千岁，不与秦塞通人烟。"
  },
  {
   "t": 17.319,
   "d": 3.944,
   "s": "西当太白有鸟道，可以横绝峨眉巅。"
  },
  {
   "t": 21.264,
   "d": 4.806,
   "s": "地崩山摧壮士死，然后天梯石栈相钩连。"
  },
  {
   "t": 26.069,
   "d": 5.458,
   "s": "上有六龙回日之高标，下有冲波逆折之回川。"
  },
  {
   "t": 31.528,
   "d": 4.556,
   "s": "黄鹤之飞尚不得过，猿猱欲度愁攀援。"
  },
  {
   "t": 36.083,
   "d": 3.917,
   "s": "青泥何盘盘，百步九折萦岩峦。"
  },
  {
   "t": 40.0,
   "d": 4.417,
   "s": "扪参历井仰胁息，以手抚膺坐长叹。"
  },
  {
   "t": 44.417,
   "d": 2.278,
   "s": "问君西游何时还？"
  },
  {
   "t": 46.694,
   "d": 2.25,
   "s": "畏途巉岩不可攀。"
  },
  {
   "t": 48.944,
   "d": 4.569,
   "s": "但见悲鸟号古木，雄飞雌从绕林间。"
  },
  {
   "t": 53.514,
   "d": 3.472,
   "s": "又闻子规啼夜月，愁空山。"
  },
  {
   "t": 56.986,
   "d": 5.0,
   "s": "蜀道之难，难于上青天，使人听此凋朱颜！"
  },
  {
   "t": 61.986,
   "d": 4.153,
   "s": "连峰去天不盈尺，枯松倒挂倚绝壁。"
  },
  {
   "t": 66.139,
   "d": 4.306,
   "s": "飞湍瀑流争喧豗，砯崖转石万壑雷。"
  },
  {
   "t": 70.444,
   "d": 4.611,
   "s": "其险也如此，嗟尔远道之人胡为乎来哉！"
  },
  {
   "t": 75.056,
   "d": 4.819,
   "s": "剑阁峥嵘而崔嵬，一夫当关，万夫莫开。"
  },
  {
   "t": 79.875,
   "d": 3.347,
   "s": "所守或匪亲，化为狼与豺。"
  },
  {
   "t": 83.222,
   "d": 5.472,
   "s": "朝避猛虎，夕避长蛇；磨牙吮血，杀人如麻。"
  },
  {
   "t": 88.694,
   "d": 3.181,
   "s": "锦城虽云乐，不如早还家。"
  },
  {
   "t": 91.875,
   "d": 5.625,
   "s": "蜀道之难，难于上青天，侧身西望长咨嗟！"
  }
 ]
}