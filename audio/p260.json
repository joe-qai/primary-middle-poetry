  {
   "t": 0.1,
   "d": 3.103,
   "s": "归园田居，少无适俗韵"
  },
  {
   "t": 3.153,
   "d": 2.403,
   "s": "东晋，陶渊明"
  },
  {
   "t": 5.556,
   "d": 3.486,
   "s": "少无适俗韵，性本爱丘山。"
  },
  {
   "t": 9.042,
   "d": 3.306,
   "s": "误落尘网中，一去三十年。"
  },
  {
   "t": 12.347,
   "d": 3.444,
   "s": "羁鸟恋旧林，池鱼思故渊。"
  },
  {
   "t": 15.792,
   "d": 3.431,
   "s": "开荒南野际，守拙归园田。"
  },
  {
   "t": 19.222,
   "d": 3.542,
   "s": "方宅十余亩，草屋八九间。"
  },
  {
   "t": 22.764,
   "d": 3.444,
   "s": "榆柳荫后檐，桃李罗堂前。"
  },
  {
   "t": 26.208,
   "d": 3.361,
   "s": "暧暧远人村，依依墟里烟。"
  },
  {
   "t": 29.569,
   "d": 3.444,
   "s": "狗吠深巷中，鸡鸣桑树颠。"
  },
  {
   "t": 33.014,
   "d": 3.5,
   "s": "户庭无尘杂，虚室有余闲。"
  },
  {
   "t": 36.514,
   "d": 3.569,
   "s": "久在樊笼里，复得返自然。"
  }
 ]
}