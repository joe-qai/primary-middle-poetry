  {
   "t": 0.1,
   "d": 3.103,
   "s": "归园田居，少无适俗韵"
  },
  {
   "t": 3.153,
   "d": 2.736,
   "s": "东晋，陶渊明"
  },
  {
   "t": 6.052,
   "d": 3.825,
   "s": "少无适俗韵，性本爱丘山。"
  },
  {
   "t": 9.988,
   "d": 3.644,
   "s": "误落尘网中，一去三十年。"
  },
  {
   "t": 13.732,
   "d": 3.783,
   "s": "羁鸟恋旧林，池鱼思故渊。"
  },
  {
   "t": 17.62,
   "d": 3.769,
   "s": "开荒南野际，守拙归园田。"
  },
  {
   "t": 21.508,
   "d": 3.881,
   "s": "方宅十余亩，草屋八九间。"
  },
  {
   "t": 25.492,
   "d": 3.783,
   "s": "榆柳荫后檐，桃李罗堂前。"
  },
  {
   "t": 29.38,
   "d": 3.7,
   "s": "暧暧远人村，依依墟里烟。"
  },
  {
   "t": 33.196,
   "d": 3.783,
   "s": "狗吠深巷中，鸡鸣桑树颠。"
  },
  {
   "t": 37.084,
   "d": 3.839,
   "s": "户庭无尘杂，虚室有余闲。"
  },
  {
   "t": 41.044,
   "d": 3.575,
   "s": "久在樊笼里，复得返自然。"
  }
 ]
}