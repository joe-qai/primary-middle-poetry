   "s": "凿壁偷光"
  },
  {
   "t": 1.736,
   "d": 2.5,
   "s": "西汉，西京杂记"
  },
  {
   "t": 4.236,
   "d": 5.361,
   "s": "西汉时的匡衡，小时候家里很穷，买不起蜡烛。"
  },
  {
   "t": 9.597,
   "d": 4.181,
   "s": "邻居家有蜡烛，但光亮照不到他家。"
  },
  {
   "t": 13.778,
   "d": 7.083,
   "s": "匡衡就在墙上凿了一个洞，引来邻居家的烛光，借着微弱的灯光读书。"
  },
  {
   "t": 20.861,
   "d": 4.986,
   "s": "同乡有个大户人家叫文不识，家里藏书很多。"
  },
  {
   "t": 25.847,
   "d": 3.694,
   "s": "匡衡就去给他家做工，不要报酬。"
  },
  {
   "t": 29.542,
   "d": 3.264,
   "s": "主人感到奇怪，问他为什么。"
  },
  {
   "t": 32.806,
   "d": 4.278,
   "s": "匡衡说：我希望能够读遍您家的藏书。"
  },
  {
   "t": 37.083,
   "d": 3.542,
   "s": "主人感叹不已，就把书借给他。"
  },
  {
   "t": 40.625,
   "d": 3.986,
   "s": "匡衡后来成为一位很有学问的人。"
  }
 ]
}