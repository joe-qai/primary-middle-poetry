  {
   "t": 0.1,
   "d": 1.242,
   "s": "青春"
  },
  {
   "t": 1.292,
   "d": 2.472,
   "s": "英国，王尔德"
  },
  {
   "t": 3.94,
   "d": 3.172,
   "s": "青春是人生中最好的季节，"
  },
  {
   "t": 7.062,
   "d": 3.514,
   "s": "因为它充满了可能性和梦想。"
  },
  {
   "t": 10.732,
   "d": 2.964,
   "s": "年老时我们会怀念青春，"
  },
  {
   "t": 13.646,
   "d": 2.375,
   "s": "不是因为失去了什么，"
  },
  {
   "t": 16.021,
   "d": 4.431,
   "s": "而是因为拥有了那么多曾经想要的一切。"
  },
  {
   "t": 20.62,
   "d": 2.075,
   "s": "不要害怕变老，"
  },
  {
   "t": 22.645,
   "d": 2.986,
   "s": "不要因为皱纹，而哭泣，"
  },
  {
   "t": 25.631,
   "d": 2.264,
   "s": "每一道岁月的痕迹，"
  },
  {
   "t": 27.895,
   "d": 3.306,
   "s": "都是生命写给时光的情书。"
  },
  {
   "t": 31.372,
   "d": 2.325,
   "s": "青春不只是年华，"
  },
  {
   "t": 33.647,
   "d": 2.083,
   "s": "更是一种心境——"
  },
  {
   "t": 35.73,
   "d": 2.486,
   "s": "是心中不灭的火焰，"
  },
  {
   "t": 38.216,
   "d": 2.875,
   "s": "是对世界永远的好奇。"
  }
 ]
}