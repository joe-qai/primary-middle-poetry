  },
  {
   "t": 5.0,
   "d": 4.347,
   "s": "登临送目，正故国晚秋，天气初肃。"
  },
  {
   "t": 9.347,
   "d": 3.583,
   "s": "千里澄江似练，翠峰如簇。"
  },
  {
   "t": 12.931,
   "d": 4.611,
   "s": "征帆去棹残阳里，背西风，酒旗斜矗。"
  },
  {
   "t": 17.542,
   "d": 4.569,
   "s": "彩舟云淡，星河鹭起，画图难足。"
  },
  {
   "t": 22.111,
   "d": 5.597,
   "s": "念往昔，繁华竞逐，叹门外楼头，悲恨相续。"
  },
  {
   "t": 27.708,
   "d": 3.514,
   "s": "千古凭高对此，谩嗟荣辱。"
  },
  {
   "t": 31.222,
   "d": 4.653,
   "s": "六朝旧事随流水，但寒烟衰草凝绿。"
  },
  {
   "t": 35.875,
   "d": 4.514,
   "s": "至今商女，时时犹唱，后庭遗曲。"
