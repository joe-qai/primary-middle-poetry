  },
  {
   "t": 2.819,
   "d": 2.514,
   "s": "宋代，王安石"
  },
  {
   "t": 5.433,
   "d": 4.686,
   "s": "登临送目，正故国晚秋，天气初肃。"
  },
  {
   "t": 10.339,
   "d": 3.922,
   "s": "千里澄江似练，翠峰如簇。"
  },
  {
   "t": 14.481,
   "d": 4.95,
   "s": "征帆去棹残阳里，背西风，酒旗斜矗。"
  },
  {
   "t": 19.651,
   "d": 4.908,
   "s": "彩舟云淡，星河鹭起，画图难足。"
  },
  {
   "t": 24.779,
   "d": 5.936,
   "s": "念往昔，繁华竞逐，叹门外楼头，悲恨相续。"
  },
  {
   "t": 30.935,
   "d": 3.853,
   "s": "千古凭高对此，谩嗟荣辱。"
  },
  {
   "t": 35.008,
   "d": 4.992,
   "s": "六朝旧事随流水，但寒烟衰草凝绿。"
  },
  {
   "t": 40.22,
   "d": 3.844,
   "s": "至今商女，时时犹唱，后庭遗曲。"
  }
 ]
