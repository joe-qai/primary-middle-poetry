  {
   "t": 0.1,
   "d": 1.631,
   "s": "古朗月行"
  },
  {
   "t": 1.681,
   "d": 2.458,
   "s": "唐代，李白"
  },
  {
   "t": 5.97,
   "d": 3.7,
   "s": "小时不识月，呼作白玉盘。"
  },
  {
   "t": 9.89,
   "d": 3.686,
   "s": "又疑瑶台镜，飞在青云端。"
  },
  {
   "t": 13.796,
   "d": 3.867,
   "s": "仙人垂两足，桂树何团团。"
  },
  {
   "t": 17.883,
   "d": 3.797,
   "s": "白兔捣药成，问言与谁餐？"
  },
  {
   "t": 21.9,
   "d": 3.867,
   "s": "蟾蜍蚀圆影，大明夜已残。"
  },
  {
   "t": 25.987,
   "d": 3.908,
   "s": "羿昔落九乌，天人清且安。"
  },
  {
   "t": 30.115,
   "d": 3.811,
   "s": "阴精此沦惑，去去不足观。"
  },
  {
   "t": 34.146,
   "d": 2.2,
   "s": "忧来其如何？"
  },
  {
   "t": 36.566,
   "d": 2.339,
   "s": "凄怆摧心肝。"
  }
 ]
}