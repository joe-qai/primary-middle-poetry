  {
   "t": 0.1,
   "d": 1.631,
   "s": "古朗月行"
  },
  {
   "t": 1.681,
   "d": 2.458,
   "s": "唐代，李白"
  },
  {
   "t": 4.239,
   "d": 3.7,
   "s": "小时不识月，呼作白玉盘。"
  },
  {
   "t": 8.159,
   "d": 3.686,
   "s": "又疑瑶台镜，飞在青云端。"
  },
  {
   "t": 12.065,
   "d": 3.867,
   "s": "仙人垂两足，桂树何团团。"
  },
  {
   "t": 16.152,
   "d": 3.797,
   "s": "白兔捣药成，问言与谁餐？"
  },
  {
   "t": 20.169,
   "d": 3.867,
   "s": "蟾蜍蚀圆影，大明夜已残。"
  },
  {
   "t": 24.256,
   "d": 3.908,
   "s": "羿昔落九乌，天人清且安。"
  },
  {
   "t": 28.384,
   "d": 3.811,
   "s": "阴精此沦惑，去去不足观。"
  },
  {
   "t": 32.415,
   "d": 2.2,
   "s": "忧来其如何？"
  },
  {
   "t": 34.835,
   "d": 1.525,
   "s": "凄怆摧心肝。"
  }
 ]
}