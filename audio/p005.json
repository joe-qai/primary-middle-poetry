  {
   "t": 0.1,
   "d": 1.631,
   "s": "古朗月行"
  },
  {
   "t": 1.681,
   "d": 2.125,
   "s": "唐代，李白"
  },
  {
   "t": 3.806,
   "d": 3.361,
   "s": "小时不识月，呼作白玉盘。"
  },
  {
   "t": 7.167,
   "d": 3.347,
   "s": "又疑瑶台镜，飞在青云端。"
  },
  {
   "t": 10.514,
   "d": 3.528,
   "s": "仙人垂两足，桂树何团团。"
  },
  {
   "t": 14.042,
   "d": 3.458,
   "s": "白兔捣药成，问言与谁餐？"
  },
  {
   "t": 17.5,
   "d": 3.528,
   "s": "蟾蜍蚀圆影，大明夜已残。"
  },
  {
   "t": 21.028,
   "d": 3.569,
   "s": "羿昔落九乌，天人清且安。"
  },
  {
   "t": 24.597,
   "d": 3.472,
   "s": "阴精此沦惑，去去不足观。"
  },
  {
   "t": 28.069,
   "d": 1.861,
   "s": "忧来其如何？"
  },
  {
   "t": 29.931,
   "d": 2.333,
   "s": "凄怆摧心肝。"
  }
 ]
}