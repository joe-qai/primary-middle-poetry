 "v": "f0d68e6a",
 "cues": [
  {
   "t": 0.1,
   "d": 2.075,
   "s": "周亚夫军细柳"
  },
  {
   "t": 2.125,
   "d": 2.319,
   "s": "西汉，司马迁"
  },
  {
   "t": 4.444,
   "d": 3.347,
   "s": "文帝之后六年，匈奴大入边。"
  },
  {
   "t": 7.792,
   "d": 10.972,
   "s": "乃以宗正刘礼为将军，军霸上；祝兹侯徐厉为将军，军棘门；以河内守亚夫为将军，军细柳：以备胡。"
  },
  {
   "t": 18.764,
   "d": 1.681,
   "s": "上自劳军。"
  },
  {
   "t": 20.444,
   "d": 4.986,
   "s": "至霸上及棘门军，直驰入，将以下骑送迎。"
  },
  {
   "t": 25.431,
   "d": 6.306,
   "s": "已而之细柳军，军士吏被甲，锐兵刃，彀弓弩，持满。"
  },
  {
   "t": 31.736,
   "d": 3.056,
   "s": "天子先驱至，不得入。"
  },
  {
   "t": 34.792,
   "d": 2.903,
   "s": "先驱曰：天子且至！"
  },
  {
   "t": 37.694,
   "d": 6.556,
   "s": "军门都尉曰：将军令曰：军中闻将军令，不闻天子之诏。"
  },
  {
   "t": 44.25,
   "d": 3.361,
   "s": "居无何，上至，又不得入。"
  },
  {
   "t": 47.611,
   "d": 5.014,
   "s": "于是上乃使使持节诏将军：吾欲入劳军。"
  },
  {
   "t": 52.625,
   "d": 2.5,
   "s": "亚夫乃传言开壁门。"
  },
  {
   "t": 55.125,
   "d": 5.681,
   "s": "壁门士吏谓从属车骑曰：将军约，军中不得驱驰。"
  },
  {
   "t": 60.806,
   "d": 3.028,
   "s": "于是天子乃按辔徐行。"
  },
  {
   "t": 63.833,
   "d": 6.667,
   "s": "至营，将军亚夫持兵揖曰：介胄之士不拜，请以军礼见。"
  },
  {
   "t": 70.5,
   "d": 2.903,
   "s": "天子为动，改容式车。"
  },
  {
   "t": 73.403,
   "d": 3.597,
   "s": "使人称谢：皇帝敬劳将军。"
  },
  {
   "t": 77.0,
   "d": 1.722,
   "s": "成礼而去。"
  },
  {
   "t": 78.722,
   "d": 2.944,
   "s": "既出军门，群臣皆惊。"
  },
  {
   "t": 81.667,
   "d": 3.75,
   "s": "文帝曰：嗟乎，此真将军矣！"
  },
  {
   "t": 85.417,
   "d": 5.958,
   "s": "曩者霸上、棘门军，若儿戏耳，其将固可袭而虏也。"
  },
  {
   "t": 91.375,
   "d": 3.069,
   "s": "至于亚夫，可得而犯邪！"
  },
  {
   "t": 94.444,
   "d": 2.278,
   "s": "称善者久之。"
  }
 ]
}