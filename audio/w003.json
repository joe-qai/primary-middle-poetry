 "cues": [
  {
   "t": 0.1,
   "d": 1.311,
   "s": "三峡"
  },
  {
   "t": 1.361,
   "d": 2.028,
   "s": "北魏，郦道元"
  },
  {
   "t": 3.389,
   "d": 4.722,
   "s": "自三峡七百里中，两岸连山，略无阙处。"
  },
  {
   "t": 8.111,
   "d": 2.847,
   "s": "重岩叠嶂，隐天蔽日。"
  },
  {
   "t": 10.958,
   "d": 3.208,
   "s": "自非亭午夜分，不见曦月。"
  },
  {
   "t": 14.167,
   "d": 3.472,
   "s": "至于夏水襄陵，沿溯阻绝。"
  },
  {
   "t": 17.639,
   "d": 8.486,
   "s": "或王命急宣，有时朝发白帝，暮到江陵，其间千二百里，虽乘奔御风，不以疾也。"
  },
  {
   "t": 26.125,
   "d": 4.708,
   "s": "春冬之时，则素湍绿潭，回清倒影。"
  },
  {
   "t": 30.833,
   "d": 7.181,
   "s": "绝巘多生怪柏，悬泉瀑布，飞漱其间，清荣峻茂，良多趣味。"
  },
  {
   "t": 38.014,
   "d": 8.681,
   "s": "每至晴初霜旦，林寒涧肃，常有高猿长啸，属引凄异，空谷传响，哀转久绝。"
  },
  {
   "t": 46.694,
   "d": 6.028,
   "s": "故渔者歌曰：巴东三峡巫峡长，猿鸣三声泪沾裳。"
  }
 ]
}