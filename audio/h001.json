  {
   "t": 0.1,
   "d": 2.353,
   "s": "沁园春，长沙"
  },
  {
   "t": 2.403,
   "d": 2.681,
   "s": "现代，毛泽东"
  },
  {
   "t": 5.236,
   "d": 4.658,
   "s": "独立寒秋，湘江北去，橘子洲头。"
  },
  {
   "t": 10.012,
   "d": 6.242,
   "s": "看万山红遍，层林尽染；漫江碧透，百舸争流。"
  },
  {
   "t": 16.372,
   "d": 5.047,
   "s": "鹰击长空，鱼翔浅底，万类霜天竞自由。"
  },
  {
   "t": 21.532,
   "d": 4.575,
   "s": "怅寥廓，问苍茫大地，谁主沉浮？"
  },
  {
   "t": 26.212,
   "d": 2.269,
   "s": "携来百侣曾游。"
  },
  {
   "t": 28.588,
   "d": 2.783,
   "s": "忆往昔峥嵘岁月稠。"
  },
  {
   "t": 31.492,
   "d": 6.006,
   "s": "恰同学少年，风华正茂；书生意气，挥斥方遒。"
  },
  {
   "t": 37.612,
   "d": 5.117,
   "s": "指点江山，激扬文字，粪土当年万户侯。"
  },
  {
   "t": 42.844,
   "d": 4.325,
   "s": "曾记否，到中流击水，浪遏飞舟？"
  }
 ]
}