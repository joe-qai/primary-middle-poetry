 "cues": [
  {
   "t": 0.1,
   "d": 2.353,
   "s": "沁园春，长沙"
  },
  {
   "t": 2.403,
   "d": 2.681,
   "s": "现代，毛泽东"
  },
  {
   "t": 5.236,
   "d": 4.658,
   "s": "独立寒秋，湘江北去，橘子洲头。"
  },
  {
   "t": 10.012,
   "d": 6.964,
   "s": "\\n看万山红遍，层林尽染；漫江碧透，百舸争流。"
  },
  {
   "t": 17.092,
   "d": 5.894,
   "s": "\\n鹰击长空，鱼翔浅底，万类霜天竞自由。"
  },
  {
   "t": 23.092,
   "d": 5.519,
   "s": "\\n怅寥廓，问苍茫大地，谁主沉浮？"
  },
  {
   "t": 28.732,
   "d": 3.172,
   "s": "\\n携来百侣曾游。"
  },
  {
   "t": 32.02,
   "d": 2.783,
   "s": "忆往昔峥嵘岁月稠。"
  },
  {
   "t": 34.924,
   "d": 6.686,
   "s": "\\n恰同学少年，风华正茂；书生意气，挥斥方遒。"
  },
  {
   "t": 41.716,
   "d": 6.186,
   "s": "\\n指点江山，激扬文字，粪土当年万户侯。"
  },
  {
   "t": 48.004,
   "d": 5.436,
   "s": "\\n曾记否，到中流击水，浪遏飞舟？"
  }
 ]
}