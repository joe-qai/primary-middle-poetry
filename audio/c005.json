{
 "id": "c005",
 "title": "六国论",
 "voice": "zh-CN-YunjianNeural",
 "rate": "-10%",
 "pitch": "+0Hz",
 "dur": 172.08,
 "hdr": 2,
 "bodyCues": 35,
 "v": "10c524bb",
 "cues": [
  {
   "t": 0.1,
   "d": 1.436,
   "s": "六国论"
  },
  {
   "t": 1.486,
   "d": 2.153,
   "s": "北宋，苏洵"
  },
  {
   "t": 3.639,
   "d": 4.917,
   "s": "六国破灭，非兵不利，战不善，弊在赂秦。"
  },
  {
   "t": 8.556,
   "d": 3.347,
   "s": "赂秦而力亏，破灭之道也。"
  },
  {
   "t": 11.903,
   "d": 3.778,
   "s": "或曰：六国互丧，率赂秦耶？"
  },
  {
   "t": 15.681,
   "d": 5.236,
   "s": "曰：不赂者以赂者丧，盖失强援，不能独完。"
  },
  {
   "t": 20.917,
   "d": 2.236,
   "s": "故曰弊在赂秦也。"
  },
  {
   "t": 23.153,
   "d": 4.542,
   "s": "秦以攻取之外，小则获邑，大则得城。"
  },
  {
   "t": 27.694,
   "d": 8.792,
   "s": "较秦之所得，与战胜而得者，其实百倍；诸侯之所亡，与战败而亡者，其实亦百倍。"
  },
  {
   "t": 36.486,
   "d": 5.042,
   "s": "则秦之所大欲，诸侯之所大患，固不在战矣。"
  },
  {
   "t": 41.528,
   "d": 5.583,
   "s": "思厥先祖父，暴霜露，斩荆棘，以有尺寸之地。"
  },
  {
   "t": 47.111,
   "d": 4.694,
   "s": "子孙视之不甚惜，举以予人，如弃草芥。"
  },
  {
   "t": 51.806,
   "d": 5.125,
   "s": "今日割五城，明日割十城，然后得一夕安寝。"
  },
  {
   "t": 56.931,
   "d": 3.542,
   "s": "起视四境，而秦兵又至矣。"
  },
  {
   "t": 60.472,
   "d": 6.264,
   "s": "然则诸侯之地有限，暴秦之欲无厌，奉之弥繁，侵之愈急。"
  },
  {
   "t": 66.736,
   "d": 3.222,
   "s": "故不战而强弱胜负已判矣。"
  },
  {
   "t": 69.958,
   "d": 2.875,
   "s": "至于颠覆，理固宜然。"
  },
  {
   "t": 72.833,
   "d": 6.111,
   "s": "古人云：以地事秦，犹抱薪救火，薪不尽，火不灭。"
  },
  {
   "t": 78.944,
   "d": 1.597,
   "s": "此言得之。"
  },
  {
   "t": 80.542,
   "d": 4.625,
   "s": "齐人未尝赂秦，终继五国迁灭，何哉？"
  },
  {
   "t": 85.167,
   "d": 2.431,
   "s": "与嬴而不助五国也。"
  },
  {
   "t": 87.597,
   "d": 2.806,
   "s": "五国既丧，齐亦不免矣。"
  },
  {
   "t": 90.403,
   "d": 5.319,
   "s": "燕赵之君，始有远略，能守其土，义不赂秦。"
  },
  {
   "t": 95.722,
   "d": 4.972,
   "s": "是故燕虽小国，而后亡，斯用兵之效也。"
  },
  {
   "t": 100.694,
   "d": 3.556,
   "s": "至丹以荆卿为计，始速祸焉。"
  },
  {
   "t": 104.25,
   "d": 3.569,
   "s": "赵尝五战于秦，二败而三胜。"
  },
  {
   "t": 107.819,
   "d": 3.667,
   "s": "后秦击赵者再，李牧连却之。"
  },
  {
   "t": 111.486,
   "d": 5.111,
   "s": "洎牧以谗诛，邯郸为郡，惜其用武而不终也。"
  },
  {
   "t": 116.597,
   "d": 7.278,
   "s": "且燕赵处秦革灭殆尽之际，可谓智力孤危，战败而亡，诚不得已。"
  },
  {
   "t": 123.875,
   "d": 11.458,
   "s": "向使三国各爱其地，齐人勿附于秦，刺客不行，良将犹在，则胜负之数，存亡之理，当与秦相较，或未易量。"
  },
  {
   "t": 135.333,
   "d": 1.583,
   "s": "呜呼！"
  },
  {
   "t": 136.917,
   "d": 9.833,
   "s": "以赂秦之地封天下之谋臣，以事秦之心礼天下之奇才，并力西向，则吾恐秦人食之不得下咽也。"
  },
  {
   "t": 146.75,
   "d": 1.333,
   "s": "悲夫！"
  },
  {
   "t": 148.083,
   "d": 6.5,
   "s": "有如此之势，而为秦人积威之所劫，日削月割，以趋于亡。"
  },
  {
   "t": 154.583,
   "d": 3.528,
   "s": "为国者无使为积威之所劫哉！"
  },
  {
   "t": 158.111,
   "d": 7.167,
   "s": "夫六国与秦皆诸侯，其势弱于秦，而犹有可以不赂，而胜之之势。"
  },
  {
   "t": 165.278,
   "d": 6.722,
   "s": "苟以天下之大，下而从六国破亡之故事，是又在六国下矣。"
  }
 ]
}