 "cues": [
  {
   "t": 0.1,
   "d": 1.756,
   "s": "守株待兔"
  },
  {
   "t": 1.806,
   "d": 3.292,
   "s": "战国，韩非子，五蠹"
  },
  {
   "t": 5.097,
   "d": 4.236,
   "s": "宋国有个农夫，每天在田里辛勤耕作。"
  },
  {
   "t": 9.333,
   "d": 11.153,
   "s": "有一天，他正在田里干活，忽然看见一只兔子从树林里跑出来，慌慌张张地撞在田边的树桩上，折断脖子死了。"
  },
  {
   "t": 20.486,
   "d": 5.514,
   "s": "农夫捡起兔子，高兴极了，白得了一只肥美的兔子。"
  },
  {
   "t": 26.0,
   "d": 7.694,
   "s": "从此，他便放下手中的农具，天天守在那个树桩旁，等着再有兔子撞死。"
  },
  {
   "t": 33.694,
   "d": 5.139,
   "s": "可是一天又一天过去了，再也没有兔子撞到树桩上。"
  },
  {
   "t": 38.833,
   "d": 4.875,
   "s": "而他的田地却因为无人耕种，长满了荒草。"
  },
  {
   "t": 43.708,
   "d": 4.056,
   "s": "这个农夫因此成了宋国人的笑柄。"
  }
 ]
}