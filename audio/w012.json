 "cues": [
  {
   "t": 0.1,
   "d": 1.728,
   "s": "论语十二章"
  },
  {
   "t": 1.778,
   "d": 2.958,
   "s": "春秋，孔子及其弟子"
  },
  {
   "t": 4.736,
   "d": 3.931,
   "s": "子曰：学而时习之，不亦说乎？"
  },
  {
   "t": 8.667,
   "d": 3.264,
   "s": "有朋自远方来，不亦乐乎？"
  },
  {
   "t": 11.931,
   "d": 3.667,
   "s": "人不知而不愠，不亦君子乎？"
  },
  {
   "t": 15.597,
   "d": 1.028,
   "s": "学而"
  },
  {
   "t": 16.625,
   "d": 5.389,
   "s": "曾子曰：吾日三省吾身：为人谋而不忠乎？"
  },
  {
   "t": 22.014,
   "d": 2.542,
   "s": "与朋友交而不信乎？"
  },
  {
   "t": 24.556,
   "d": 1.639,
   "s": "传不习乎？"
  },
  {
   "t": 26.194,
   "d": 1.028,
   "s": "学而"
  },
  {
   "t": 27.222,
   "d": 11.583,
   "s": "子曰：吾十有五而志于学，三十而立，四十而不惑，五十而知天命，六十而耳顺，七十而从心所欲，不逾矩。"
  },
  {
   "t": 38.806,
   "d": 3.986,
   "s": "子曰：温故而知新，可以为师矣。"
  },
  {
   "t": 42.792,
   "d": 4.556,
   "s": "子曰：学而不思则罔，思而不学则殆。"
  },
  {
   "t": 47.347,
   "d": 2.875,
   "s": "子曰：贤哉，回也！"
  },
  {
   "t": 50.222,
   "d": 6.222,
   "s": "一箪食，一瓢饮，在陋巷，人不堪其忧，回也不改其乐。"
  },
  {
   "t": 56.444,
   "d": 2.194,
   "s": "贤哉，回也！"
  },
  {
   "t": 58.639,
   "d": 5.556,
   "s": "子曰：知之者不如好之者，好之者不如乐之者。"
  },
  {
   "t": 64.194,
   "d": 6.472,
   "s": "子曰：饭疏食，饮水，曲肱而枕之，乐亦在其中矣。"
  },
  {
   "t": 70.667,
   "d": 3.917,
   "s": "不义而富且贵，于我如浮云。"
  },
  {
   "t": 74.583,
   "d": 3.694,
   "s": "子曰：三人行，必有我师焉。"
  },
  {
   "t": 78.278,
   "d": 4.292,
   "s": "择其善者而从之，其不善者而改之。"
  },
  {
   "t": 82.569,
   "d": 4.792,
   "s": "子在川上曰：逝者如斯夫，不舍昼夜。"
  },
  {
   "t": 87.361,
   "d": 4.875,
   "s": "子曰：三军可夺帅也，匹夫不可夺志也。"
  },
  {
   "t": 92.236,
   "d": 6.236,
   "s": "子夏曰：博学而笃志，切问而近思，仁在其中矣。"
  }
 ]
}