   "s": "卖炭翁"
  },
  {
   "t": 1.458,
   "d": 2.264,
   "s": "唐代，白居易"
  },
  {
   "t": 3.722,
   "d": 3.514,
   "s": "卖炭翁，伐薪烧炭南山中。"
  },
  {
   "t": 7.236,
   "d": 4.25,
   "s": "满面尘灰烟火色，两鬓苍苍十指黑。"
  },
  {
   "t": 11.486,
   "d": 2.528,
   "s": "卖炭得钱何所营？"
  },
  {
   "t": 14.014,
   "d": 2.389,
   "s": "身上衣裳口中食。"
  },
  {
   "t": 16.403,
   "d": 4.319,
   "s": "可怜身上衣正单，心忧炭贱愿天寒。"
  },
  {
   "t": 20.722,
   "d": 4.556,
   "s": "夜来城外一尺雪，晓驾炭车辗冰辙。"
  },
  {
   "t": 25.278,
   "d": 4.028,
   "s": "牛困人饥日已高，市南门外泥中歇。"
  },
  {
   "t": 29.306,
   "d": 2.097,
   "s": "翩翩两骑来是谁？"
  },
  {
   "t": 31.403,
   "d": 2.306,
   "s": "黄衣使者白衫儿。"
  },
  {
   "t": 33.708,
   "d": 4.444,
   "s": "手把文书口称敕，回车叱牛牵向北。"
  },
  {
   "t": 38.153,
   "d": 4.319,
   "s": "一车炭，千余斤，宫使驱将惜不得。"
  },
  {
   "t": 42.472,
   "d": 4.736,
   "s": "半匹红纱一丈绫，系向牛头充炭直。"
  }
 ]
}