   "d": 1.408,
   "s": "卖炭翁"
  },
  {
   "t": 1.458,
   "d": 2.597,
   "s": "唐代，白居易"
  },
  {
   "t": 4.155,
   "d": 3.853,
   "s": "卖炭翁，伐薪烧炭南山中。"
  },
  {
   "t": 8.228,
   "d": 4.589,
   "s": "满面尘灰烟火色，两鬓苍苍十指黑。"
  },
  {
   "t": 13.037,
   "d": 2.867,
   "s": "卖炭得钱何所营？"
  },
  {
   "t": 16.124,
   "d": 2.728,
   "s": "身上衣裳口中食。"
  },
  {
   "t": 19.072,
   "d": 4.658,
   "s": "可怜身上衣正单，心忧炭贱愿天寒。"
  },
  {
   "t": 23.95,
   "d": 4.894,
   "s": "夜来城外一尺雪，晓驾炭车辗冰辙。"
  },
  {
   "t": 29.064,
   "d": 4.367,
   "s": "牛困人饥日已高，市南门外泥中歇。"
  },
  {
   "t": 33.651,
   "d": 2.436,
   "s": "翩翩两骑来是谁？"
  },
  {
   "t": 36.307,
   "d": 2.644,
   "s": "黄衣使者白衫儿。"
  },
  {
   "t": 39.171,
   "d": 4.783,
   "s": "手把文书口称敕，回车叱牛牵向北。"
  },
  {
   "t": 44.174,
   "d": 4.658,
   "s": "一车炭，千余斤，宫使驱将惜不得。"
  },
  {
   "t": 49.052,
   "d": 3.628,
   "s": "半匹红纱一丈绫，系向牛头充炭直。"
  }
 ]
}