  {
   "t": 0.1,
   "d": 1.408,
   "s": "卖炭翁"
  },
  {
   "t": 1.458,
   "d": 2.597,
   "s": "唐代，白居易"
  },
  {
   "t": 5.663,
   "d": 3.853,
   "s": "卖炭翁，伐薪烧炭南山中。"
  },
  {
   "t": 9.736,
   "d": 4.589,
   "s": "满面尘灰烟火色，两鬓苍苍十指黑。"
  },
  {
   "t": 14.545,
   "d": 2.867,
   "s": "卖炭得钱何所营？"
  },
  {
   "t": 17.632,
   "d": 2.728,
   "s": "身上衣裳口中食。"
  },
  {
   "t": 20.58,
   "d": 4.658,
   "s": "可怜身上衣正单，心忧炭贱愿天寒。"
  },
  {
   "t": 25.458,
   "d": 4.894,
   "s": "夜来城外一尺雪，晓驾炭车辗冰辙。"
  },
  {
   "t": 30.572,
   "d": 4.367,
   "s": "牛困人饥日已高，市南门外泥中歇。"
  },
  {
   "t": 35.159,
   "d": 2.436,
   "s": "翩翩两骑来是谁？"
  },
  {
   "t": 37.815,
   "d": 2.644,
   "s": "黄衣使者白衫儿。"
  },
  {
   "t": 40.679,
   "d": 4.783,
   "s": "手把文书口称敕，回车叱牛牵向北。"
  },
  {
   "t": 45.682,
   "d": 4.658,
   "s": "一车炭，千余斤，宫使驱将惜不得。"
  },
  {
   "t": 50.56,
   "d": 4.742,
   "s": "半匹红纱一丈绫，系向牛头充炭直。"
  }
 ]
}