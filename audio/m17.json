  {
   "t": 0.1,
   "d": 2.575,
   "s": "沁园春，雪节选"
  },
  {
   "t": 2.625,
   "d": 2.681,
   "s": "现代，毛泽东"
  },
  {
   "t": 5.476,
   "d": 4.644,
   "s": "北国风光，千里冰封，万里雪飘。"
  },
  {
   "t": 10.228,
   "d": 6.047,
   "s": "望长城内外，惟余莽莽；大河上下，顿失滔滔。"
  },
  {
   "t": 16.396,
   "d": 5.2,
   "s": "山舞银蛇，原驰蜡象，欲与天公试比高。"
  },
  {
   "t": 21.7,
   "d": 4.867,
   "s": "须晴日，看红装素裹，分外妖娆。"
  },
  {
   "t": 26.668,
   "d": 4.617,
   "s": "江山如此多娇，引无数英雄竞折腰。"
  },
  {
   "t": 31.396,
   "d": 6.339,
   "s": "惜秦皇汉武，略输文采；唐宗宋祖，稍逊风骚。"
  },
  {
   "t": 37.852,
   "d": 5.131,
   "s": "一代天骄，成吉思汗，只识弯弓射大雕。"
  },
  {
   "t": 43.084,
   "d": 4.256,
   "s": "俱往矣，数风流人物，还看今朝。"
  }
 ]
}