 "cues": [
  {
   "t": 0.1,
   "d": 2.769,
   "s": "念奴娇，赤壁怀古"
  },
  {
   "t": 2.819,
   "d": 2.472,
   "s": "宋代，苏轼"
  },
  {
   "t": 5.452,
   "d": 4.811,
   "s": "大江东去，浪淘尽，千古风流人物。"
  },
  {
   "t": 10.372,
   "d": 4.686,
   "s": "故垒西边，人道是，三国周郎赤壁。"
  },
  {
   "t": 15.172,
   "d": 5.228,
   "s": "乱石穿空，惊涛拍岸，卷起千堆雪。"
  },
  {
   "t": 20.5,
   "d": 3.769,
   "s": "江山如画，一时多少豪杰。"
  },
  {
   "t": 24.388,
   "d": 5.075,
   "s": "遥想公瑾当年，小乔初嫁了，雄姿英发。"
  },
  {
   "t": 29.572,
   "d": 4.881,
   "s": "羽扇纶巾，谈笑间，樯橹灰飞烟灭。"
  },
  {
   "t": 34.564,
   "d": 4.561,
   "s": "故国神游，多情应笑我，早生华发。"
  },
  {
   "t": 39.244,
   "d": 3.811,
   "s": "人生如梦，一尊还酹江月。"
  }
 ]
}