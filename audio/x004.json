 "cues": [
  {
   "t": 0.1,
   "d": 2.769,
   "s": "念奴娇，赤壁怀古"
  },
  {
   "t": 2.819,
   "d": 2.139,
   "s": "宋代，苏轼"
  },
  {
   "t": 4.958,
   "d": 4.472,
   "s": "大江东去，浪淘尽，千古风流人物。"
  },
  {
   "t": 9.431,
   "d": 4.347,
   "s": "故垒西边，人道是，三国周郎赤壁。"
  },
  {
   "t": 13.778,
   "d": 4.889,
   "s": "乱石穿空，惊涛拍岸，卷起千堆雪。"
  },
  {
   "t": 18.667,
   "d": 3.431,
   "s": "江山如画，一时多少豪杰。"
  },
  {
   "t": 22.097,
   "d": 4.736,
   "s": "遥想公瑾当年，小乔初嫁了，雄姿英发。"
  },
  {
   "t": 26.833,
   "d": 4.542,
   "s": "羽扇纶巾，谈笑间，樯橹灰飞烟灭。"
  },
  {
   "t": 31.375,
   "d": 4.222,
   "s": "故国神游，多情应笑我，早生华发。"
  },
  {
   "t": 35.597,
   "d": 3.806,
   "s": "人生如梦，一尊还酹江月。"
  }
 ]
}