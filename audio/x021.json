  {
   "t": 0.1,
   "d": 3.561,
   "s": "永遇乐，京口北固亭怀古"
  },
  {
   "t": 3.611,
   "d": 2.306,
   "s": "宋代，辛弃疾"
  },
  {
   "t": 5.917,
   "d": 4.389,
   "s": "千古江山，英雄无觅，孙仲谋处。"
  },
  {
   "t": 10.306,
   "d": 4.125,
   "s": "舞榭歌台，风流总被，雨打风吹去。"
  },
  {
   "t": 14.431,
   "d": 4.792,
   "s": "斜阳草树，寻常巷陌，人道寄奴曾住。"
  },
  {
   "t": 19.222,
   "d": 4.583,
   "s": "想当年，金戈铁马，气吞万里如虎。"
  },
  {
   "t": 23.806,
   "d": 4.847,
   "s": "元嘉草草，封狼居胥，赢得仓皇北顾。"
  },
  {
   "t": 28.653,
   "d": 4.5,
   "s": "四十三年，望中犹记，烽火扬州路。"
  },
  {
   "t": 33.153,
   "d": 4.681,
   "s": "可堪回首，佛狸祠下，一片神鸦社鼓。"
  },
  {
   "t": 37.833,
   "d": 4.278,
   "s": "凭谁问：廉颇老矣，尚能饭否？"
  }
 ]
}