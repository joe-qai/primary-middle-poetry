  {
   "t": 0.1,
   "d": 3.561,
   "s": "永遇乐，京口北固亭怀古"
  },
  {
   "t": 3.611,
   "d": 2.639,
   "s": "宋代，辛弃疾"
  },
  {
   "t": 6.412,
   "d": 4.728,
   "s": "千古江山，英雄无觅，孙仲谋处。"
  },
  {
   "t": 11.26,
   "d": 4.464,
   "s": "舞榭歌台，风流总被，雨打风吹去。"
  },
  {
   "t": 15.844,
   "d": 5.131,
   "s": "斜阳草树，寻常巷陌，人道寄奴曾住。"
  },
  {
   "t": 21.076,
   "d": 4.922,
   "s": "想当年，金戈铁马，气吞万里如虎。"
  },
  {
   "t": 26.116,
   "d": 5.186,
   "s": "元嘉草草，封狼居胥，赢得仓皇北顾。"
  },
  {
   "t": 31.42,
   "d": 4.839,
   "s": "四十三年，望中犹记，烽火扬州路。"
  },
  {
   "t": 36.364,
   "d": 5.019,
   "s": "可堪回首，佛狸祠下，一片神鸦社鼓。"
  },
  {
   "t": 41.5,
   "d": 4.283,
   "s": "凭谁问：廉颇老矣，尚能饭否？"
  }
 ]
}