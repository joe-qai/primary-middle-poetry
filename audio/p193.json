   "s": "七哀诗三首，其一"
  },
  {
   "t": 2.597,
   "d": 2.431,
   "s": "汉代，王粲"
  },
  {
   "t": 5.128,
   "d": 3.617,
   "s": "西京乱无象，豺虎方遘患。"
  },
  {
   "t": 8.965,
   "d": 3.797,
   "s": "复弃中国去，委身适荆蛮。"
  },
  {
   "t": 12.982,
   "d": 3.297,
   "s": "亲戚对我悲，朋友相追攀。"
  },
  {
   "t": 16.499,
   "d": 3.783,
   "s": "出门无所见，白骨蔽平原。"
  },
  {
   "t": 20.502,
   "d": 3.742,
   "s": "路有饥妇人，抱子弃草间。"
  },
  {
   "t": 24.464,
   "d": 3.894,
   "s": "顾闻号泣声，挥涕独不还。"
  },
  {
   "t": 28.578,
   "d": 3.908,
   "s": "未知身死处，何能两相完？"
  },
  {
   "t": 32.706,
   "d": 3.811,
   "s": "抚襟望古人，达节殊不然。"
  },
  {
   "t": 36.737,
   "d": 2.269,
   "s": "借问此何时？"
  },
  {
   "t": 39.226,
   "d": 2.242,
   "s": "蝗蝗岁云暮。"
  },
  {
   "t": 41.688,
   "d": 2.424,
   "s": "悠悠卷旆旌，饥馑不可渡。"
  }
 ]
