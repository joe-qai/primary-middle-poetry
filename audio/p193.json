   "s": "七哀诗三首，其一"
  },
  {
   "t": 2.597,
   "d": 2.097,
   "s": "汉代，王粲"
  },
  {
   "t": 4.694,
   "d": 3.278,
   "s": "西京乱无象，豺虎方遘患。"
  },
  {
   "t": 7.972,
   "d": 3.458,
   "s": "复弃中国去，委身适荆蛮。"
  },
  {
   "t": 11.431,
   "d": 2.958,
   "s": "亲戚对我悲，朋友相追攀。"
  },
  {
   "t": 14.389,
   "d": 3.444,
   "s": "出门无所见，白骨蔽平原。"
  },
  {
   "t": 17.833,
   "d": 3.403,
   "s": "路有饥妇人，抱子弃草间。"
  },
  {
   "t": 21.236,
   "d": 3.556,
   "s": "顾闻号泣声，挥涕独不还。"
  },
  {
   "t": 24.792,
   "d": 3.569,
   "s": "未知身死处，何能两相完？"
  },
  {
   "t": 28.361,
   "d": 3.472,
   "s": "抚襟望古人，达节殊不然。"
  },
  {
   "t": 31.833,
   "d": 1.931,
   "s": "借问此何时？"
  },
  {
   "t": 33.764,
   "d": 1.903,
   "s": "蝗蝗岁云暮。"
  },
  {
   "t": 35.667,
   "d": 3.472,
   "s": "悠悠卷旆旌，饥馑不可渡。"
  }
 ]
}