   "s": "七哀诗三首，其一"
  },
  {
   "t": 2.597,
   "d": 2.431,
   "s": "汉代，王粲"
  },
  {
   "t": 5.188,
   "d": 3.617,
   "s": "西京乱无象，豺虎方遘患。"
  },
  {
   "t": 8.908,
   "d": 3.797,
   "s": "复弃中国去，委身适荆蛮。"
  },
  {
   "t": 12.82,
   "d": 3.297,
   "s": "亲戚对我悲，朋友相追攀。"
  },
  {
   "t": 16.228,
   "d": 3.783,
   "s": "出门无所见，白骨蔽平原。"
  },
  {
   "t": 20.116,
   "d": 3.74,
   "s": "路有饥妇人，抱子弃草间。"
  },
  {
   "t": 23.956,
   "d": 3.894,
   "s": "顾闻号泣声，挥涕独不还。"
  },
  {
   "t": 27.964,
   "d": 3.908,
   "s": "未知身死处，何能两相完？"
  },
  {
   "t": 31.972,
   "d": 3.811,
   "s": "抚襟望古人，达节殊不然。"
  },
  {
   "t": 35.884,
   "d": 2.269,
   "s": "借问此何时？"
  },
  {
   "t": 38.26,
   "d": 2.242,
   "s": "蝗蝗岁云暮。"
  },
  {
   "t": 40.612,
   "d": 3.478,
   "s": "悠悠卷旆旌，饥馑不可渡。"
  }
 ]
