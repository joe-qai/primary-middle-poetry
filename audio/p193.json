   "d": 2.431,
   "s": "汉代，王粲"
  },
  {
   "t": 7.775,
   "d": 1.644,
   "s": "西京"
  },
  {
   "t": 9.819,
   "d": 2.881,
   "s": "乱无象，豺虎方遘患。"
  },
  {
   "t": 12.65,
   "d": 1.528,
   "s": "复弃"
  },
  {
   "t": 17.559,
   "d": 3.006,
   "s": "中国去，委身适荆蛮。"
  },
  {
   "t": 20.515,
   "d": 1.667,
   "s": "亲戚"
  },
  {
   "t": 25.688,
   "d": 2.506,
   "s": "对我悲，朋友相追攀。"
  },
  {
   "t": 28.144,
   "d": 1.569,
   "s": "出门"
  },
  {
   "t": 32.719,
   "d": 2.825,
   "s": "无所见，白骨蔽平原。"
  },
  {
   "t": 35.494,
   "d": 1.514,
   "s": "路有"
  },
  {
   "t": 40.333,
   "d": 3.019,
   "s": "饥妇人，抱子弃草间。"
  },
  {
   "t": 43.302,
   "d": 1.583,
   "s": "顾闻"
  },
  {
   "t": 48.404,
   "d": 3.047,
   "s": "号泣声，挥涕独不还。"
  },
  {
   "t": 51.401,
   "d": 1.5,
   "s": "未知"
  },
  {
   "t": 56.448,
   "d": 3.131,
   "s": "身死处，何能两相完？"
  },
  {
   "t": 59.529,
   "d": 1.611,
   "s": "抚襟"
  },
  {
   "t": 64.771,
   "d": 2.839,
   "s": "望古人，达节殊不然。"
  },
  {
   "t": 67.56,
   "d": 1.931,
   "s": "借问此何时？"
  },
  {
   "t": 69.49,
   "d": 1.903,
   "s": "蝗蝗岁云暮。"
  },
  {
   "t": 71.393,
   "d": 1.444,
   "s": "悠悠"
  },
  {
   "t": 87.718,
   "d": 2.992,
   "s": "卷旆旌，饥馑不可渡。"
  }
