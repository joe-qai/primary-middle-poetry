 "cues": [
  {
   "t": 0.1,
   "d": 2.561,
   "s": "茅屋为秋风所破歌"
  },
  {
   "t": 2.611,
   "d": 2.028,
   "s": "唐代，杜甫"
  },
  {
   "t": 4.639,
   "d": 4.375,
   "s": "八月秋高风怒号，卷我屋上三重茅。"
  },
  {
   "t": 9.014,
   "d": 6.431,
   "s": "茅飞渡江洒江郊，高者挂罥长林梢，下者飘转沉塘坳。"
  },
  {
   "t": 15.444,
   "d": 4.736,
   "s": "南村群童欺我老无力，忍能对面为盗贼。"
  },
  {
   "t": 20.181,
   "d": 6.069,
   "s": "公然抱茅入竹去，唇焦口燥呼不得，归来倚杖自叹息。"
  },
  {
   "t": 26.25,
   "d": 4.389,
   "s": "俄顷风定云墨色，秋天漠漠向昏黑。"
  },
  {
   "t": 30.639,
   "d": 4.375,
   "s": "布衾多年冷似铁，娇儿恶卧踏里裂。"
  },
  {
   "t": 35.014,
   "d": 4.236,
   "s": "床头屋漏无干处，雨脚如麻未断绝。"
  },
  {
   "t": 39.25,
   "d": 4.486,
   "s": "自经丧乱少睡眠，长夜沾湿何由彻！"
  },
  {
   "t": 43.736,
   "d": 4.931,
   "s": "安得广厦千万间，大庇天下寒士俱欢颜！"
  },
  {
   "t": 48.667,
   "d": 2.347,
   "s": "风雨不动安如山。"
  },
  {
   "t": 51.014,
   "d": 1.583,
   "s": "呜呼！"
  },
  {
   "t": 52.597,
   "d": 5.597,
   "s": "何时眼前突兀见此屋，吾庐独破受冻死亦足！"
  }
 ]
}