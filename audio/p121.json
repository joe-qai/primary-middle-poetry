 "cues": [
  {
   "t": 0.1,
   "d": 2.561,
   "s": "茅屋为秋风所破歌"
  },
  {
   "t": 2.611,
   "d": 2.361,
   "s": "唐代，杜甫"
  },
  {
   "t": 5.14,
   "d": 4.714,
   "s": "八月秋高风怒号，卷我屋上三重茅。"
  },
  {
   "t": 9.964,
   "d": 6.769,
   "s": "茅飞渡江洒江郊，高者挂罥长林梢，下者飘转沉塘坳。"
  },
  {
   "t": 16.852,
   "d": 5.075,
   "s": "南村群童欺我老无力，忍能对面为盗贼。"
  },
  {
   "t": 22.036,
   "d": 6.408,
   "s": "公然抱茅入竹去，唇焦口燥呼不得，归来倚杖自叹息。"
  },
  {
   "t": 28.564,
   "d": 4.728,
   "s": "俄顷风定云墨色，秋天漠漠向昏黑。"
  },
  {
   "t": 33.412,
   "d": 4.714,
   "s": "布衾多年冷似铁，娇儿恶卧踏里裂。"
  },
  {
   "t": 38.236,
   "d": 4.575,
   "s": "床头屋漏无干处，雨脚如麻未断绝。"
  },
  {
   "t": 42.916,
   "d": 4.825,
   "s": "自经丧乱少睡眠，长夜沾湿何由彻！"
  },
  {
   "t": 47.86,
   "d": 5.269,
   "s": "安得广厦千万间，大庇天下寒士俱欢颜！"
  },
  {
   "t": 53.236,
   "d": 2.686,
   "s": "风雨不动安如山。"
  },
  {
   "t": 56.044,
   "d": 1.922,
   "s": "呜呼！"
  },
  {
   "t": 58.084,
   "d": 5.603,
   "s": "何时眼前突兀见此屋，吾庐独破受冻死亦足！"
  }
 ]
}