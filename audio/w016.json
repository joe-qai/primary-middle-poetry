 "cues": [
  {
   "t": 0.1,
   "d": 1.742,
   "s": "河中石兽"
  },
  {
   "t": 1.792,
   "d": 2.0,
   "s": "清代，纪昀"
  },
  {
   "t": 3.792,
   "d": 5.514,
   "s": "沧州南一寺临河干，山门圮于河，二石兽并沉焉。"
  },
  {
   "t": 9.306,
   "d": 7.264,
   "s": "阅十余岁，僧募金重修，求二石兽于水中，竟不可得，以为顺流下矣。"
  },
  {
   "t": 16.569,
   "d": 4.403,
   "s": "棹数小舟，曳铁钯，寻十余里无迹。"
  },
  {
   "t": 20.972,
   "d": 5.486,
   "s": "一讲学家设帐寺中，闻之笑曰：尔辈不能究物理。"
  },
  {
   "t": 26.458,
   "d": 3.903,
   "s": "是非木杮，岂能为暴涨携之去？"
  },
  {
   "t": 30.361,
   "d": 5.806,
   "s": "乃石性坚重，沙性松浮，湮于沙上，渐沉渐深耳。"
  },
  {
   "t": 36.167,
   "d": 2.806,
   "s": "沿河求之，不亦颠乎？"
  },
  {
   "t": 38.972,
   "d": 1.931,
   "s": "众服为确论。"
  },
  {
   "t": 40.903,
   "d": 6.403,
   "s": "一老河兵闻之，又笑曰：凡河中失石，当求之于上流。"
  },
  {
   "t": 47.306,
   "d": 8.639,
   "s": "盖石性坚重，沙性松浮，水不能冲石，其反激之力，必于石下迎水处啮沙为坎穴。"
  },
  {
   "t": 55.944,
   "d": 5.0,
   "s": "渐激渐深，至石之半，石必倒掷坎穴中。"
  },
  {
   "t": 60.944,
   "d": 2.931,
   "s": "如是再啮，石又再转。"
  },
  {
   "t": 63.875,
   "d": 3.556,
   "s": "转转不已，遂反溯流逆上矣。"
  },
  {
   "t": 67.431,
   "d": 4.722,
   "s": "求之下流，固颠；求之地中，不更颠乎？"
  },
  {
   "t": 72.153,
   "d": 2.958,
   "s": "如其言，果得于数里外。"
  },
  {
   "t": 75.111,
   "d": 6.708,
   "s": "然则天下之事，但知其一，不知其二者多矣，可据理臆断欤？"
  }
 ]
}