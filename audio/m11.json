 "cues": [
  {
   "t": 0.1,
   "d": 2.436,
   "s": "你是人间的四月天"
  },
  {
   "t": 2.486,
   "d": 2.722,
   "s": "现代，林徽因"
  },
  {
   "t": 5.38,
   "d": 8.06,
   "s": "我说你是人间的四月天；笑响点亮了四面风；轻灵在春的光艳中交舞着变。"
  },
  {
   "t": 13.54,
   "d": 8.478,
   "s": "你是四月早天里的云烟，黄昏吹着风的软，星子在无意中闪，细雨点洒在花前。"
  },
  {
   "t": 22.132,
   "d": 9.672,
   "s": "那轻，那娉婷，你是，鲜妍百花的冠冕你戴着，你是天真，庄严，你是夜夜的月圆。"
  },
  {
   "t": 31.924,
   "d": 10.033,
   "s": "雪化后那片鹅黄，你像；新鲜初放芽的绿，你是；柔嫩喜悦水光浮动着你梦期待中白莲。"
  },
  {
   "t": 42.076,
   "d": 9.075,
   "s": "你是一树一树的花开，是燕在梁间呢喃，——你是爱，是暖，是希望，你是人间的四月天！"
  }
 ]
}