  {
   "t": 0.1,
   "d": 2.436,
   "s": "你是人间的四月天"
  },
  {
   "t": 2.486,
   "d": 2.722,
   "s": "现代，林徽因"
  },
  {
   "t": 5.38,
   "d": 2.867,
   "s": "我说你是人间的四月天；"
  },
  {
   "t": 8.197,
   "d": 3.486,
   "s": "笑响点亮了四面风；轻灵"
  },
  {
   "t": 11.683,
   "d": 3.417,
   "s": "在春的光艳中交舞着变。"
  },
  {
   "t": 15.268,
   "d": 2.867,
   "s": "你是四月早天里的云烟，"
  },
  {
   "t": 18.085,
   "d": 3.5,
   "s": "黄昏吹着风的软，星子在"
  },
  {
   "t": 21.585,
   "d": 3.75,
   "s": "无意中闪，细雨点洒在花前。"
  },
  {
   "t": 25.492,
   "d": 3.992,
   "s": "那轻，那娉婷，你是，鲜妍"
  },
  {
   "t": 29.434,
   "d": 3.181,
   "s": "百花的冠冕你戴着，你是"
  },
  {
   "t": 32.614,
   "d": 4.167,
   "s": "天真，庄严，你是夜夜的月圆。"
  },
  {
   "t": 36.94,
   "d": 4.283,
   "s": "雪化后那片鹅黄，你像；新鲜"
  },
  {
   "t": 41.173,
   "d": 3.972,
   "s": "初放芽的绿，你是；柔嫩喜悦"
  },
  {
   "t": 45.146,
   "d": 4.181,
   "s": "水光浮动着你梦中期待着的白莲。"
  },
  {
   "t": 49.492,
   "d": 3.506,
   "s": "你是一树一树的花开，是燕"
  },
  {
   "t": 52.948,
   "d": 3.569,
   "s": "在梁间呢喃，——你是爱，是暖，"
  },
  {
   "t": 56.517,
   "d": 3.681,
   "s": "是希望，你是人间的四月天！"
  }
 ]
