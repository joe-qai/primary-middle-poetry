{
 "id": "c019",
 "title": "秋声赋",
 "voice": "zh-CN-YunjianNeural",
 "rate": "-10%",
 "pitch": "+0Hz",
 "dur": 135.216,
 "hdr": 2,
 "bodyCues": 23,
 "v": "a203a104",
 "cues": [
  {
   "t": 0.1,
   "d": 1.422,
   "s": "秋声赋"
  },
  {
   "t": 1.472,
   "d": 2.069,
   "s": "北宋，欧阳修"
  },
  {
   "t": 3.542,
   "d": 7.236,
   "s": "欧阳子方夜读书，闻有声自西南来者，悚然而听之，曰：异哉！"
  },
  {
   "t": 10.778,
   "d": 6.486,
   "s": "初淅沥以萧飒，忽奔腾而砰湃，如波涛夜惊，风雨骤至。"
  },
  {
   "t": 17.264,
   "d": 10.319,
   "s": "其触于物也，鏦鏦铮铮，金铁皆鸣；又如赴敌之兵，衔枚疾走，不闻号令，但闻人马之行声。"
  },
  {
   "t": 27.583,
   "d": 3.014,
   "s": "余谓童子：此何声也？"
  },
  {
   "t": 30.597,
   "d": 1.569,
   "s": "汝出视之。"
  },
  {
   "t": 32.167,
   "d": 6.681,
   "s": "童子曰：星月皎洁，明河在天，四无人声，声在树间。"
  },
  {
   "t": 38.847,
   "d": 2.542,
   "s": "余曰：噫嘻悲哉！"
  },
  {
   "t": 41.389,
   "d": 3.306,
   "s": "此秋声也，胡为而来哉？"
  },
  {
   "t": 44.694,
   "d": 12.361,
   "s": "盖夫秋之为状也：其色惨淡，烟霏云敛；其容清明，天高日晶；其气栗冽，砭人肌骨；其意萧条，山川寂寥。"
  },
  {
   "t": 57.056,
   "d": 4.569,
   "s": "故其为声也，凄凄切切，呼号愤发。"
  },
  {
   "t": 61.625,
   "d": 7.792,
   "s": "丰草绿缛而争茂，佳木葱茏而可悦；草拂之而色变，木遭之而叶脱。"
  },
  {
   "t": 69.417,
   "d": 4.306,
   "s": "其所以摧败零落者，乃其一气之余烈。"
  },
  {
   "t": 73.722,
   "d": 9.278,
   "s": "夫秋，刑官也，于时为阴；又兵象也，于行用金，是谓天地之义气，常以肃杀而为心。"
  },
  {
   "t": 83.0,
   "d": 7.861,
   "s": "天之于物，春生秋实，故其在乐也，商声主西方之音，夷则为七月之律。"
  },
  {
   "t": 90.861,
   "d": 6.819,
   "s": "商，伤也，物既老而悲伤；夷，戮也，物过盛而当杀。"
  },
  {
   "t": 97.681,
   "d": 1.417,
   "s": "嗟乎！"
  },
  {
   "t": 99.097,
   "d": 2.958,
   "s": "草木无情，有时飘零。"
  },
  {
   "t": 102.056,
   "d": 8.083,
   "s": "人为动物，惟物之灵；百忧感其心，万事劳其形；有动于中，必摇其精。"
  },
  {
   "t": 110.139,
   "d": 8.847,
   "s": "而况思其力之所不及，忧其智之所不能；宜其渥然丹者为槁木，黟然黑者为星星。"
  },
  {
   "t": 118.986,
   "d": 4.528,
   "s": "奈何以非金石之质，欲与草木而争荣？"
  },
  {
   "t": 123.514,
   "d": 4.042,
   "s": "念谁为之戕贼，亦何恨乎秋声！"
  },
  {
   "t": 127.556,
   "d": 2.931,
   "s": "童子莫对，垂头而睡。"
  },
  {
   "t": 130.486,
   "d": 4.667,
   "s": "但闻四壁虫声唧唧，如助余之叹息。"
  }
 ]
}