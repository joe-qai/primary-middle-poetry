  },
  {
   "t": 3.208,
   "d": 2.667,
   "s": "唐代，李商隐"
  },
  {
   "t": 9.233,
   "d": 4.631,
   "s": "相见时难别亦难，东风无力百花残。"
  },
  {
   "t": 14.084,
   "d": 4.714,
   "s": "春蚕到死丝方尽，蜡炬成灰泪始干。"
  },
  {
   "t": 19.018,
   "d": 4.95,
   "s": "晓镜但愁云鬓改，夜吟应觉月光寒。"
  },
  {
   "t": 24.188,
   "d": 4.839,
   "s": "蓬山此去无多路，青鸟殷勤为探看。"
  }
 ]
