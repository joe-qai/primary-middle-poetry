 "bodyCues": 19,
 "v": "b537c3a9",
 "cues": [
  {
   "t": 0.1,
   "d": 0.936,
   "s": "狼"
  },
  {
   "t": 0.986,
   "d": 3.0,
   "s": "清代，蒲松龄聊斋志异"
  },
  {
   "t": 3.986,
   "d": 4.236,
   "s": "一屠晚归，担中肉尽，止有剩骨。"
  },
  {
   "t": 8.222,
   "d": 2.917,
   "s": "途中两狼，缀行甚远。"
  },
  {
   "t": 11.139,
   "d": 2.167,
   "s": "屠惧，投以骨。"
  },
  {
   "t": 13.306,
   "d": 3.0,
   "s": "一狼得骨止，一狼仍从。"
  },
  {
   "t": 16.306,
   "d": 3.833,
   "s": "复投之，后狼止而前狼又至。"
  },
  {
   "t": 20.139,
   "d": 4.014,
   "s": "骨已尽矣，而两狼之并驱如故。"
  },
  {
   "t": 24.153,
   "d": 3.153,
   "s": "屠大窘，恐前后受其敌。"
  },
  {
   "t": 27.306,
   "d": 4.708,
   "s": "顾野有麦场，场主积薪其中，苫蔽成丘。"
  },
  {
   "t": 32.014,
   "d": 3.333,
   "s": "屠乃奔倚其下，弛担持刀。"
  },
  {
   "t": 35.347,
   "d": 2.917,
   "s": "狼不敢前，眈眈相向。"
  },
  {
   "t": 38.264,
   "d": 4.153,
   "s": "少时，一狼径去，其一犬坐于前。"
  },
  {
   "t": 42.417,
   "d": 3.139,
   "s": "久之，目似瞑，意暇甚。"
  },
  {
   "t": 45.556,
   "d": 4.181,
   "s": "屠暴起，以刀劈狼首，又数刀毙之。"
  },
  {
   "t": 49.736,
   "d": 6.389,
   "s": "方欲行，转视积薪后，一狼洞其中，意将隧入以攻其后也。"
  },
  {
   "t": 56.125,
   "d": 2.986,
   "s": "身已半入，止露尻尾。"
  },
  {
   "t": 59.111,
   "d": 3.153,
   "s": "屠自后断其股，亦毙之。"
  },
  {
   "t": 62.264,
   "d": 3.042,
   "s": "乃悟前狼假寐，盖以诱敌。"
  },
  {
   "t": 65.306,
   "d": 5.306,
   "s": "狼亦黠矣，而顷刻两毙，禽兽之变诈几何哉？"
  },
  {
   "t": 70.611,
   "d": 2.083,
   "s": "止增笑耳。"
  }
 ]
}