   "s": "青玉案，元夕"
  },
  {
   "t": 2.25,
   "d": 2.306,
   "s": "宋代，辛弃疾"
  },
  {
   "t": 4.556,
   "d": 4.472,
   "s": "东风夜放花千树，更吹落，星如雨。"
  },
  {
   "t": 9.028,
   "d": 2.222,
   "s": "宝马雕车香满路。"
  },
  {
   "t": 11.25,
   "d": 4.778,
   "s": "凤箫声动，玉壶光转，一夜鱼龙舞。"
  },
  {
   "t": 16.028,
   "d": 4.278,
   "s": "蛾儿雪柳黄金缕，笑语盈盈暗香去。"
  },
  {
   "t": 20.306,
   "d": 6.542,
   "s": "众里寻他千百度，蓦然回首，那人却在，灯火阑珊处。"
  }
 ]
}