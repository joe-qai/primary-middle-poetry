   "s": "青玉案，元夕"
  },
  {
   "t": 2.25,
   "d": 2.639,
   "s": "宋代，辛弃疾"
  },
  {
   "t": 5.044,
   "d": 4.811,
   "s": "东风夜放花千树，更吹落，星如雨。"
  },
  {
   "t": 9.964,
   "d": 2.561,
   "s": "宝马雕车香满路。"
  },
  {
   "t": 12.628,
   "d": 5.117,
   "s": "凤箫声动，玉壶光转，一夜鱼龙舞。"
  },
  {
   "t": 17.86,
   "d": 4.617,
   "s": "蛾儿雪柳黄金缕，笑语盈盈暗香去。"
  },
  {
   "t": 22.588,
   "d": 6.547,
   "s": "众里寻他千百度，蓦然回首，那人却在，灯火阑珊处。"
  }
 ]
}