{
 "id": "c003",
 "title": "滕王阁序",
 "voice": "zh-CN-YunjianNeural",
 "rate": "-10%",
 "dur": 260.5,
 "hdr": 2,
 "bodyCues": 58,
 "v": "bfa2e08d",
 "cues": [
  {
   "t": 0.1,
   "d": 1.644,
   "s": "滕王阁序"
  },
  {
   "t": 1.694,
   "d": 2.097,
   "s": "唐代，王勃"
  },
  {
   "t": 3.792,
   "d": 3.028,
   "s": "豫章故郡，洪都新府。"
  },
  {
   "t": 6.819,
   "d": 3.0,
   "s": "星分翼轸，地接衡庐。"
  },
  {
   "t": 9.819,
   "d": 4.389,
   "s": "襟三江而带五湖，控蛮荆而引瓯越。"
  },
  {
   "t": 14.208,
   "d": 7.028,
   "s": "物华天宝，龙光射牛斗之墟；人杰地灵，徐孺下陈蕃之榻。"
  },
  {
   "t": 21.236,
   "d": 3.139,
   "s": "雄州雾列，俊采星驰。"
  },
  {
   "t": 24.375,
   "d": 4.236,
   "s": "台隍枕夷夏之交，宾主尽东南之美。"
  },
  {
   "t": 28.611,
   "d": 6.736,
   "s": "都督阎公之雅望，棨戟遥临；宇文新州之懿范，襜帷暂驻。"
  },
  {
   "t": 35.347,
   "d": 5.75,
   "s": "十旬休假，胜友如云；千里逢迎，高朋满座。"
  },
  {
   "t": 41.097,
   "d": 6.569,
   "s": "腾蛟起凤，孟学士之词宗；紫电青霜，王将军之武库。"
  },
  {
   "t": 47.667,
   "d": 5.458,
   "s": "家君作宰，路出名区；童子何知，躬逢胜饯。"
  },
  {
   "t": 53.125,
   "d": 2.972,
   "s": "时维九月，序属三秋。"
  },
  {
   "t": 56.097,
   "d": 4.458,
   "s": "潦水尽而寒潭清，烟光凝而暮山紫。"
  },
  {
   "t": 60.556,
   "d": 3.736,
   "s": "俨骖騑于上路，访风景于崇阿。"
  },
  {
   "t": 64.292,
   "d": 3.875,
   "s": "临帝子之长洲，得天人之旧馆。"
  },
  {
   "t": 68.167,
   "d": 5.528,
   "s": "层峦耸翠，上出重霄；飞阁流丹，下临无地。"
  },
  {
   "t": 73.694,
   "d": 6.333,
   "s": "鹤汀凫渚，穷岛屿之萦回；桂殿兰宫，即冈峦之体势。"
  },
  {
   "t": 80.028,
   "d": 5.903,
   "s": "披绣闼，俯雕甍，山原旷其盈视，川泽纡其骇瞩。"
  },
  {
   "t": 85.931,
   "d": 6.153,
   "s": "闾阎扑地，钟鸣鼎食之家；舸舰弥津，青雀黄龙之舳。"
  },
  {
   "t": 92.083,
   "d": 2.986,
   "s": "云销雨霁，彩彻区明。"
  },
  {
   "t": 95.069,
   "d": 3.986,
   "s": "落霞与孤鹜齐飞，秋水共长天一色。"
  },
  {
   "t": 99.056,
   "d": 6.5,
   "s": "渔舟唱晚，响穷彭蠡之滨；雁阵惊寒，声断衡阳之浦。"
  },
  {
   "t": 105.556,
   "d": 2.833,
   "s": "遥襟甫畅，逸兴遄飞。"
  },
  {
   "t": 108.389,
   "d": 4.472,
   "s": "爽籁发而清风生，纤歌凝而白云遏。"
  },
  {
   "t": 112.861,
   "d": 6.472,
   "s": "睢园绿竹，气凌彭泽之樽；邺水朱华，光照临川之笔。"
  },
  {
   "t": 119.333,
   "d": 2.389,
   "s": "四美具，二难并。"
  },
  {
   "t": 121.722,
   "d": 3.625,
   "s": "穷睇眄于中天，极娱游于暇日。"
  },
  {
   "t": 125.347,
   "d": 6.264,
   "s": "天高地迥，觉宇宙之无穷；兴尽悲来，识盈虚之有数。"
  },
  {
   "t": 131.611,
   "d": 4.014,
   "s": "望长安于日下，目吴会于云间。"
  },
  {
   "t": 135.625,
   "d": 4.167,
   "s": "地势极而南溟深，天柱高而北辰远。"
  },
  {
   "t": 139.792,
   "d": 3.444,
   "s": "关山难越，谁悲失路之人？"
  },
  {
   "t": 143.236,
   "d": 3.486,
   "s": "萍水相逢，尽是他乡之客。"
  },
  {
   "t": 146.722,
   "d": 3.944,
   "s": "怀帝阍而不见，奉宣室以何年？"
  },
  {
   "t": 150.667,
   "d": 1.417,
   "s": "嗟乎！"
  },
  {
   "t": 152.083,
   "d": 2.889,
   "s": "时运不齐，命途多舛。"
  },
  {
   "t": 154.972,
   "d": 3.125,
   "s": "冯唐易老，李广难封。"
  },
  {
   "t": 158.097,
   "d": 6.278,
   "s": "屈贾谊于长沙，非无圣主；窜梁鸿于海曲，岂乏明时？"
  },
  {
   "t": 164.375,
   "d": 3.417,
   "s": "所赖君子见机，达人知命。"
  },
  {
   "t": 167.792,
   "d": 3.181,
   "s": "老当益壮，宁移白首之心？"
  },
  {
   "t": 170.972,
   "d": 3.417,
   "s": "穷且益坚，不坠青云之志。"
  },
  {
   "t": 174.389,
   "d": 3.931,
   "s": "酌贪泉而觉爽，处涸辙以犹欢。"
  },
  {
   "t": 178.319,
   "d": 5.0,
   "s": "北海虽赊，扶摇可接；东隅已逝，桑榆非晚。"
  },
  {
   "t": 183.319,
   "d": 6.889,
   "s": "孟尝高洁，空余报国之情；阮籍猖狂，岂效穷途之哭！"
  },
  {
   "t": 190.208,
   "d": 3.653,
   "s": "勃，三尺微命，一介书生。"
  },
  {
   "t": 193.861,
   "d": 6.694,
   "s": "无路请缨，等终军之弱冠；有怀投笔，慕宗悫之长风。"
  },
  {
   "t": 200.556,
   "d": 4.194,
   "s": "舍簪笏于百龄，奉晨昏于万里。"
  },
  {
   "t": 204.75,
   "d": 3.792,
   "s": "非谢家之宝树，接孟氏之芳邻。"
  },
  {
   "t": 208.542,
   "d": 5.431,
   "s": "他日趋庭，叨陪鲤对；今兹捧袂，喜托龙门。"
  },
  {
   "t": 213.972,
   "d": 6.333,
   "s": "杨意不逢，抚凌云而自惜；钟期既遇，奏流水以何惭？"
  },
  {
   "t": 220.306,
   "d": 1.583,
   "s": "呜呼！"
  },
  {
   "t": 221.889,
   "d": 5.417,
   "s": "胜地不常，盛筵难再；兰亭已矣，梓泽丘墟。"
  },
  {
   "t": 227.306,
   "d": 6.528,
   "s": "临别赠言，幸承恩于伟饯；登高作赋，是所望于群公。"
  },
  {
   "t": 233.833,
   "d": 5.153,
   "s": "敢竭鄙怀，恭疏短引；一言均赋，四韵俱成。"
  },
  {
   "t": 238.986,
   "d": 3.528,
   "s": "请洒潘江，各倾陆海云尔。"
  },
  {
   "t": 242.514,
   "d": 4.097,
   "s": "滕王高阁临江渚，佩玉鸣鸾罢歌舞。"
  },
  {
   "t": 246.611,
   "d": 4.25,
   "s": "画栋朝飞南浦云，珠帘暮卷西山雨。"
  },
  {
   "t": 250.861,
   "d": 4.292,
   "s": "闲云潭影日悠悠，物换星移几度秋。"
  },
  {
   "t": 255.153,
   "d": 2.431,
   "s": "阁中帝子今何在？"
  },
  {
   "t": 257.583,
   "d": 2.917,
   "s": "槛外长江空自流。"
  }
 ]
}