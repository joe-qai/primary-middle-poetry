 "cues": [
  {
   "t": 0.1,
   "d": 1.478,
   "s": "蜀道难"
  },
  {
   "t": 1.528,
   "d": 2.458,
   "s": "唐代，李白"
  },
  {
   "t": 4.156,
   "d": 3.2,
   "s": "噫吁嚱，危乎高哉！"
  },
  {
   "t": 7.468,
   "d": 3.686,
   "s": "蜀道之难，难于上青天！"
  },
  {
   "t": 11.26,
   "d": 3.769,
   "s": "蚕丛及鱼凫，开国何茫然！"
  },
  {
   "t": 15.148,
   "d": 4.367,
   "s": "尔来四万八千岁，不与秦塞通人烟。"
  },
  {
   "t": 19.636,
   "d": 4.283,
   "s": "西当太白有鸟道，可以横绝峨眉巅。"
  },
  {
   "t": 24.028,
   "d": 5.144,
   "s": "地崩山摧壮士死，然后天梯石栈相钩连。"
  },
  {
   "t": 29.284,
   "d": 5.797,
   "s": "上有六龙回日之高标，下有冲波逆折之回川。"
  },
  {
   "t": 35.188,
   "d": 4.894,
   "s": "黄鹤之飞尚不得过，猿猱欲度愁攀援。"
  },
  {
   "t": 40.204,
   "d": 4.256,
   "s": "青泥何盘盘，百步九折萦岩峦。"
  },
  {
   "t": 44.572,
   "d": 4.756,
   "s": "扪参历井仰胁息，以手抚膺坐长叹。"
  },
  {
   "t": 49.444,
   "d": 2.617,
   "s": "问君西游何时还？"
  },
  {
   "t": 52.18,
   "d": 2.588,
   "s": "畏途巉岩不可攀。"
  },
  {
   "t": 54.868,
   "d": 4.908,
   "s": "但见悲鸟号古木，雄飞雌从绕林间。"
  },
  {
   "t": 59.884,
   "d": 3.811,
   "s": "又闻子规啼夜月，愁空山。"
  },
  {
   "t": 63.796,
   "d": 5.339,
   "s": "蜀道之难，难于上青天，使人听此凋朱颜！"
  },
  {
   "t": 69.244,
   "d": 4.492,
   "s": "连峰去天不盈尺，枯松倒挂倚绝壁。"
  },
  {
   "t": 73.852,
   "d": 4.644,
   "s": "飞湍瀑流争喧豗，砯崖转石万壑雷。"
  },
  {
   "t": 78.604,
   "d": 4.95,
   "s": "其险也如此，嗟尔远道之人胡为乎来哉！"
  },
  {
   "t": 83.668,
   "d": 5.158,
   "s": "剑阁峥嵘而崔嵬，一夫当关，万夫莫开。"
  },
  {
   "t": 88.948,
   "d": 3.686,
   "s": "所守或匪亲，化为狼与豺。"
  },
  {
   "t": 92.74,
   "d": 5.811,
   "s": "朝避猛虎，夕避长蛇；磨牙吮血，杀人如麻。"
  },
  {
   "t": 98.668,
   "d": 3.519,
   "s": "锦城虽云乐，不如早还家。"
  },
  {
   "t": 102.292,
   "d": 5.631,
   "s": "蜀道之难，难于上青天，侧身西望长咨嗟！"
  }
 ]
}