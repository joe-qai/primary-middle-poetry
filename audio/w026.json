 "cues": [
  {
   "t": 0.1,
   "d": 2.353,
   "s": "陈太丘与友期行"
  },
  {
   "t": 2.403,
   "d": 2.833,
   "s": "南朝，刘义庆世说新语"
  },
  {
   "t": 5.236,
   "d": 3.375,
   "s": "陈太丘与友期行，期日中。"
  },
  {
   "t": 8.611,
   "d": 4.083,
   "s": "过中不至，太丘舍去，去后乃至。"
  },
  {
   "t": 12.694,
   "d": 2.958,
   "s": "元方时年七岁，门外戏。"
  },
  {
   "t": 15.653,
   "d": 3.028,
   "s": "客问元方：尊君在不？"
  },
  {
   "t": 18.681,
   "d": 3.417,
   "s": "答曰：待君久不至，已去。"
  },
  {
   "t": 22.097,
   "d": 3.056,
   "s": "友人便怒曰：非人哉！"
  },
  {
   "t": 25.153,
   "d": 2.875,
   "s": "与人期行，相委而去。"
  },
  {
   "t": 28.028,
   "d": 3.306,
   "s": "元方曰：君与家君期日中。"
  },
  {
   "t": 31.333,
   "d": 5.014,
   "s": "日中不至，则是无信；对子骂父，则是无礼。"
  },
  {
   "t": 36.347,
   "d": 2.694,
   "s": "友人惭，下车引之。"
  },
  {
   "t": 39.042,
   "d": 2.389,
   "s": "元方入门不顾。"
  }
 ]
}