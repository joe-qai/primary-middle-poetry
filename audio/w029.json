 "cues": [
  {
   "t": 0.1,
   "d": 1.658,
   "s": "与朱元思书"
  },
  {
   "t": 1.708,
   "d": 2.042,
   "s": "南朝，吴均"
  },
  {
   "t": 3.75,
   "d": 3.264,
   "s": "风烟俱净，天山共色。"
  },
  {
   "t": 7.014,
   "d": 2.764,
   "s": "从流飘荡，任意东西。"
  },
  {
   "t": 9.778,
   "d": 5.486,
   "s": "自富阳至桐庐一百许里，奇山异水，天下独绝。"
  },
  {
   "t": 15.264,
   "d": 2.806,
   "s": "水皆缥碧，千丈见底。"
  },
  {
   "t": 18.069,
   "d": 2.653,
   "s": "游鱼细石，直视无碍。"
  },
  {
   "t": 20.722,
   "d": 3.139,
   "s": "急湍甚箭，猛浪若奔。"
  },
  {
   "t": 23.861,
   "d": 7.931,
   "s": "夹岸高山，皆生寒树，负势竞上，互相轩邈，争高直指，千百成峰。"
  },
  {
   "t": 31.792,
   "d": 5.736,
   "s": "泉水激石，泠泠作响；好鸟相鸣，嘤嘤成韵。"
  },
  {
   "t": 37.528,
   "d": 4.014,
   "s": "蝉则千转不穷，猿则百叫无绝。"
  },
  {
   "t": 41.542,
   "d": 6.056,
   "s": "鸢飞戾天者，望峰息心；经纶世务者，窥谷忘反。"
  },
  {
   "t": 47.597,
   "d": 6.069,
   "s": "横柯上蔽，在昼犹昏；疏条交映，有时见日。"
  }
 ]
}