  {
   "t": 0.1,
   "d": 3.103,
   "s": "水调歌头，明月几时有"
  },
  {
   "t": 3.153,
   "d": 2.472,
   "s": "宋代，苏轼"
  },
  {
   "t": 8.928,
   "d": 6.186,
   "s": "丙辰中秋，欢饮达旦，大醉，作此篇，兼怀子由。"
  },
  {
   "t": 15.334,
   "d": 2.186,
   "s": "明月几时有？"
  },
  {
   "t": 17.74,
   "d": 2.214,
   "s": "把酒问青天。"
  },
  {
   "t": 20.174,
   "d": 3.881,
   "s": "不知天上宫阙，今夕是何年。"
  },
  {
   "t": 24.275,
   "d": 5.492,
   "s": "我欲乘风归去，又恐琼楼玉宇，高处不胜寒。"
  },
  {
   "t": 29.987,
   "d": 3.756,
   "s": "起舞弄清影，何似在人间。"
  },
  {
   "t": 33.963,
   "d": 3.686,
   "s": "转朱阁，低绮户，照无眠。"
  },
  {
   "t": 37.869,
   "d": 3.978,
   "s": "不应有恨，何事长向别时圆？"
  },
  {
   "t": 42.067,
   "d": 5.533,
   "s": "人有悲欢离合，月有阴晴圆缺，此事古难全。"
  },
  {
   "t": 47.82,
   "d": 3.811,
   "s": "但愿人长久，千里共婵娟。"
  }
 ]
