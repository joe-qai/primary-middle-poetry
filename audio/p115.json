  {
   "t": 0.1,
   "d": 3.103,
   "s": "水调歌头，明月几时有"
  },
  {
   "t": 3.153,
   "d": 2.139,
   "s": "宋代，苏轼"
  },
  {
   "t": 5.292,
   "d": 5.847,
   "s": "丙辰中秋，欢饮达旦，大醉，作此篇，兼怀子由。"
  },
  {
   "t": 11.139,
   "d": 1.847,
   "s": "明月几时有？"
  },
  {
   "t": 12.986,
   "d": 1.875,
   "s": "把酒问青天。"
  },
  {
   "t": 14.861,
   "d": 3.542,
   "s": "不知天上宫阙，今夕是何年。"
  },
  {
   "t": 18.403,
   "d": 5.153,
   "s": "我欲乘风归去，又恐琼楼玉宇，高处不胜寒。"
  },
  {
   "t": 23.556,
   "d": 3.417,
   "s": "起舞弄清影，何似在人间。"
  },
  {
   "t": 26.972,
   "d": 3.347,
   "s": "转朱阁，低绮户，照无眠。"
  },
  {
   "t": 30.319,
   "d": 3.639,
   "s": "不应有恨，何事长向别时圆？"
  },
  {
   "t": 33.958,
   "d": 5.194,
   "s": "人有悲欢离合，月有阴晴圆缺，此事古难全。"
  },
  {
   "t": 39.153,
   "d": 3.806,
   "s": "但愿人长久，千里共婵娟。"
  }
 ]
}