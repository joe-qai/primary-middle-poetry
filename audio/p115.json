  {
   "t": 0.1,
   "d": 3.103,
   "s": "水调歌头，明月几时有"
  },
  {
   "t": 3.153,
   "d": 2.472,
   "s": "宋代，苏轼"
  },
  {
   "t": 8.928,
   "d": 1.631,
   "s": "丙辰"
  },
  {
   "t": 10.959,
   "d": 2.519,
   "s": "中秋，欢饮"
  },
  {
   "t": 13.878,
   "d": 4.283,
   "s": "达旦，大醉，作此篇，兼怀子由。"
  },
  {
   "t": 18.111,
   "d": 1.847,
   "s": "明月几时有？"
  },
  {
   "t": 19.959,
   "d": 1.875,
   "s": "把酒问青天。"
  },
  {
   "t": 21.834,
   "d": 3.542,
   "s": "不知天上宫阙，今夕是何年。"
  },
  {
   "t": 25.375,
   "d": 5.153,
   "s": "我欲乘风归去，又恐琼楼玉宇，高处不胜寒。"
  },
  {
   "t": 30.528,
   "d": 1.667,
   "s": "起舞"
  },
  {
   "t": 79.562,
   "d": 2.964,
   "s": "弄清影，何似在人间。"
  },
  {
   "t": 82.476,
   "d": 3.347,
   "s": "转朱阁，低绮户，照无眠。"
  },
  {
   "t": 85.823,
   "d": 1.486,
   "s": "不应"
  },
  {
   "t": 97.134,
   "d": 3.339,
   "s": "有恨，何事长向别时圆？"
  },
  {
   "t": 100.423,
   "d": 5.194,
   "s": "人有悲欢离合，月有阴晴圆缺，此事古难全。"
  },
  {
   "t": 105.617,
   "d": 1.528,
   "s": "但愿"
  },
  {
   "t": 119.567,
   "d": 3.339,
   "s": "人长久，千里共婵娟。"
  }
 ]
}