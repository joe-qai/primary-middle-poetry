 "v": "7664b4c3",
 "cues": [
  {
   "t": 0.1,
   "d": 1.464,
   "s": "非攻上"
  },
  {
   "t": 1.514,
   "d": 2.111,
   "s": "战国，墨子"
  },
  {
   "t": 3.625,
   "d": 7.653,
   "s": "今有一人，入人园圃，窃其桃李，众闻则非之，上为政者得则罚之。"
  },
  {
   "t": 11.278,
   "d": 1.681,
   "s": "此何也？"
  },
  {
   "t": 12.958,
   "d": 2.181,
   "s": "以亏人自利也。"
  },
  {
   "t": 15.139,
   "d": 5.486,
   "s": "至攘人犬豕鸡豚者，其不义又甚入人园圃窃桃李。"
  },
  {
   "t": 20.625,
   "d": 1.875,
   "s": "是何故也？"
  },
  {
   "t": 22.5,
   "d": 4.194,
   "s": "以亏人愈多，其不仁兹甚，罪益厚。"
  },
  {
   "t": 26.694,
   "d": 6.292,
   "s": "至入人栏厩，取人马牛者，其不仁义又甚攘人犬豕鸡豚。"
  },
  {
   "t": 32.986,
   "d": 1.958,
   "s": "此何故也？"
  },
  {
   "t": 34.944,
   "d": 2.042,
   "s": "以其亏人愈多。"
  },
  {
   "t": 36.986,
   "d": 4.194,
   "s": "苟亏人愈多，其不仁兹甚，罪益厚。"
  },
  {
   "t": 41.181,
   "d": 7.736,
   "s": "至杀不辜人也，拖其衣裘，取戈剑者，其不义又甚入人栏厩取人马牛。"
  },
  {
   "t": 48.917,
   "d": 1.958,
   "s": "此何故也？"
  },
  {
   "t": 50.875,
   "d": 2.042,
   "s": "以其亏人愈多。"
  },
  {
   "t": 52.917,
   "d": 4.361,
   "s": "苟亏人愈多，其不仁兹甚矣，罪益厚。"
  },
  {
   "t": 57.278,
   "d": 5.611,
   "s": "当此，天下之君子皆知，而非之，谓之不义。"
  },
  {
   "t": 62.889,
   "d": 5.722,
   "s": "今至大为不义攻国，则弗知非，从而誉之，谓之义。"
  },
  {
   "t": 68.611,
   "d": 3.125,
   "s": "此可谓知义与不义之别乎？"
  },
  {
   "t": 71.736,
   "d": 4.306,
   "s": "杀一人，谓之不义，必有一死罪矣。"
  },
  {
   "t": 76.042,
   "d": 9.361,
   "s": "若以此说往，杀十人，十重不义，必有十死罪矣；杀百人，百重不义，必有百死罪矣。"
  },
  {
   "t": 85.403,
   "d": 5.611,
   "s": "当此，天下之君子皆知，而非之，谓之不义。"
  },
  {
   "t": 91.014,
   "d": 5.722,
   "s": "今至大为不义攻国，则弗知非，从而誉之，谓之义。"
  },
  {
   "t": 96.736,
   "d": 8.917,
   "s": "情不知其不义也，故书其言以遗后世；若知其不义也，夫奚说书其不义以遗后世哉？"
  },
  {
   "t": 105.653,
   "d": 13.625,
   "s": "今有人于此，少见黑曰黑，多见黑曰白，则必以此人为不知白黑之辩矣；少尝苦曰苦，多尝苦曰甘，则必以此人为不知甘苦之辩矣。"
  },
  {
   "t": 119.278,
   "d": 7.694,
   "s": "今小为非，则知而非之；大为非攻国，则不知非，从而誉之，谓之义。"
  },
  {
   "t": 126.972,
   "d": 3.236,
   "s": "此可谓知义与不义之辩乎？"
  },
  {
   "t": 130.208,
   "d": 5.361,
   "s": "是以知天下之君子也，辩义与不义之乱也。"
  }
 ]
}