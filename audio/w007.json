 "cues": [
  {
   "t": 0.1,
   "d": 1.658,
   "s": "小石潭记"
  },
  {
   "t": 1.708,
   "d": 2.278,
   "s": "唐代，柳宗元"
  },
  {
   "t": 3.986,
   "d": 7.069,
   "s": "从小丘西行百二十步，隔篁竹，闻水声，如鸣珮环，心乐之。"
  },
  {
   "t": 11.056,
   "d": 4.208,
   "s": "伐竹取道，下见小潭，水尤清冽。"
  },
  {
   "t": 15.264,
   "d": 7.181,
   "s": "全石以为底，近岸，卷石底以出，为坻，为屿，为嵁，为岩。"
  },
  {
   "t": 22.444,
   "d": 4.222,
   "s": "青树翠蔓，蒙络摇缀，参差披拂。"
  },
  {
   "t": 26.667,
   "d": 6.542,
   "s": "潭中鱼可百许头，皆若空游无所依，日光下澈，影布石上。"
  },
  {
   "t": 33.208,
   "d": 5.556,
   "s": "佁然不动，俶尔远逝，往来翕忽，似与游者相乐。"
  },
  {
   "t": 38.764,
   "d": 4.431,
   "s": "潭西南而望，斗折蛇行，明灭可见。"
  },
  {
   "t": 43.194,
   "d": 3.583,
   "s": "其岸势犬牙差互，不可知其源。"
  },
  {
   "t": 46.778,
   "d": 6.875,
   "s": "坐潭上，四面竹树环合，寂寥无人，凄神寒骨，悄怆幽邃。"
  },
  {
   "t": 53.653,
   "d": 4.472,
   "s": "以其境过清，不可久居，乃记之而去。"
  },
  {
   "t": 58.125,
   "d": 4.569,
   "s": "同游者：吴武陵，龚古，余弟宗玄。"
  },
  {
   "t": 62.694,
   "d": 5.486,
   "s": "隶而从者，崔氏二小生：曰恕己，曰奉壹。"
  }
 ]
}