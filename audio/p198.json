  },
  {
   "t": 3.181,
   "d": 1.875,
   "s": "南唐，李煜"
  },
  {
   "t": 5.056,
   "d": 3.0,
   "s": "帘外雨潺潺，春意阑珊。"
  },
  {
   "t": 8.056,
   "d": 2.264,
   "s": "罗衾不耐五更寒。"
  },
  {
   "t": 10.319,
   "d": 3.472,
   "s": "梦里不知身是客，一晌贪欢。"
  },
  {
   "t": 13.792,
   "d": 3.028,
   "s": "独自莫凭栏，无限江山。"
  },
  {
   "t": 16.819,
   "d": 2.361,
   "s": "别时容易见时难。"
  },
  {
   "t": 19.181,
   "d": 3.944,
   "s": "流水落花春去也，天上人间。"
  }
 ]
