 "cues": [
  {
   "t": 0.1,
   "d": 1.867,
   "s": "我爱这土地"
  },
  {
   "t": 1.917,
   "d": 2.583,
   "s": "现代，艾青"
  },
  {
   "t": 4.66,
   "d": 2.297,
   "s": "假如我是一只鸟，"
  },
  {
   "t": 6.907,
   "d": 3.042,
   "s": "我也应该用嘶哑的喉咙歌唱："
  },
  {
   "t": 9.949,
   "d": 3.236,
   "s": "这被暴风雨所打击着的土地，"
  },
  {
   "t": 13.185,
   "d": 3.569,
   "s": "这永远汹涌着我们的悲愤的河流，"
  },
  {
   "t": 16.754,
   "d": 3.403,
   "s": "这无止息地吹刮着的激怒的风，"
  },
  {
   "t": 20.157,
   "d": 3.75,
   "s": "和那来自林间的无比温柔的黎明……"
  },
  {
   "t": 23.907,
   "d": 1.847,
   "s": "然后我死了，"
  },
  {
   "t": 25.754,
   "d": 3.333,
   "s": "连羽毛也腐烂在土地里面。"
  },
  {
   "t": 29.26,
   "d": 3.353,
   "s": "为什么我的眼里常含泪水？"
  },
  {
   "t": 32.716,
   "d": 3.547,
   "s": "因为我对这土地爱得深沉……"
  }
 ]
}