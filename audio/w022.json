{
 "id": "w022",
 "title": "核舟记",
 "voice": "zh-CN-YunjianNeural",
 "rate": "-10%",
 "dur": 140.416,
 "hdr": 2,
 "bodyCues": 24,
 "v": "505fa9a9",
 "cues": [
  {
   "t": 0.1,
   "d": 1.422,
   "s": "核舟记"
  },
  {
   "t": 1.472,
   "d": 2.264,
   "s": "明代，魏学洢"
  },
  {
   "t": 3.736,
   "d": 11.667,
   "s": "明有奇巧人曰王叔远，能以径寸之木，为宫室、器皿、人物，以至鸟兽、木石，罔不因势象形，各具情态。"
  },
  {
   "t": 15.403,
   "d": 3.931,
   "s": "尝贻余核舟一，盖大苏泛赤壁云。"
  },
  {
   "t": 19.333,
   "d": 4.111,
   "s": "舟首尾长约八分有奇，高可二黍许。"
  },
  {
   "t": 23.444,
   "d": 3.333,
   "s": "中轩敞者为舱，箬篷覆之。"
  },
  {
   "t": 26.778,
   "d": 3.875,
   "s": "旁开小窗，左右各四，共八扇。"
  },
  {
   "t": 30.653,
   "d": 3.361,
   "s": "启窗而观，雕栏相望焉。"
  },
  {
   "t": 34.014,
   "d": 8.389,
   "s": "闭之，则右刻山高月小，水落石出，左刻清风徐来，水波不兴，石青糁之。"
  },
  {
   "t": 42.403,
   "d": 6.75,
   "s": "船头坐三人，中峨冠而多髯者为东坡，佛印居右，鲁直居左。"
  },
  {
   "t": 49.153,
   "d": 3.097,
   "s": "苏、黄共阅一手卷。"
  },
  {
   "t": 52.25,
   "d": 3.972,
   "s": "东坡右手执卷端，左手抚鲁直背。"
  },
  {
   "t": 56.222,
   "d": 4.917,
   "s": "鲁直左手执卷末，右手指卷，如有所语。"
  },
  {
   "t": 61.139,
   "d": 7.806,
   "s": "东坡现右足，鲁直现左足，各微侧，其两膝相比者，各隐卷底衣褶中。"
  },
  {
   "t": 68.944,
   "d": 7.181,
   "s": "佛印绝类弥勒，袒胸露乳，矫首昂视，神情与苏、黄不属。"
  },
  {
   "t": 76.125,
   "d": 7.889,
   "s": "卧右膝，诎右臂支船，而竖其左膝，左臂挂念珠倚之——珠可历历数也。"
  },
  {
   "t": 84.014,
   "d": 2.042,
   "s": "舟尾横卧一楫。"
  },
  {
   "t": 86.056,
   "d": 2.569,
   "s": "楫左右舟子各一人。"
  },
  {
   "t": 88.625,
   "d": 6.375,
   "s": "居右者椎髻仰面，左手倚一衡木，右手攀右趾，若啸呼状。"
  },
  {
   "t": 95.0,
   "d": 8.319,
   "s": "居左者右手执蒲葵扇，左手抚炉，炉上有壶，其人视端容寂，若听茶声然。"
  },
  {
   "t": 103.319,
   "d": 10.569,
   "s": "其船背稍夷，则题名其上，文曰天启壬戌秋日，虞山王毅叔远甫刻，细若蚊足，钩画了了，其色墨。"
  },
  {
   "t": 113.889,
   "d": 4.542,
   "s": "又用篆章一，文曰初平山人，其色丹。"
  },
  {
   "t": 118.431,
   "d": 13.264,
   "s": "通计一舟，为人五；为窗八；为箬篷，为楫，为炉，为壶，为手卷，为念珠各一；对联、题名并篆文，为字共三十有四。"
  },
  {
   "t": 131.694,
   "d": 2.611,
   "s": "而计其长曾不盈寸。"
  },
  {
   "t": 134.306,
   "d": 2.778,
   "s": "盖简桃核修狭者为之。"
  },
  {
   "t": 137.083,
   "d": 3.333,
   "s": "嘻，技亦灵怪矣哉！"
  }
 ]
}