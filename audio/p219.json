  {
   "t": 0.1,
   "d": 1.936,
   "s": "赠卫八处士"
  },
  {
   "t": 1.986,
   "d": 2.361,
   "s": "唐代，杜甫"
  },
  {
   "t": 6.483,
   "d": 3.881,
   "s": "人生不相见，动如参与商。"
  },
  {
   "t": 10.584,
   "d": 3.839,
   "s": "今夕复何夕，共此灯烛光。"
  },
  {
   "t": 14.643,
   "d": 3.547,
   "s": "少壮能几时，鬓发各已苍。"
  },
  {
   "t": 18.41,
   "d": 3.7,
   "s": "访旧半为鬼，惊呼热中肠。"
  },
  {
   "t": 22.33,
   "d": 3.881,
   "s": "焉知二十载，重上君子堂。"
  },
  {
   "t": 26.431,
   "d": 3.964,
   "s": "昔别君未婚，儿女忽成行。"
  },
  {
   "t": 30.615,
   "d": 3.603,
   "s": "怡然敬父执，问我来何方。"
  },
  {
   "t": 34.438,
   "d": 3.603,
   "s": "问答乃未已，驱儿罗酒浆。"
  },
  {
   "t": 38.261,
   "d": 3.839,
   "s": "夜雨剪春韭，新炊间黄粱。"
  },
  {
   "t": 42.32,
   "d": 3.631,
   "s": "主称会面难，一举累十觞。"
  },
  {
   "t": 46.171,
   "d": 3.603,
   "s": "十觞亦不醉，感子故意长。"
  },
  {
   "t": 49.994,
   "d": 3.575,
   "s": "明日隔山岳，世事两茫茫。"
  }
 ]
}