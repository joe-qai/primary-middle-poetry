  {
   "t": 0.1,
   "d": 1.936,
   "s": "赠卫八处士"
  },
  {
   "t": 1.986,
   "d": 2.028,
   "s": "唐代，杜甫"
  },
  {
   "t": 4.014,
   "d": 3.542,
   "s": "人生不相见，动如参与商。"
  },
  {
   "t": 7.556,
   "d": 3.5,
   "s": "今夕复何夕，共此灯烛光。"
  },
  {
   "t": 11.056,
   "d": 3.208,
   "s": "少壮能几时，鬓发各已苍。"
  },
  {
   "t": 14.264,
   "d": 3.361,
   "s": "访旧半为鬼，惊呼热中肠。"
  },
  {
   "t": 17.625,
   "d": 3.542,
   "s": "焉知二十载，重上君子堂。"
  },
  {
   "t": 21.167,
   "d": 3.625,
   "s": "昔别君未婚，儿女忽成行。"
  },
  {
   "t": 24.792,
   "d": 3.264,
   "s": "怡然敬父执，问我来何方。"
  },
  {
   "t": 28.056,
   "d": 3.264,
   "s": "问答乃未已，驱儿罗酒浆。"
  },
  {
   "t": 31.319,
   "d": 3.5,
   "s": "夜雨剪春韭，新炊间黄粱。"
  },
  {
   "t": 34.819,
   "d": 3.292,
   "s": "主称会面难，一举累十觞。"
  },
  {
   "t": 38.111,
   "d": 3.264,
   "s": "十觞亦不醉，感子故意长。"
  },
  {
   "t": 41.375,
   "d": 3.569,
   "s": "明日隔山岳，世事两茫茫。"
  }
 ]
}