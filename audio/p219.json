   "d": 1.611,
   "s": "少壮"
  },
  {
   "t": 24.533,
   "d": 2.797,
   "s": "能几时，鬓发各已苍。"
  },
  {
   "t": 27.28,
   "d": 1.569,
   "s": "访旧"
  },
  {
   "t": 32.146,
   "d": 3.033,
   "s": "半为鬼，惊呼热中肠。"
  },
  {
   "t": 35.129,
   "d": 1.5,
   "s": "焉知"
  },
  {
   "t": 40.162,
   "d": 3.158,
   "s": "二十载，重上君子堂。"
  },
  {
   "t": 43.27,
   "d": 1.597,
   "s": "昔别"
  },
  {
   "t": 48.525,
   "d": 3.2,
   "s": "君未婚，儿女忽成行。"
  },
  {
   "t": 51.675,
   "d": 1.528,
   "s": "怡然"
  },
  {
   "t": 56.903,
   "d": 2.908,
   "s": "敬父执，问我来何方。"
  },
  {
   "t": 59.761,
   "d": 1.528,
   "s": "问答"
  },
  {
   "t": 64.697,
   "d": 2.783,
   "s": "乃未已，驱儿罗酒浆。"
  },
  {
   "t": 67.43,
   "d": 1.528,
   "s": "夜雨"
  },
  {
   "t": 72.241,
   "d": 3.228,
   "s": "剪春韭，新炊间黄粱。"
  },
  {
   "t": 75.419,
   "d": 1.569,
   "s": "主称"
  },
  {
   "t": 80.716,
   "d": 2.908,
   "s": "会面难，一举累十觞。"
  },
  {
