  {
   "t": 0.1,
   "d": 2.839,
   "s": "雨霖铃，寒蝉凄切"
  },
  {
   "t": 2.889,
   "d": 2.056,
   "s": "宋代，柳永"
  },
  {
   "t": 4.944,
   "d": 3.847,
   "s": "寒蝉凄切，对长亭晚，骤雨初歇。"
  },
  {
   "t": 8.792,
   "d": 4.208,
   "s": "都门帐饮无绪，留恋处，兰舟催发。"
  },
  {
   "t": 13.0,
   "d": 3.958,
   "s": "执手相看泪眼，竟无语凝噎。"
  },
  {
   "t": 16.958,
   "d": 4.903,
   "s": "念去去，千里烟波，暮霭沉沉楚天阔。"
  },
  {
   "t": 21.861,
   "d": 4.972,
   "s": "多情自古伤离别，更那堪，冷落清秋节！"
  },
  {
   "t": 26.833,
   "d": 2.347,
   "s": "今宵酒醒何处？"
  },
  {
   "t": 29.181,
   "d": 2.778,
   "s": "杨柳岸，晓风残月。"
  },
  {
   "t": 31.958,
   "d": 3.944,
   "s": "此去经年，应是良辰好景虚设。"
  },
  {
   "t": 35.903,
   "d": 4.25,
   "s": "便纵有千种风情，更与何人说？"
  }
 ]
}