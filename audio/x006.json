   "s": "雨霖铃，寒蝉凄切"
  },
  {
   "t": 2.889,
   "d": 2.389,
   "s": "宋代，柳永"
  },
  {
   "t": 5.428,
   "d": 4.186,
   "s": "寒蝉凄切，对长亭晚，骤雨初歇。"
  },
  {
   "t": 9.724,
   "d": 4.547,
   "s": "都门帐饮无绪，留恋处，兰舟催发。"
  },
  {
   "t": 14.38,
   "d": 4.297,
   "s": "执手相看泪眼，竟无语凝噎。"
  },
  {
   "t": 18.796,
   "d": 5.242,
   "s": "念去去，千里烟波，暮霭沉沉楚天阔。"
  },
  {
   "t": 24.148,
   "d": 5.311,
   "s": "多情自古伤离别，更那堪，冷落清秋节！"
  },
  {
   "t": 29.572,
   "d": 2.686,
   "s": "今宵酒醒何处？"
  },
  {
   "t": 32.38,
   "d": 3.116,
   "s": "杨柳岸，晓风残月。"
  },
  {
   "t": 35.596,
   "d": 4.283,
   "s": "此去经年，应是良辰好景虚设。"
  },
  {
   "t": 39.988,
   "d": 4.256,
   "s": "便纵有千种风情，更与何人说？"
  }
 ]
