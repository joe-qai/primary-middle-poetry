{
 "id": "c010",
 "title": "苏武传",
 "voice": "zh-CN-YunjianNeural",
 "rate": "-10%",
 "pitch": "+0Hz",
 "dur": 497.544,
 "hdr": 2,
 "bodyCues": 106,
 "v": "e8b25ed1",
 "cues": [
  {
   "t": 0.1,
   "d": 1.381,
   "s": "苏武传"
  },
  {
   "t": 1.431,
   "d": 2.153,
   "s": "东汉，班固"
  },
  {
   "t": 3.583,
   "d": 4.361,
   "s": "武字子卿，少以父任，兄弟并为郎。"
  },
  {
   "t": 7.944,
   "d": 2.361,
   "s": "稍迁至栘中厩监。"
  },
  {
   "t": 10.306,
   "d": 3.819,
   "s": "时汉连伐胡，数通使相窥观。"
  },
  {
   "t": 14.125,
   "d": 5.042,
   "s": "匈奴留汉使郭吉、路充国等，前后十余辈。"
  },
  {
   "t": 19.167,
   "d": 3.583,
   "s": "匈奴使来，汉亦留之以相当。"
  },
  {
   "t": 22.75,
   "d": 8.208,
   "s": "天汉元年，且鞮侯单于初立，恐汉袭之，乃曰：汉天子我丈人行也。"
  },
  {
   "t": 30.958,
   "d": 2.542,
   "s": "尽归汉使路充国等。"
  },
  {
   "t": 33.5,
   "d": 8.819,
   "s": "武帝嘉其义，乃遣武以中郎将使持节送匈奴使留在汉者，因厚赂单于，答其善意。"
  },
  {
   "t": 42.319,
   "d": 5.917,
   "s": "武与副中郎将张胜及假吏常惠等募士斥候百余人俱。"
  },
  {
   "t": 48.236,
   "d": 3.097,
   "s": "既至匈奴，置币遗单于。"
  },
  {
   "t": 51.333,
   "d": 3.389,
   "s": "单于益骄，非汉所望也。"
  },
  {
   "t": 54.722,
   "d": 5.681,
   "s": "方欲发使送武等，会缑王与长水虞常等谋反匈奴中。"
  },
  {
   "t": 60.403,
   "d": 7.222,
   "s": "缑王者，昆邪王姊子也，与昆邪王俱降汉，后随浞野侯没胡中。"
  },
  {
   "t": 67.625,
   "d": 5.375,
   "s": "及卫律所将降者，阴相与谋劫单于母阏氏归汉。"
  },
  {
   "t": 73.0,
   "d": 11.222,
   "s": "会武等至匈奴，虞常在汉时素与副张胜相知，私候胜曰：闻汉天子甚怨卫律，常能为汉伏弩射杀之。"
  },
  {
   "t": 84.222,
   "d": 3.458,
   "s": "吾母与弟在汉，幸蒙其赏赐。"
  },
  {
   "t": 87.681,
   "d": 3.306,
   "s": "张胜许之，以货物与常。"
  },
  {
   "t": 90.986,
   "d": 4.208,
   "s": "后月余，单于出猎，独阏氏子弟在。"
  },
  {
   "t": 95.194,
   "d": 4.722,
   "s": "虞常等七十余人欲发，其一人夜亡，告之。"
  },
  {
   "t": 99.917,
   "d": 2.361,
   "s": "单于子弟发兵与战。"
  },
  {
   "t": 102.278,
   "d": 3.208,
   "s": "缑王等皆死，虞常生得。"
  },
  {
   "t": 105.486,
   "d": 2.431,
   "s": "单于使卫律治其事。"
  },
  {
   "t": 107.917,
   "d": 3.958,
   "s": "张胜闻之，恐前语发，以状语武。"
  },
  {
   "t": 111.875,
   "d": 3.5,
   "s": "武曰：事如此，此必及我。"
  },
  {
   "t": 115.375,
   "d": 2.764,
   "s": "见犯乃死，重负国。"
  },
  {
   "t": 118.139,
   "d": 3.486,
   "s": "欲自杀，胜、惠共止之。"
  },
  {
   "t": 121.625,
   "d": 2.069,
   "s": "虞常果引张胜。"
  },
  {
   "t": 123.694,
   "d": 4.375,
   "s": "单于怒，召诸贵人议，欲杀汉使者。"
  },
  {
   "t": 128.069,
   "d": 4.361,
   "s": "左伊秩訾曰：即谋单于，何以复加？"
  },
  {
   "t": 132.431,
   "d": 1.778,
   "s": "宜皆降之。"
  },
  {
   "t": 134.208,
   "d": 2.597,
   "s": "单于使卫律召武受辞。"
  },
  {
   "t": 136.806,
   "d": 5.125,
   "s": "武谓惠等：屈节辱命，虽生，何面目以归汉！"
  },
  {
   "t": 141.931,
   "d": 1.889,
   "s": "引佩刀自刺。"
  },
  {
   "t": 143.819,
   "d": 3.625,
   "s": "卫律惊，自抱持武，驰召医。"
  },
  {
   "t": 147.444,
   "d": 5.417,
   "s": "凿地为坎，置煴火，覆武其上，蹈其背以出血。"
  },
  {
   "t": 152.861,
   "d": 2.708,
   "s": "武气绝，半日复息。"
  },
  {
   "t": 155.569,
   "d": 2.208,
   "s": "惠等哭，舆归营。"
  },
  {
   "t": 157.778,
   "d": 5.167,
   "s": "单于壮其节，朝夕遣人候问武，而收系张胜。"
  },
  {
   "t": 162.944,
   "d": 5.778,
   "s": "武益愈，单于使使晓武，会论虞常，欲因此时降武。"
  },
  {
   "t": 168.722,
   "d": 6.792,
   "s": "剑斩虞常已，律曰：汉使张胜谋杀单于近臣，当死。"
  },
  {
   "t": 175.514,
   "d": 2.139,
   "s": "单于募降者赦罪。"
  },
  {
   "t": 177.653,
   "d": 3.028,
   "s": "举剑欲击之，胜请降。"
  },
  {
   "t": 180.681,
   "d": 3.528,
   "s": "律谓武曰：副有罪，当相坐。"
  },
  {
   "t": 184.208,
   "d": 4.806,
   "s": "武曰：本无谋，又非亲属，何谓相坐？"
  },
  {
   "t": 189.014,
   "d": 2.722,
   "s": "复举剑拟之，武不动。"
  },
  {
   "t": 191.736,
   "d": 6.486,
   "s": "律曰：苏君，律前负汉归匈奴，幸蒙大恩，赐号称王。"
  },
  {
   "t": 198.222,
   "d": 4.319,
   "s": "拥众数万，马畜弥山，富贵如此！"
  },
  {
   "t": 202.542,
   "d": 3.125,
   "s": "苏君今日降，明日复然。"
  },
  {
   "t": 205.667,
   "d": 3.417,
   "s": "空以身膏草野，谁复知之！"
  },
  {
   "t": 209.083,
   "d": 1.306,
   "s": "武不应。"
  },
  {
   "t": 210.389,
   "d": 8.444,
   "s": "律曰：君因我降，与君为兄弟；今不听吾计，后虽欲复见我，尚可得乎？"
  },
  {
   "t": 218.833,
   "d": 8.625,
   "s": "武骂律曰：汝为人臣子，不顾恩义，畔主背亲，为降虏于蛮夷，何以汝为见！"
  },
  {
   "t": 227.458,
   "d": 7.083,
   "s": "且单于信汝，使决人死生，不平心持正，反欲斗两主，观祸败。"
  },
  {
   "t": 234.542,
   "d": 6.097,
   "s": "若知我不降明，欲令两国相攻，匈奴之祸，从我始矣。"
  },
  {
   "t": 240.639,
   "d": 3.181,
   "s": "律知武终不可胁，白单于。"
  },
  {
   "t": 243.819,
   "d": 2.458,
   "s": "单于愈益欲降之。"
  },
  {
   "t": 246.278,
   "d": 3.5,
   "s": "乃幽武置大窖中，绝不饮食。"
  },
  {
   "t": 249.778,
   "d": 6.0,
   "s": "天雨雪，武卧啮雪，与旃毛并咽之，数日不死。"
  },
  {
   "t": 255.778,
   "d": 1.944,
   "s": "匈奴以为神。"
  },
  {
   "t": 257.722,
   "d": 5.139,
   "s": "乃徙武北海上无人处，使牧羝，羝乳乃得归。"
  },
  {
   "t": 262.861,
   "d": 3.403,
   "s": "别其官属常惠等各置他所。"
  },
  {
   "t": 266.264,
   "d": 5.694,
   "s": "武既至海上，廪食不至，掘野鼠去草实，而食之。"
  },
  {
   "t": 271.958,
   "d": 4.472,
   "s": "杖汉节牧羊，卧起操持，节旄尽落。"
  },
  {
   "t": 276.431,
   "d": 4.069,
   "s": "积五六年，单于弟於靬王弋射海上。"
  },
  {
   "t": 280.5,
   "d": 5.556,
   "s": "武能网纺缴，檠弓弩，於靬王爱之，给其衣食。"
  },
  {
   "t": 286.056,
   "d": 5.125,
   "s": "三岁余，王病，赐武马畜、服匿、穹庐。"
  },
  {
   "t": 291.181,
   "d": 2.778,
   "s": "王死后，人众徙去。"
  },
  {
   "t": 293.958,
   "d": 4.444,
   "s": "其冬，丁令盗武牛羊，武复穷厄。"
  },
  {
   "t": 298.588,
   "d": 3.075,
   "s": "初，武与李陵俱为侍中。"
  },
  {
   "t": 301.613,
   "d": 4.389,
   "s": "武使匈奴，明年，陵降，不敢求武。"
  },
  {
   "t": 306.002,
   "d": 4.75,
   "s": "久之，单于使陵至海上，为武置酒设乐。"
  },
  {
   "t": 310.752,
   "d": 6.917,
   "s": "因谓武曰：单于闻陵与子卿素厚，故使陵来说足下，虚心欲相待。"
  },
  {
   "t": 317.669,
   "d": 5.792,
   "s": "终不得归汉，空自苦亡人之地，信义安所见乎？"
  },
  {
   "t": 323.46,
   "d": 10.236,
   "s": "前长君为奉车，从至雍棫阳宫，扶辇下除，触柱折辕，劾大不敬，伏剑自刎，赐钱二百万以葬。"
  },
  {
   "t": 333.696,
   "d": 11.986,
   "s": "孺卿从祠河东后土，宦骑与黄门驸马争船，推堕驸马河中溺死，宦骑亡，诏使孺卿逐捕，不得，惶恐饮药而死。"
  },
  {
   "t": 345.682,
   "d": 4.264,
   "s": "来时太夫人已不幸，陵送葬至阳陵。"
  },
  {
   "t": 349.946,
   "d": 3.472,
   "s": "子卿妇年少，闻已更嫁矣。"
  },
  {
   "t": 353.419,
   "d": 6.236,
   "s": "独有女弟二人，两女一男，今复十余年，存亡不可知。"
  },
  {
   "t": 359.655,
   "d": 3.667,
   "s": "人生如朝露，何久自苦如此！"
  },
  {
   "t": 363.321,
   "d": 6.278,
   "s": "陵始降时，忽忽如狂，自痛负汉，加以老母系保宫。"
  },
  {
   "t": 369.599,
   "d": 3.222,
   "s": "子卿不欲降，何以过陵？"
  },
  {
   "t": 372.821,
   "d": 8.861,
   "s": "且陛下春秋高，法令亡常，大臣亡罪夷灭者数十家，安危不可知，子卿尚复谁为乎？"
  },
  {
   "t": 381.682,
   "d": 2.806,
   "s": "愿听陵计，勿复有云。"
  },
  {
   "t": 384.488,
   "d": 9.694,
   "s": "武曰：武父子亡功德，皆为陛下所成就，位列将，爵通侯，兄弟亲近，常愿肝脑涂地。"
  },
  {
   "t": 394.182,
   "d": 5.264,
   "s": "今得杀身自效，虽蒙斧钺汤镬，诚甘乐之。"
  },
  {
   "t": 399.446,
   "d": 3.139,
   "s": "臣事君，犹子事父也。"
  },
  {
   "t": 402.585,
   "d": 4.431,
   "s": "子为父死，亡所恨，愿勿复再言！"
  },
  {
   "t": 407.016,
   "d": 4.764,
   "s": "陵与武饮数日，复曰：子卿壹听陵言！"
  },
  {
   "t": 411.78,
   "d": 3.125,
   "s": "武曰：自分已死久矣！"
  },
  {
   "t": 414.905,
   "d": 4.889,
   "s": "王必欲降武，请毕今日之欢，效死于前！"
  },
  {
   "t": 419.794,
   "d": 5.014,
   "s": "陵见其至诚，喟然叹曰：嗟乎，义士！"
  },
  {
   "t": 424.807,
   "d": 3.167,
   "s": "陵与卫律之罪上通于天！"
  },
  {
   "t": 427.974,
   "d": 3.153,
   "s": "因泣下沾衿，与武决去。"
  },
  {
   "t": 431.127,
   "d": 4.542,
   "s": "陵恶自赐武，使其妻赐武牛羊数十头。"
  },
  {
   "t": 435.669,
   "d": 8.5,
   "s": "后陵复至北海上，语武：区脱捕得云中生口，言太守以下吏民皆白服，曰上崩。"
  },
  {
   "t": 444.169,
   "d": 4.792,
   "s": "武闻之，南乡号哭，欧血，旦夕临。"
  },
  {
   "t": 448.96,
   "d": 2.306,
   "s": "数月，昭帝即位。"
  },
  {
   "t": 451.266,
   "d": 3.042,
   "s": "数年，匈奴与汉和亲。"
  },
  {
   "t": 454.307,
   "d": 3.514,
   "s": "汉求武等，匈奴诡言武死。"
  },
  {
   "t": 457.821,
   "d": 7.319,
   "s": "后汉使复至匈奴，常惠请其守者与俱，得夜见汉使，具自陈道。"
  },
  {
   "t": 465.141,
   "d": 8.153,
   "s": "教使者谓单于，言天子射上林中，得雁，足有系帛书，言武等在某泽中。"
  },
  {
   "t": 473.294,
   "d": 3.625,
   "s": "使者大喜，如惠语以让单于。"
  },
  {
   "t": 476.919,
   "d": 5.056,
   "s": "单于视左右而惊，谢汉使曰：武等实在。"
  },
  {
   "t": 481.974,
   "d": 6.153,
   "s": "单于召会武官属，前以降及物故，凡随武还者九人。"
  },
  {
   "t": 488.127,
   "d": 3.028,
   "s": "武以始元六年春至京师。"
  },
  {
   "t": 491.155,
   "d": 6.306,
   "s": "武留匈奴凡十九岁，始以强壮出，及还，须发尽白。"
  }
 ]
}