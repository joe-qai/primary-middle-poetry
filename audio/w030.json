 "cues": [
  {
   "t": 0.1,
   "d": 2.006,
   "s": "富贵不能淫"
  },
  {
   "t": 2.056,
   "d": 2.181,
   "s": "战国，孟子"
  },
  {
   "t": 4.236,
   "d": 4.972,
   "s": "景春曰：公孙衍、张仪岂不诚大丈夫哉？"
  },
  {
   "t": 9.208,
   "d": 3.819,
   "s": "一怒而诸侯惧，安居而天下熄。"
  },
  {
   "t": 13.028,
   "d": 3.736,
   "s": "孟子曰：是焉得为大丈夫乎？"
  },
  {
   "t": 16.764,
   "d": 2.056,
   "s": "子未学礼乎？"
  },
  {
   "t": 18.819,
   "d": 11.153,
   "s": "丈夫之冠也，父命之；女子之嫁也，母命之，往送之门，戒之曰：往之女家，必敬必戒，无违夫子！"
  },
  {
   "t": 29.972,
   "d": 3.458,
   "s": "以顺为正者，妾妇之道也。"
  },
  {
   "t": 33.431,
   "d": 5.472,
   "s": "居天下之广居，立天下之正位，行天下之大道。"
  },
  {
   "t": 38.903,
   "d": 4.361,
   "s": "得志，与民由之；不得志，独行其道。"
  },
  {
   "t": 43.264,
   "d": 6.792,
   "s": "富贵不能淫，贫贱不能移，威武不能屈，此之谓大丈夫。"
  }
 ]
}