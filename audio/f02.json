 "cues": [
  {
   "t": 0.1,
   "d": 2.144,
   "s": "假如——致儿子"
  },
  {
   "t": 2.194,
   "d": 3.542,
   "s": "英国，拉迪亚德，吉卜林"
  },
  {
   "t": 5.908,
   "d": 4.7,
   "s": "假如你能容忍被歪曲的话，而不以牙还牙，"
  },
  {
   "t": 10.558,
   "d": 3.875,
   "s": "或者被人憎恨却不以仇恨报应；"
  },
  {
   "t": 14.433,
   "d": 3.444,
   "s": "假如你肯等待又不因此急躁，"
  },
  {
   "t": 17.877,
   "d": 3.694,
   "s": "也不会因为别人说谎就跟着说谎，"
  },
  {
   "t": 21.572,
   "d": 3.764,
   "s": "假如你肯梦想——但不让梦做主宰，"
  },
  {
   "t": 25.336,
   "d": 3.958,
   "s": "假如你肯思考——但不把思想当目的，"
  },
  {
   "t": 29.294,
   "d": 3.569,
   "s": "假如遇见胜利和失败两位骗子，"
  },
  {
   "t": 32.864,
   "d": 3.125,
   "s": "却能一视同仁镇定地对待；"
  },
  {
   "t": 35.989,
   "d": 3.556,
   "s": "假如你能把输赢交给命运处理，"
  },
  {
   "t": 39.544,
   "d": 3.208,
   "s": "冒着一切风险坚持到底，"
  },
  {
   "t": 42.752,
   "d": 3.458,
   "s": "用所剩无几的力量继续奋斗，"
  },
  {
   "t": 46.211,
   "d": 3.583,
   "s": "即使一无所有只剩毅力支撑……"
  },
  {
   "t": 49.794,
   "d": 3.194,
   "s": "你的品德就会这样强大，"
  },
  {
   "t": 52.989,
   "d": 3.514,
   "s": "大地也会为你充满丰富的内容，"
  },
  {
   "t": 56.502,
   "d": 4.431,
   "s": "更重要的是，你将成为一个真正的人！"
  }
 ]
}