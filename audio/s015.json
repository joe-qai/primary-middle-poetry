 "cues": [
  {
   "t": 0.1,
   "d": 1.658,
   "s": "愚公移山"
  },
  {
   "t": 1.708,
   "d": 3.0,
   "s": "战国，列子，汤问"
  },
  {
   "t": 4.708,
   "d": 9.903,
   "s": "太行山和王屋山这两座大山，方圆七百里，高七八千丈，本来在冀州的南面、黄河北岸的北面。"
  },
  {
   "t": 14.611,
   "d": 6.264,
   "s": "北山有个老人叫愚公，年近九十，他家面对着这两座大山。"
  },
  {
   "t": 20.875,
   "d": 14.208,
   "s": "愚公苦于山北阻塞，出入要绕远路，就召集全家人商量说：我和你们尽全力铲平险峻的大山，让道路一直通到豫州南部，到达汉水南岸，好吗？"
  },
  {
   "t": 35.083,
   "d": 2.736,
   "s": "全家人纷纷表示赞同。"
  },
  {
   "t": 37.819,
   "d": 7.486,
   "s": "于是愚公带领子孙，凿石头、挖泥土，用箕畚把土石运到渤海边上。"
  },
  {
   "t": 45.306,
   "d": 4.125,
   "s": "河曲智叟嘲笑他说：你太不聪明了！"
  },
  {
   "t": 49.431,
   "d": 6.139,
   "s": "凭你残年余力，连山上的草木都毁不掉，又能把土石怎么样？"
  },
  {
   "t": 55.569,
   "d": 5.125,
   "s": "愚公长叹说：你思想顽固，还不如寡妇和小孩。"
  },
  {
   "t": 60.694,
   "d": 11.472,
   "s": "即使我死了，还有儿子在；儿子又生孙子，孙子又生儿子；子子孙孙无穷无尽，可是山却不会增高，还怕挖不平吗？"
  },
  {
   "t": 72.167,
   "d": 2.097,
   "s": "智叟无言以对。"
  },
  {
   "t": 74.264,
   "d": 6.194,
   "s": "山神听说后，怕愚公挖山不止，就把这件事报告了天帝。"
  },
  {
   "t": 80.458,
   "d": 7.597,
   "s": "天帝被愚公的诚心感动，命令大力神夸娥氏的两个儿子背走了两座大山。"
  }
 ]
}