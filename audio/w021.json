  {
   "t": 0.1,
   "d": 1.464,
   "s": "诫子书"
  },
  {
   "t": 1.514,
   "d": 2.139,
   "s": "三国，诸葛亮"
  },
  {
   "t": 3.653,
   "d": 4.611,
   "s": "夫君子之行，静以修身，俭以养德。"
  },
  {
   "t": 8.264,
   "d": 4.361,
   "s": "非淡泊无以明志，非宁静无以致远。"
  },
  {
   "t": 12.625,
   "d": 6.764,
   "s": "夫学须静也，才须学也，非学无以广才，非志无以成学。"
  },
  {
   "t": 19.389,
   "d": 4.056,
   "s": "淫慢则不能励精，险躁则不能治性。"
  },
  {
   "t": 23.444,
   "d": 8.153,
   "s": "年与时驰，意与日去，遂成枯落，多不接世，悲守穷庐，将复何及！"
  }
 ]
}